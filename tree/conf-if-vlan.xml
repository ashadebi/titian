<?xml version="1.0" encoding="UTF-8"?>
<CLISH_MODULE xmlns="http://clish.sourceforge.net/XMLSchema" 
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
 xsi:schemaLocation="http://clish.sourceforge.net/XMLSchema
                     http://clish.sourceforge.net/XMLSchema/clish.xsd">
    <!--=======================================================-->

<VIEW name="configure-view">

    <COMMAND name="interface vlan"
        help="vlan interface"
        view="configure-vlan-view"
        viewid="iface=${iface_vlan}">
        <PARAM name="iface_vlan"
            help="nama-parent.VLAN-ID (contoh: enp9s0.100; parent boleh nama hasil rename)"
            completion="${Get_if_vlan}"
            ptype="IFACE_VLAN"/>
        <CONFIG priority="0x2200" pattern="^${__line}$"/>
        <ACTION>
            # Loading module
            if test ! -d "/proc/net/vlan"; then
                printf "%s \n" "[loading modules]"
                modprobe 8021q
            fi
            # split eth . vid, chk if
            Chkif=`echo ${iface_vlan}|awk -F"." '{print $1}'`
            Chkvid=`echo ${iface_vlan}|awk -F"." '{print $2}'`
            if test ! -d "/sys/class/net/$Chkif"; then
                printf "%s \n" "Error: interface $Chkif tidak ditemukan di sistem (lihat 'show interfaces' untuk daftar)."
                exit 33
            elif test ! -f "/proc/net/vlan/${iface_vlan}"; then
                if ! ip link add name ${iface_vlan} link $Chkif type vlan id $Chkvid; then
                    printf "%s \n" "Error: gagal membuat ${iface_vlan} (nama terlalu panjang atau parent tidak valid).."
                    exit 33
                fi
                ${RT_SBIN}/titian-persist.sh mark-if "${iface_vlan}"
            fi
        </ACTION>
    </COMMAND>

<!-- no vlan config-->
    <COMMAND name="no interface vlan"
            help="hapus interface vlan">
            <PARAM name="iface_vlan"
                help=""
                completion="${Get_if_vlan}"
                ptype="IFACE_VLAN"/>
        <CONFIG operation="unset" pattern="interface vlan ${iface_vlan}$"/>
        <ACTION>
            if test -d "/sys/class/net/${iface_vlan}"; then
                ip link del dev ${iface_vlan}
                ${RT_SBIN}/titian-persist.sh drop-if "${iface_vlan}"
            else
                printf "%s \n" "${iface_vlan} not found.."
                exit 0
            fi
        </ACTION>
    </COMMAND>

</VIEW>

<VIEW name="configure-vlan-view"
    prompt="${SYSTEM_NAME}(config-vlan-${iface})# "
    depth="1">
    <COMMAND name="ipv6"
        help="Interface IPv6 config commands"/>

    <COMMAND name="no ipv6"
        help="Negate IPv6 commands"/>


<!-- Inheritance -->
    <NAMESPACE ref="configure-view"
        help="false"
        completion="true"/>

<!-- configure-vlan-view commands -->
    <COMMAND name="exit"
        help="Exit from interface configuration mode"
        lock="false">
        <ACTION builtin="clish_nested_up"/>
    </COMMAND>
    <HOTKEY key="^Z" cmd="exit"/>
    
    <COMMAND name="no"
        help="Negate a command or set its defaults"/>

    <COMMAND name="ip"
        help="Interface Internet Protocol config commands"/>

    <COMMAND name="no ip"
        help="Interface Internet Protocol config commands"/>

<!-- Enable/Disable -->
    <COMMAND name="disable"
          help="Disable the selected interface">
        <CONFIG operation="unset" pattern="^enable"/>
        <ACTION>
            ip link set ${iface} down
        </ACTION>
    </COMMAND>

    <COMMAND name="enable"
        help="Enable the selected interface">
        <CONFIG/>
        <ACTION>
            ip link set ${iface} up
        </ACTION>
    </COMMAND>

<!-- IP address -->
    <COMMAND name="ip address"
            help="Set the IP address of an interface">
            <PARAM name="ip"
                help="IP address"
                ptype="IP_ADDR_MASK_OPT"/>
        <PARAM name="peer"
                help="Peer address for point-to-point link (ex: ip address 103.50.128.1 peer 10.10.10.10)"
                optional="true"
                mode="subcommand"
                ptype="SUBCOMMAND">
            <PARAM name="peer_ip"
                help="Peer IP address"
                ptype="IP_ADDR"/>
        </PARAM>
        <CONFIG pattern="ip address ${ip}" splitter="false"/>
        <ACTION>
            ${RT_SBIN}/titian-if.sh addr-add "${iface}" "${ip}" "${peer_ip}" &amp;&amp; ${RT_SBIN}/titian-persist.sh sync-if "${iface}"
        </ACTION>
    </COMMAND>

    <COMMAND name="no ip address"
           help="Delete IP address of an interface"
           lock="false">
           <PARAM name="ip"
                help="IP address"
                ptype="IP_ADDR_MASK_OPT"/>
        <PARAM name="peer"
                help="Peer address for point-to-point link"
                optional="true"
                mode="subcommand"
                ptype="SUBCOMMAND">
            <PARAM name="peer_ip"
                help="Peer IP address"
                ptype="IP_ADDR"/>
        </PARAM>
        <CONFIG operation="unset" pattern="ip address ${ip}"/>
        <ACTION>
            ${RT_SBIN}/titian-if.sh addr-del "${iface}" "${ip}" "${peer_ip}" &amp;&amp; ${RT_SBIN}/titian-persist.sh sync-if "${iface}"
        </ACTION>
    </COMMAND>

<!-- IPv6 address (TITIAN Fase 1) -->
    <COMMAND name="ipv6 address"
            help="Set the IPv6 address of an interface">
            <PARAM name="ip"
                help="IPv6 address"
                ptype="IP6_ADDR_MASK_OPT"/>
        <PARAM name="peer"
                help="Peer address for point-to-point link"
                optional="true"
                mode="subcommand"
                ptype="SUBCOMMAND">
            <PARAM name="peer_ip"
                help="Peer IPv6 address"
                ptype="IP6_ADDR"/>
        </PARAM>
        <CONFIG pattern="ipv6 address ${ip}" splitter="false"/>
        <ACTION>
            ${RT_SBIN}/titian-if.sh addr6-add "${iface}" "${ip}" "${peer_ip}" &amp;&amp; ${RT_SBIN}/titian-persist.sh sync-if "${iface}"
        </ACTION>
    </COMMAND>

    <COMMAND name="no ipv6 address"
           help="Delete IPv6 address of an interface"
           lock="false">
           <PARAM name="ip"
                help="IPv6 address"
                ptype="IP6_ADDR_MASK_OPT"/>
        <PARAM name="peer"
                help="Peer address for point-to-point link"
                optional="true"
                mode="subcommand"
                ptype="SUBCOMMAND">
            <PARAM name="peer_ip"
                help="Peer IPv6 address"
                ptype="IP6_ADDR"/>
        </PARAM>
        <CONFIG operation="unset" pattern="ipv6 address ${ip}"/>
        <ACTION>
            ${RT_SBIN}/titian-if.sh addr6-del "${iface}" "${ip}" "${peer_ip}" &amp;&amp; ${RT_SBIN}/titian-persist.sh sync-if "${iface}"
        </ACTION>
    </COMMAND>

    <COMMAND name="description"
            help="human-readable Alias link description">
        <PARAM name="desc"
              help="Description/Alias"
              ptype="STRING"/>
        <CONFIG/>
        <ACTION>
            ip link set dev ${iface} alias "${desc}"
        </ACTION>
    </COMMAND>

    <COMMAND name="mtu"
              help="MTU: ukuran paket terbesar lewat interface (live + persisten). 1500 = default Ethernet; 9000 = jumbo, wajib didukung seluruh path.">
            <PARAM name="mtu"
                help="range 68-9000"
                ptype="MTU"/>
        <CONFIG pattern="^mtu"/>
        <ACTION>
            if test -d "/sys/class/net/${iface}/master"; then
                printf "%s \n" "Error: ${iface} mode is bond-group."
                exit 33
            else
                ${RT_SBIN}/titian-tune.sh mtu "${iface}" "${mtu}"
            fi
        </ACTION>
    </COMMAND>

    <COMMAND name="no mtu"
              help="Hapus setelan MTU Titian (kembali ke nilai sebelum di-set Titian (umumnya 1500); cermin bersih)">
        <CONFIG operation="unset" pattern="^mtu"/>
        <ACTION>
            ${RT_SBIN}/titian-tune.sh mtu-del "${iface}"
        </ACTION>
    </COMMAND>

<!-- Depth2 options, view yang sama dengan ethernet (offload/coalesce
     lewat ethtool juga berlaku untuk device vlan) -->
    <COMMAND name="options"
            help="Depth Coalesce and Features parameter"
            view="configure-if-options"
            viewid="iface=${iface}">
            <CONFIG pattern="^${__line}$"/>
    </COMMAND>

</VIEW>

</CLISH_MODULE>