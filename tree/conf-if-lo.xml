<?xml version="1.0" encoding="UTF-8"?>
<CLISH_MODULE xmlns="http://clish.sourceforge.net/XMLSchema" 
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
 xsi:schemaLocation="http://clish.sourceforge.net/XMLSchema
                     http://clish.sourceforge.net/XMLSchema/clish.xsd">
	<!--===========================
modprobe dummy numdummies=1 (default)
    ============================-->

<VIEW name="configure-view">

	<COMMAND name="interface loopback"
		help="dummy interface"
		view="configure-lo-view"
		viewid="iface=${iface_dummy}">
		<PARAM name="iface_dummy"
			help=""
            completion="${Get_if_dummy}"
			ptype="IFACE_DUMMY"/>
		<CONFIG priority="0x1999" pattern="^${__line}$"/>
            <ACTION>
                # Loading module
                if test ! -d "/sys/class/net/${iface_dummy}"; then
                    lsmod |grep dummy > /dev/null
                    Rval=$?
                    if [ "$Rval" -ne 0 ]; then
                        printf "%s \n" "[loading modules]"
                        modprobe dummy numdummies=0
                    fi
                fi
                
                if test ! -d "/sys/class/net/${iface_dummy}"; then
                    ip link add name ${iface_dummy} type dummy
                    ${RT_SBIN}/titian-persist.sh mark-if "${iface_dummy}"
                fi
            </ACTION>
	</COMMAND>

<!-- no loopback config-->
    <COMMAND name="no interface loopback"
            help="delete interface loopback">
            <PARAM name="iface_dummy"
                    help=""
                    completion="${Get_if_dummy}"
                    ptype="IFACE_DUMMY"/>
        <CONFIG operation="unset" pattern="interface loopback ${iface_dummy}$"/>
            <ACTION>
                if test -d "/sys/class/net/${iface_dummy}"; then
                    ip link del dev ${iface_dummy}
                else
                    printf "%s \n" "${iface_dummy} not found.."
                fi
            </ACTION>
    </COMMAND>
</VIEW>

<!-- configure-lo-view commands -->
<VIEW name="configure-lo-view"
	prompt="${SYSTEM_NAME}(config-lo-${iface})# "
	depth="1">
    <COMMAND name="ipv6"
        help="Interface IPv6 config commands"/>

    <COMMAND name="no ipv6"
        help="Negate IPv6 commands"/>


<!-- Inheritance -->
	<NAMESPACE ref="configure-view"
		help="false"
		completion="true"/>

	<COMMAND name="exit"
		help="Exit configuration mode"
		lock="false">
		<ACTION builtin="clish_nested_up"/>
	</COMMAND>
    <HOTKEY key="^Z" cmd="exit"/>

	<COMMAND name="no"
		help="Negate a command or set its defaults"/>

	<COMMAND name="ip"
		help="Interface Internet Protocol config commands"/>

	<COMMAND name="no ip"
		help="Interface Internet Protocol config commands"/>


<!-- Enable/Disable -->
    <COMMAND name="disable"
          help="Disable the selected interface">
        <CONFIG operation="unset" pattern="^enable"/>
        <ACTION>
            ip link set ${iface} down
        </ACTION>
    </COMMAND>

    <COMMAND name="enable"
        help="Enable the selected interface">
        <CONFIG/>
        <ACTION>
            ip link set ${iface} up
        </ACTION>
    </COMMAND>

<!-- IP address -->
    <COMMAND name="ip address"
            help="Set the IP address of an interface">
            <PARAM name="ip"
                help="IP address"
                ptype="IP_ADDR_MASK_OPT"/>
        <PARAM name="peer"
                help="Peer address for point-to-point link (ex: ip address 103.50.128.1 peer 10.10.10.10)"
                optional="true"
                mode="subcommand"
                ptype="SUBCOMMAND">
            <PARAM name="peer_ip"
                help="Peer IP address"
                ptype="IP_ADDR"/>
        </PARAM>
        <CONFIG pattern="ip address ${ip}" splitter="false"/>
        <ACTION>
            ${RT_SBIN}/titian-if.sh addr-set "${iface}" "${ip}" "${peer_ip}" &amp;&amp; ${RT_SBIN}/titian-persist.sh sync-if "${iface}"
        </ACTION>
    </COMMAND>

    <COMMAND name="no ip address"
           help="Delete IP address of an interface"
           lock="false">
           <PARAM name="ip"
                help="IP address"
                ptype="IP_ADDR_MASK_OPT"/>
        <PARAM name="peer"
                help="Peer address for point-to-point link"
                optional="true"
                mode="subcommand"
                ptype="SUBCOMMAND">
            <PARAM name="peer_ip"
                help="Peer IP address"
                ptype="IP_ADDR"/>
        </PARAM>
        <CONFIG operation="unset" pattern="^ip address"/>
        <ACTION>
            ${RT_SBIN}/titian-if.sh addr-del "${iface}" "${ip}" "${peer_ip}" &amp;&amp; ${RT_SBIN}/titian-persist.sh sync-if "${iface}"
        </ACTION>
    </COMMAND>

<!-- IPv6 address (TITIAN Fase 1) -->
    <COMMAND name="ipv6 address"
            help="Set the IPv6 address of an interface">
            <PARAM name="ip"
                help="IPv6 address"
                ptype="IP6_ADDR_MASK_OPT"/>
        <PARAM name="peer"
                help="Peer address for point-to-point link"
                optional="true"
                mode="subcommand"
                ptype="SUBCOMMAND">
            <PARAM name="peer_ip"
                help="Peer IPv6 address"
                ptype="IP6_ADDR"/>
        </PARAM>
        <CONFIG pattern="ipv6 address ${ip}" splitter="false"/>
        <ACTION>
            ${RT_SBIN}/titian-if.sh addr6-add "${iface}" "${ip}" "${peer_ip}" &amp;&amp; ${RT_SBIN}/titian-persist.sh sync-if "${iface}"
        </ACTION>
    </COMMAND>

    <COMMAND name="no ipv6 address"
           help="Delete IPv6 address of an interface"
           lock="false">
           <PARAM name="ip"
                help="IPv6 address"
                ptype="IP6_ADDR_MASK_OPT"/>
        <PARAM name="peer"
                help="Peer address for point-to-point link"
                optional="true"
                mode="subcommand"
                ptype="SUBCOMMAND">
            <PARAM name="peer_ip"
                help="Peer IPv6 address"
                ptype="IP6_ADDR"/>
        </PARAM>
        <CONFIG operation="unset" pattern="ipv6 address ${ip}"/>
        <ACTION>
            ${RT_SBIN}/titian-if.sh addr6-del "${iface}" "${ip}" "${peer_ip}" &amp;&amp; ${RT_SBIN}/titian-persist.sh sync-if "${iface}"
        </ACTION>
    </COMMAND>

    <COMMAND name="description"
            help="human-readable Alias link description">
        <PARAM name="desc"
              help="Description/Alias"
              ptype="STRING"/>
        <CONFIG/>
        <ACTION>
            ip link set dev ${iface} alias "${desc}"
        </ACTION>
    </COMMAND>

</VIEW>

</CLISH_MODULE>
