X#!/bin/sh
X# TITIAN BSDRP — BIRD per-section generator + deteksi varian bird2/bird3
X# + mutual exclusion bird vs FRR.
X# Desain: files/klish-bird2-bird3.md (§1 deteksi, §2a-e adaptasi, §2f
X# mutual exclusion). Satu image hanya berisi SATU varian bird (binari +
X# rc script sama, CONFLICTS di ports tree).
X#
X# Urutan wajib generate: render -> validasi varian (braces `case` +
X# atribut `scope`) -> backup config lama -> bird -p -c (cek sintaks;
X# gagal = BERHENTI, tidak ada terap paksa) -> birdc configure.
X# Section hidup di /opt/titian/etc/bird.d/<section>.conf; bird.conf
X# dipotong per marker gaya rtcli (#-BGP-# ... #-ENDBGP-#, dst).
X# Satu section ditulis ulang tanpa menyentuh section lain.
X#
X# Enable/disable BIRD TIDAK langsung start/stop service: perintah
X# `router bird enable` hanya mencatat niat + menandai dirty; yang
X# menaikkan service adalah `commit` (titian-commit.sh), yang
X# memeriksa ulang mutual exclusion di sana. Alasan: commit = tulis
X# file + service langsung naik (feature-list §1-§2); enable di tengah
X# sesi tanpa commit tidak boleh mengubah service yang jalan.
X# POSIX sh.
XOS=$(uname -s)
XROOT=${TITIAN_ROOT:-/opt/titian}
XSBIN_DIR=$(dirname "$0")
XBIRD_SH="$SBIN_DIR/titian-bird.sh"
XINTENT="$ROOT/etc/netstate/routing.intent"
XDIRTY=/var/run/routing.dirty
Xerr() { echo "Error: $*" >&2; exit 33; }
X
Xconf_path() {
X    if [ "$OS" = "FreeBSD" ]; then
X        echo "/usr/local/etc/bird.conf"
X    else
X        echo "/etc/bird/bird.conf"
X    fi
X}
X
Xbird_bin() {
X    command -v bird 2>/dev/null || { [ -x /usr/sbin/bird ] && echo /usr/sbin/bird; } || \
X        { [ -x /usr/local/sbin/bird ] && echo /usr/local/sbin/bird; } || echo bird
X}
X
Xbirdc_bin() {
X    command -v birdc 2>/dev/null || { [ -x /usr/sbin/birdc ] && echo /usr/sbin/birdc; } || \
X        { [ -x /usr/local/sbin/birdc ] && echo /usr/local/sbin/birdc; } || echo birdc
X}
X
X# ---------------- deteksi varian (§1) ----------------
X# Urutan sumber (pertama yang berhasil dipakai):
X#   1. /etc/version.build (bird_version=2|3)
X#   2. bird -v (runtime truth; menang atas version.build + peringatan)
X#   3. pkg info -x '^bird[23]$'
X#   4. birdc show status (bila daemon jalan)
X# Output: "<variant> <version>" — mis. "2 2.20.0", "3 3.4.0", atau "none"
X# bila bird tidak terpasang sama sekali. Versi "unknown" bila varian
X# diketahui tapi nomor versinya tidak bisa dibaca.
X# Sengaja dideteksi per panggilan (bukan cache sekali saat klish start):
X# murah (baca file + `bird -v`) dan tidak pernah basi bila binari
X# diganti manual pasca-install.
Xdetect_variant() {
X    local vb="" bv="" bver="unknown" variant=""
X    if [ -f /etc/version.build ]; then
X        vb=$(sed -n 's/^bird_version=//p' /etc/version.build 2>/dev/null | head -1 | tr -d '[:space:]')
X        case "$vb" in 2|3) ;; *) vb="" ;; esac
X    fi
X    if command -v bird >/dev/null 2>&1 || [ -x /usr/sbin/bird ] || [ -x /usr/local/sbin/bird ]; then
X        bv=$("$(bird_bin)" -v 2>&1 | head -1)
X        case "$bv" in
X            *"BIRD version 2."*) variant=2; bver=$(printf '%s' "$bv" | sed -n 's/.*BIRD version \([0-9.]*\).*/\1/p') ;;
X            *"BIRD version 3."*) variant=3; bver=$(printf '%s' "$bv" | sed -n 's/.*BIRD version \([0-9.]*\).*/\1/p') ;;
X        esac
X        [ -n "$bver" ] || bver="unknown"
X    fi
X    if [ -n "$variant" ] && [ -n "$vb" ] && [ "$variant" != "$vb" ]; then
X        echo "% Warning: bird on disk is ${bver} but this image was built with bird${vb}" >&2
X    fi
X    if [ -z "$variant" ]; then
X        if [ -n "$vb" ]; then
X            variant="$vb"
X        elif command -v pkg >/dev/null 2>&1; then
X            if pkg info -x '^bird3$' >/dev/null 2>&1; then variant=3
X            elif pkg info -x '^bird2$' >/dev/null 2>&1; then variant=2; fi
X        fi
X        if [ -z "$variant" ] && command -v birdc >/dev/null 2>&1; then
X            bv=$(birdc show status 2>/dev/null | grep -i 'BIRD version' | head -1)
X            case "$bv" in
X                *" 2."*) variant=2; bver=$(printf '%s' "$bv" | sed -n 's/.*BIRD version \([0-9.]*\).*/\1/p') ;;
X                *" 3."*) variant=3; bver=$(printf '%s' "$bv" | sed -n 's/.*BIRD version \([0-9.]*\).*/\1/p') ;;
X            esac
X        fi
X    fi
X    if [ -z "$variant" ]; then
X        echo "none"
X    else
X        echo "$variant ${bver:-unknown}"
X    fi
X}
X
Xbird_variant() { detect_variant | awk '{print $1}'; }
Xbird_version() { detect_variant | awk '{print $2}'; }
X
X# ---------------- status service/proses ----------------
X# Semua helper ini gagal-aman: bila sysrc/service/pgrep tidak ada
X# (mis. saat diuji di Linux), hasilnya "bukan YES / tidak jalan".
Xsysrc_val() {
X    # $1 = nama variabel rc.conf
X    command -v sysrc >/dev/null 2>&1 || return 1
X    sysrc -n "$1" 2>/dev/null
X}
X
Xbird_enabled() {
X    [ "$(sysrc_val bird_enable 2>/dev/null)" = "YES" ]
X}
X
Xfrr_enabled() {
X    [ "$(sysrc_val frr_enable 2>/dev/null)" = "YES" ]
X}
X
Xproc_pid() {
X    # $1 = nama proses; cetak pid pertama atau kosong
X    if command -v pgrep >/dev/null 2>&1; then
X        pgrep -x "$1" 2>/dev/null | head -1
X    else
X        ps -ax 2>/dev/null | awk -v n="$1" '$5 == n || $NF == n {print $1; exit}'
X    fi
X}
X
Xbird_pid() { proc_pid bird; }
Xzebra_pid() { proc_pid zebra; }
X
Xbird_running() { [ -n "$(bird_pid)" ]; }
Xfrr_running() { [ -n "$(zebra_pid)" ]; }
X
Xfrr_version() {
X    local v=""
X    if command -v vtysh >/dev/null 2>&1; then
X        v=$(vtysh --version 2>/dev/null | head -1 | sed -n 's/.* \([0-9][0-9.]*\).*/\1/p')
X    fi
X    if [ -z "$v" ] && command -v pkg >/dev/null 2>&1; then
X        v=$(pkg info -x '^frr[0-9]*$' 2>/dev/null | head -1 | sed -n 's/^frr[0-9]*-\([0-9][0-9.]*\).*/\1/p')
X    fi
X    printf '%s' "${v:-unknown}"
X}
X
Xintent_val() {
X    # $1 = bird|frr -> yes|no|unset
X    [ -f "$INTENT" ] || { echo "unset"; return 0; }
X    sed -n "s/^$1 //p" "$INTENT" 2>/dev/null | head -1
X    [ -n "$(sed -n "s/^$1 //p" "$INTENT" 2>/dev/null | head -1)" ] || echo "unset"
X}
X
Xset_intent() {
X    # $1 = bird|frr, $2 = yes|no
X    mkdir -p "$(dirname "$INTENT")" 2>/dev/null
X    touch "$INTENT" 2>/dev/null
X    _tmp="$INTENT.tmp.$$"
X    grep -v "^$1 " "$INTENT" > "$_tmp" 2>/dev/null || true
X    printf '%s %s\n' "$1" "$2" >> "$_tmp"
X    mv "$_tmp" "$INTENT" || err "gagal tulis $INTENT"
X    touch "$DIRTY" 2>/dev/null || true
X}
X
X# ---------------- mutual exclusion (§2f) ----------------
X# check-exclusion <bird|frr|commit>: gagal (exit 33) + pesan jelas bila
X# routing daemon lawan aktif — dicek dari TIGA sumber: niat di rc.conf
X# (sysrc), status service, dan proses yang jalan (bird/zebra).
Xcheck_exclusion() {
X    local want=$1 zpid bpid bver variant
X    variant=$(bird_variant); bver=$(bird_version); zpid=$(zebra_pid); bpid=$(bird_pid)
X    case "$want" in
X        bird)
X            if frr_enabled || frr_running || [ "$(intent_val frr)" = "yes" ]; then
X                [ -n "$zpid" ] && echo "% Warning: FRR is currently running (zebra pid $zpid, frr_enable=$(sysrc_val frr_enable 2>/dev/null || echo NO))" >&2
X                [ -z "$zpid" ] && echo "% Warning: FRR is enabled (frr_enable=$(sysrc_val frr_enable 2>/dev/null || echo NO))" >&2
X                echo "% Bird and FRR cannot run at the same time." >&2
X                exit 33
X            fi
X            ;;
X        frr)
X            if bird_enabled || bird_running || [ "$(intent_val bird)" = "yes" ]; then
X                if [ "$variant" = "none" ]; then
X                    echo "% Warning: BIRD is enabled/running (bird_enable=$(sysrc_val bird_enable 2>/dev/null || echo NO))" >&2
X                else
X                    echo "% Warning: BIRD $bver is enabled/running (bird${variant}, bird_enable=$(sysrc_val bird_enable 2>/dev/null || echo NO)${bpid:+, pid $bpid})" >&2
X                fi
X                echo "% Bird and FRR cannot run at the same time." >&2
X                exit 33
X            fi
X            ;;
X        commit)
X            # Dua arah: niat bird + frr lawan hidup, atau sebaliknya.
X            if [ "$(intent_val bird)" = "yes" ] && ( frr_enabled || frr_running ); then
X                echo "% Error: commit blocked — FRR is running. Disable FRR first:" >&2
X                echo "%   no router frr enable" >&2
X                echo "%   commit" >&2
X                exit 33
X            fi
X            if [ "$(intent_val frr)" = "yes" ] && ( bird_enabled || bird_running ); then
X                if [ "$variant" = "none" ]; then
X                    echo "% Error: commit blocked — BIRD is running (bird_enable=$(sysrc_val bird_enable 2>/dev/null || echo NO))." >&2
X                else
X                    echo "% Error: commit blocked — BIRD $bver is running (bird_enable=$(sysrc_val bird_enable 2>/dev/null || echo NO))." >&2
X                fi
X                echo "% Disable BIRD first:" >&2
X                echo "%   no router bird enable" >&2
X                echo "%   commit" >&2
X                exit 33
X            fi
X            # Konflik niat-vs-niat (kedua enable, belum ada yang jalan).
X            if [ "$(intent_val bird)" = "yes" ] && [ "$(intent_val frr)" = "yes" ]; then
X                echo "% Error: commit blocked — both BIRD and FRR are enabled. Disable one first." >&2
X                exit 33
X            fi
X            ;;
X        *) err "check-exclusion butuh: bird|frr|commit" ;;
X    esac
X    return 0
X}
X
X# ---------------- validasi varian (§2a, §2d) ----------------
X# validate-config <file>: tolak (exit 33, tunjuk baris) bila:
X#   - varian bird3 + config mengandung atribut route `scope` (dihapus di 3.1)
X#   - varian bird3 + cabang `case` multi-command TANPA braces
X#   - varian bird2 + `case` tanpa braces: hanya peringatan (diterima).
X# Heuristik satu baris: cabang `N:` / `else:` yang isi sesudah `:` tidak
X# mengandung `{` dan mengandung >= 2 pernyataan (`;`) = multi-command.
X# Cabang multi-baris tanpa braces TIDAK terdeteksi heuristik ini — tetap
X# ditangkap `bird -p` bila sintaksnya salah di bird3.
Xvalidate_config() {
X    local file=$1 variant
X    variant=$(bird_variant)
X    [ "$variant" = "none" ] && return 0
X    awk -v variant="$variant" '
X        { line=$0; sub(/#.*/, "", line) }
X        line ~ /(^|[^A-Za-z0-9_])scope([^A-Za-z0-9_]|$)/ {
X            if (variant == "3") {
X                printf "%% Error: route attribute \x27scope\x27 was removed in BIRD 3; use a custom attribute instead (line %d)\n", NR > "/dev/stderr"
X                bad=1
X            }
X        }
X        line ~ /^[[:space:]]*([0-9]+|else):/ {
X            rest=line; sub(/^[^:]*:/, "", rest)
X            if (rest !~ /\{/) {
X                n=gsub(/;/, ";", rest)
X                if (n >= 2) {
X                    if (variant == "3") {
X                        printf "%% Error: bird3 requires braces around multi-command case branch (line %d)\n", NR > "/dev/stderr"
X                        bad=1
X                    } else {
X                        printf "%% Warning: case branch without braces (line %d) — braces recommended for BIRD 3 compatibility\n", NR > "/dev/stderr"
X                    }
X                }
X            }
X        }
X        END { exit bad ? 33 : 0 }
X    ' "$file" || exit 33
X    return 0
X}
X
X# ---------------- generator (asli titian-bird.sh + validasi) ----------------
X# section -> MARKER (tanpa #- pembungkus)
Xmarker_of() {
X    case "$1" in
X        function) echo "FUNCTION" ;;
X        filter)   echo "FILTER" ;;
X        protocol) echo "PROTOCOL" ;;
X        static)   echo "PROTOCOL-STATIC" ;;
X        bgp)      echo "BGP" ;;
X        ospf)     echo "OSPF" ;;
X        direct)   echo "DIRECT" ;;
X        bfd)      echo "BFD" ;;
X        pipe)     echo "PIPE" ;;
X        *)        err "section tidak dikenal: $1 (function|filter|protocol|static|bgp|ospf|direct|bfd|pipe)" ;;
X    esac
X}
X
Xrender() {
X    # $1=section -> cetak bird.conf baru ke stdout; gagal bila marker hilang
X    local section=$1 mark sm em conf src
X    mark=$(marker_of "$section")
X    sm="#-${mark}-#"
X    em="#-END${mark}-#"
X    conf=$(conf_path)
X    src="$ROOT/etc/bird.d/$section.conf"
X    [ -f "$src" ] || err "sumber section tidak ada: $src"
X    [ -f "$conf" ] || err "bird.conf tidak ada: $conf"
X    grep -qF -- "$sm" "$conf" || err "marker $sm tidak ditemukan di $conf"
X    grep -qF -- "$em" "$conf" || err "marker $em tidak ditemukan di $conf"
X    awk -v sm="$sm" -v em="$em" -v src="$src" '
X        $0 == sm { print; while ((getline line < src) > 0) print line; skip = 1; next }
X        $0 == em { skip = 0; print; next }
X        skip { next }
X        { print }
X    ' "$conf"
X}
X
Xdo_check() {
X    # $1=section: render + validasi varian + parse saja, tanpa tulis
X    local section=$1 tmp bird
X    tmp=$(mktemp /tmp/titian-bird-check.XXXXXX) || err "gagal mktemp"
X    render "$section" > "$tmp" || { rm -f "$tmp"; exit 33; }
X    validate_config "$tmp" || { rm -f "$tmp"; exit 33; }
X    bird=$(bird_bin)
X    if "$bird" -p -c "$tmp" 2>&1; then
X        echo "parse OK: section $section"
X        rm -f "$tmp"
X        return 0
X    else
X        echo "parse GAGAL: section $section (tidak ada perubahan diterapkan)" >&2
X        rm -f "$tmp"
X        exit 33
X    fi
X}
X
Xdo_generate() {
X    # $1=section: render -> validasi varian -> backup -> parse -> terap -> birdc configure
X    local section=$1 tmp bird birdc conf bakdir ts
X    tmp=$(mktemp /tmp/titian-bird-gen.XXXXXX) || err "gagal mktemp"
X    render "$section" > "$tmp" || { rm -f "$tmp"; exit 33; }
X    validate_config "$tmp" || { rm -f "$tmp"; exit 33; }
X    bird=$(bird_bin)
X    if ! out=$("$bird" -p -c "$tmp" 2>&1); then
X        echo "$out" >&2
X        echo "parse GAGAL: section $section (tidak ada perubahan diterapkan)" >&2
X        rm -f "$tmp"
X        exit 33
X    fi
X    conf=$(conf_path)
X    bakdir="$ROOT/etc/bird-backup"
X    mkdir -p "$bakdir" || err "gagal mkdir $bakdir"
X    ts=$(date +%Y%m%d-%H%M%S)
X    cp -f "$conf" "$bakdir/bird.conf.$ts" || { rm -f "$tmp"; err "gagal backup $conf"; }
X    cp -f "$conf" "$bakdir/bird.conf.bak"
X    cat "$tmp" > "$conf" || { rm -f "$tmp"; err "gagal tulis $conf (backup: $bakdir/bird.conf.$ts)"; }
X    rm -f "$tmp"
X    echo "backup: $bakdir/bird.conf.$ts"
X    echo "parse OK: section $section"
X    birdc=$(birdc_bin)
X    echo "--- birdc configure ---"
X    out=$("$birdc" configure 2>&1); rc=$?
X    echo "$out" | grep -v '^BIRD'
X    if [ "$rc" -ne 0 ]; then
X        echo "PERINGATAN: birdc configure gagal (config sudah tertulis; backup: $bakdir/bird.conf.$ts)" >&2
X        exit 33
X    fi
X}
X
X# ---------------- perintah varian-spesifik ----------------
Xdo_reload_filters() {
X    # §2b: reload filter saja — bird2 `birdc reload`, bird3 `birdc reload filters`
X    local variant birdc out rc
X    variant=$(bird_variant)
X    [ "$variant" = "none" ] && err "no BIRD installed in this image (build with BIRD_VERSION=2 or 3)"
X    birdc=$(birdc_bin)
X    if [ "$variant" = "3" ]; then
X        out=$("$birdc" reload filters 2>&1); rc=$?
X    else
X        out=$("$birdc" reload 2>&1); rc=$?
X    fi
X    echo "$out" | grep -v '^BIRD'
X    [ "$rc" -ne 0 ] && exit 33
X    return 0
X}
X
Xdo_set_threads() {
X    # §2c: `threads` hanya bird3. Generator tidak pernah menulisnya
X    # kecuali user mengaturnya eksplisit di sini.
X    local n=$1 variant bver conf
X    case "$n" in ''|*[!0-9]*) err "threads harus bilangan 1-32: $n" ;; esac
X    [ "$n" -ge 1 ] 2>/dev/null && [ "$n" -le 32 ] 2>/dev/null || err "threads harus bilangan 1-32: $n"
X    variant=$(bird_variant); bver=$(bird_version)
X    [ "$variant" = "none" ] && err "no BIRD installed in this image (build with BIRD_VERSION=2 or 3)"
X    [ "$variant" = "3" ] || err "'threads' is a BIRD 3 option; this image runs BIRD $bver"
X    conf=$(conf_path)
X    [ -f "$conf" ] || err "bird.conf tidak ada: $conf"
X    _tmp=$(mktemp /tmp/titian-bird-threads.XXXXXX) || err "gagal mktemp"
X    if grep -q '^threads [0-9][0-9]*;' "$conf"; then
X        sed "s/^threads [0-9][0-9]*;/threads $n;/" "$conf" > "$_tmp"
X    else
X        # sisipkan sesudah baris pertama (opsi global, paling atas)
X        awk -v n="$n" 'NR==1 {print; print "threads " n ";"; next} {print}' "$conf" > "$_tmp"
X    fi
X    validate_config "$_tmp" || { rm -f "$_tmp"; exit 33; }
X    if ! out=$("$(bird_bin)" -p -c "$_tmp" 2>&1); then
X        echo "$out" >&2; rm -f "$_tmp"
X        err "parse GAGAL: threads $n (bird.conf tidak diubah)"
X    fi
X    cp -f "$conf" "$ROOT/etc/bird-backup/bird.conf.threads-bak" 2>/dev/null || true
X    cat "$_tmp" > "$conf" || { rm -f "$_tmp"; err "gagal tulis $conf"; }
X    rm -f "$_tmp"
X    echo "threads $n ditulis ke $conf"
X    out=$("$(birdc_bin)" configure 2>&1); rc=$?
X    echo "$out" | grep -v '^BIRD'
X    [ "$rc" -ne 0 ] && err "birdc configure gagal sesudah threads $n"
X}
X
Xdo_bird_enable() {
X    local variant
X    variant=$(bird_variant)
X    [ "$variant" = "none" ] && err "no BIRD installed in this image (build with BIRD_VERSION=2 or 3)"
X    check_exclusion bird
X    set_intent bird yes
X    echo "router bird enable (pending commit — service bird naik saat commit)"
X}
X
Xdo_bird_disable() {
X    set_intent bird no
X    echo "router bird disable (pending commit — service bird berhenti saat commit)"
X}
X
X# ---------------- show routing / show version (§2e) ----------------
Xdo_show_routing() {
X    local variant bver bpid ben brn fver fen frn
X    variant=$(bird_variant); bver=$(bird_version)
X    bpid=$(bird_pid); ben=no; brn="not running"
X    bird_enabled && ben="enabled"
X    bird_running && brn="running, pid $bpid"
X    if [ "$variant" = "none" ]; then
X        echo "Routing daemon: BIRD not installed (build with BIRD_VERSION=2 or 3)"
X    else
X        echo "Routing daemon: BIRD $bver (bird${variant}, $ben, $brn)"
X    fi
X    fver=$(frr_version); fen=no; frn="not running"
X    frr_enabled && fen="enabled"
X    frr_running && frn="running, pid $(zebra_pid)"
X    if [ "$fver" = "unknown" ] && ! frr_enabled && ! frr_running; then
X        echo "FRR: disabled, not running"
X    else
X        echo "FRR: $fver ($fen, $frn)"
X    fi
X}
X
Xdo_show_version() {
X    local variant bver bsdrp build fver frn
X    variant=$(bird_variant); bver=$(bird_version)
X    bsdrp="BSDRP"; build=""
X    if [ -f /etc/version.build ]; then
X        _v=$(grep -E '^(version|bsdrp_version)=' /etc/version.build 2>/dev/null | head -1 | cut -d= -f2-)
X        _b=$(grep -E '^(build|version\.build|n)=' /etc/version.build 2>/dev/null | head -1 | cut -d= -f2-)
X        [ -z "$_b" ] && _b=$(sed -n 's/^.*\(n[0-9]\{6,\}\).*$/\1/p' /etc/version.build 2>/dev/null | head -1)
X        [ -n "$_v" ] && bsdrp="BSDRP $_v"
X        [ -n "$_b" ] && build=" ($_b)"
X    fi
X    fver=$(frr_version); frn="not running"
X    frr_running && frn="running, pid $(zebra_pid)"
X    if [ "$variant" = "none" ]; then
X        echo "$bsdrp$build, bird_version=none (BIRD not installed), FRR $fver ($frn)"
X    else
X        echo "$bsdrp$build, bird_version=$variant (BIRD $bver), FRR $fver ($frn)"
X    fi
X}
X
Xcase "${1:-}" in
X    conf-path) conf_path ;;
X    detect) detect_variant ;;
X    check)     do_check "${2:-}" ;;
X    validate-config) validate_config "${2:-}" ;;
X    generate)  do_generate "${2:-}" ;;
X    reload-filters) do_reload_filters ;;
X    set-threads) do_set_threads "${2:-}" ;;
X    bird-enable) do_bird_enable ;;
X    bird-disable) do_bird_disable ;;
X    check-exclusion) check_exclusion "${2:-}" ;;
X    show-routing) do_show_routing ;;
X    show-version) do_show_version ;;
X    *) echo "Usage: $0 {conf-path|detect|check|generate|reload-filters|set-threads N|bird-enable|bird-disable|check-exclusion bird|frr|commit|show-routing|show-version} [section]" >&2; exit 2 ;;
Xesac
cc2f168c410baf438ffbc38f333b1c99
echo x - net/titian/files/sbin/titian-boot.sh
sed 's/^X//' >net/titian/files/sbin/titian-boot.sh << '4938d9f81eb2c0d8fa38d4bd3f77944f'
X#!/bin/sh
X# TITIAN Fase 1 — boot service: jalankan konfd (bila belum jalan)
X# lalu replay startup-config gaya rtcli init-rtcli.
X# Dipanggil systemd unit (Debian) / rc script (FreeBSD).
X# POSIX sh.
XROOT=${TITIAN_ROOT:-/opt/titian}
XBIN=$ROOT/bin
Xif [ ! -x "$BIN/konfd" ] && [ -x /usr/local/bin/konfd ]; then
X    BIN=/usr/local/bin
Xfi
Xexport LD_LIBRARY_PATH=$ROOT/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}
Xexport PATH=/sbin:/usr/sbin:/bin:/usr/bin:/usr/local/sbin:/usr/local/bin:$BIN
XPIDFILE=/var/run/titian-konfd.pid
XSOCKFILE=/tmp/konfd.socket
XLOG=/var/log/titian-konfd.log
X
X# bersihkan pid/socket basi (boot tidak bersih sebelumnya)
Xif [ -f "$PIDFILE" ]; then
X    oldpid=$(cat "$PIDFILE" 2>/dev/null)
X    if [ -n "$oldpid" ] && kill -0 "$oldpid" 2>/dev/null; then
X        echo "konfd sudah jalan (pid $oldpid)"
X    else
X        rm -f "$PIDFILE" "$SOCKFILE"
X    fi
Xfi
Xif [ ! -f "$PIDFILE" ]; then
X    [ -S "$SOCKFILE" ] && rm -f "$SOCKFILE"
X    # konfd klish 2.x: daemon socket default /tmp/konfd.socket
X    "$BIN/konfd" >>"$LOG" 2>&1 &
X    # tunggu socket maksimal ~10 detik
X    i=0
X    while [ ! -S "$SOCKFILE" ] && [ "$i" -lt 20 ]; do
X        sleep 0.5
X        i=$((i + 1))
X    done
X    # konfd menulis pidfile-nya sendiri (/var/run/konfd.pid klish);
X    # salin ke pidfile titian bila ada
X    if [ -f /var/run/konfd.pid ]; then
X        cp -f /var/run/konfd.pid "$PIDFILE" 2>/dev/null || true
X    fi
X    if [ ! -S "$SOCKFILE" ]; then
X        echo "PERINGATAN: socket konfd tidak muncul; lihat $LOG" >&2
X    fi
Xfi
X
X# FreeBSD: pastikan modul vxlan termuat SEBELUM replay, agar replay
X# baris `interface vxlan` tidak gagal karena if_vxlan belum ada.
X# (loader.conf if_vxlan_load="YES" ditulis saat create; kldload di sini
X# menutup celah bila loader.conf belum sempat ditulis / modul tidak
X# ter-load.) Best-effort: replay tetap jalan bila modul gagal.
Xif [ "$(uname -s)" = "FreeBSD" ]; then
X    kldload if_vxlan 2>/dev/null || true
Xfi
X
X# replay startup-config (bila ada) — idempotent (replace semantics)
Xif [ -f "$ROOT/etc/startup-config" ]; then
X    "$BIN/clish" -x "$ROOT/etc/clish-en" -w configure-view "$ROOT/etc/startup-config" 2>&1 | tee /var/log/titian-replay.log
Xfi
X
X# jaring pengaman tuning: terapkan ulang nilai .tuning yang tercatat
X# (best-effort, idempotent, tidak pernah menggagalkan boot). Ini
X# menutup celah bila replay baris view `options` (nested) gagal, dan
X# menerapkan tuning yang tercatat di cermin meski belum sempat `save`.
Xif [ -x "$ROOT/sbin/titian-tune.sh" ]; then
X    "$ROOT/sbin/titian-tune.sh" apply-all 2>/dev/null || true
Xfi
X
X# jaring pengaman bond: pasang ulang slave bond yang tercatat.
X# Replay menempelkan slave, tapi sync tuning sesudahnya memicu
X# reconfigure networkd yang melepas slave (bond titian bukan NetDev
X# networkd, jadi networkd tidak mempertahankan master-nya). Langkah
X# ini jalan PALING AKHIR, sesudah semua reload, sehingga tidak ada
X# lagi reconfigure yang bisa melepasnya.
Xif [ -x "$ROOT/sbin/titian-persist.sh" ]; then
X    "$ROOT/sbin/titian-persist.sh" apply-bond 2>/dev/null || true
Xfi
X
X# jaring pengaman vxlan: bangun ulang vxlan yang tercatat di netstate
X# tapi interfacenya hilang (replay gagal untuk seksi itu). No-op bila
X# replay berhasil. Jalan sesudah apply-bond; vxlan bukan slave bond,
X# jadi urutan terhadap reload networkd aman.
Xif [ -x "$ROOT/sbin/titian-vxlan.sh" ]; then
X    "$ROOT/sbin/titian-vxlan.sh" apply-all 2>/dev/null || true
Xfi
X
X# jaring pengaman firewall: rebuild backend penuh dari netstate
X# (flush + generate). Ini JUGA yang membuat rollback checkpoint benar
X# untuk firewall: restore netstate titik + restart -> apply ini
X# membuang rule live yang tidak ada di titik. No-op (tabel/anchor
X# dibersihkan) bila netstate kosong. Jalan PALING AKHIR.
Xif [ -x "$ROOT/sbin/titian-fw.sh" ]; then
X    "$ROOT/sbin/titian-fw.sh" apply-all 2>/dev/null || true
Xfi
X
X# BSDRP port: terapkan semua niat pending (routing/firewall/
X# traffic-shape/pppoe/wireguard/monitoring) sesudah replay — replay
X# klish menandai dirty lagi, jadi commit apply-all di sini yang
X# menaikkan service sesuai niat startup-config. No-op bila tidak ada
X# niat pending. Mutual exclusion bird/FRR tetap diperiksa.
Xif [ -x "$ROOT/sbin/titian-commit.sh" ]; then
X    "$ROOT/sbin/titian-commit.sh" apply-all 2>/dev/null || true
Xfi
Xexit 0
