sed 's/^X//' >net/titian/files/tree/conf-if-opt-fbsd.xml << 'a63644ae488d1ec757a36b7d8814d010'
X<?xml version="1.0" encoding="UTF-8"?>
X<CLISH_MODULE xmlns="http://clish.sourceforge.net/XMLSchema"
X          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
X xsi:schemaLocation="http://clish.sourceforge.net/XMLSchema
X                     http://clish.sourceforge.net/XMLSchema/clish.xsd">
X    <!--=======================================================-->
X    <!-- View options FreeBSD (padanan conf-if-eth-opt.xml Linux).
X         Hanya fitur yang punya padanan ifconfig: tso/lro/rx/tx.
X         gro/gso/sg/coalesce/qlen TIDAK punya padanan generik di
X         FreeBSD sehingga tidak dibuat perintahnya (ditolak bersih
X         bila dicoba lewat helper). Semua perintah lewat
X         titian-tune.sh: live + tercatat di netstate/<iface>.tuning
X         + cermin rc.conf (blok #-TITIAN-#). Bentuk `no <fitur>`
X         mengembalikan default konvensional dan membersihkan cermin.
X         Hanya diinstal di FreeBSD. -->
X
X<VIEW name="configure-if-options-fbsd"
X    prompt="${SYSTEM_NAME}(config-if-${iface}-options)# "
X    depth="2">
X
X<!-- Inheritance -->
X    <NAMESPACE ref="configure-if-view"
X        help="false"
X        completion="true"/>
X    <NAMESPACE ref="configure-view"
X        help="false"
X        completion="true"/>
X
X    <COMMAND name="exit"
X        help="Exit from interface configuration mode"
X        lock="false">
X        <ACTION builtin="clish_nested_up"/>
X    </COMMAND>
X
X    <COMMAND name="tso"
X        help="TSO (TCP segmentation offload, ifconfig tso/-tso): NIC memotong segmen TCP besar jadi paket MTU. Efek: hemat CPU untuk trafik yang berasal dari box ini; tidak memengaruhi paket yang di-forward. Tradeoff: off hanya bila dicurigai bug driver/NIC. Default: on (bila didukung driver).">
X        <PARAM name="tso_method"
X            help="on = aktif (default) | off = nonaktif"
X            ptype="SUBCOMMAND"
X            mode="switch">
X            <PARAM name="on"
X                help="Default on"
X                ptype="SUBCOMMAND"
X                mode="subcommand"/>
X            <PARAM name="off"
X                help="off"
X                ptype="SUBCOMMAND"
X                mode="subcommand"/>
X        </PARAM>
X        <CONFIG pattern="^tso"/>
X        <ACTION>
X            ${RT_SBIN}/titian-tune.sh offload "${iface}" tso "${tso_method}"
X        </ACTION>
X    </COMMAND>
X
X    <COMMAND name="no tso"
X        help="Hapus setelan TSO Titian (kembali ke nilai sebelum di-set Titian (umumnya on); cermin bersih)">
X        <CONFIG operation="unset" pattern="^tso"/>
X        <ACTION>
X            ${RT_SBIN}/titian-tune.sh offload-del "${iface}" tso
X        </ACTION>
X    </COMMAND>
X
X    <COMMAND name="lro"
X        help="LRO (large receive offload, ifconfig lro/-lro): HARDWARE menggabung paket receive. Efek: hemat CPU receive. Tradeoff: HARUS off di router/bridge — agregasi hardware bisa merusak semantik forwarding. Default: off.">
X        <PARAM name="lro_method"
X            help="on = aktif | off = nonaktif (default untuk router)"
X            ptype="SUBCOMMAND"
X            mode="switch">
X            <PARAM name="on"
X                help="on"
X                ptype="SUBCOMMAND"
X                mode="subcommand"/>
X            <PARAM name="off"
X                help="Default off"
X                ptype="SUBCOMMAND"
X                mode="subcommand"/>
X        </PARAM>
X        <CONFIG pattern="^lro"/>
X        <ACTION>
X            ${RT_SBIN}/titian-tune.sh offload "${iface}" lro "${lro_method}"
X        </ACTION>
X    </COMMAND>
X
X    <COMMAND name="no lro"
X        help="Hapus setelan LRO Titian (kembali ke nilai sebelum di-set Titian (umumnya off); cermin bersih)">
X        <CONFIG operation="unset" pattern="^lro"/>
X        <ACTION>
X            ${RT_SBIN}/titian-tune.sh offload-del "${iface}" lro
X        </ACTION>
X    </COMMAND>
X
X    <COMMAND name="rx"
X        help="RX checksumming (ifconfig rxcsum/-rxcsum): NIC menghitung checksum paket masuk. Efek: hemat CPU receive. Tradeoff: hampir tidak ada; off hanya bila dicurigai bug checksum driver. Default: on (bila didukung driver).">
X        <PARAM name="rx_method"
X            help="on = aktif (default) | off = nonaktif"
X            ptype="SUBCOMMAND"
X            mode="switch">
X            <PARAM name="on"
X                help="Default on"
X                ptype="SUBCOMMAND"
X                mode="subcommand"/>
X            <PARAM name="off"
X                help="off"
X                ptype="SUBCOMMAND"
X                mode="subcommand"/>
X        </PARAM>
X        <!-- pola pakai spasi akhir agar tidak menyentuh baris lain -->
X        <CONFIG pattern="^rx "/>
X        <ACTION>
X            ${RT_SBIN}/titian-tune.sh offload "${iface}" rx "${rx_method}"
X        </ACTION>
X    </COMMAND>
X
X    <COMMAND name="no rx"
X        help="Hapus setelan RX checksumming Titian (kembali ke nilai sebelum di-set Titian (umumnya on); cermin bersih)">
X        <CONFIG operation="unset" pattern="^rx "/>
X        <ACTION>
X            ${RT_SBIN}/titian-tune.sh offload-del "${iface}" rx
X        </ACTION>
X    </COMMAND>
X
X    <COMMAND name="tx"
X        help="TX checksumming (ifconfig txcsum/-txcsum): NIC menghitung checksum paket keluar. Efek: hemat CPU transmit. Tradeoff: hampir tidak ada; off hanya bila dicurigai bug checksum driver. Default: on (bila didukung driver).">
X        <PARAM name="tx_method"
X            help="on = aktif (default) | off = nonaktif"
X            ptype="SUBCOMMAND"
X            mode="switch">
X            <PARAM name="on"
X                help="Default on"
X                ptype="SUBCOMMAND"
X                mode="subcommand"/>
X            <PARAM name="off"
X                help="off"
X                ptype="SUBCOMMAND"
X                mode="subcommand"/>
X        </PARAM>
X        <CONFIG pattern="^tx"/>
X        <ACTION>
X            ${RT_SBIN}/titian-tune.sh offload "${iface}" tx "${tx_method}"
X        </ACTION>
X    </COMMAND>
X
X    <COMMAND name="no tx"
X        help="Hapus setelan TX checksumming Titian (kembali ke nilai sebelum di-set Titian (umumnya on); cermin bersih)">
X        <CONFIG operation="unset" pattern="^tx"/>
X        <ACTION>
X            ${RT_SBIN}/titian-tune.sh offload-del "${iface}" tx
X        </ACTION>
X    </COMMAND>
X
X</VIEW>
X
X</CLISH_MODULE>
