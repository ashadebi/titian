echo x - net/titian/files/sbin/titian-traffic-shape.sh
sed 's/^X//' >net/titian/files/sbin/titian-traffic-shape.sh << 'a81bd9daa4a7ec8c67ba23b0a743ac6d'
X#!/bin/sh
X# titian-traffic-shape.sh — klish helper: edit + apply /usr/local/etc/traffic-shape.conf
X# BSDRP_klish, prepared 2026-11-08 (completed 2026-11-08 ~18:00 WIB).
X# POSIX sh, no bashisms. Syntax verified against FreeBSD 16 ipfw.8
X# (obj/FreeBSD/sbin/ipfw/ipfw.8) + sbin/ipfw/dummynet.c.
X#
X# Config format (one object per line; written by klish, read by
X# traffic-shape-apply):
X#   enable yes|no
X#   pipe <name> bw <rate> queue <n> delay <ms> plr <x> burst <n>
X#        [aqm <clause...>]
X#   sched <name> type <t> [bw <rate>] [quantum <n>] [limit <n>] [flows <n>]
X#   queue <name> <pipe|sched> <parent> mask <spec> <val> weight <n>
X#         queue <n> [aqm <clause...>]
X#   rule <name> <in|out> on <if> {pipe|queue} <ref> [src <a>] [dst <a>]
X#        [proto <p>] [dport <n>]
X#
X# Mask specifiers (ipfw.8): dst-ip, src-ip, dst-ip6, src-ip6, dst-port,
X# src-port, proto, flow-id, all. Values are /N bit counts (preferred) or
X# numbers (0x.../decimal). Full masks: dst-ip /32, dst-ip6 /128,
X# dst-port /16, src-port /16, proto /8, flow-id /32. `all` takes no value
X# (stored as `-`).
X# AQM clause (verbatim ipfw tokens, must come last on the line):
X#   aqm droptail | aqm red <wq> <min_th> <max_th> <max_p>
X#   | aqm gred <wq> <min_th> <max_th> <max_p>
X#   | aqm codel [target <ms>] [interval <ms>]
X#   | aqm pie [target <ms>] [tupdate <ms>]
X#
X# Every mutation touches /var/run/traffic-shape.dirty so the klish commit
X# hook knows to run `service traffic-shape restart` (or stop).
Xset -u
X
XCONF="${TS_CONF:-/usr/local/etc/traffic-shape.conf}"
XDIRTY=/var/run/traffic-shape.dirty
XPROG="titian-traffic-shape"
X
Xdie() { echo "$PROG: $*" >&2; exit 1; }
X
Xtouch_conf() {
X    if [ ! -f "$CONF" ]; then
X        printf '# traffic-shape.conf - generated by klish, do not edit by hand\nenable no\n' > "$CONF" \
X            || die "cannot create $CONF"
X    fi
X}
X
Xmark_dirty() { touch "$DIRTY" 2>/dev/null || true; }
X
X# upsert <grep-regex-anchored> <new-line>
Xupsert() {
X    _re="$1"; _line="$2"
X    touch_conf
X    _tmp="$CONF.tmp.$$"
X    grep -v "$_re" "$CONF" > "$_tmp" 2>/dev/null || true
X    printf '%s\n' "$_line" >> "$_tmp"
X    mv "$_tmp" "$CONF" || die "cannot write $CONF"
X    mark_dirty
X}
X
X# delete lines matching regex; fail if none matched
Xdellines() {
X    _re="$1"; _what="$2"
X    touch_conf
X    if ! grep -q "$_re" "$CONF" 2>/dev/null; then
X        die "$_what not found"
X    fi
X    _tmp="$CONF.tmp.$$"
X    grep -v "$_re" "$CONF" > "$_tmp" || true
X    mv "$_tmp" "$CONF" || die "cannot write $CONF"
X    mark_dirty
X}
X
X# --- validation helpers -------------------------------------------------
Xvalid_name() {
X    case "$1" in
X        *[!A-Za-z0-9_-]*|"") die "bad name: $1 (use [A-Za-z0-9_-]+)" ;;
X    esac
X}
X
Xpipe_exists()  { grep -q "^pipe $1 " "$CONF" 2>/dev/null; }
Xsched_exists() { grep -q "^sched $1 " "$CONF" 2>/dev/null; }
Xqueue_exists() { grep -q "^queue $1 " "$CONF" 2>/dev/null; }
Xrule_exists()  { grep -q "^rule $1 " "$CONF" 2>/dev/null; }
X
Xiface_exists() {
X    ifconfig "$1" >/dev/null 2>&1 || die "interface $1 not found (see 'show interfaces')"
X}
X
X# Full mask value (bit-count form) for a mask specifier.
Xdefault_mask_val() {
X    case "$1" in
X        dst-ip|src-ip) echo "/32" ;;
X        dst-ip6|src-ip6) echo "/128" ;;
X        dst-port|src-port) echo "/16" ;;
X        proto) echo "/8" ;;
X        flow-id) echo "/32" ;;
X        all) echo "-" ;;
X        *) die "unknown mask specifier: $1" ;;
X    esac
X}
X
X# Validate a mask value for a specifier. Accepts /N (bit count) or a
X# number (0x.../decimal). Dies on out-of-range bit counts.
Xvalid_mask_val() {
X    _spec="$1"; _val="$2"
X    case "$_val" in
X        /*)
X            _n="${_val#/}"
X            case "$_n" in *[!0-9]*|"") die "bad mask value: $_val" ;; esac
X            case "$_spec" in
X                dst-ip|src-ip|flow-id) _max=32 ;;
X                dst-ip6|src-ip6) _max=128 ;;
X                dst-port|src-port) _max=16 ;;
X                proto) _max=8 ;;
X                *) die "unknown mask specifier: $_spec" ;;
X            esac
X            [ "$_n" -le "$_max" ] || die "mask $_spec: /$_n exceeds /$_max"
X            ;;
X        0x*|[0-9]*)
X            case "$_val" in
X                0x*[!0-9a-fA-F]*|*[!0-9]*) die "bad mask value: $_val" ;;
X            esac
X            ;;
X        *) die "bad mask value: $_val (use /N or a number)" ;;
X    esac
X}
X
X# Validate an AQM clause (single string, e.g. "aqm codel target 5").
Xvalid_aqm_clause() {
X    set -- $1
X    [ "$1" = "aqm" ] || die "bad aqm clause: $1"
X    case "${2:-}" in
X        droptail) [ "$#" -eq 2 ] || die "aqm droptail takes no arguments" ;;
X        red|gred) [ "$#" -eq 6 ] || die "aqm $2 needs: <wq> <min_th> <max_th> <max_p>" ;;
X        codel|pie) ;;  # optional key/value params, checked by ipfw at apply
X        *) die "unknown aqm: ${2:-} (droptail|red|gred|codel|pie)" ;;
X    esac
X}
X
X# --- read-only ops ------------------------------------------------------
Xcmd_check() {
X    touch_conf
X    exit 0
X}
X
Xcmd_check_pipe()  { valid_name "$1"; touch_conf; exit 0; }
Xcmd_check_sched() { valid_name "$1"; touch_conf; exit 0; }
Xcmd_check_queue() { valid_name "$1"; touch_conf; exit 0; }
Xcmd_check_rule()  { valid_name "$1"; touch_conf; exit 0; }
X
Xcmd_show() {
X    touch_conf
X    _en=$(sed -n 's/^enable //p' "$CONF" | head -1)
X    echo "traffic-shape: ${_en:-no}"
X    echo "pipes:"
X    grep '^pipe ' "$CONF" 2>/dev/null | sed 's/^/  /' || true
X    echo "schedulers:"
X    grep '^sched ' "$CONF" 2>/dev/null | sed 's/^/  /' || true
X    echo "queues:"
X    grep '^queue ' "$CONF" 2>/dev/null | sed 's/^/  /' || true
X    echo "rules:"
X    grep '^rule ' "$CONF" 2>/dev/null | sed 's/^/  /' || true
X    exit 0
X}
X
Xcmd_show_pipe()  { touch_conf; grep '^pipe ' "$CONF" 2>/dev/null || echo "(no pipes)"; exit 0; }
Xcmd_show_sched() { touch_conf; grep '^sched ' "$CONF" 2>/dev/null || echo "(no schedulers)"; exit 0; }
Xcmd_show_queue() { touch_conf; grep '^queue ' "$CONF" 2>/dev/null || echo "(no queues)"; exit 0; }
Xcmd_show_rule()  { touch_conf; grep '^rule ' "$CONF" 2>/dev/null || echo "(no rules)"; exit 0; }
X
Xcmd_stats() {
X    if ! kldstat -q -m dummynet 2>/dev/null; then
X        echo "dummynet not loaded (traffic-shape never applied?)" >&2
X        exit 0
X    fi
X    echo "== pipes =="
X    ipfw pipe show 2>/dev/null || echo "(no pipes in kernel)"
X    echo "== schedulers =="
X    ipfw sched show 2>/dev/null || echo "(no schedulers in kernel)"
X    echo "== queues =="
X    ipfw queue show 2>/dev/null || echo "(no queues in kernel)"
X    exit 0
X}
X
X# --- mutations ----------------------------------------------------------
Xcmd_set_enable() {
X    case "$1" in
X        yes|no) upsert '^enable ' "enable $1" ;;
X        *) die "enable takes yes|no" ;;
X    esac
X    case "$1" in
X        yes) echo "traffic-shape enabled" ;;
X        no)  echo "traffic-shape disabled" ;;
X    esac
X    exit 0
X}
X
X# set-pipe-field <name> <field> [value...]
X# Fields: bw, queue, delay, plr, burst, aqm-clause (one arg: full clause).
Xcmd_set_pipe_field() {
X    _name="$1"; _field="$2"; shift 2
X    _value="$1"
X    valid_name "$_name"
X    touch_conf
X    _line=$(grep "^pipe $_name " "$CONF" 2>/dev/null | head -1)
X    if [ -z "$_line" ]; then
X        _line="pipe $_name bw unset queue 50 delay 0 plr 0 burst 0"
X    fi
X    set -- $_line
X    [ "$#" -ge 12 ] || die "corrupt pipe line: $_line"
X    # $1=pipe $2=name $3=bw $4=rate $5=queue $6=n $7=delay $8=ms $9=plr
X    # ${10}=x $11=burst $12=n ; $13+ = aqm clause
X    _bw="$4"; _q="$6"; _d="$8"; _plr="${10}"; _burst="${12}"
X    shift 12
X    _aqm="$*"
X    case "$_field" in
X        bw)    _bw="$_value" ;;
X        queue) _q="$_value" ;;
X        delay) _d="$_value" ;;
X        plr)   _plr="$_value" ;;
X        burst) _burst="$_value" ;;
X        aqm-clause)
X            valid_aqm_clause "$_value"
X            _aqm="$_value" ;;
X        *) die "unknown pipe field: $_field" ;;
X    esac
X    _line="pipe $_name bw $_bw queue $_q delay $_d plr $_plr burst $_burst"
X    [ -n "$_aqm" ] && _line="$_line $_aqm"
X    upsert "^pipe $_name " "$_line"
X    echo "pipe $_name: $_field = $_value"
X    exit 0
X}
X
X# set-sched-field <name> <field> <value>
X# Fields: type, bw, quantum, limit, flows.
X# Line format: sched <name> type <t> [bw <rate>] [quantum <n>]
X#              [limit <n>] [flows <n>]  (key/value pairs after the name)
Xcmd_set_sched_field() {
X    _name="$1"; _field="$2"; _value="${3:-}"
X    valid_name "$_name"
X    touch_conf
X    _line=$(grep "^sched $_name " "$CONF" 2>/dev/null | head -1)
X    _type=""; _bw=""; _quantum=""; _limit=""; _flows=""
X    if [ -n "$_line" ]; then
X        set -- $_line
X        shift 2  # drop "sched NAME"
X        while [ $# -gt 0 ]; do
X            case "$1" in
X                type)    _type="${2:-}"; shift 2 ;;
X                bw)      _bw="${2:-}"; shift 2 ;;
X                quantum) _quantum="${2:-}"; shift 2 ;;
X                limit)   _limit="${2:-}"; shift 2 ;;
X                flows)   _flows="${2:-}"; shift 2 ;;
X                *) die "cannot parse sched line: $_line" ;;
X            esac
X        done
X    fi
X    case "$_field" in
X        type)
X            case "$_value" in
X                fifo|wf2q+|rr|qfq|fq_codel|fq_pie) _type="$_value" ;;
X                *) die "sched type must be fifo|wf2q+|rr|qfq|fq_codel|fq_pie" ;;
X            esac
X            ;;
X        bw) _bw="$_value" ;;
X        quantum|limit|flows)
X            case "$_type" in
X                fq_codel|fq_pie) ;;
X                *) die "$_field needs sched type fq_codel|fq_pie (current: ${_type:-unset})" ;;
X            esac
X            case "$_value" in *[!0-9]*|"") die "$_field must be a number" ;; esac
X            case "$_field" in
X                quantum) _quantum="$_value" ;;
X                limit)   _limit="$_value" ;;
X                flows)   _flows="$_value" ;;
X            esac
X            ;;
X        *) die "unknown sched field: $_field" ;;
X    esac
X    _line="sched $_name"
X    [ -n "$_type" ] && _line="$_line type $_type"
X    [ -n "$_bw" ] && _line="$_line bw $_bw"
X    [ -n "$_quantum" ] && _line="$_line quantum $_quantum"
X    [ -n "$_limit" ] && _line="$_line limit $_limit"
X    [ -n "$_flows" ] && _line="$_line flows $_flows"
X    upsert "^sched $_name " "$_line"
X    echo "sched $_name: $_field = $_value"
X    exit 0
X}
X
X# set-queue-field <name> <field> [value...]
X# Fields: pipe <pname> | sched <sname> | mask <spec> [val] |
X#         weight <n> | queue <n> | aqm-clause <clause>.
Xcmd_set_queue_field() {
X    _name="$1"; _field="$2"; shift 2
X    _a1="${1:-}"; _a2="${2:-}"
X    valid_name "$_name"
X    touch_conf
X    _line=$(grep "^queue $_name " "$CONF" 2>/dev/null | head -1)
X    if [ -z "$_line" ]; then
X        _line="queue $_name pipe unset mask all - weight 1 queue 50"
X    fi
X    set -- $_line
X    [ "$#" -ge 11 ] || die "corrupt queue line: $_line"
X    # $1=queue $2=name $3=kind $4=parent $5=mask $6=spec $7=val $8=weight
X    # $9=w $10=queue $11=n ; $12+ = aqm clause
X    _kind="$3"; _parent="$4"; _spec="$6"; _val="$7"; _w="$9"; _q="${11}"
X    shift 11
X    _aqm="$*"
X    case "$_field" in
X        pipe)
X            valid_name "$_a1"
X            pipe_exists "$_a1" || die "pipe $_a1 not found (create it first)"
X            _kind="pipe"; _parent="$_a1" ;;
X        sched)
X            valid_name "$_a1"
X            sched_exists "$_a1" || die "sched $_a1 not found (create it first)"
X            _kind="sched"; _parent="$_a1" ;;
X        mask)
X            case "$_a1" in
X                dst-ip|src-ip|dst-ip6|src-ip6|dst-port|src-port|proto|flow-id|all)
X                    _spec="$_a1" ;;
X                *) die "mask must be dst-ip|src-ip|dst-ip6|src-ip6|dst-port|src-port|proto|flow-id|all" ;;
X            esac
X            if [ "$_spec" = "all" ]; then
X                _val="-"
X            else
X                _val="$_a2"
X                [ -n "$_val" ] || _val=$(default_mask_val "$_spec")
X                valid_mask_val "$_spec" "$_val"
X            fi
X            ;;
X        weight)
X            case "$_a1" in *[!0-9]*|"") die "weight must be 1-100" ;; esac
X            [ "$_a1" -ge 1 ] && [ "$_a1" -le 100 ] || die "weight must be 1-100"
X            _w="$_a1" ;;
X        queue)
X            case "$_a1" in *[!0-9]*|"") die "queue must be a number" ;; esac
X            _q="$_a1" ;;
X        aqm-clause)
X            valid_aqm_clause "$_a1"
X            _aqm="$_a1" ;;
X        *) die "unknown queue field: $_field" ;;
X    esac
X    _line="queue $_name $_kind $_parent mask $_spec $_val weight $_w queue $_q"
X    [ -n "$_aqm" ] && _line="$_line $_aqm"
X    upsert "^queue $_name " "$_line"
X    echo "queue $_name: $_field updated"
X    exit 0
X}
X
X# set-rule-field <name> <field> [value...]
X#   interface <if> <dir> | target pipe|queue <ref> | src|dst <addr> |
X#   proto <p> | dport <n>
Xcmd_set_rule_field() {
X    _name="$1"; _field="$2"; shift 2
X    _a1="${1:-}"; _a2="${2:-}"
X    valid_name "$_name"
X    touch_conf
X    _line=$(grep "^rule $_name " "$CONF" 2>/dev/null | head -1)
X    if [ -z "$_line" ]; then
X        # Fresh rule: interface must come first (it carries dir + if).
X        [ "$_field" = "interface" ] || die "rule $_name not found (set interface first)"
X        _line="rule $_name $_a2 on $_a1 pipe unset"
X    fi
X    # Tokenise the current line into positional fields.
X    set -- $_line
X    [ "$#" -ge 7 ] || die "corrupt rule line: $_line"
X    # $1=rule $2=name $3=dir $4=on $5=if $6=kind $7=ref $8..=optional filters
X    _dir="$3"; _if="$5"; _kind="$6"; _ref="$7"
X    shift 7
X    _src=""; _dst=""; _proto=""; _dport=""
X    while [ $# -gt 0 ]; do
X        case "$1" in
X            src)   _src="${2:-}"; shift 2 ;;
X            dst)   _dst="${2:-}"; shift 2 ;;
X            proto) _proto="${2:-}"; shift 2 ;;
X            dport) _dport="${2:-}"; shift 2 ;;
X            *) die "cannot parse rule line: $_line" ;;
X        esac
X    done
X    case "$_field" in
X        interface)
X            _if="$_a1"; _dir="$_a2"
X            iface_exists "$_if"
X            case "$_dir" in in|out) ;; *) die "direction must be in|out" ;; esac
X            ;;
X        target)
X            _kind="$_a1"; _ref="$_a2"
X            case "$_kind" in
X                pipe)  pipe_exists "$_ref" || die "pipe $_ref not found (create it first)" ;;
X                queue) queue_exists "$_ref" || die "queue $_ref not found (create it first)" ;;
X                *) die "target must be pipe|queue" ;;
X            esac
X            ;;
X        src)   _src="$_a1" ;;
X        dst)   _dst="$_a1" ;;
X        proto)
X            case "$_a1" in tcp|udp|icmp|all) _proto="$_a1" ;; *) die "proto must be tcp|udp|icmp|all" ;; esac
X            ;;
X        dport)
X            case "$_proto" in
X                tcp|udp) ;;
X                *) die "dport needs proto tcp|udp (current proto: ${_proto:-unset})" ;;
X            esac
X            case "$_a1" in
X                *[!0-9]*|"") die "dport must be 1-65535" ;;
X            esac
X            [ "$_a1" -ge 1 ] && [ "$_a1" -le 65535 ] || die "dport must be 1-65535"
X            _dport="$_a1"
X            ;;
X        *) die "unknown rule field: $_field" ;;
X    esac
X    _line="rule $_name $_dir on $_if $_kind $_ref"
X    [ -n "$_src" ] && _line="$_line src $_src"
X    [ -n "$_dst" ] && _line="$_line dst $_dst"
X    [ -n "$_proto" ] && _line="$_line proto $_proto"
X    [ -n "$_dport" ] && _line="$_line dport $_dport"
X    upsert "^rule $_name " "$_line"
X    echo "rule $_name updated"
X    exit 0
X}
X
Xcmd_del_pipe() {
X    _name="$1"; valid_name "$_name"
X    touch_conf
X    _dep=$(grep -E "^queue [^ ]+ pipe $_name( |\$)" "$CONF" 2>/dev/null | awk '{print $2}' | tr '\n' ' ')
X    _dep2=$(grep -E "^rule [^ ]+ .* pipe $_name( |\$)" "$CONF" 2>/dev/null | awk '{print $2}' | tr '\n' ' ')
X    if [ -n "$_dep$_dep2" ]; then
X        die "pipe $_name still used by: queues [${_dep:-none}] rules [${_dep2:-none}] (delete them first)"
X    fi
X    dellines "^pipe $_name " "pipe $_name"
X    echo "pipe $_name deleted"
X    exit 0
X}
X
Xcmd_del_sched() {
X    _name="$1"; valid_name "$_name"
X    touch_conf
X    _dep=$(grep -E "^queue [^ ]+ sched $_name( |\$)" "$CONF" 2>/dev/null | awk '{print $2}' | tr '\n' ' ')
X    if [ -n "$_dep" ]; then
X        die "sched $_name still used by queues: [$_dep] (delete them first)"
X    fi
X    dellines "^sched $_name " "sched $_name"
X    echo "sched $_name deleted"
X    exit 0
X}
X
Xcmd_del_queue() {
X    _name="$1"; valid_name "$_name"
X    touch_conf
X    _dep=$(grep -E "^rule [^ ]+ .* queue $_name( |\$)" "$CONF" 2>/dev/null | awk '{print $2}' | tr '\n' ' ')
X    if [ -n "$_dep" ]; then
X        die "queue $_name still used by rules: [$_dep] (delete them first)"
X    fi
X    dellines "^queue $_name " "queue $_name"
X    echo "queue $_name deleted"
X    exit 0
X}
X
Xcmd_del_rule() {
X    _name="$1"; valid_name "$_name"
X    dellines "^rule $_name " "rule $_name"
X    echo "rule $_name deleted"
X    exit 0
X}
X
X# traffic-shape-apply — apply /usr/local/etc/traffic-shape.conf to the kernel
X# BSDRP_klish, prepared 2026-11-08 (completed 2026-11-08 ~18:00 WIB).
X# POSIX sh, no bashisms. Syntax verified against FreeBSD 16 ipfw.8
X# (obj/FreeBSD/sbin/ipfw/ipfw.8) + sbin/ipfw/dummynet.c.
X#
X# Usage (merged): titian-traffic-shape.sh apply [config-file] | apply --flush
X#
X# Objects (number ranges are reserved for this subsystem):
X#   pipes  1-99    — bandwidth cap (bw, delay, burst, plr, queue, aqm)
X#   queues 100-199 — per-flow split of a pipe OR sched (mask, weight, aqm)
X#   scheds 200-299 — scheduling algorithm (type, bw, quantum/limit/flows)
X# Pipes are created with `ipfw pipe`; scheds with `ipfw sched`; queues
X# attach to either via `pipe N` or `sched N`. The dnctl(8) utility does
X# NOT exist in this FreeBSD tree, so ipfw is the only pipe/sched creator.
X# Rules divert traffic via pf anchor "traffic-shape" (dnpipe/dnqueue).
X# The anchor only takes effect if /etc/pf.conf references it:
X#     anchor "traffic-shape"
X# (integration step — see README.md; the apply step warns if missing.)
X# Idempotent: flushes only its own number ranges before re-applying.
X# Exit 0 on success (including disabled / no config). Non-zero with a
X# clear message on bad config, so a klish commit can fail loudly.
X
XANCHOR_FILE=/etc/pf-traffic-shape.conf
XANCHOR=traffic-shape
X
Xwarn() { echo "$PROG: warning: $*" >&2; }
X
Xpf_enabled() {
X    pfctl -s info 2>/dev/null | grep -q "Status: Enabled"
X}
X
Xflush_all() {
X    # Only our own ranges: pipes 1-99, queues 100-199, scheds 200-299.
X    _n=1
X    while [ "$_n" -le 99 ]; do
X        ipfw pipe "$_n" delete >/dev/null 2>&1 || true
X        _n=$((_n + 1))
X    done
X    _n=100
X    while [ "$_n" -le 199 ]; do
X        ipfw queue "$_n" delete >/dev/null 2>&1 || true
X        _n=$((_n + 1))
X    done
X    _n=200
X    while [ "$_n" -le 299 ]; do
X        ipfw sched "$_n" delete >/dev/null 2>&1 || true
X        _n=$((_n + 1))
X    done
X    if pf_enabled; then
X        pfctl -a "$ANCHOR" -F rules >/dev/null 2>&1 || true
X    fi
X    rm -f "$ANCHOR_FILE"
X}
X
X# --- name -> number maps (kept in shell vars; all passes run in this shell)
X_pipes=""    # "name:num name:num ..."
X_scheds=""   # "name:num name:num ..."
X_queues=""   # "name:num name:num ..."
X
Xlookup() {
X    # lookup <map> <name> -> prints number or empty
X    _map="$1"; _want="$2"
X    for _e in $_map; do
X        case "$_e" in
X            "$_want":*) echo "${_e#*:}"; return 0 ;;
X        esac
X    done
X    return 1
X}
X
X# emit_aqm <clause> — sets _aqm_toks to the ipfw tokens for an AQM clause
X# ("" for none/droptail). Dies on a bad clause. Runs in the main shell.
Xemit_aqm() {
X    case "$1" in
X        ""|"aqm droptail") _aqm_toks="" ;;
X        "aqm red "*|"aqm gred "*|"aqm codel"|"aqm codel "*|"aqm pie"|"aqm pie "*)
X            _aqm_toks="${1#aqm }" ;;
X        *) die "bad aqm clause: $1" ;;
X    esac
X}
X
X# --- apply (was traffic-shape-apply, standalone) --------------------
Xcmd_apply() {
X    # $1 = optional config path, or --flush
X    if [ "${1:-}" = "--flush" ]; then
X        kldstat -q -m dummynet 2>/dev/null || exit 0
X        flush_all
X        exit 0
X    fi
X    [ -n "${1:-}" ] && CONF="$1"
X    # --- load modules -------------------------------------------------------
X    kldstat -q -m dummynet 2>/dev/null || kldload dummynet \
X        || die "cannot load dummynet module"
X    kldstat -q -m ipfw 2>/dev/null || kldload ipfw \
X        || die "cannot load ipfw module"
X
X    # --- no config yet = nothing to do --------------------------------------
X    [ -f "$CONF" ] || { flush_all; exit 0; }
X
X    # --- disabled = flush everything and stop -------------------------------
X    _en=$(sed -n 's/^enable //p' "$CONF" | head -1)
X    if [ "$_en" != "yes" ]; then
X        flush_all
X        exit 0
X    fi
X
X    flush_all
X
X    # --- pass 1: pipes ------------------------------------------------------
X    _pipeno=0
X    while read -r _line; do
X        case "$_line" in
X            pipe\ *)
X                set -- $_line
X                [ "$#" -ge 12 ] || die "corrupt pipe line: $_line"
X                # $1=pipe $2=name $3=bw $4=rate $5=queue $6=n $7=delay $8=ms
X                # $9=plr ${10}=x $11=burst ${12}=n ; $13+ = aqm clause
X                _pname="$2"; _bw="$4"; _q="$6"; _d="$8"; _plr="${10}"; _burst="${12}"
X                [ "$_bw" != "unset" ] || die "pipe $_pname has no bandwidth (set it first)"
X                shift 12
X                _aqm="$*"
X                _pipeno=$((_pipeno + 1))
X                [ "$_pipeno" -le 99 ] || die "too many pipes (max 99)"
X                _pipes="$_pipes $_pname:$_pipeno"
X                _burst_opt=""
X                [ "$_burst" -gt 0 ] 2>/dev/null && _burst_opt="burst $_burst"
X                emit_aqm "$_aqm"
X                # shellcheck disable=SC2086 (intentional word-splitting)
X                ipfw pipe "$_pipeno" config bw "$_bw" queue "$_q" delay "$_d" \
X                    plr "$_plr" $_burst_opt $_aqm_toks \
X                    || die "ipfw pipe $_pipeno (name $_pname) failed"
X                ;;
X        esac
X    done < "$CONF"
X
X    # --- pass 1b: schedulers ------------------------------------------------
X    _schedno=199
X    while read -r _line; do
X        case "$_line" in
X            sched\ *)
X                set -- $_line
X                _sname="$2"
X                shift 2
X                _type=""; _bw=""; _quantum=""; _limit=""; _flows=""
X                while [ $# -gt 0 ]; do
X                    case "$1" in
X                        type)    _type="${2:-}"; shift 2 ;;
X                        bw)      _bw="${2:-}"; shift 2 ;;
X                        quantum) _quantum="${2:-}"; shift 2 ;;
X                        limit)   _limit="${2:-}"; shift 2 ;;
X                        flows)   _flows="${2:-}"; shift 2 ;;
X                        *) die "cannot parse sched line: $_line" ;;
X                    esac
X                done
X                [ -n "$_type" ] || die "sched $_sname has no type (set it first)"
X                case "$_type" in
X                    fifo|wf2q+|rr|qfq|fq_codel|fq_pie) ;;
X                    *) die "sched $_sname: bad type $_type" ;;
X                esac
X                case "$_type" in
X                    fq_codel|fq_pie) ;;
X                    *)
X                        [ -z "$_quantum$_limit$_flows" ] \
X                            || die "sched $_sname: quantum/limit/flows need type fq_codel|fq_pie"
X                        ;;
X                esac
X                _schedno=$((_schedno + 1))
X                [ "$_schedno" -le 299 ] || die "too many schedulers (max 100)"
X                _scheds="$_scheds $_sname:$_schedno"
X                # bw (a non-fq option) goes BEFORE the type token; fq params
X                # go AFTER it (ipfw.8: tokens after fq_codel/fq_pie belong to it).
X                _scfg="type $_type"
X                [ -n "$_bw" ] && _scfg="bw $_bw $_scfg"
X                [ -n "$_quantum" ] && _scfg="$_scfg quantum $_quantum"
X                [ -n "$_limit" ] && _scfg="$_scfg limit $_limit"
X                [ -n "$_flows" ] && _scfg="$_scfg flows $_flows"
X                # shellcheck disable=SC2086 (intentional word-splitting)
X                ipfw sched "$_schedno" config $_scfg \
X                    || die "ipfw sched $_schedno (name $_sname) failed"
X                ;;
X        esac
X    done < "$CONF"
X
X    # --- pass 2: queues -----------------------------------------------------
X    _queueno=99
X    while read -r _line; do
X        case "$_line" in
X            queue\ *)
X                set -- $_line
X                [ "$#" -ge 11 ] || die "corrupt queue line: $_line"
X                # $1=queue $2=name $3=kind $4=parent $5=mask $6=spec $7=val
X                # $8=weight $9=w $10=queue $11=n ; $12+ = aqm clause
X                _qname="$2"; _kind="$3"; _parent="$4"
X                _spec="$6"; _val="$7"; _w="$9"; _q="${11}"
X                [ "$_parent" != "unset" ] || die "queue $_qname has no parent (set pipe or sched first)"
X                shift 11
X                _aqm="$*"
X                case "$_kind" in
X                    pipe)
X                        _pno=$(lookup "$_pipes" "$_parent") \
X                            || die "queue $_qname refers to unknown pipe $_parent"
X                        _parent_opt="pipe $_pno" ;;
X                    sched)
X                        _sno=$(lookup "$_scheds" "$_parent") \
X                            || die "queue $_qname refers to unknown sched $_parent"
X                        _parent_opt="sched $_sno" ;;
X                    *) die "queue $_qname: bad parent kind $_kind" ;;
X                esac
X                case "$_spec" in
X                    all) _mask="mask all" ;;
X                    dst-ip|src-ip|dst-ip6|src-ip6|dst-port|src-port|proto|flow-id)
X                        _mask="mask $_spec $_val" ;;
X                    *) die "queue $_qname: bad mask $_spec" ;;
X                esac
X                _queueno=$((_queueno + 1))
X                [ "$_queueno" -le 199 ] || die "too many queues (max 100)"
X                _queues="$_queues $_qname:$_queueno"
X                emit_aqm "$_aqm"
X                # shellcheck disable=SC2086 (intentional word-splitting)
X                ipfw queue "$_queueno" config $_parent_opt $_mask \
X                    weight "$_w" queue "$_q" $_aqm_toks \
X                    || die "ipfw queue $_queueno (name $_qname) failed"
X                ;;
X        esac
X    done < "$CONF"
X
X    # --- pass 3: rules -> pf anchor file ------------------------------------
X    _anchor_tmp="$ANCHOR_FILE.tmp.$$"
X    : > "$_anchor_tmp" || die "cannot write $ANCHOR_FILE"
X    while read -r _line; do
X        case "$_line" in
X            rule\ *)
X                set -- $_line
X                [ "$#" -ge 7 ] || die "corrupt rule line: $_line"
X                # $1=rule $2=name $3=dir $4=on $5=if $6=kind $7=ref $8..=filters
X                _rname="$2"; _dir="$3"; _if="$5"; _kind="$6"; _ref="$7"
X                shift 7
X                _src=""; _dst=""; _proto=""; _dport=""
X                while [ $# -gt 0 ]; do
X                    case "$1" in
X                        src)   _src="${2:-}"; shift 2 ;;
X                        dst)   _dst="${2:-}"; shift 2 ;;
X                        proto) _proto="${2:-}"; shift 2 ;;
X                        dport) _dport="${2:-}"; shift 2 ;;
X                        *) die "cannot parse rule line: $_line" ;;
X                    esac
X                done
X                case "$_kind" in
X                    pipe)
X                        _no=$(lookup "$_pipes" "$_ref") \
X                            || die "rule $_rname refers to unknown pipe $_ref"
X                        _act="dnpipe $_no" ;;
X                    queue)
X                        _no=$(lookup "$_queues" "$_ref") \
X                            || die "rule $_rname refers to unknown queue $_ref"
X                        _act="dnqueue $_no" ;;
X                    *) die "rule $_rname: bad target kind $_kind" ;;
X                esac
X                _rule="pass $_dir on $_if"
X                case "$_proto" in
X                    ""|all) ;;
X                    tcp|udp|icmp) _rule="$_rule proto $_proto" ;;
X                    *) die "rule $_rname: bad proto $_proto" ;;
X                esac
X                case "$_src" in
X                    ""|any) ;;
X                    *) _rule="$_rule from $_src" ;;
X                esac
X                case "$_dst" in
X                    ""|any) ;;
X                    *) _rule="$_rule to $_dst" ;;
X                esac
X                if [ -n "$_dport" ]; then
X                    case "$_proto" in
X                        tcp|udp) _rule="$_rule port $_dport" ;;
X                        *) die "rule $_rname: dport needs proto tcp|udp" ;;
X                    esac
X                fi
X                printf '%s %s\n' "$_rule" "$_act" >> "$_anchor_tmp"
X                ;;
X        esac
X    done < "$CONF"
X    mv "$_anchor_tmp" "$ANCHOR_FILE" || die "cannot write $ANCHOR_FILE"
X
X    # --- load the anchor into pf --------------------------------------------
X    if pf_enabled; then
X        if grep -q "anchor \"$ANCHOR\"" /etc/pf.conf 2>/dev/null; then
X            pfctl -a "$ANCHOR" -f "$ANCHOR_FILE" \
X                || die "pfctl failed to load anchor $ANCHOR"
X        else
X            warn "/etc/pf.conf does not reference anchor \"$ANCHOR\" — add this line (after scrub, before filter rules):"
X            warn "    anchor \"$ANCHOR\""
X            warn "pipes/queues are created, but no traffic is diverted until then"
X        fi
X    else
X        warn "pf is disabled — anchor not loaded (pipes/queues created anyway)"
X    fi
X
X    exit 0
X}
X
X# --- dispatch -----------------------------------------------------------
Xop="${1:-}"; shift 2>/dev/null || true
Xcase "$op" in
X    check)         cmd_check ;;
X    check-pipe)    cmd_check_pipe "$@" ;;
X    check-sched)   cmd_check_sched "$@" ;;
X    check-queue)   cmd_check_queue "$@" ;;
X    check-rule)    cmd_check_rule "$@" ;;
X    show)          cmd_show ;;
X    show-pipe)     cmd_show_pipe ;;
X    show-sched)    cmd_show_sched ;;
X    show-queue)    cmd_show_queue ;;
X    show-rule)     cmd_show_rule ;;
X    stats)         cmd_stats ;;
X    set-enable)    cmd_set_enable "$@" ;;
X    set-pipe-field)  cmd_set_pipe_field "$@" ;;
X    set-sched-field) cmd_set_sched_field "$@" ;;
X    set-queue-field) cmd_set_queue_field "$@" ;;
X    set-rule-field)  cmd_set_rule_field "$@" ;;
X    del-pipe)      cmd_del_pipe "$@" ;;
X    del-sched)     cmd_del_sched "$@" ;;
X    del-queue)     cmd_del_queue "$@" ;;
X    del-rule)      cmd_del_rule "$@" ;;
X    apply)         cmd_apply "$@" ;;
X    apply-all)     cmd_apply ;;
X    flush)         cmd_apply --flush ;;
X    *) echo "usage: $PROG <check|set-enable|set-pipe-field|set-sched-field|set-queue-field|set-rule-field|del-pipe|del-sched|del-queue|del-rule|show|show-pipe|show-sched|show-queue|show-rule|stats|apply|apply-all|flush> ..." >&2; exit 2 ;;
Xesac
a81bd9daa4a7ec8c67ba23b0a743ac6d
echo x - net/titian/files/sbin/titian-tune-recommend.sh
sed 's/^X//' >net/titian/files/sbin/titian-tune-recommend.sh << '87b63c8b9b9b7fe8810570c225aaf379'
X#!/bin/sh
X# TITIAN — rekomendasi tuning (READ-ONLY, tidak mengubah apa-apa).
X# Hanya membaca: /sys, ethtool -i/-k/-c (query), ip link, ifconfig,
X# sysctl -n. TIDAK PERNAH menjalankan ethtool -K/-C, ip link set,
X# ifconfig set, atau sysctl -w.
X#
X# Profil default = ROUTER (box forwarding BIRD). Bila box ini endpoint
X# (bukan router), abaikan rekomendasi ip_forward (seharusnya 0).
X# Setiap rekomendasi mencetak perintah CLI Titian persis yang bisa
X# dijalankan operator untuk menerapkannya — tool ini sendiri tidak
X# menerapkannya.
X#
X# Graceful degradation: ethtool tidak ada -> bagian offload/coalesce
X# dilewati dengan catatan; fitur [fixed] driver -> tidak direkomendasikan
X# diubah; interface tanpa dukungan suatu fitur -> dilewati diam-diam
X# untuk fitur itu.
X# POSIX sh (jalan di dash Debian dan sh FreeBSD).
Xset -u
XOS=$(uname -s)
X
Xsay() { echo "$*"; }
Xrec() {
X    # $1=perintah titian $2=alasan
X    echo "  REKOMENDASI: $1"
X    echo "    alasan: $2"
X}
Xok() { echo "  OK: $*"; }
Xnote() { echo "  CATATAN: $*"; }
X
X# ---------- sysctl (kedua OS) ----------
Xsysctl_section_linux() {
X    say "== Sysctl (Linux, profil router) =="
X    _v=$(sysctl -n net.ipv4.ip_forward 2>/dev/null || echo "?")
X    if [ "$_v" = "1" ]; then ok "net.ipv4.ip_forward=1 (forwarding aktif)"; else rec "system sysctl net.ipv4.ip_forward 1" "router wajib meneruskan paket antar interface (saat ini: $_v). Bila box ini endpoint, justru harus 0."; fi
X    _v=$(sysctl -n net.ipv6.conf.all.forwarding 2>/dev/null || echo "?")
X    if [ "$_v" = "1" ]; then ok "net.ipv6.conf.all.forwarding=1"; else rec "system sysctl net.ipv6.conf.all.forwarding 1" "forwarding IPv6 untuk router dual-stack (saat ini: $_v)."; fi
X    for k in net.ipv4.conf.all.rp_filter net.ipv4.conf.default.rp_filter; do
X        _v=$(sysctl -n "$k" 2>/dev/null || echo "?")
X        case "$_v" in
X            2) ok "$k=2 (loose)" ;;
X            *) rec "system sysctl $k 2" "strict (1) menolak paket dari jalur tak terduga dan merusak routing asimetris; loose (2) tetap memfilter spoof kasar tanpa memutus rute asimetris (saat ini: $_v)." ;;
X        esac
X    done
X    _v=$(sysctl -n net.core.netdev_max_backlog 2>/dev/null || echo "?")
X    case "$_v" in
X        ''|'[?]') ;;
X        *) if [ "$_v" -ge 5000 ] 2>/dev/null; then ok "net.core.netdev_max_backlog=$_v"; else rec "system sysctl net.core.netdev_max_backlog 5000" "antrean paket masuk sebelum diproses; nilai kecil menyebabkan drop RX saat burst (saat ini: $_v)."; fi ;;
X    esac
X    _v=$(sysctl -n net.core.rmem_max 2>/dev/null || echo "?")
X    case "$_v" in
X        ''|'[?]') ;;
X        *) if [ "$_v" -ge 16777216 ] 2>/dev/null; then ok "net.core.rmem_max=$_v"; else rec "system sysctl net.core.rmem_max 16777216" "buffer socket maksimum; menaikkan ini saja belum berefek tanpa tcp_rmem (saat ini: $_v)."; fi ;;
X    esac
X    _v=$(sysctl -n net.core.wmem_max 2>/dev/null || echo "?")
X    case "$_v" in
X        ''|'[?]') ;;
X        *) if [ "$_v" -ge 16777216 ] 2>/dev/null; then ok "net.core.wmem_max=$_v"; else rec "system sysctl net.core.wmem_max 16777216" "seperti rmem_max, untuk arah kirim (saat ini: $_v)."; fi ;;
X    esac
X    _v=$(sysctl -n net.ipv4.tcp_rmem 2>/dev/null || echo "?")
X    case "$_v" in
X        ''|'[?]') ;;
X        *) _max=$(echo "$_v" | awk '{print $3}')
X            if [ "${_max:-0}" -ge 16777216 ] 2>/dev/null; then ok "net.ipv4.tcp_rmem=$_v"; else rec "system sysctl net.ipv4.tcp_rmem \"4096 87380 16777216\"" "buffer TCP (min/default/maks); maks kecil membatasi throughput sesi jarak jauh/latensi tinggi seperti BGP antar POP (saat ini: $_v)."; fi ;;
X    esac
X    _v=$(sysctl -n net.ipv4.tcp_wmem 2>/dev/null || echo "?")
X    case "$_v" in
X        ''|'[?]') ;;
X        *) _max=$(echo "$_v" | awk '{print $3}')
X            if [ "${_max:-0}" -ge 16777216 ] 2>/dev/null; then ok "net.ipv4.tcp_wmem=$_v"; else rec "system sysctl net.ipv4.tcp_wmem \"4096 65536 16777216\"" "seperti tcp_rmem, untuk arah kirim (saat ini: $_v)."; fi ;;
X    esac
X}
Xsysctl_section_freebsd() {
X    say "== Sysctl (FreeBSD, profil router) =="
X    _v=$(sysctl -n net.inet.ip.forwarding 2>/dev/null || echo "?")
X    if [ "$_v" = "1" ]; then ok "net.inet.ip.forwarding=1 (forwarding aktif)"; else rec "system sysctl net.inet.ip.forwarding 1" "router wajib meneruskan paket antar interface (saat ini: $_v). Bila box ini endpoint, justru harus 0."; fi
X    _v=$(sysctl -n net.inet6.ip6.forwarding 2>/dev/null || echo "?")
X    if [ "$_v" = "1" ]; then ok "net.inet6.ip6.forwarding=1"; else rec "system sysctl net.inet6.ip6.forwarding 1" "forwarding IPv6 untuk router dual-stack (saat ini: $_v)."; fi
X    _v=$(sysctl -n net.inet.tcp.sendbuf_max 2>/dev/null || echo "?")
X    case "$_v" in
X        ''|'[?]') ;;
X        *) if [ "$_v" -ge 16777216 ] 2>/dev/null; then ok "net.inet.tcp.sendbuf_max=$_v"; else rec "system sysctl net.inet.tcp.sendbuf_max 16777216" "buffer kirim TCP maksimum; kecil membatasi throughput sesi jarak jauh (saat ini: $_v)."; fi ;;
X    esac
X    _v=$(sysctl -n net.inet.tcp.recvbuf_max 2>/dev/null || echo "?")
X    case "$_v" in
X        ''|'[?]') ;;
X        *) if [ "$_v" -ge 16777216 ] 2>/dev/null; then ok "net.inet.tcp.recvbuf_max=$_v"; else rec "system sysctl net.inet.tcp.recvbuf_max 16777216" "seperti sendbuf_max, untuk arah terima (saat ini: $_v)."; fi ;;
X    esac
X    note "FreeBSD tidak punya rp_filter seperti Linux (tidak ada rekomendasi padanan)."
X}
X
X# ---------- interface: Linux ----------
Xiface_linux() {
X    local iface=$1 drv speed mtu qlen
X    say "== Interface $iface (Linux) =="
X    drv=$(ethtool -i "$iface" 2>/dev/null | awk -F': ' '/^driver:/{print $2; exit}')
X    [ -n "$drv" ] && say "  driver: $drv" || say "  driver: (tidak terbaca — ethtool tidak tersedia?)"
X    mtu=$(cat "/sys/class/net/$iface/mtu" 2>/dev/null || echo "?")
X    qlen=$(cat "/sys/class/net/$iface/tx_queue_len" 2>/dev/null || echo "?")
X    say "  mtu saat ini: $mtu | txqueuelen saat ini: $qlen"
X    case "$mtu" in
X        1500) note "mtu 1500 = default aman. Jumbo 9000 hanya bila SELURUH path mendukung; bila ya: interface ethernet $iface -> mtu 9000." ;;
X        9000) ok "mtu 9000 (jumbo) — pastikan seluruh path mendukung, kalau tidak paket besar di-drop." ;;
X        *) note "mtu $mtu bukan 1500/9000 — pastikan disengaja (pastikan path + peer sepakat)." ;;
X    esac
X    if command -v ethtool >/dev/null 2>&1; then
X        speed=$(ethtool "$iface" 2>/dev/null | awk -F': ' '/^[[:space:]]*Speed:/{print $2; exit}')
X        [ -n "$speed" ] && say "  kecepatan link: $speed"
X        case "$speed" in
X            10000Mb/s)
X                if [ "$qlen" = "10000" ]; then ok "txqueuelen 10000 cocok untuk 10G"; else rec "interface ethernet $iface -> qlen 10Gbit" "antrean kirim 10000 untuk 10G (saat ini: $qlen)."; fi ;;
X            1000Mb/s)
X                if [ "$qlen" = "1000" ]; then ok "txqueuelen 1000 cocok untuk 1G"; else rec "interface ethernet $iface -> qlen 1Gbit" "antrean kirim 1000 untuk 1G (saat ini: $qlen)."; fi ;;
X            *) note "kecepatan link tidak terbaca ($speed) — rekomendasi qlen dilewati." ;;
X        esac
X        # offload: hanya fitur yang dikenal + tidak [fixed]
X        ethtool -k "$iface" 2>/dev/null | while read -r line; do
X            case "$line" in
X                'tcp-segmentation-offload: '*) _f=tso ;;
X                'generic-segmentation-offload: '*) _f=gso ;;
X                'generic-receive-offload: '*) _f=gro ;;
X                'large-receive-offload: '*) _f=lro ;;
X                'rx-checksumming: '*) _f=rx ;;
X                'tx-checksumming: '*) _f=tx ;;
X                'scatter-gather: '*) _f=sg ;;
X                *) continue ;;
X            esac
X            _val=${line#*: }; _state=${_val%% *}; _fixed=""
X            case "$_val" in *'[fixed]'*) _fixed=1 ;; esac
X            if [ -n "$_fixed" ]; then
X                note "$_f: $_state [fixed driver] — tidak bisa diubah, dilewati."
X                continue
X            fi
X            case "$_f:$_state" in
X                'lro:on') rec "interface ethernet $iface -> options -> no lro" "LRO hardware HARUS off di router/bridge karena bisa merusak semantik forwarding; pakai GRO (software) sebagai gantinya." ;;
X                'lro:off') ok "lro off (benar untuk router)" ;;
X                'tso:off') rec "interface ethernet $iface -> options -> tso on" "TSO off membebani CPU untuk trafik lokal (sesi BGP/manajemen yang berasal dari box ini)." ;;
X                'gso:off') rec "interface ethernet $iface -> options -> gso on" "GSO off membebani CPU untuk trafik lokal." ;;
X                'gro:off') rec "interface ethernet $iface -> options -> gro on" "GRO off membebani CPU receive; GRO aman untuk router (berbeda dengan LRO hardware)." ;;
X                'rx:off') rec "interface ethernet $iface -> options -> rx on" "checksum receive oleh NIC menghemat CPU; hampir selalu on." ;;
X                'tx:off') rec "interface ethernet $iface -> options -> tx on" "checksum transmit oleh NIC menghemat CPU; hampir selalu on." ;;
X                'sg:off') rec "interface ethernet $iface -> options -> sg on" "scatter-gather adalah prasyarat TSO/GSO; off membatasi offload lain." ;;
X                *) ok "$_f $_state" ;;
X            esac
X        done
X        _c=$(ethtool -c "$iface" 2>/dev/null)
X        _rxu=$(echo "$_c" | awk '/^RX-usecs:/{print $2}')
X        _arx=$(echo "$_c" | awk '/^Adaptive RX:/{print $3}')
X        if [ -n "$_rxu" ]; then
X            case "$_rxu" in
X                0) note "rx-usecs 0 = interupsi segera (latensi terendah, CPU tertinggi). Untuk throughput tinggi pertimbangkan: interface ethernet $iface -> options -> rx-usecs 125." ;;
X                *) if [ "$_rxu" -gt 500 ] 2>/dev/null; then note "rx-usecs $_rxu tinggi: hemat CPU tapi latensi naik; untuk latensi rendah pertimbangkan 125 atau 0."; else ok "rx-usecs $_rxu (dalam rentang wajar)."; fi ;;
X            esac
X        fi
X        if [ -n "$_arx" ]; then
X            case "$_arx" in
X                off) note "adaptive-rx off. Untuk beban campuran (kadang sepi, kadang burst) pertimbangkan: interface ethernet $iface -> options -> adaptive-rx on." ;;
X                *) ok "adaptive-rx $_arx" ;;
X            esac
X        fi
X    else
X        note "ethtool tidak ditemukan — bagian offload/coalesce/kecepatan dilewati (pasang ethtool untuk rekomendasi lengkap)."
X    fi
X}
X
X# ---------- interface: FreeBSD ----------
Xiface_freebsd() {
X    local iface=$1 out opts
X    say "== Interface $iface (FreeBSD) =="
X    out=$(ifconfig "$iface" 2>/dev/null) || { note "tidak bisa dibaca, dilewati."; return 0; }
X    say "  mtu saat ini: $(echo "$out" | awk '{for(i=1;i<=NF;i++) if ($i == "mtu") {print $(i+1); exit}}')"
X    # token options=<> dipisah koma, cocok PERSIS (bukan substring:
X    # VLAN_HWTSO bukan TSO, RXCSUM_IPV6 bukan RXCSUM)
X    _toks=$(echo "$out" | awk '/^[[:space:]]options=/{print; exit}' | sed 's/.*<//; s/>.*//')
X    say "  options=<$_toks>"
X    _has() { case ",$_toks," in *",$1,"*) return 0 ;; *) return 1 ;; esac; }
X    if _has TSO4 || _has TSO6; then ok "tso aktif (TSO4/TSO6)"; else rec "interface ethernet $iface -> options -> tso on" "TSO off membebani CPU untuk trafik lokal (bila driver mendukung)."; fi
X    if _has LRO; then rec "interface ethernet $iface -> options -> no lro" "LRO HARUS off di router/bridge karena bisa merusak semantik forwarding."; else ok "lro off (benar untuk router)"; fi
X    if _has RXCSUM; then ok "rxcsum aktif"; else rec "interface ethernet $iface -> options -> rx on" "checksum receive oleh NIC menghemat CPU (bila driver mendukung)."; fi
X    if _has TXCSUM; then ok "txcsum aktif"; else rec "interface ethernet $iface -> options -> tx on" "checksum transmit oleh NIC menghemat CPU (bila driver mendukung)."; fi
X    note "gro/gso/sg tidak punya padanan ifconfig di FreeBSD — tidak dinilai."
X    note "coalesce tidak punya padanan generik di FreeBSD — tidak dinilai."
X    note "qlen (txqueuelen) tidak punya padanan di FreeBSD — tidak dinilai."
X}
X
Xsay "TITIAN tuning recommendations ($OS) — READ-ONLY, tidak ada yang diubah"
Xsay "Profil: ROUTER (forwarding BIRD). Bila box ini endpoint, abaikan rekomendasi ip_forward."
Xsay ""
Xif [ "$OS" = "FreeBSD" ]; then
X    for i in $(ifconfig -l 2>/dev/null); do
X        case "$i" in lo*|pflog*|pfsync*) continue ;; esac
X        iface_freebsd "$i"
X        say ""
X    done
X    sysctl_section_freebsd
Xelse
X    for d in /sys/class/net/*; do
X        [ -d "$d" ] || continue
X        i=$(basename "$d")
X        case "$i" in lo) continue ;; esac
X        iface_linux "$i"
X        say ""
X    done
X    sysctl_section_linux
Xfi
Xsay ""
Xsay "Selesai. Jalankan perintah REKOMENDASI di atas lewat CLI Titian bila setuju — tool ini tidak mengubah apa-apa."
87b63c8b9b9b7fe8810570c225aaf379
echo x - net/titian/files/sbin/titian-tune.sh
sed 's/^X//' >net/titian/files/sbin/titian-tune.sh << '4ef2f011a3a4b72bf57f7c99c6d60117'
X#!/bin/sh
X# TITIAN — parameter tuning interface (mtu, qlen, speed, offload, coalesce).
X# Dipakai perintah `mtu`/`qlen`/`speed` di semua if-view dan perintah di view
X# `options` (Linux) / `options` FreeBSD, kedua OS.
X#
X# Dua jalur persistensi (tanpa daemon/service baru):
X#  1. running-config: tiap perintah punya CONFIG di tree, jadi `save`
X#     + replay startup-config saat boot menjalankannya lagi.
X#  2. cermin deklaratif titian-persist.sh: nilai dicatat di
X#     netstate/<iface>.tuning, lalu ditulis ke
X#       Debian: [Link] MTUBytes/TransmitQueueLength di
X#               /etc/systemd/network/00-titian-<iface>.network
X#               (offload/coalesce TIDAK punya padanan networkd — jalur
X#               replay + apply-all di titian-boot.sh yang membawanya).
X#       FreeBSD: opsi `mtu` + flag offload (-tso/-lro/rxcsum/...)
X#               di baris ifconfig_<iface> blok #-TITIAN-# rc.conf.
X#     titian-boot.sh menjalankan `titian-tune.sh apply-all` sehabis
X#     replay (best-effort, idempotent) sebagai jaring pengaman bila
X#     replay baris view `options` (nested) gagal.
X#
X# Semantik `no <param>` (perintah `no mtu`, `no tso`, dsb.):
X#   menghapus catatan titian + mengembalikan nilai live ke nilai
X#   SEBELUM Titian pertama kali menyetel kunci itu (dicatat di
X#   <iface>.tuning.prev saat set pertama; bila tidak tercatat —
X#   mis. `no` tanpa pernah set — dipakai default konvensional.
X#   Prev HANYA dicatat bila nilai live saat itu berbeda dari target
X#   (set yang sama dengan nilai live — mis. replay saat restart —
X#   tidak menimpa prev; bila tidak, replay akan "mencatat" nilai
X#   Titian sendiri sebagai "sebelum", dan `no` menjadi no-op).
X#   mtu 1500, qlen 1000, tso/gro/gso/rx/tx/sg on, lro off,
X#   rx-usecs 0, adaptive-rx off). Bila driver menolak ubah nilai live,
X#   perintah tetap sukses dengan peringatan: nilai live bertahan
X#   sampai reboot, dan cermin sudah bersih sehingga boot berikutnya
X#   memakai default driver. CATATAN: `no` berarti "lupakan setelan
X#   Titian", BUKAN "setelan persisten ke default" — bila mau nilai
X#   default bertahan melewati reboot, pakai bentuk set-nya
X#   (mis. `lro off`, bukan `no lro`).
X#
X# Batasan per-OS (jujur, bukan diam):
X#   - speed: Linux saja (ethtool -s). FreeBSD tidak butuh speed-set
X#     untuk lagg (terbukti merespons LACP dengan benar tanpa itu),
X#     dan media/mediaopt vtnet tidak berefek pada lagg — jadi tidak
X#     ada perintah speed di view FreeBSD (bukan ditolak, memang tidak
X#     ada; pola yang sama dengan qlen/coalesce Linux saja).
X#   - qlen (txqueuelen): Linux saja. FreeBSD tidak punya padanan
X#     per-interface yang setara.
X#   - coalesce (rx-usecs/adaptive-rx): Linux (ethtool -C) saja.
X#     FreeBSD tidak punya knob generik yang setara.
X#   - offload FreeBSD: hanya tso/lro/rx/tx (ifconfig: tso/-tso,
X#     lro/-lro, rxcsum/-rxcsum, txcsum/-txcsum). gro/gso/sg tidak
X#     punya padanan ifconfig -> ditolak bersih dengan pesan.
X#   - ethtool: bila biner tidak ada, perintah offload/coalesce Linux
X#     gagal bersih (bukan diam).
X# POSIX sh (jalan di dash Debian dan sh FreeBSD).
Xset -u
XOS=$(uname -s)
XROOT=${TITIAN_ROOT:-/opt/titian}
XSTATE_DIR=${TITIAN_STATE_DIR:-$ROOT/etc/netstate}
XPERSIST=${RT_SBIN:-$ROOT/sbin}/titian-persist.sh
X
Xerr() { echo "Error: $*" >&2; exit 33; }
Xwarn() { echo "Warning(tune): $*" >&2; }
X
X# --- state file <iface>.tuning ---
Xtune_set() {
X    # $1=iface $2=line ("mtu 9000" | "qlen 1000" | "offload tso on" |
X    # "coalesce rx-usecs 125" | "coalesce adaptive-rx on")
X    local iface=$1 line=$2 key f
X    key=${line%% *}
X    mkdir -p "$STATE_DIR" 2>/dev/null || return 0
X    f="$STATE_DIR/$iface.tuning"
X    touch "$f" 2>/dev/null || return 0
X    case "$line" in
X        'offload '*)
X            # hapus baris offload <feat> lama apa pun nilainya (on->off
X            # harus menggantikan, bukan menumpuk dua baris)
X            _feat=${line#offload }; _feat=${_feat%% *}
X            grep -v "^offload $_feat " "$f" > "$f.tmp" 2>/dev/null; mv "$f.tmp" "$f" 2>/dev/null || true ;;
X        'coalesce '*)
X            _kind=${line#coalesce }; _kind=${_kind%% *}
X            grep -v "^coalesce $_kind " "$f" > "$f.tmp" 2>/dev/null; mv "$f.tmp" "$f" 2>/dev/null || true ;;
X        *) grep -v "^$key " "$f" > "$f.tmp" 2>/dev/null; mv "$f.tmp" "$f" 2>/dev/null || true ;;
X    esac
X    echo "$line" >> "$f"
X}
Xtune_del() {
X    # $1=iface $2=prefix ("mtu" | "qlen" | "offload tso" | "coalesce rx-usecs")
X    local f="$STATE_DIR/$1.tuning"
X    [ -f "$f" ] || return 0
X    grep -v "^$2 " "$f" > "$f.tmp" 2>/dev/null; mv "$f.tmp" "$f" 2>/dev/null || true
X}
Xtune_get() {
X    # $1=iface $2=prefix -> nilai (kolom terakhir) atau kosong
X    local f="$STATE_DIR/$1.tuning"
X    [ -f "$f" ] || return 0
X    grep "^$2 " "$f" 2>/dev/null | tail -1 | awk '{print $NF}'
X}
X# --- nilai sebelum-set pertama (untuk `no` yang mengembalikan) ---
Xtune_prev_get() {
X    # $1=iface $2=key ("mtu"|"qlen"|"offload tso"|"coalesce rx-usecs")
X    local f="$STATE_DIR/$1.tuning.prev"
X    [ -f "$f" ] || return 0
X    grep "^$2=" "$f" 2>/dev/null | tail -1 | cut -d= -f2-
X}
Xtune_prev_set() {
X    # $1=iface $2=key $3=nilai-awal: catat hanya bila belum tercatat
X    local f="$STATE_DIR/$1.tuning.prev"
X    [ -n "$(tune_prev_get "$1" "$2")" ] && return 0
X    [ -n "$3" ] || return 0
X    mkdir -p "$STATE_DIR" 2>/dev/null || return 0
X    touch "$f" 2>/dev/null || return 0
X    echo "$2=$3" >> "$f"
X}
Xtune_prev_del() {
X    local f="$STATE_DIR/$1.tuning.prev"
X    [ -f "$f" ] || return 0
X    grep -v "^$2=" "$f" > "$f.tmp" 2>/dev/null; mv "$f.tmp" "$f" 2>/dev/null || true
X}
Xlive_mtu() {
X    if [ "$OS" = "FreeBSD" ]; then
X        ifconfig "$1" 2>/dev/null | awk '{for(i=1;i<=NF;i++) if ($i == "mtu") {print $(i+1); exit}}'
X    else
X        cat "/sys/class/net/$1/mtu" 2>/dev/null
X    fi
X}
Xlive_offload() {
X    # $1=iface $2=feat -> on|off (kosong bila tak terbaca)
X    local line
X    if [ "$OS" = "FreeBSD" ]; then
X        case "$2" in
X            tso) (fbsd_opt_has "$1" TSO4 || fbsd_opt_has "$1" TSO6) && echo on || echo off ;;
X            lro) fbsd_opt_has "$1" LRO && echo on || echo off ;;
X            rx)  fbsd_opt_has "$1" RXCSUM && echo on || echo off ;;
X            tx)  fbsd_opt_has "$1" TXCSUM && echo on || echo off ;;
X            *) echo "" ;;
X        esac
X    else
X        line=$(ethtool -k "$1" 2>/dev/null | grep "^$(offload_ethtool_name "$2"): " | head -1)
X        echo "$line" | awk '{print $2}'
X    fi
X}
Xsync() {
X    # Regenerasi cermin + reload networkd, lalu pasang ulang slave bond
X    # bila interface ini anggota bond (regen+reload memicu reconfigure
X    # networkd yang melepas slave — attach-bond menutup celah itu).
X    # No-op untuk interface biasa (tanpa file .bond).
X    [ -x "$PERSIST" ] && "$PERSIST" sync-if "$1" 2>/dev/null || true
X    [ -x "$PERSIST" ] && "$PERSIST" attach-bond "$1" 2>/dev/null || true
X}
X
Xvalid_int() {
X    # $1=nilai $2=min $3=max
X    case "$1" in ''|*[!0-9]*) return 1 ;; esac
X    [ "$1" -ge "$2" ] 2>/dev/null && [ "$1" -le "$3" ] 2>/dev/null
X}
X
Xiface_exists() {
X    if [ "$OS" = "FreeBSD" ]; then
X        ifconfig "$1" >/dev/null 2>&1
X    else
X        [ -d "/sys/class/net/$1" ]
X    fi
X}
X
X# --- readback: perintah set WAJIB membuktikan nilai live berubah.
X# (Pelajaran dari virtio lab: `ethtool -C ... adaptive-rx on` exit 0
X# tapi nilai live tetap off — tanpa readback, CLI akan mencatat
X# setelan palsu. Karena itu SET yang gagal readback = gagal total,
X# tanpa mencatat apa pun.)
Xreadback_mtu() {
X    # $1=iface $2=mtu-harapan -> 0 bila cocok
X    # FreeBSD: mtu ada di baris flags yang sama ("vtnet1: flags=... mtu
X    # 1400"), BUKAN di baris sendiri — awk harus memindai semua kolom.
X    local cur
X    if [ "$OS" = "FreeBSD" ]; then
X        cur=$(ifconfig "$1" 2>/dev/null | awk '{for(i=1;i<=NF;i++) if ($i == "mtu") {print $(i+1); exit}}')
X    else
X        cur=$(cat "/sys/class/net/$1/mtu" 2>/dev/null)
X    fi
X    [ "$cur" = "$2" ]
X}
Xfbsd_opt_tokens() {
X    # $1=iface -> daftar token options=<> dipisah koma (baris options
X    # utama saja; baris "nd6 options=" sengaja dikecualikan)
X    ifconfig "$1" 2>/dev/null | awk '/^[[:space:]]options=/{print; exit}' | sed 's/.*<//; s/>.*//'
X}
Xfbsd_opt_has() {
X    # $1=iface $2=token -> 0 bila token PERSIS ada (cocok koma, bukan
X    # substring: "TSO" tidak boleh cocok "VLAN_HWTSO", "RXCSUM" tidak
X    # boleh cocok "RXCSUM_IPV6")
X    local toks
X    toks=$(fbsd_opt_tokens "$1")
X    case ",$toks," in *",$2,"*) return 0 ;; *) return 1 ;; esac
X}
X
X# --- mtu ---
Xmtu_set() {
X    # $1=iface $2=mtu (tree MTU ptype: 68-9000)
X    local iface=$1 mtu=$2
X    iface_exists "$iface" || err "interface $iface tidak ditemukan di sistem (lihat 'show interfaces' untuk daftar)"
X    valid_int "$mtu" 68 9000 || err "mtu harus 68-9000 (batas ptype MTU tree): $mtu"
X    _cur=$(live_mtu "$iface"); [ "$_cur" != "$mtu" ] && tune_prev_set "$iface" "mtu" "$_cur"
X    if [ "$OS" = "FreeBSD" ]; then
X        ifconfig "$iface" mtu "$mtu" || err "gagal set mtu $mtu di $iface"
X    else
X        ip link set dev "$iface" mtu "$mtu" || err "gagal set mtu $mtu di $iface"
X    fi
X    readback_mtu "$iface" "$mtu" || err "mtu $iface tidak berubah menjadi $mtu (perintah diterima tapi nilai live menolak — tidak dicatat)"
X    tune_set "$iface" "mtu $mtu"
X    sync "$iface"
X}
Xmtu_del() {
X    local iface=$1 prev
X    iface_exists "$iface" || err "interface $iface tidak ditemukan di sistem (lihat 'show interfaces' untuk daftar)"
X    prev=$(tune_prev_get "$iface" "mtu")
X    [ -n "$prev" ] || prev=1500
X    if [ "$OS" = "FreeBSD" ]; then
X        ifconfig "$iface" mtu "$prev" 2>/dev/null || warn "gagal kembalikan mtu live ke $prev di $iface (cermin tetap dibersihkan)"
X    else
X        ip link set dev "$iface" mtu "$prev" 2>/dev/null || warn "gagal kembalikan mtu live ke $prev di $iface (cermin tetap dibersihkan)"
X    fi
X    tune_del "$iface" "mtu"
X    tune_prev_del "$iface" "mtu"
X    sync "$iface"
X}
X
X# --- qlen (Linux saja) ---
Xqlen_set() {
X    # $1=iface $2=qlen
X    local iface=$1 q=$2
X    [ "$OS" = "FreeBSD" ] && err "qlen (txqueuelen) tidak punya padanan di FreeBSD"
X    iface_exists "$iface" || err "interface $iface tidak ditemukan di sistem (lihat 'show interfaces' untuk daftar)"
X    valid_int "$q" 0 100000 || err "qlen harus 0-100000: $q"
X    _cur=$(cat "/sys/class/net/$iface/tx_queue_len" 2>/dev/null); [ "$_cur" != "$q" ] && tune_prev_set "$iface" "qlen" "$_cur"
X    # Dipakai bentuk panjang `txqueuelen` (terdokumentasi); bentuk
X    # singkat `qlen` dari tree lama TERVERIFIKASI juga jalan di
X    # iproute2 Debian 13 (diuji: qlen 5000 mengubah txqueuelen) —
X    # yang diperbaiki di sini adalah exit code yang dicek +
X    # persistensi, bukan sintaksnya.
X    ip link set dev "$iface" txqueuelen "$q" || err "gagal set txqueuelen $q di $iface"
X    [ "$(cat "/sys/class/net/$iface/tx_queue_len" 2>/dev/null)" = "$q" ] || err "txqueuelen $iface tidak berubah menjadi $q (tidak dicatat)"
X    tune_set "$iface" "qlen $q"
X    sync "$iface"
X}
Xqlen_del() {
X    local iface=$1 prev
X    [ "$OS" = "FreeBSD" ] && err "qlen (txqueuelen) tidak punya padanan di FreeBSD"
X    iface_exists "$iface" || err "interface $iface tidak ditemukan di sistem (lihat 'show interfaces' untuk daftar)"
X    prev=$(tune_prev_get "$iface" "qlen")
X    [ -n "$prev" ] || prev=1000
X    ip link set dev "$iface" txqueuelen "$prev" 2>/dev/null || warn "gagal kembalikan txqueuelen live ke $prev di $iface (cermin tetap dibersihkan)"
X    tune_del "$iface" "qlen"
X    tune_prev_del "$iface" "qlen"
X    sync "$iface"
X}
X
X# --- offload ---
Xoffload_feat_ok() {
X    # $1=feat -> 0 bila dikenal
X    case "$1" in tso|gro|lro|gso|rx|tx|sg) return 0 ;; *) return 1 ;; esac
X}
Xoffload_default() {
X    # $1=feat -> default konvensional
X    case "$1" in lro) echo "off" ;; *) echo "on" ;; esac
X}
Xoffload_ethtool_name() {
X    # $1=feat -> nama baris ethtool -k
X    case "$1" in
X        tso) echo "tcp-segmentation-offload" ;;
X        gro) echo "generic-receive-offload" ;;
X        lro) echo "large-receive-offload" ;;
X        gso) echo "generic-segmentation-offload" ;;
X        rx)  echo "rx-checksumming" ;;
X        tx)  echo "tx-checksumming" ;;
X        sg)  echo "scatter-gather" ;;
X    esac
X}
Xoffload_readback() {
X    # $1=iface $2=feat $3=on|off -> 0 bila nilai live cocok
X    local iface=$1 feat=$2 val=$3 line state flag
X    if [ "$OS" = "FreeBSD" ]; then
X        case "$feat:$val" in
X            tso:on)  fbsd_opt_has "$iface" TSO4 || fbsd_opt_has "$iface" TSO6 ;;
X            tso:off) ! fbsd_opt_has "$iface" TSO4 && ! fbsd_opt_has "$iface" TSO6 ;;
X            lro:on)  fbsd_opt_has "$iface" LRO ;;
X            lro:off) ! fbsd_opt_has "$iface" LRO ;;
X            rx:on)   fbsd_opt_has "$iface" RXCSUM ;;
X            rx:off)  ! fbsd_opt_has "$iface" RXCSUM ;;
X            tx:on)   fbsd_opt_has "$iface" TXCSUM ;;
X            tx:off)  ! fbsd_opt_has "$iface" TXCSUM ;;
X            *) return 1 ;;
X        esac
X    else
X        line=$(ethtool -k "$iface" 2>/dev/null | grep "^$(offload_ethtool_name "$feat"): " | head -1)
X        state=$(echo "$line" | awk '{print $2}')
X        [ "$state" = "$val" ]
X    fi
X}
Xoffload_set() {
X    # $1=iface $2=feat $3=on|off
X    local iface=$1 feat=$2 val=$3 flag
X    iface_exists "$iface" || err "interface $iface tidak ditemukan di sistem (lihat 'show interfaces' untuk daftar)"
X    offload_feat_ok "$feat" || err "fitur offload tidak dikenal: $feat (tso gro lro gso rx tx sg)"
X    case "$val" in on|off) ;; *) err "nilai offload harus on|off: $val" ;; esac
X    _cur=$(live_offload "$iface" "$feat"); [ "$_cur" != "$val" ] && tune_prev_set "$iface" "offload $feat" "$_cur"
X    if [ "$OS" = "FreeBSD" ]; then
X        case "$feat" in
X            tso) flag=tso ;; lro) flag=lro ;;
X            rx)  flag=rxcsum ;; tx) flag=txcsum ;;
X            *) err "offload $feat tidak punya padanan ifconfig di FreeBSD (yang tersedia: tso lro rx tx)" ;;
X        esac
X        if [ "$val" = "off" ]; then flag="-$flag"; fi
X        ifconfig "$iface" "$flag" || err "gagal set $feat $val di $iface (driver mungkin tidak mendukung)"
X    else
X        command -v ethtool >/dev/null 2>&1 || err "ethtool tidak ditemukan di host ini"
X        ethtool -K "$iface" "$feat" "$val" || err "gagal set $feat $val di $iface (fitur mungkin [fixed] oleh driver)"
X    fi
X    offload_readback "$iface" "$feat" "$val" || err "$feat $iface tidak berubah menjadi $val (perintah diterima tapi nilai live menolak — tidak dicatat)"
X    tune_set "$iface" "offload $feat $val"
X    sync "$iface"
X}
Xoffload_del() {
X    # $1=iface $2=feat -> kembalikan nilai sebelum-set pertama;
X    # bila tak tercatat, pakai default konvensional
X    local iface=$1 feat=$2 def
X    iface_exists "$iface" || err "interface $iface tidak ditemukan di sistem (lihat 'show interfaces' untuk daftar)"
X    offload_feat_ok "$feat" || err "fitur offload tidak dikenal: $feat"
X    def=$(tune_prev_get "$iface" "offload $feat")
X    [ -n "$def" ] || def=$(offload_default "$feat")
X    # pakai jalur set tapi tanpa mencatat (lalu hapus catatan)
X    if [ "$OS" = "FreeBSD" ]; then
X        case "$feat" in
X            tso) flag=tso ;; lro) flag=lro ;;
X            rx)  flag=rxcsum ;; tx) flag=txcsum ;;
X            *) warn "offload $feat tidak punya padanan ifconfig di FreeBSD; catatan tetap dihapus" ;;
X        esac
X        if [ -n "${flag:-}" ]; then
X            if [ "$def" = "off" ]; then flag="-$flag"; fi
X            ifconfig "$iface" "$flag" 2>/dev/null || warn "gagal kembalikan $feat live ke $def di $iface (cermin tetap dibersihkan)"
X        fi
X    else
X        if command -v ethtool >/dev/null 2>&1; then
X            ethtool -K "$iface" "$feat" "$def" 2>/dev/null || warn "gagal kembalikan $feat live ke $def di $iface (cermin tetap dibersihkan)"
X        fi
X    fi
X    tune_del "$iface" "offload $feat"
X    tune_prev_del "$iface" "offload $feat"
X    sync "$iface"
X}
X
X# --- coalesce (Linux saja) ---
Xcoalesce_set() {
X    # $1=iface $2=kind $3=value ; kind=rx-usecs|adaptive-rx
X    local iface=$1 kind=$2 val=$3
X    [ "$OS" = "FreeBSD" ] && err "coalesce tidak punya padanan generik di FreeBSD"
X    iface_exists "$iface" || err "interface $iface tidak ditemukan di sistem (lihat 'show interfaces' untuk daftar)"
X    command -v ethtool >/dev/null 2>&1 || err "ethtool tidak ditemukan di host ini"
X    case "$kind" in
X        rx-usecs)
X            valid_int "$val" 0 1000 || err "rx-usecs harus 0-1000: $val"
X            _cur=$(ethtool -c "$iface" 2>/dev/null | awk '/^RX-usecs:/{print $2}'); [ "$_cur" != "$val" ] && tune_prev_set "$iface" "coalesce rx-usecs" "$_cur"
X            ethtool -C "$iface" rx-usecs "$val" || err "gagal set rx-usecs $val di $iface"
X            _live=$(ethtool -c "$iface" 2>/dev/null | awk '/^RX-usecs:/{print $2}')
X            [ "$_live" = "$val" ] || err "rx-usecs $iface tidak berubah menjadi $val (live: ${_live:-?} — driver mengabaikan setelan; tidak dicatat)"
X            ;;
X        adaptive-rx)
X            case "$val" in on|off) ;; *) err "adaptive-rx harus on|off: $val" ;; esac
X            _cur=$(ethtool -c "$iface" 2>/dev/null | awk '/^Adaptive RX:/{print $3}'); [ "$_cur" != "$val" ] && tune_prev_set "$iface" "coalesce adaptive-rx" "$_cur"
X            ethtool -C "$iface" adaptive-rx "$val" || err "gagal set adaptive-rx $val di $iface"
X            _live=$(ethtool -c "$iface" 2>/dev/null | awk '/^Adaptive RX:/{print $3}')
X            [ "$_live" = "$val" ] || err "adaptive-rx $iface tidak berubah menjadi $val (live: ${_live:-?} — driver mengabaikan setelan; tidak dicatat)"
X            ;;
X        *) err "jenis coalesce tidak dikenal: $kind (rx-usecs adaptive-rx)" ;;
X    esac
X    tune_set "$iface" "coalesce $kind $val"
X    sync "$iface"
X}
Xcoalesce_del() {
X    # $1=iface $2=kind -> kembalikan nilai sebelum-set pertama;
X    # bila tak tercatat, pakai default (rx-usecs 0, adaptive-rx off)
X    local iface=$1 kind=$2 def
X    [ "$OS" = "FreeBSD" ] && err "coalesce tidak punya padanan generik di FreeBSD"
X    iface_exists "$iface" || err "interface $iface tidak ditemukan di sistem (lihat 'show interfaces' untuk daftar)"
X    if command -v ethtool >/dev/null 2>&1; then
X        case "$kind" in
X            rx-usecs)
X                def=$(tune_prev_get "$iface" "coalesce rx-usecs"); [ -n "$def" ] || def=0
X                ethtool -C "$iface" rx-usecs "$def" 2>/dev/null || warn "gagal kembalikan rx-usecs live ke $def di $iface (cermin tetap dibersihkan)" ;;
X            adaptive-rx)
X                def=$(tune_prev_get "$iface" "coalesce adaptive-rx"); [ -n "$def" ] || def=off
X                ethtool -C "$iface" adaptive-rx "$def" 2>/dev/null || warn "gagal kembalikan adaptive-rx live ke $def di $iface (cermin tetap dibersihkan)" ;;
X            *) err "jenis coalesce tidak dikenal: $kind" ;;
X        esac
X    fi
X    tune_del "$iface" "coalesce $kind"
X    tune_prev_del "$iface" "coalesce $kind"
X    sync "$iface"
X}
X
X# --- speed (Linux saja; gerbang LACP 802.3ad di atas virtio) ---
X# Driver bonding 802.3ad wajib speed/duplex non-nol untuk kalkulasi
X# LACP port key; virtio_net default melaporkan Unknown sehingga slave
X# MII down dan tidak ada LACPDU yang dikirim (log: failed to get link
X# speed/duplex). ethtool -s adalah kondisi perlu DAN cukup di lab ini
X# (terbukti A/B reboot, gali LACP 1 Nov 2026): nilai arbitrer untuk
X# link virtual, tapi harus sama di semua slave satu bond.
X# State: satu baris "speed <nilai> duplex <full|half>" di .tuning
X# (persistensi = replay startup-config + apply-all, sama seperti
X# offload/coalesce yang tidak punya padanan networkd).
Xspeed_ok() {
X    case "$1" in 10|100|1000|2500|5000|10000|25000|40000|50000|100000) return 0 ;; *) return 1 ;; esac
X}
Xlive_speed_duplex() {
X    # $1=iface -> "Speed/Duplex" live, mis "1000/Full" atau "Unknown/Unknown"
X    local sp dp
X    sp=$(ethtool "$1" 2>/dev/null | awk -F': ' '/^[[:space:]]*Speed:/{print $2; exit}')
X    dp=$(ethtool "$1" 2>/dev/null | awk -F': ' '/^[[:space:]]*Duplex:/{print $2; exit}')
X    case "$sp" in *'Mb/s') sp=${sp%Mb/s} ;; *) sp="Unknown" ;; esac
X    case "$dp" in Full|full) dp="Full" ;; Half|half) dp="Half" ;; *) dp="Unknown" ;; esac
X    echo "$sp/$dp"
X}
Xspeed_set() {
X    # $1=iface $2=speed $3=duplex (kosong -> full)
X    local iface=$1 sp=$2 dp=${3:-full} want cur live
X    [ "$OS" = "FreeBSD" ] && err "speed tidak punya padanan di FreeBSD (lagg FreeBSD tidak butuh speed-set untuk merespons LACP)"
X    iface_exists "$iface" || err "interface $iface tidak ditemukan di sistem (lihat 'show interfaces' untuk daftar)"
X    speed_ok "$sp" || err "speed harus salah satu dari 10 100 1000 2500 5000 10000 25000 40000 50000 100000 (Mb/s): $sp"
X    case "$dp" in full|Full) dp=full ;; half|Half) dp=half ;; *) err "duplex harus full|half: $dp" ;; esac
X    command -v ethtool >/dev/null 2>&1 || err "ethtool tidak ditemukan di host ini"
X    if [ "$dp" = "full" ]; then want="$sp/Full"; else want="$sp/Half"; fi
X    cur=$(live_speed_duplex "$iface")
X    [ "$cur" != "$want" ] && tune_prev_set "$iface" "speed" "$cur"
X    ethtool -s "$iface" speed "$sp" duplex "$dp" || err "gagal set speed $sp duplex $dp di $iface (driver menolak — tidak dicatat)"
X    live=$(live_speed_duplex "$iface")
X    [ "$live" = "$want" ] || err "speed $iface tidak berubah menjadi $want (live: $live — driver mengabaikan setelan; tidak dicatat)"
X    tune_set "$iface" "speed $sp duplex $dp"
X    sync "$iface"
X}
Xspeed_del() {
X    # $1=iface: hapus catatan speed; live hanya bisa dikembalikan bila
X    # nilai sebelum-set pertama tercatat DAN bukan Unknown (driver
X    # tidak punya operasi unset — nilai live bertahan sampai reboot).
X    local iface=$1 prev psp pdp
X    [ "$OS" = "FreeBSD" ] && err "speed tidak punya padanan di FreeBSD"
X    iface_exists "$iface" || err "interface $iface tidak ditemukan di sistem (lihat 'show interfaces' untuk daftar)"
X    prev=$(tune_prev_get "$iface" "speed")
X    if [ -n "$prev" ] && [ "$prev" != "Unknown/Unknown" ]; then
X        psp=${prev%%/*}; pdp=${prev##*/}
X        case "$pdp" in
X            Full) pdp=full ;;
X            Half) pdp=half ;;
X            *) pdp="" ;;
X        esac
X        if [ -n "$pdp" ] && command -v ethtool >/dev/null 2>&1; then
X            ethtool -s "$iface" speed "$psp" duplex "$pdp" 2>/dev/null || warn "gagal kembalikan speed live ke $prev di $iface (cermin tetap dibersihkan)"
X        fi
X    else
X        warn "tidak ada nilai speed sebelum-set yang bisa dikembalikan (driver tidak punya operasi unset): nilai live bertahan sampai reboot, cermin sudah bersih sehingga boot berikutnya memakai default driver"
X    fi
X    tune_del "$iface" "speed"
X    tune_prev_del "$iface" "speed"
X    sync "$iface"
X}
Xspeed_set_quiet() {
X    # seperti speed_set tapi tanpa tulis state/sync (dipakai apply)
X    [ "$OS" = "FreeBSD" ] && return 0
X    command -v ethtool >/dev/null 2>&1 || return 0
X    ethtool -s "$1" speed "$2" duplex "$3" 2>/dev/null || true
X}
X
X# --- apply ulang (jaring pengaman boot; idempotent) ---
Xapply_iface() {
X    # $1=iface: terapkan semua baris .tuning live (tanpa tulis ulang state)
X    local iface=$1 f line a b c
X    f="$STATE_DIR/$iface.tuning"
X    [ -f "$f" ] || return 0
X    iface_exists "$iface" || return 0
X    while IFS= read -r line; do
X        [ -n "$line" ] || continue
X        set -- $line; a=${1:-}; b=${2:-}; c=${3:-}
X        case "$a" in
X            mtu) if [ "$OS" = "FreeBSD" ]; then ifconfig "$iface" mtu "$b" 2>/dev/null || true; else ip link set dev "$iface" mtu "$b" 2>/dev/null || true; fi ;;
X            qlen) [ "$OS" != "FreeBSD" ] && ip link set dev "$iface" txqueuelen "$b" 2>/dev/null || true ;;
X            offload) offload_set_quiet "$iface" "$b" "$c" ;;
X            coalesce) coalesce_set_quiet "$iface" "$b" "$c" ;;
X            speed) speed_set_quiet "$iface" "$b" "${d:-full}" ;;
X        esac
X    done < "$f"
X}
Xoffload_set_quiet() {
X    # seperti offload_set tapi tanpa tulis state/sync (dipakai apply)
X    local iface=$1 feat=$2 val=$3 flag
X    if [ "$OS" = "FreeBSD" ]; then
X        case "$feat" in
X            tso) flag=tso ;; lro) flag=lro ;;
X            rx)  flag=rxcsum ;; tx) flag=txcsum ;; *) return 0 ;;
X        esac
X        [ "$val" = "off" ] && flag="-$flag"
X        ifconfig "$iface" "$flag" 2>/dev/null || true
X    else
X        command -v ethtool >/dev/null 2>&1 || return 0
X        ethtool -K "$iface" "$feat" "$val" 2>/dev/null || true
X    fi
X}
Xcoalesce_set_quiet() {
X    local iface=$1 kind=$2 val=$3
X    [ "$OS" = "FreeBSD" ] && return 0
X    command -v ethtool >/dev/null 2>&1 || return 0
X    case "$kind" in
X        rx-usecs) ethtool -C "$iface" rx-usecs "$val" 2>/dev/null || true ;;
X        adaptive-rx) ethtool -C "$iface" adaptive-rx "$val" 2>/dev/null || true ;;
X    esac
X}
Xapply_all() {
X    local m iface
X    for m in "$STATE_DIR"/*.tuning; do
X        [ -e "$m" ] || continue
X        iface=$(basename "$m" .tuning)
X        apply_iface "$iface"
X    done
X}
X
X# --- show tuning (dipakai `show interfaces tuning <iface>`) ---
Xshow_iface() {
X    local iface=$1
X    iface_exists "$iface" || err "interface $iface tidak ditemukan di sistem (lihat 'show interfaces' untuk daftar)"
X    echo "Tuning $iface ($OS) — nilai live + arti singkat"
X    echo "  (nilai bertanda * = pernah di-set lewat Titian / tercatat di cermin)"
X    if [ "$OS" = "FreeBSD" ]; then
X        _show_fbsd "$iface"
X    else
X        _show_linux "$iface"
X    fi
X}
X_mark() {
X    # $1=iface $2=prefix -> "*" bila tercatat, "" bila tidak
X    [ -n "$(tune_get "$1" "$2")" ] && echo "*" || echo ""
X}
X_show_linux() {
X    local iface=$1 m mtu q
X    m=$(_mark "$iface" "mtu")
X    mtu=$(cat "/sys/class/net/$iface/mtu" 2>/dev/null || echo "?")
X    echo "  mtu${m}: $mtu — ukuran paket terbesar yang boleh lewat interface; 1500 = default Ethernet, 9000 = jumbo (wajib didukung seluruh path, kalau tidak paket di-drop/difragmentasi)."
X    q=$(cat "/sys/class/net/$iface/tx_queue_len" 2>/dev/null || echo "?")
X    m=$(_mark "$iface" "qlen")
X    echo "  txqueuelen${m}: $q — panjang antrean kirim; antrean besar menahan burst tapi menambah latensi antre (bufferbloat). Default 1000 (1G), 10000 (10G)."
X    if command -v ethtool >/dev/null 2>&1; then
X        _sp=$(ethtool "$iface" 2>/dev/null | awk -F': ' '/^[[:space:]]*Speed:/{print $2; exit}')
X        _dp=$(ethtool "$iface" 2>/dev/null | awk -F': ' '/^[[:space:]]*Duplex:/{print $2; exit}')
X        [ -n "$_sp" ] || _sp="(tidak dilaporkan driver)"
X        [ -n "$_dp" ] || _dp="(tidak dilaporkan driver)"
X        echo "  speed$(_mark "$iface" "speed"): $_sp / $_dp — kecepatan + duplex yang dilaporkan driver; WAJIB non-nol + full untuk bonding 802.3ad (tanpa ini slave MII down dan tidak ada LACPDU yang dikirim). Nilai arbitrer untuk link virtual, tapi harus sama di semua slave satu bond."
X    else
X        echo "  speed: ethtool tidak tersedia di host ini (tidak bisa dibaca)."
X    fi
X    if command -v ethtool >/dev/null 2>&1; then
X        ethtool -k "$iface" 2>/dev/null | awk '/^[a-z0-9-]+:/{print}' | while read -r line; do
X            feat=${line%%:*}; rest=${line#*:}
X            case "$feat" in
X                tcp-segmentation-offload|generic-segmentation-offload|generic-receive-offload|large-receive-offload|rx-checksumming|tx-checksumming|scatter-gather)
X                    case "$feat" in
X                        tcp-segmentation-offload) short=tso; meaning="NIC memotong segmen TCP besar jadi paket MTU; hemat CPU untuk trafik lokal, tidak memengaruhi paket yang di-forward." ;;
X                        generic-segmentation-offload) short=gso; meaning="Versi software dari TSO di kernel; hemat CPU untuk trafik lokal." ;;
X                        generic-receive-offload) short=gro; meaning="Kernel menggabung paket-paket receive searah jadi satu segmen besar; hemat CPU receive. Aman untuk router (beda dengan LRO hardware)." ;;
X                        large-receive-offload) short=lro; meaning="Hardware menggabung paket receive; HARUS off di router/bridge karena bisa merusak semantik forwarding." ;;
X                        rx-checksumming) short=rx; meaning="NIC menghitung checksum paket masuk; hemat CPU, hampir selalu on." ;;
X                        tx-checksumming) short=tx; meaning="NIC menghitung checksum paket keluar; hemat CPU, hampir selalu on." ;;
X                        scatter-gather) short=sg; meaning="NIC mengirim dari banyak buffer memori sekaligus; prasyarat TSO/GSO, hampir selalu on." ;;
X                    esac
X                    m=$(_mark "$iface" "offload $short")
X                    echo "  $short${m}: $(echo "$rest" | awk '{print $1}') — $meaning"
X                    ;;
X            esac
X        done
X        _c=$(ethtool -c "$iface" 2>/dev/null)
X        _rxu=$(echo "$_c" | awk '/^RX-usecs:/{print $2}'); [ -n "$_rxu" ] || _rxu="(tidak dilaporkan driver)"
X        _arx=$(echo "$_c" | awk '/^Adaptive RX:/{print $3}'); [ -n "$_arx" ] || _arx="(tidak dilaporkan driver)"
X        echo "  rx-usecs$(_mark "$iface" "coalesce rx-usecs"): $_rxu — jeda tunda interupsi receive (mikrodetik); nilai besar = interupsi lebih jarang (hemat CPU, latensi naik), 0 = interupsi segera. Default driver, umum 125."
X        echo "  adaptive-rx$(_mark "$iface" "coalesce adaptive-rx"): $_arx — driver menyesuaikan rx-usecs otomatis ikut beban; on untuk beban campuran, off bila latensi harus deterministik. Default off."
X    else
X        echo "  offload/coalesce: ethtool tidak tersedia di host ini (tidak bisa dibaca)."
X    fi
X}
X_show_fbsd() {
X    local iface=$1 out
X    out=$(ifconfig "$iface" 2>/dev/null)
X    echo "  mtu$(_mark "$iface" "mtu"): $(echo "$out" | awk '{for(i=1;i<=NF;i++) if ($i == "mtu") {print $(i+1); exit}}') — ukuran paket terbesar; 1500 = default, 9000 = jumbo (wajib didukung seluruh path)."
X    echo "  qlen: (tidak ada padanan FreeBSD — txqueuelen adalah konsep Linux.)"
X    echo "  flags ifconfig: options=<$(fbsd_opt_tokens "$iface")>"
X    if fbsd_opt_has "$iface" TSO4 || fbsd_opt_has "$iface" TSO6; then _tso=on; else _tso=off; fi
X    if fbsd_opt_has "$iface" LRO; then _lro=on; else _lro=off; fi
X    if fbsd_opt_has "$iface" RXCSUM; then _rx=on; else _rx=off; fi
X    if fbsd_opt_has "$iface" TXCSUM; then _tx=on; else _tx=off; fi
X    echo "    tso$(_mark "$iface" "offload tso"): $_tso (flag TSO4/TSO6) — NIC memotong segmen TCP; hemat CPU trafik lokal."
X    echo "    lro$(_mark "$iface" "offload lro"): $_lro — HARUS off di router/bridge (bisa merusak forwarding); pakai GRO tidak tersedia di FreeBSD, jadi biarkan off."
X    echo "    rxcsum$(_mark "$iface" "offload rx"): $_rx — checksum receive oleh NIC; hampir selalu on."
X    echo "    txcsum$(_mark "$iface" "offload tx"): $_tx — checksum transmit oleh NIC; hampir selalu on."
X    echo "    gro/gso/sg: tidak punya padanan ifconfig di FreeBSD."
X    echo "  coalesce: tidak punya padanan generik di FreeBSD."
X}
X
Xcase "${1:-}" in
X    mtu) mtu_set "$2" "$3" ;;
X    mtu-del) mtu_del "$2" ;;
X    qlen) qlen_set "$2" "$3" ;;
X    qlen-del) qlen_del "$2" ;;
X    offload) offload_set "$2" "$3" "$4" ;;
X    offload-del) offload_del "$2" "$3" ;;
X    coalesce) coalesce_set "$2" "$3" "$4" ;;
X    coalesce-del) coalesce_del "$2" "$3" ;;
X    speed) speed_set "$2" "$3" "${4:-}" ;;
X    speed-del) speed_del "$2" ;;
X    apply) apply_iface "$2" ;;
X    apply-all) apply_all ;;
X    show) show_iface "$2" ;;
X    *) echo "Usage: $0 {mtu|mtu-del|qlen|qlen-del|offload|offload-del|coalesce|coalesce-del|speed|speed-del|apply|apply-all|show} ..." >&2; exit 2 ;;
Xesac
