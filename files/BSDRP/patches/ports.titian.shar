X              help="Add member interface to lagg group">
X        <PARAM name="member"
X              help="Member interface"
X              completion="${Get_if_eth}"
X              ptype="IFACE_SYS"/>
X        <!-- recorded: replay must re-attach members after reboot (was CONFIG-empty: lagg came back with no members) -->
X        <CONFIG pattern="^${__line}$"/>
X        <ACTION>
X            if ! ifconfig "${member}" >/dev/null 2>&amp;1; then
X                printf "%s \n" "Error: interface ${member} tidak ditemukan di sistem (lihat 'show interfaces' untuk daftar)."
