sed 's/^X//' >net/titian/files/sbin/titian-if.sh << '229879aae358df49eb134deb8a7c95f3'
X#!/bin/sh
X# TITIAN Fase 1 — operasi address interface (dipakai perintah
X# `ip address` / `ipv6 address` di semua if-view, Linux + FreeBSD).
X# Aturan pengalamatan (wajib, diuji di kedua VM):
X#  - /31 (RFC 3021): kedua alamat host valid, tidak ada network/
X#    broadcast terbuang. Linux: JANGAN pakai `brd +` untuk /31
X#    (dan /32); FreeBSD: ifconfig menerima /31 apa adanya.
X#  - PtP custom gaya MikroTik/PPP: local + peer sembarang, contoh
X#    103.50.128.1 peer 10.10.10.10 (1 IP publik per link).
X#    Linux: ip addr add <local> peer <peer> dev <iface>
X#    FreeBSD: /32 lokal + host route ke peer (destination-address ifconfig
X#    DIABAIKAN diam-diam di interface Ethernet broadcast — terbukti 28 Okt:
X#    ifconfig hanya menempel broadcast, tanpa route ke peer).
X#    Linux: ip addr add <local> peer <peer> dev <iface>
X#  - Validasi: PTYPE tree hanya filter lapis pertama; helper ini
X#    memvalidasi CIDR (v4 ketat, v6 ringan) lalu tool OS menjadi
X#    gate ketat terakhir — input tidak valid gagal bersih (exit != 0),
X#    tidak pernah tersimpan setengah jalan.
X# POSIX sh (jalan di dash Debian dan sh FreeBSD).
Xset -u
XOS=$(uname -s)
X
Xerr() { echo "Error: $*" >&2; exit 33; }
X
X# split_cidr <cidr> -> ADDR, PREFIX (PREFIX kosong bila tanpa /)
Xsplit_cidr() {
X    case "$1" in
X        */*) ADDR=${1%/*}; PREFIX=${1#*/} ;;
X        *)   ADDR=$1; PREFIX="" ;;
X    esac
X}
X
Xvalid_v4() {
X    # $1 = dotted quad; return 0 bila valid
X    local a rest o
X    rest=$1
X    for i in 1 2 3 4; do
X        case "$rest" in
X            *.*) o=${rest%%.*}; rest=${rest#*.} ;;
X            *)   o=$rest; rest="" ;;
X        esac
X        case "$o" in
X            ''|*[!0-9]*) return 1 ;;
X        esac
X        # tolak oktet kosong / leading zero berlebih? izinkan 0-255
X        if [ "$o" -gt 255 ] 2>/dev/null; then return 1; fi
X        # pastikan tidak ada sisa setelah oktet ke-4
X        if [ "$i" -eq 4 ] && [ -n "$rest" ]; then return 1; fi
X    done
X    # pastikan tepat 4 oktet (tidak kurang)
X    case "$1" in
X        *.*.*.*) return 0 ;;
X        *) return 1 ;;
X    esac
X}
X
Xvalid_prefix_v4() {
X    case "$1" in
X        ''|*[!0-9]*) return 1 ;;
X    esac
X    [ "$1" -ge 0 ] 2>/dev/null && [ "$1" -le 32 ] 2>/dev/null
X}
X
Xvalid_v6() {
X    # ringan: hanya heksadesimal/titik-dua (+ titik untuk embedded v4)
X    case "$1" in
X        *:*)
X            case "$1" in
X                *[!0-9a-fA-F:.*]*) return 1 ;;
X                *) return 0 ;;
X            esac
X            ;;
X        *) return 1 ;;
X    esac
X}
X
Xvalid_prefix_v6() {
X    case "$1" in
X        ''|*[!0-9]*) return 1 ;;
X    esac
X    [ "$1" -ge 0 ] 2>/dev/null && [ "$1" -le 128 ] 2>/dev/null
X}
X
X# --- state persisten (sumber regenerasi .network/rc.conf) ---
XSTATE_DIR=${TITIAN_STATE_DIR:-/opt/titian/etc/netstate}
Xstate_add() {
X    # $1=iface $2=line ("inet <cidr>" | "inet <local> peer <peer>" | "inet6 <cidr>")
X    mkdir -p "$STATE_DIR" 2>/dev/null || return 0
X    f="$STATE_DIR/$1.addr"
X    touch "$f" 2>/dev/null || return 0
X    grep -qxF "$2" "$f" 2>/dev/null || echo "$2" >> "$f"
X}
Xstate_del() {
X    # $1=iface $2=line-prefix-match (hapus baris yang diawali prefix ini)
X    f="$STATE_DIR/$1.addr"
X    [ -f "$f" ] || return 0
X    esc=$(printf '%s' "$2" | sed 's/[.[\*^$]/\\&/g')
X    grep -v "^$esc" "$f" > "$f.tmp" 2>/dev/null; mv "$f.tmp" "$f" 2>/dev/null || true
X}
X
X# --- v4 ---
Xaddr_add() {
X    # $1=iface $2=cidr $3=peer (boleh kosong)
X    local iface=$1 cidr=$2 peer=$3
X    split_cidr "$cidr"
X    valid_v4 "$ADDR" || err "alamat IPv4 tidak valid: $cidr"
X    if [ -n "$PREFIX" ]; then
X        valid_prefix_v4 "$PREFIX" || err "prefix IPv4 tidak valid: $cidr"
X    else
X        PREFIX=32
X    fi
X    if [ -n "$peer" ]; then
X        valid_v4 "$peer" || err "peer IPv4 tidak valid: $peer"
X        if [ "$OS" = "FreeBSD" ]; then
X            ifconfig "$iface" inet "$ADDR" -alias >/dev/null 2>&1
X            ifconfig "$iface" inet "$ADDR" netmask 255.255.255.255 alias 2>/dev/null || \
X                ifconfig "$iface" inet "$ADDR" netmask 255.255.255.255 alias || err "gagal set PtP $ADDR peer $peer di $iface"
X            # route get TIDAK bisa jadi guard: ia fallback ke default route (exit 0)
X            # meski host route belum ada. Hapus dulu (idempotent) lalu tambah.
X            route delete -host "$peer" >/dev/null 2>&1 || true
X            route add -host "$peer" -iface "$iface" >/dev/null 2>&1 || err "gagal tambah route peer $peer di $iface"
X        else
X            ip addr replace "$ADDR" peer "$peer" dev "$iface" || err "gagal set PtP $ADDR peer $peer di $iface"
X        fi
X        state_add "$iface" "inet $ADDR peer $peer"
X        return 0
X    fi
X    if [ "$OS" = "FreeBSD" ]; then
X        ifconfig "$iface" inet "$ADDR/$PREFIX" -alias >/dev/null 2>&1
X        ifconfig "$iface" inet "$ADDR/$PREFIX" alias || err "gagal set $cidr di $iface"
X    else
X        if [ "$PREFIX" -eq 31 ] || [ "$PREFIX" -eq 32 ]; then
X            # RFC 3021: /31 tanpa broadcast; /32 juga tanpa brd
X            ip addr replace "$ADDR/$PREFIX" dev "$iface" || err "gagal set $cidr di $iface"
X        else
X            ip addr replace "$ADDR/$PREFIX" brd + dev "$iface" || err "gagal set $cidr di $iface"
X        fi
X    fi
X    state_add "$iface" "inet $ADDR/$PREFIX"
X}
X
Xaddr_set() {
X    # seperti addr-add tapi menggantikan semua alamat v4 iface (semantik lo rtcli)
X    local iface=$1 cidr=$2 peer=$3
X    if [ "$OS" = "FreeBSD" ]; then
X        # hapus semua inet (bukan inet6) yang ada di iface
X        ifconfig "$iface" 2>/dev/null | awk '/^[[:space:]]*inet /{print $2}' | while read -r a; do
X            ifconfig "$iface" inet "$a" -alias >/dev/null 2>&1
X        done
X    else
X        ip -4 addr flush dev "$iface" 2>/dev/null
X    fi
X    addr_add "$iface" "$cidr" "$peer"
X}
X
Xaddr_del() {
X    # $1=iface $2=cidr $3=peer (boleh kosong)
X    local iface=$1 cidr=$2 peer=$3
X    split_cidr "$cidr"
X    valid_v4 "$ADDR" || err "alamat IPv4 tidak valid: $cidr"
X    if [ -n "$peer" ]; then
X        valid_v4 "$peer" || err "peer IPv4 tidak valid: $peer"
X        if [ "$OS" = "FreeBSD" ]; then
X            # hapus /32 + host route (idempotent: absen = sukses)
X            ifconfig "$iface" inet "$ADDR" -alias >/dev/null 2>&1 || true
X            route delete -host "$peer" >/dev/null 2>&1 || true
X        else
X            ip addr del "$ADDR" peer "$peer" dev "$iface" 2>/dev/null || \
X                ip addr del "$ADDR" dev "$iface" || err "gagal hapus PtP $ADDR peer $peer di $iface"
X        fi
X        state_del "$iface" "inet $ADDR peer $peer"
X        return 0
X    fi
X    if [ "$OS" = "FreeBSD" ]; then
X        ifconfig "$iface" inet "$ADDR" -alias || err "gagal hapus $cidr di $iface"
X    else
X        if [ -n "$PREFIX" ]; then
X            ip addr del "$ADDR/$PREFIX" dev "$iface" || err "gagal hapus $cidr di $iface"
X        else
X            ip addr del "$ADDR" dev "$iface" || err "gagal hapus $cidr di $iface"
X        fi
X    fi
X    state_del "$iface" "inet $ADDR/"
X}
X
X# --- v6 ---
Xaddr6_add() {
X    # $1=iface $2=cidr $3=peer (peer v6 hanya Linux; FreeBSD gated di XML)
X    local iface=$1 cidr=$2 peer=$3
X    split_cidr "$cidr"
X    valid_v6 "$ADDR" || err "alamat IPv6 tidak valid: $cidr"
X    if [ -n "$PREFIX" ]; then
X        valid_prefix_v6 "$PREFIX" || err "prefix IPv6 tidak valid: $cidr"
X    else
X        PREFIX=128
X    fi
X    if [ -n "$peer" ]; then
X        if [ "$OS" = "FreeBSD" ]; then
X            err "peer IPv6 belum didukung di FreeBSD (gated)"
X        fi
X        valid_v6 "$peer" || err "peer IPv6 tidak valid: $peer"
X        ip -6 addr replace "$ADDR" peer "$peer" dev "$iface" || err "gagal set PtP v6 $ADDR peer $peer di $iface"
X        state_add "$iface" "inet6 $ADDR peer $peer"
X        return 0
X    fi
X    if [ "$OS" = "FreeBSD" ]; then
X        ifconfig "$iface" inet6 "$ADDR/$PREFIX" -alias >/dev/null 2>&1
X        ifconfig "$iface" inet6 "$ADDR/$PREFIX" alias || err "gagal set $cidr di $iface"
X    else
X        ip -6 addr replace "$ADDR/$PREFIX" dev "$iface" || err "gagal set $cidr di $iface"
X    fi
X    state_add "$iface" "inet6 $ADDR/$PREFIX"
X}
X
Xaddr6_del() {
X    # $1=iface $2=cidr $3=peer (boleh kosong)
X    local iface=$1 cidr=$2 peer=$3
X    split_cidr "$cidr"
X    valid_v6 "$ADDR" || err "alamat IPv6 tidak valid: $cidr"
X    if [ -n "$peer" ]; then
X        if [ "$OS" = "FreeBSD" ]; then
X            err "peer IPv6 belum didukung di FreeBSD (gated)"
X        fi
X        ip -6 addr del "$ADDR" peer "$peer" dev "$iface" 2>/dev/null || \
X            ip -6 addr del "$ADDR" dev "$iface" || err "gagal hapus PtP v6 $ADDR peer $peer di $iface"
X        state_del "$iface" "inet6 $ADDR peer $peer"
X        return 0
X    fi
X    if [ "$OS" = "FreeBSD" ]; then
X        ifconfig "$iface" inet6 "$ADDR" -alias || err "gagal hapus $cidr di $iface"
X    else
X        if [ -n "$PREFIX" ]; then
X            ip -6 addr del "$ADDR/$PREFIX" dev "$iface" || err "gagal hapus $cidr di $iface"
X        else
X            ip -6 addr del "$ADDR" dev "$iface" || err "gagal hapus $cidr di $iface"
X        fi
X    fi
X    state_del "$iface" "inet6 $ADDR/"
X}
X
Xcase "${1:-}" in
X    addr-add)  addr_add "$2" "$3" "${4:-}" ;;
X    addr-set)  addr_set "$2" "$3" "${4:-}" ;;
X    addr-del)  addr_del "$2" "$3" "${4:-}" ;;
X    addr6-add) addr6_add "$2" "$3" "${4:-}" ;;
X    addr6-del) addr6_del "$2" "$3" "${4:-}" ;;
X    *) echo "Usage: $0 {addr-add|addr-set|addr-del|addr6-add|addr6-del} <iface> <cidr> [peer]" >&2; exit 2 ;;
Xesac
