X#!/bin/sh
X# TITIAN CLI wrapper (root -> tree clish-en, non-root -> tree clish).
XROOT=%%PREFIX%%
XBIN=%%PREFIX%%/bin
Xif [ ! -x "$BIN/clish" ]; then BIN=%%LOCALBASE%%/bin; fi
Xexport LD_LIBRARY_PATH=$ROOT/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}
Xexport PATH=/sbin:/usr/sbin:/bin:/usr/bin:/usr/local/sbin:/usr/local/bin:$BIN
Xif [ "$(id -u)" = "0" ]; then
X    exec "$BIN/clish" -l -x "$ROOT/etc/clish-en" "$@"
Xelse
X    cd /tmp 2>/dev/null || true
X    exec "$BIN/clish" -l -x "$ROOT/etc/clish" "$@"
Xfi
