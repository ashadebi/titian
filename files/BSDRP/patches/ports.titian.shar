echo x - net/titian/files/tree/en-checkpoint.xml
sed 's/^X//' >net/titian/files/tree/en-checkpoint.xml << '845d1ac655545c7526256520aa7828af'
X<?xml version="1.0" encoding="UTF-8"?>
X<CLISH_MODULE xmlns="http://clish.sourceforge.net/XMLSchema"
X          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
X xsi:schemaLocation="http://clish.sourceforge.net/XMLSchema
X                     http://clish.sourceforge.net/XMLSchema/clish.xsd">
X<!--=======================================================
XTITIAN — checkpoint + rollback (view exec, bukan configure view,
Xkarena ini operasi, bukan konfigurasi — mengikuti pola save).
X
XCheckpoint = TITIK SIMPAN BERNAMA dari konfigurasi. User membuat
Xbeberapa titik, melihat daftarnya, lalu memilih mau balik ke titik
Xyang mana. Bukan "undo satu langkah".
X
XSEMANTIK ROLLBACK (baca sebelum pakai):
X  rollback MENGEMBALIKAN running-config + bird.conf + bird.d +
X  netstate + sysctl ke isi titik, MENULIS JUGA startup-config
X  (jadi rollback BERSIFAT PERSISTEN, bertahan melewati reboot —
X  bukan sekadar live), lalu restart service titian (konfd baru +
X  replay + apply-all tuning + apply-bond + apply-vxlan) + birdc
X  configure untuk bird.conf.
X  Sebelum restart, rollback membersihkan (prune) objek live yang
X  tidak ada di titik (interface buatan yang mengendap, alamat
X  ekstra, kunci tuning ekstra, sysctl ekstra, route statik ekstra).
X  Titik BEKU: `save` biasa tidak mengubah titik yang sudah dibuat.
X  Nama titik: [A-Za-z0-9][A-Za-z0-9_-]* (mengikuti pola nama
X  community list). Nama sudah ada = DITOLAK lantang, tidak ditimpa
X  diam-diam. Nama tidak ada saat rollback/delete = GAGAL lantang
X  TANPA mengubah apa pun.
X=======================================================-->
X
X<VIEW name="enable-view">
X
X    <!-- Induk telanjang (wajib klish: keluarga perintah multi-kata
X         butuh prefix ini agar checkpoint save/list/delete ter-resolve,
X         mengikuti pola community/show/generate di tree lain) -->
X    <COMMAND name="checkpoint"
X             help="Checkpoint management (titik simpan bernama)"/>
X
X    <COMMAND name="checkpoint save"
X             help="Simpan running-config saat ini sebagai titik bernama (beku; save biasa tidak mengubahnya)">
X        <PARAM name="name"
X               help="Nama titik [A-Za-z0-9_-]+"
X               ptype="CHECKPOINT_NAME"/>
X        <ACTION>${RT_SBIN}/titian-checkpoint.sh save "${name}"</ACTION>
X    </COMMAND>
X
X    <COMMAND name="checkpoint list"
X             help="Daftar titik checkpoint (nama + waktu dibuat WIB; * = sama dengan running-config saat ini)">
X        <ACTION>${RT_SBIN}/titian-checkpoint.sh list</ACTION>
X    </COMMAND>
X
X    <COMMAND name="checkpoint delete"
X             help="Hapus satu titik checkpoint">
X        <PARAM name="name"
X               help="Nama titik [A-Za-z0-9_-]+"
X               ptype="CHECKPOINT_NAME"/>
X        <ACTION>${RT_SBIN}/titian-checkpoint.sh delete "${name}"</ACTION>
X    </COMMAND>
X
X    <COMMAND name="show checkpoints"
X             help="Daftar titik checkpoint (sama dengan checkpoint list)">
X        <ACTION>${RT_SBIN}/titian-checkpoint.sh list</ACTION>
X    </COMMAND>
X
X    <COMMAND name="rollback"
X             help="Kembali ke titik checkpoint bernama; tanpa nama = kembali ke startup-config (buang perubahan running yang belum di-save). PERSISTEN: running-config + bird.conf + bird.d + netstate + sysctl dikembalikan ke isi titik, startup-config ditulis dari titik + restart service + birdc configure, bertahan melewati reboot">
X        <PARAM name="name"
X               help="Nama titik [A-Za-z0-9_-]+ (kosong = startup-config)"
X               ptype="CHECKPOINT_NAME"
X               optional="true"/>
X        <ACTION>${RT_SBIN}/titian-checkpoint.sh rollback "${name}"</ACTION>
X    </COMMAND>
X
X</VIEW>
X</CLISH_MODULE>
845d1ac655545c7526256520aa7828af
echo x - net/titian/files/tree/en-rename.xml
sed 's/^X//' >net/titian/files/tree/en-rename.xml << '4751490327a33b57bc2c5d03b570b5d6'
X<?xml version="1.0" encoding="UTF-8"?>
X<CLISH_MODULE xmlns="http://clish.sourceforge.net/XMLSchema"
X          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
X xsi:schemaLocation="http://clish.sourceforge.net/XMLSchema
X                     http://clish.sourceforge.net/XMLSchema/clish.xsd">
X<!--=======================================================
XTITIAN — rename interface sistem (view exec, bukan configure view,
Xkarena ini operasi, bukan konfigurasi — mengikuti pola save /
Xcheckpoint / rollback).
X
X`rename <lama> <baru>` mengganti nama interface sistem di OS +
Xmemigrasikan seluruh state Titian yang keyed by name (netstate,
Xcermin networkd/rc.conf, section + referensi di startup-config),
Xlalu restart service (replay) — PERSISTEN seperti rollback:
Xstartup-config ditulis ulang + aturan boot ditulis (Linux: .link
Xberdasarkan MAC; FreeBSD: ifconfig_<asal>_name di rc.conf), jadi
Xrename bertahan melewati reboot untuk interface persisten (NIC
Xnyata, MAC stabil). Objek runtime (dummy/epair/vlan) hilang saat
Xreboot bersama objeknya — itu sifat objeknya, bukan rename.
X
XATURAN AMAN (lihat header titian-rename.sh untuk detail):
X  - lama harus ada di sistem; baru belum dipakai sistem;
X    baru lolos charset IFACE_SYS; lama != baru.
X  - DITOLAK: objek Titian (bond/vxlan/lagg/vlan), loopback
X    (lo/lo0/lo[N]), nama bertitik — hapus + buat ulang, bukan rename.
X  - DITOLAK bila startup-config tidak ada (jalankan `save` dulu).
X  - DIIZINKAN: interface UP beralamat (siklus down -> rename -> up;
X    alamat/route melekat ke ifindex, selamat), slave bond, member
X    lagg, parent vlan (referensi ditulis ulang; perangkat vlan Linux
X    TIDAK mengikuti rename parent — link-nya ifindex, bukan nama).
X  - JANGAN rename interface mgmt/produksi: perintah ini tidak tahu
X    interface mana yang mgmt; interupsi down/up sesaat + salah nama
X    bisa memutus akses remote. Itu tanggung jawab operator.
X  - Sesi CLI terputus saat restart (sama seperti rollback): sambung
X    lagi, verifikasi dengan `show interfaces` / `show running-config`.
X  - bird.conf tidak disentuh; checkpoint lama tidak ditulis ulang.
X=======================================================-->
X
X<VIEW name="enable-view">
X
X    <COMMAND name="rename"
X             help="Rename interface sistem + migrasi state Titian (PERSISTEN + restart service). Contoh: rename wan0 xxve9. JANGAN rename interface mgmt/produksi">
X        <PARAM name="old"
X               help="Nama interface sekarang (lihat 'show interfaces'; Tab/? untuk daftar)"
X               completion="${Get_if_eth}"
X               ptype="IFACE_SYS"/>
X        <PARAM name="new"
X               help="Nama baru (charset IFACE_SYS; belum dipakai sistem; bukan bond/vxlan/lagg/vlan/lo)"
X               ptype="IFACE_SYS"/>
X        <ACTION>${RT_SBIN}/titian-rename.sh "${old}" "${new}"</ACTION>
X    </COMMAND>
X
X</VIEW>
X</CLISH_MODULE>
4751490327a33b57bc2c5d03b570b5d6
