echo x - net/titian/files/sbin/titian-sys.sh
sed 's/^X//' >net/titian/files/sbin/titian-sys.sh << 'c54185f92322000bb91d7b656e4292c1'
X#!/bin/sh
X# TITIAN Fase 1 — perintah system/service/ssh/show-hw (cabang OS).
X# POSIX sh.
XOS=$(uname -s)
XBIN=${TITIAN_BIN:-/opt/titian/bin}
Xerr() { echo "Error: $*" >&2; exit 33; }
X
X# Portable in-place sed: BSD sed -i wajib arg backup, GNU sed tidak.
Xsys_sed_i() {
X    # $1=file $2=script
X    if [ "$OS" = "FreeBSD" ]; then
X        sed -i '' "$2" "$1"
X    else
X        sed -i "$2" "$1"
X    fi
X}
Xsys_sed_del_blank() {
X    # $1=file
X    if [ "$OS" = "FreeBSD" ]; then
X        sed -i '' '/^$/d' "$1"
X    else
X        sed -i '/^$/d' "$1"
X    fi
X}
X# Mode DNS stub: /etc/resolv.conf symlink + systemd-resolved aktif.
X# Di mode ini symlink stub TIDAK BOLEH dirusak (sed -i mengganti symlink
X# jadi file reguler); konfigurasi ditulis ke drop-in resolved.
Xdns_stub_mode() {
X    [ -L /etc/resolv.conf ] && [ "$OS" != "FreeBSD" ] && \
X        command -v systemctl >/dev/null 2>&1 && \
X        systemctl is-active --quiet systemd-resolved 2>/dev/null
X}
Xdns_dropin() { printf '%s' "/etc/systemd/resolved.conf.d/titian.conf"; }
Xdns_dropin_ensure() {
X    mkdir -p /etc/systemd/resolved.conf.d
X    if [ ! -f "$(dns_dropin)" ]; then
X        printf '[Resolve]\n' > "$(dns_dropin)"
X    elif ! grep -q '^\[Resolve\]' "$(dns_dropin)" 2>/dev/null; then
X        { printf '[Resolve]\n'; cat "$(dns_dropin)"; } > "$(dns_dropin).tmp" && \
X            mv "$(dns_dropin).tmp" "$(dns_dropin)"
X    fi
X}
Xdns_dropin_restart() {
X    systemctl restart systemd-resolved 2>/dev/null || true
X}
X
Xcase "${1:-}" in
X    hostname)
X        # $2 = nama baru
X        [ -n "${2:-}" ] || err "hostname kosong"
X        hostname "$2" || err "gagal set hostname"
X        if [ "$OS" = "FreeBSD" ]; then
X            if command -v sysrc >/dev/null 2>&1; then
X                sysrc hostname="$2" >/dev/null || true
X            else
X                grep -q '^hostname=' /etc/rc.conf 2>/dev/null && \
X                    sed -i '' "s|^hostname=.*|hostname=\"$2\"|" /etc/rc.conf || \
X                    echo "hostname=\"$2\"" >> /etc/rc.conf
X            fi
X        else
X            echo "$2" > /etc/hostname 2>/dev/null || true
X        fi
X        sed -i "s|^127\.0\.0\.1.*$|127.0.0.1 localhost $2|" /etc/hosts 2>/dev/null || true
X        ;;
X    timezone)
X        # $2 = Asia/Jakarta | Asia/Makassar | UTC (sesuai tree)
X        [ -n "${2:-}" ] || err "timezone kosong"
X        if [ ! -f "/usr/share/zoneinfo/$2" ]; then
X            err "timezone tidak dikenal: $2"
X        fi
X        ln -sf "/usr/share/zoneinfo/$2" /etc/localtime || err "gagal set localtime"
X        if [ "$OS" != "FreeBSD" ]; then
X            echo "$2" > /etc/timezone 2>/dev/null || true
X            if command -v systemctl >/dev/null 2>&1; then
X                systemctl restart rsyslog 2>/dev/null || true
X            fi
X        fi
X        ;;
X    ssh-check)
X        if [ ! -x /usr/sbin/sshd ]; then
X            err "[openssh-server] tidak ditemukan"
X        fi
X        if [ -f /etc/ssh/sshd_config ] && [ ! -f /etc/ssh/sshd_config-save-titian ]; then
X            cp -f /etc/ssh/sshd_config /etc/ssh/sshd_config-save-titian
X        fi
X        ;;
X    ssh-restart)
X        if [ "$OS" = "FreeBSD" ]; then
X            service sshd restart || err "gagal restart sshd"
X        else
X            if command -v systemctl >/dev/null 2>&1; then
X                # Reset rate-limit systemd (default StartLimitBurst=5/10s):
X                # rentetan perubahan ssh via CLI tidak boleh membuat sshd
X                # wedge dalam status start-limit-hit.
X                systemctl reset-failed ssh sshd 2>/dev/null || true
X                systemctl restart ssh 2>/dev/null || systemctl restart sshd 2>/dev/null || service ssh restart 2>/dev/null || err "gagal restart ssh"
X            else
X                service ssh restart 2>/dev/null || err "gagal restart ssh"
X            fi
X        fi
X        ;;
X    port-in-use)
X        # $2 = port; gagal (33) bila dipakai proses selain sshd
X        port=$2
X        if [ "$OS" = "FreeBSD" ]; then
X            if command -v sockstat >/dev/null 2>&1; then
X                other=$(sockstat -l 2>/dev/null | awk -v p=":$port" '$6 ~ p"$" && $1 != "root" {print} $6 ~ p"$" && $0 !~ /sshd/ {print}')
X                if [ -n "$other" ]; then
X                    echo "Port: $port already in Use.." >&2; exit 33
X                fi
X            fi
X        else
X            if command -v ss >/dev/null 2>&1; then
X                if ss -ltnp 2>/dev/null | grep -q ":$port "; then
X                    if ! ss -ltnp 2>/dev/null | grep ":$port " | grep -q sshd; then
X                        echo "Port: $port already in Use.." >&2; exit 33
X                    fi
X                fi
X            elif command -v lsof >/dev/null 2>&1; then
X                if lsof -i:"$port" 2>/dev/null | grep -qv '^sshd'; then
X                    if lsof -i:"$port" 2>/dev/null | grep -q .; then
X                        echo "Port: $port already in Use.." >&2; exit 33
X                    fi
X                fi
X            fi
X        fi
X        ;;
X    services)
X        if [ "$OS" = "FreeBSD" ]; then
X            service -e 2>/dev/null || service -l 2>/dev/null || err "tidak bisa daftar service"
X        else
X            if [ -x "$BIN/sigexec" ]; then
X                "$BIN/sigexec" service --status-all 2>/dev/null || service --status-all
X            else
X                service --status-all
X            fi
X        fi
X        ;;
X    service-status)
X        if [ "$OS" = "FreeBSD" ]; then
X            service "$2" status
X        else
X            if [ -x "$BIN/sigexec" ]; then
X                "$BIN/sigexec" service "$2" status 2>/dev/null || service "$2" status
X            else
X                service "$2" status
X            fi
X        fi
X        ;;
X    process)
X        if [ "$OS" = "FreeBSD" ]; then
X            ps aux | grep -v -E 'cli|klish|ps aux|agetty'
X        else
X            ps axf | grep -v -E 'cli|kli|klish|ps axf|agetty'
X        fi
X        ;;
X    memory)
X        if [ "$OS" = "FreeBSD" ]; then
X            sysctl hw.physmem hw.usermem 2>/dev/null
X            vmstat -s 2>/dev/null | head -8
X        else
X            free -h
X        fi
X        ;;
X    cpu)
X        if [ "$OS" = "FreeBSD" ]; then
X            sysctl hw.model hw.ncpu hw.machine 2>/dev/null
X        else
X            if command -v lscpu >/dev/null 2>&1; then lscpu; else grep -m1 'model name' /proc/cpuinfo; fi
X        fi
X        ;;
X    pci)
X        if [ "$OS" = "FreeBSD" ]; then
X            pciconf -lv 2>/dev/null || echo "pciconf tidak tersedia"
X        else
X            if command -v lspci >/dev/null 2>&1; then lspci; else echo "lspci tidak tersedia (paket pciutils)"; fi
X        fi
X        ;;
X    dmi)
X        if command -v dmidecode >/dev/null 2>&1; then
X            dmidecode 2>/dev/null | head -60
X        else
X            echo "dmidecode tidak tersedia (Debian: apt install dmidecode; FreeBSD: pkg install dmidecode)"
X        fi
X        ;;
X    connections)
X        if [ "$OS" = "FreeBSD" ]; then
X            netstat -an 2>/dev/null
X        else
X            if command -v ss >/dev/null 2>&1; then ss -tunap 2>/dev/null; elif command -v netstat >/dev/null 2>&1; then netstat -en; else echo "ss/netstat tidak tersedia"; fi
X        fi
X        ;;
X    summary)
X        # Ringkasan sistem lengkap untuk `show system` (OS, kernel, versi, hw ringkas).
X        # Label 14 kolom + ": " supaya titik dua lurus.
X        printf "\n"
X        printf "Hostname......: %s\n" "$(hostname 2>/dev/null)"
X        if [ "$OS" = "FreeBSD" ]; then
X            printf "OS............: FreeBSD %s\n" "$(freebsd-version 2>/dev/null || echo "?")"
X        else
X            pretty=$(grep '^PRETTY_NAME=' /etc/os-release 2>/dev/null | cut -d= -f2- | tr -d '"')
X            [ -n "$pretty" ] || pretty="Linux (os-release tidak ditemukan)"
X            printf "OS............: %s\n" "$pretty"
X        fi
X        printf "Kernel........: %s\n" "$(uname -r 2>/dev/null)"
X        printf "Kernel build..: %s\n" "$(uname -v 2>/dev/null)"
X        printf "Arsitektur....: %s\n" "$(uname -m 2>/dev/null)"
X        printf "Waktu sistem..: %s\n" "$(date 2>/dev/null)"
X        printf "Waktu WIB.....: %s\n" "$(TZ=Asia/Jakarta date 2>/dev/null)"
X        if [ "$OS" = "FreeBSD" ]; then
X            printf "Uptime........: %s\n" "$(uptime 2>/dev/null | sed 's/^ *//')"
X            printf "CPU...........: %s (%s CPU)\n" "$(sysctl -n hw.model 2>/dev/null)" "$(sysctl -n hw.ncpu 2>/dev/null)"
X            phys=$(sysctl -n hw.physmem 2>/dev/null); user=$(sysctl -n hw.usermem 2>/dev/null)
X            if [ -n "$phys" ] && [ -n "$user" ]; then
X                printf "Memori........: %s MB terpakai / %s MB total\n" "$(( (phys - user) / 1024 / 1024 ))" "$(( phys / 1024 / 1024 ))"
X            fi
X            sysctl -n vm.loadavg 2>/dev/null | awk '{printf "Beban CPU.....: %s %s %s\n", $2, $3, $4}'
X        else
X            printf "Uptime........: %s\n" "$(uptime -p 2>/dev/null || uptime 2>/dev/null)"
X            model=$(grep -m1 'model name' /proc/cpuinfo 2>/dev/null | cut -d: -f2- | sed 's/^ //')
X            printf "CPU...........: %s (%s CPU)\n" "$model" "$(nproc 2>/dev/null || grep -c '^processor' /proc/cpuinfo 2>/dev/null)"
X            free -m 2>/dev/null | awk 'NR==2{printf "Memori........: %s MB terpakai / %s MB total\n", $3, $2}'
X            awk '{printf "Beban CPU.....: %s %s %s\n", $1, $2, $3}' /proc/loadavg 2>/dev/null
X        fi
X        df -h / 2>/dev/null | awk 'NR==2{printf "Disk (/)......: %s terpakai / %s total (%s)\n", $3, $2, $5}'
X        printf "Titian CLI....: klish %s (tree /opt/titian/etc/clish-en)\n" "$("$BIN/clish" -v 2>/dev/null | head -1)"
X        if command -v birdc >/dev/null 2>&1; then
X            printf "BIRD..........: %s\n" "$(birdc show status 2>/dev/null | head -1 | sed 's/^BIRD //;s/ ready\.$//')"
X        fi
X        printf "\n"
X        ;;
X    sed-replace)
X        # $2=file $3=script sed — portable sed -i (dipakai aksi XML).
X        [ -n "${2:-}" ] && [ -n "${3:-}" ] || err "sed-replace butuh file + script"
X        sys_sed_i "$2" "$3"
X        ;;
X    sed-del-blank)
X        # $2=file — hapus baris kosong, portable.
X        [ -n "${2:-}" ] || err "sed-del-blank butuh file"
X        sys_sed_del_blank "$2"
X        ;;
X    dns-domain)
X        # $2=domain
X        [ -n "${2:-}" ] || err "domain kosong"
X        if dns_stub_mode; then
X            dns_dropin_ensure
X            sys_sed_i "$(dns_dropin)" '/^Domains=/d'
X            printf 'Domains=%s\n' "$2" >> "$(dns_dropin)"
X            dns_dropin_restart
X        elif [ -L /etc/resolv.conf ]; then
X            err "resolv.conf symlink tanpa systemd-resolved aktif — tidak diubah (stub dilindungi)"
X        else
X            sys_sed_i /etc/resolv.conf 's|^domain.*||'
X            sys_sed_i /etc/resolv.conf 's|^search.*||'
X            sys_sed_del_blank /etc/resolv.conf
X            echo "domain $2" >> /etc/resolv.conf
X        fi
X        ;;
X    dns-domain-clear)
X        if dns_stub_mode; then
X            if [ -f "$(dns_dropin)" ]; then
X                sys_sed_i "$(dns_dropin)" '/^Domains=/d'
X                if ! grep -q -E '^(DNS|Domains)=' "$(dns_dropin)" 2>/dev/null; then
X                    rm -f "$(dns_dropin)"
X                fi
X            fi
X            dns_dropin_restart
X        elif [ -L /etc/resolv.conf ]; then
X            err "resolv.conf symlink tanpa systemd-resolved aktif — tidak diubah (stub dilindungi)"
X        else
X            sys_sed_i /etc/resolv.conf 's|^domain.*||'
X            sys_sed_i /etc/resolv.conf 's|^search.*||'
X            sys_sed_del_blank /etc/resolv.conf
X        fi
X        ;;
X    dns-ns-add)
X        # $2=ip nameserver
X        [ -n "${2:-}" ] || err "nameserver kosong"
X        if dns_stub_mode; then
X            dns_dropin_ensure
X            awk -v ip="$2" '/^DNS=/ { n=split(substr($0,5), a, " "); found=0; for (i=1;i<=n;i++) if (a[i]==ip) found=1; if (!found) $0=$0 " " ip } {print}' "$(dns_dropin)" > "$(dns_dropin).tmp" && mv "$(dns_dropin).tmp" "$(dns_dropin)"
X            if ! grep -q '^DNS=' "$(dns_dropin)" 2>/dev/null; then
X                printf 'DNS=%s\n' "$2" >> "$(dns_dropin)"
X            fi
X            dns_dropin_restart
X        elif [ -L /etc/resolv.conf ]; then
X            err "resolv.conf symlink tanpa systemd-resolved aktif — tidak diubah (stub dilindungi)"
X        else
X            sys_sed_i /etc/resolv.conf "s|nameserver $2\$||"
X            sys_sed_del_blank /etc/resolv.conf
X            echo "nameserver $2" >> /etc/resolv.conf
X        fi
X        ;;
X    dns-ns-del)
X        # $2=ip nameserver
X        [ -n "${2:-}" ] || err "nameserver kosong"
X        if dns_stub_mode; then
X            if [ -f "$(dns_dropin)" ]; then
X                awk -v ip="$2" '/^DNS=/ { n=split(substr($0,5), a, " "); out=""; for (i=1;i<=n;i++) if (a[i]!=ip) out=out (out==""?"":" ") a[i]; if (out!="") $0="DNS=" out; else next } {print}' "$(dns_dropin)" > "$(dns_dropin).tmp" && mv "$(dns_dropin).tmp" "$(dns_dropin)"
X                if ! grep -q -E '^(DNS|Domains)=' "$(dns_dropin)" 2>/dev/null; then
X                    rm -f "$(dns_dropin)"
X                fi
X            fi
X            dns_dropin_restart
X        elif [ -L /etc/resolv.conf ]; then
X            err "resolv.conf symlink tanpa systemd-resolved aktif — tidak diubah (stub dilindungi)"
X        else
X            sys_sed_i /etc/resolv.conf "s|nameserver $2\$||"
X            sys_sed_del_blank /etc/resolv.conf
X        fi
X        ;;
X    *) echo "Usage: $0 {hostname|timezone|ssh-check|ssh-restart|port-in-use|services|service-status|process|memory|cpu|pci|dmi|connections|sed-replace|sed-del-blank|dns-domain|dns-domain-clear|dns-ns-add|dns-ns-del} ..." >&2; exit 2 ;;
Xesac
