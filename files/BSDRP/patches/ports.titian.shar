echo x - net/titian/files/tree/conf-fw.xml
sed 's/^X//' >net/titian/files/tree/conf-fw.xml << '131e2b2dffe733f11d2557328040fb92'
X<?xml version="1.0" encoding="UTF-8"?>
X<CLISH_MODULE xmlns="http://clish.sourceforge.net/XMLSchema"
X          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
X xsi:schemaLocation="http://clish.sourceforge.net/XMLSchema
X                     http://clish.sourceforge.net/XMLSchema/clish.xsd">
X    <!--=======================================================-->
X    <!-- firewall + NAT (pf) — BSDRP_klish.
X         Prepared 2026-11-08, ~19:15 WIB. MERGED into the BSDRP tree as conf-fw.xml (~/workspace/titian-bsdRP-xml/tree/).
X         Model follows Titian's proven conf-fw.xml (lab-verified 2 Nov
X         2026): rules identified by CONTENT (no IDs), `no` form = same
X         full syntax, duplicates = "already exists".
X         Differences vs Titian (deliberate, see design doc §0):
X         - pf only (no nftables — BSDRP is FreeBSD-only).
X         - output chain usable: in=any + out=<iface> (Titian rejected
X           out for all chains on FreeBSD).
X         - anti-lockout `protected` interface list (default em0).
X         PTYPEs FW_* are defined here; IFACE_SYS / IP_ADDR /
X         IP_ADDR_MASK / DSTPORT come from the main tree (types-dev.xml).
X         If the main tree already defines an FW_* ptype, REMOVE the
X         local copy at merge time (no duplicates).
X         Backend: ${RT_SBIN}/titian-fw.sh (edit config),
X         /usr/local/sbin/firewall-apply (apply at commit/boot),
X         /usr/local/etc/rc.d/firewall (rc script).
X         Needs a clish syntax check against klish 0.2.0 at port time,
X         plus a live test on a guest. -->
X    <!--=======================================================-->
X
X    <!--==================== configure-view ====================-->
X    <VIEW name="configure-view">
X        <COMMAND name="firewall"
X                help="Firewall + NAT (pf) — IPv4 saja v1; forward default DENY, input/output default ACCEPT"
X                view="configure-firewall-view"
X                viewid="sysview=firewall"
X                ptype="SUBCOMMAND"
X                mode="subcommand">
X            <CONFIG priority="0x1400" pattern="^${__line}$"/>
X            <ACTION>
X                ${RT_SBIN}/titian-fw.sh check
X            </ACTION>
X        </COMMAND>
X        <COMMAND name="no firewall"
X                help="Hapus SELURUH konfigurasi firewall (semua rule)">
X            <CONFIG operation="unset" pattern="^firewall$"/>
X            <ACTION>
X                ${RT_SBIN}/titian-fw.sh flush
X            </ACTION>
X        </COMMAND>
X    </VIEW>
X
X    <!--================= configure-firewall-view =================-->
X    <VIEW name="configure-firewall-view"
X        prompt="${SYSTEM_NAME}(config-firewall)# "
X        depth="1">
X
X        <NAMESPACE ref="configure-view"
X            help="false"
X            completion="true"/>
X
X        <COMMAND name="exit"
X            help="Exit firewall mode"
X            lock="false">
X            <ACTION builtin="clish_nested_up"/>
X        </COMMAND>
X        <HOTKEY key="^Z" cmd="exit"/>
X
X        <COMMAND name="no"
X            help="Negate a command or set its defaults"/>
X
X        <COMMAND name="enable"
X              help="Enable firewall + NAT">
X            <CONFIG/>
X            <ACTION>
X                ${RT_SBIN}/titian-fw.sh set-enable yes
X            </ACTION>
X        </COMMAND>
X        <COMMAND name="no enable"
X              help="Disable firewall + NAT (flush anchors, pf stays loaded)">
X            <CONFIG operation="unset" pattern="^enable"/>
X            <ACTION>
X                ${RT_SBIN}/titian-fw.sh set-enable no
X            </ACTION>
X        </COMMAND>
X
X        <COMMAND name="filter"
X                help="Aturan filter: chain + aksi + proto + src + dst + sport + dport + in + out (semua field wajib, pakai any bila tidak peduli; urutan dibuat = prioritas, pertama cocok menang)">
X            <PARAM name="chain"
X                help="forward (transit) | input (ke router) | output (dari router)"
X                ptype="FW_CHAIN"/>
X            <PARAM name="action"
X                help="permit (lolos) | deny (buang)"
X                ptype="FW_ACTION"/>
X            <PARAM name="proto"
X                help="proto"
X                mode="subcommand"
X                ptype="SUBCOMMAND">
X                <PARAM name="proto_val"
X                    help="tcp | udp | icmp | all (all/icmp tidak memakai port)"
X                    ptype="FW_PROTO"/>
X            </PARAM>
X            <PARAM name="src"
X                help="src"
X                mode="subcommand"
X                ptype="SUBCOMMAND">
X                <PARAM name="src_val"
X                    help="sumber CIDR (mis. 192.168.1.0/24) atau any"
X                    ptype="FW_CIDR_OR_ANY"/>
X            </PARAM>
X            <PARAM name="dst"
X                help="dst"
X                mode="subcommand"
X                ptype="SUBCOMMAND">
X                <PARAM name="dst_val"
X                    help="tujuan CIDR atau any"
X                    ptype="FW_CIDR_OR_ANY"/>
X            </PARAM>
X            <PARAM name="sport"
X                help="sport"
X                mode="subcommand"
X                ptype="SUBCOMMAND">
X                <PARAM name="sport_val"
X                    help="port sumber 1-65535 atau any (hanya tcp/udp)"
X                    ptype="FW_PORT_OR_ANY"/>
X            </PARAM>
X            <PARAM name="dport"
X                help="dport"
X                mode="subcommand"
X                ptype="SUBCOMMAND">
X                <PARAM name="dport_val"
X                    help="port tujuan 1-65535 atau any (hanya tcp/udp)"
X                    ptype="FW_PORT_OR_ANY"/>
X            </PARAM>
X            <PARAM name="in"
X                help="in"
X                mode="subcommand"
X                ptype="SUBCOMMAND">
X                <PARAM name="in_val"
X                    help="interface masuk (forward/input: WAJIB iface; output: any)"
X                    ptype="FW_IFACE_OR_ANY"/>
X            </PARAM>
X            <PARAM name="out"
X                help="out"
X                mode="subcommand"
X                ptype="SUBCOMMAND">
X                <PARAM name="out_val"
X                    help="interface keluar (forward/input: any; output: WAJIB iface)"
X                    ptype="FW_IFACE_OR_ANY"/>
X            </PARAM>
X            <CONFIG pattern="^${__line}$"/>
X            <ACTION>
X                ${RT_SBIN}/titian-fw.sh add-filter "${chain}" "${action}" "${proto_val}" "${src_val}" "${dst_val}" "${sport_val}" "${dport_val}" "${in_val}" "${out_val}"
X            </ACTION>
X        </COMMAND>
X        <COMMAND name="no filter"
X                help="Hapus aturan filter (sintaks lengkap sama dengan pembuatnya)">
X            <PARAM name="chain"
X                help="forward | input | output"
X                ptype="FW_CHAIN"/>
X            <PARAM name="action"
X                help="permit | deny"
X                ptype="FW_ACTION"/>
X            <PARAM name="proto"
X                help="proto"
X                mode="subcommand"
X                ptype="SUBCOMMAND">
X                <PARAM name="proto_val"
X                    help="tcp | udp | icmp | all"
X                    ptype="FW_PROTO"/>
X            </PARAM>
X            <PARAM name="src"
X                help="src"
X                mode="subcommand"
X                ptype="SUBCOMMAND">
X                <PARAM name="src_val"
X                    help="sumber CIDR atau any"
X                    ptype="FW_CIDR_OR_ANY"/>
X            </PARAM>
X            <PARAM name="dst"
X                help="dst"
X                mode="subcommand"
X                ptype="SUBCOMMAND">
X                <PARAM name="dst_val"
X                    help="tujuan CIDR atau any"
X                    ptype="FW_CIDR_OR_ANY"/>
X            </PARAM>
X            <PARAM name="sport"
X                help="sport"
X                mode="subcommand"
X                ptype="SUBCOMMAND">
X                <PARAM name="sport_val"
X                    help="port sumber atau any"
X                    ptype="FW_PORT_OR_ANY"/>
X            </PARAM>
X            <PARAM name="dport"
X                help="dport"
X                mode="subcommand"
X                ptype="SUBCOMMAND">
X                <PARAM name="dport_val"
X                    help="port tujuan atau any"
X                    ptype="FW_PORT_OR_ANY"/>
X            </PARAM>
X            <PARAM name="in"
X                help="in"
X                mode="subcommand"
X                ptype="SUBCOMMAND">
X                <PARAM name="in_val"
X                    help="interface masuk atau any"
X                    ptype="FW_IFACE_OR_ANY"/>
X            </PARAM>
X            <PARAM name="out"
X                help="out"
X                mode="subcommand"
X                ptype="SUBCOMMAND">
X                <PARAM name="out_val"
X                    help="interface keluar atau any"
X                    ptype="FW_IFACE_OR_ANY"/>
X            </PARAM>
X            <CONFIG operation="unset" pattern="^filter ${chain} ${action} proto ${proto_val} src ${src_val} dst ${dst_val} sport ${sport_val} dport ${dport_val} in ${in_val} out ${out_val}$"/>
X            <ACTION>
X                ${RT_SBIN}/titian-fw.sh del-filter "${chain}" "${action}" "${proto_val}" "${src_val}" "${dst_val}" "${sport_val}" "${dport_val}" "${in_val}" "${out_val}"
X            </ACTION>
X        </COMMAND>
X
X        <COMMAND name="snat"
X                help="Source NAT: trafik dari srcnet yang keluar via out diubah sumbernya ke target (alamat eksplisit atau masquerade = alamat iface keluar)">
X            <PARAM name="srcnet"
X                help="jaringan sumber CIDR (mis. 192.168.1.0/24)"
X                ptype="IP_ADDR_MASK"/>
X            <PARAM name="to"
X                help="to"
X                mode="subcommand"
X                ptype="SUBCOMMAND">
X                <PARAM name="to_val"
X                    help="alamat IPv4 hasil NAT atau masquerade"
X                    ptype="FW_SNAT_TARGET"/>
X            </PARAM>
X            <PARAM name="out"
X                help="out"
X                mode="subcommand"
X                ptype="SUBCOMMAND">
X                <PARAM name="out_val"
X                    help="interface keluar (WAJIB iface)"
X                    ptype="IFACE_SYS"/>
X            </PARAM>
X            <CONFIG pattern="^${__line}$"/>
X            <ACTION>
X                ${RT_SBIN}/titian-fw.sh add-snat "${srcnet}" "${to_val}" "${out_val}"
X            </ACTION>
X        </COMMAND>
X        <COMMAND name="no snat"
X                help="Hapus aturan snat (sintaks lengkap sama dengan pembuatnya)">
X            <PARAM name="srcnet"
X                help="jaringan sumber CIDR"
X                ptype="IP_ADDR_MASK"/>
X            <PARAM name="to"
X                help="to"
X                mode="subcommand"
X                ptype="SUBCOMMAND">
X                <PARAM name="to_val"
X                    help="alamat IPv4 hasil NAT atau masquerade"
X                    ptype="FW_SNAT_TARGET"/>
X            </PARAM>
X            <PARAM name="out"
X                help="out"
X                mode="subcommand"
X                ptype="SUBCOMMAND">
X                <PARAM name="out_val"
X                    help="interface keluar"
X                    ptype="IFACE_SYS"/>
X            </PARAM>
X            <CONFIG operation="unset" pattern="^snat ${srcnet} to ${to_val} out ${out_val}$"/>
X            <ACTION>
X                ${RT_SBIN}/titian-fw.sh del-snat "${srcnet}" "${to_val}" "${out_val}"
X            </ACTION>
X        </COMMAND>
X
X        <COMMAND name="dnat"
X                help="Destination NAT / port forwarding: trafik masuk via in ke dport dialihkan ke alamat (+port) tujuan. BUTUH forward permit ke tujuan TERJEMAHAN agar lolos (filter melihat paket post-DNAT)">
X            <PARAM name="proto"
X                help="tcp | udp (icmp tidak memakai port, tidak didukung dnat)"
X                ptype="FW_DNAT_PROTO"/>
X            <PARAM name="in"
X                help="in"
X                mode="subcommand"
X                ptype="SUBCOMMAND">
X                <PARAM name="in_val"
X                    help="interface masuk (wajib; dnat selalu terikat iface)"
X                    ptype="IFACE_SYS"/>
X            </PARAM>
X            <PARAM name="dport"
X                help="dport"
X                mode="subcommand"
X                ptype="SUBCOMMAND">
X                <PARAM name="dport_val"
X                    help="port publik 1-65535"
X                    ptype="DSTPORT"/>
X            </PARAM>
X            <PARAM name="to"
X                help="to"
X                mode="subcommand"
X                ptype="SUBCOMMAND">
X                <PARAM name="to_val"
X                    help="alamat IPv4 tujuan"
X                    ptype="IP_ADDR"/>
X            </PARAM>
X            <PARAM name="port"
X                help="port"
X                mode="subcommand"
X                ptype="SUBCOMMAND">
X                <PARAM name="toport_val"
X                    help="port tujuan 1-65535 atau same (= port publik)"
X                    ptype="FW_PORT_OR_SAME"/>
X            </PARAM>
X            <CONFIG pattern="^${__line}$"/>
X            <ACTION>
X                ${RT_SBIN}/titian-fw.sh add-dnat "${proto}" "${in_val}" "${dport_val}" "${to_val}" "${toport_val}"
X            </ACTION>
X        </COMMAND>
X        <COMMAND name="no dnat"
X                help="Hapus aturan dnat (sintaks lengkap sama dengan pembuatnya)">
X            <PARAM name="proto"
X                help="tcp | udp"
X                ptype="FW_DNAT_PROTO"/>
X            <PARAM name="in"
X                help="in"
X                mode="subcommand"
X                ptype="SUBCOMMAND">
X                <PARAM name="in_val"
X                    help="interface masuk"
X                    ptype="IFACE_SYS"/>
X            </PARAM>
X            <PARAM name="dport"
X                help="dport"
X                mode="subcommand"
X                ptype="SUBCOMMAND">
X                <PARAM name="dport_val"
X                    help="port publik"
X                    ptype="DSTPORT"/>
X            </PARAM>
X            <PARAM name="to"
X                help="to"
X                mode="subcommand"
X                ptype="SUBCOMMAND">
X                <PARAM name="to_val"
X                    help="alamat IPv4 tujuan"
X                    ptype="IP_ADDR"/>
X            </PARAM>
X            <PARAM name="port"
X                help="port"
X                mode="subcommand"
X                ptype="SUBCOMMAND">
X                <PARAM name="toport_val"
X                    help="port tujuan atau same"
X                    ptype="FW_PORT_OR_SAME"/>
X            </PARAM>
X            <CONFIG operation="unset" pattern="^dnat ${proto} in ${in_val} dport ${dport_val} to ${to_val} port ${toport_val}$"/>
X            <ACTION>
X                ${RT_SBIN}/titian-fw.sh del-dnat "${proto}" "${in_val}" "${dport_val}" "${to_val}" "${toport_val}"
X            </ACTION>
X        </COMMAND>
X
X        <COMMAND name="protect-interface"
X                help="Tambah interface ke daftar protected (rule tidak boleh memakai iface ini sebagai in/out — guard anti-lockout)">
X            <PARAM name="If"
X                help="nama interface"
X                ptype="IFACE_SYS"/>
X            <CONFIG/>
X            <ACTION>
X                ${RT_SBIN}/titian-fw.sh add-protected "${If}"
X            </ACTION>
X        </COMMAND>
X        <COMMAND name="no protect-interface"
X                help="Hapus interface dari daftar protected (minimal satu harus tersisa)">
X            <PARAM name="If"
X                help="nama interface"
X                ptype="IFACE_SYS"/>
X            <CONFIG operation="unset" pattern="^protected ${If}"/>
X            <ACTION>
X                ${RT_SBIN}/titian-fw.sh del-protected "${If}"
X            </ACTION>
X        </COMMAND>
X
X    </VIEW>
X
X    <!--=================== exec (show) ===================-->
X    <!-- BSDRP port: show commands live in the main tree exec view
X         (enable-view). PTYPEs FW_* come from types-dev.xml (COMMON);
X         backend is now ${RT_SBIN}/titian-fw.sh (merged firewall-cfg
X         + firewall-apply, pf-only). This file REPLACES the tree
X         conf-fw.xml (nftables/Linux branches removed; output chain
X         usable; protect-interface guard added). -->
X    <VIEW name="enable-view">
X
X        <COMMAND name="show firewall"
X                help="Daftar rule firewall/NAT (urutan = prioritas) + dump anchor pf live + status forwarding"
X                lock="false"
X                interrupt="true">
X            <ACTION>
X                ${RT_SBIN}/titian-fw.sh show
X                ${RT_SBIN}/titian-fw.sh status
X            </ACTION>
X        </COMMAND>
X        <COMMAND name="show firewall filter"
X                help="Daftar rule filter saja"
X                lock="false"
X                interrupt="true">
X            <ACTION>
X                ${RT_SBIN}/titian-fw.sh show-filter
X            </ACTION>
X        </COMMAND>
X        <COMMAND name="show firewall nat"
X                help="Daftar rule snat/dnat saja"
X                lock="false"
X                interrupt="true">
X            <ACTION>
X                ${RT_SBIN}/titian-fw.sh show-nat
X            </ACTION>
X        </COMMAND>
X
X    </VIEW>
X
X</CLISH_MODULE>
