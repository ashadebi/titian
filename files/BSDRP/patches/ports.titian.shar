echo x - net/titian/files/tree/conf-pppoe.xml
sed 's/^X//' >net/titian/files/tree/conf-pppoe.xml << 'cf571a15cab4506e154a9fec424630b1'
X<?xml version="1.0" encoding="UTF-8"?>
X<CLISH_MODULE xmlns="http://clish.sourceforge.net/XMLSchema"
X          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
X xsi:schemaLocation="http://clish.sourceforge.net/XMLSchema
X                     http://clish.sourceforge.net/XMLSchema/clish.xsd">
X    <!--=======================================================-->
X    <!-- PPPoE server (mpd5 5.9, netgraph) — BSDRP port (BARU).
X         Backend: ${RT_SBIN}/titian-pppoe.sh, config klish di
X         /usr/local/etc/pppoe.conf, config mpd5 yang dihasilkan di
X         /usr/local/etc/mpd5/mpd.conf + mpd.secret (mode 600).
X         `enable` hanya mencatat niat + dirty; service mpd5 naik/
X         berhenti saat `commit`. User/pool/interface berlaku saat
X         commit berikutnya (atau langsung bila service sudah jalan
X         dan commit dijalankan).
X         CATATAN: password user tersimpan di mpd.secret (600) dan
X         tercatat di running-config seperti perintah password router
X         pada umumnya — ganti berkala; jangan expose file itu.
X         Sintaks mpd.conf yang dihasilkan BELUM teruji live di guest
X         (ditulis dari dokumentasi mpd5) — verifikasi live wajib
X         sebelum dipakai produksi. -->
X
X<VIEW name="configure-view">
X    <COMMAND name="pppoe-server"
X            help="PPPoE server (mpd5)"
X            view="configure-pppoe-view"
X            viewid="sysview=pppoe-server"
X            ptype="SUBCOMMAND"
X            mode="subcommand">
X        <CONFIG priority="0x1600" pattern="^${__line}$"/>
X        <ACTION>
X            ${RT_SBIN}/titian-pppoe.sh check
X        </ACTION>
X    </COMMAND>
X    <COMMAND name="no pppoe-server"
X            help="Hapus SELURUH konfigurasi PPPoE server (semua user + pool)">
X        <CONFIG operation="unset" pattern="^pppoe-server$"/>
X        <ACTION>
X            ${RT_SBIN}/titian-pppoe.sh flush
X        </ACTION>
X    </COMMAND>
X</VIEW>
X
X<VIEW name="configure-pppoe-view"
X    prompt="${SYSTEM_NAME}(config-pppoe)# "
X    depth="1">
X    <NAMESPACE ref="configure-view"
X        help="false"
X        completion="true"/>
X
X    <COMMAND name="exit"
X        help="Kembali ke configure-view"
X        lock="false">
X        <ACTION builtin="clish_nested_up"/>
X    </COMMAND>
X    <COMMAND name="end"
X        help="Kembali ke enable-view"
X        view="enable-view"/>
X    <HOTKEY key="^Z" cmd="exit"/>
X
X    <COMMAND name="no"
X        help="Negate a command or set its defaults"/>
X
X    <COMMAND name="enable"
X          help="Enable PPPoE server (pending commit)">
X        <CONFIG/>
X        <ACTION>
X            ${RT_SBIN}/titian-pppoe.sh set-enable yes
X        </ACTION>
X    </COMMAND>
X    <COMMAND name="no enable"
X          help="Disable PPPoE server (pending commit)">
X        <CONFIG operation="unset" pattern="^enable"/>
X        <ACTION>
X            ${RT_SBIN}/titian-pppoe.sh set-enable no
X        </ACTION>
X    </COMMAND>
X
X    <COMMAND name="interface"
X        help="Interface tempat PPPoE server mendengarkan">
X        <PARAM name="If"
X            help="nama interface"
X            ptype="IFACE_SYS"/>
X        <CONFIG/>
X        <ACTION>
X            ${RT_SBIN}/titian-pppoe.sh set-interface "${If}"
X        </ACTION>
X    </COMMAND>
X    <COMMAND name="no interface"
X        help="Hapus interface PPPoE server">
X        <CONFIG operation="unset" pattern="^interface"/>
X        <ACTION>
X            ${RT_SBIN}/titian-pppoe.sh del-interface
X        </ACTION>
X    </COMMAND>
X
X    <COMMAND name="pool"
X        help="Pool alamat IP untuk klien PPPoE (range start-end)">
X        <PARAM name="Start"
X            help="alamat awal pool"
X            ptype="IP_ADDR"/>
X        <PARAM name="End"
X            help="alamat akhir pool"
X            ptype="IP_ADDR"/>
X        <CONFIG/>
X        <ACTION>
X            ${RT_SBIN}/titian-pppoe.sh set-pool "${Start}" "${End}"
X        </ACTION>
X    </COMMAND>
X    <COMMAND name="no pool"
X        help="Hapus pool alamat PPPoE">
X        <CONFIG operation="unset" pattern="^pool"/>
X        <ACTION>
X            ${RT_SBIN}/titian-pppoe.sh del-pool
X        </ACTION>
X    </COMMAND>
X
X    <COMMAND name="user"
X            help="User PPPoE (password + IP statis opsional di subview)"
X            view="configure-pppoe-user-view"
X            viewid="pppoe_user=${Name}"
X            ptype="SUBCOMMAND"
X            mode="subcommand">
X        <PARAM name="Name"
X            help="nama user"
X            ptype="STRING"/>
X        <CONFIG priority="0x1610" pattern="^user ${Name}$"/>
X        <ACTION>
X            ${RT_SBIN}/titian-pppoe.sh user-add "${Name}"
X        </ACTION>
X    </COMMAND>
X    <COMMAND name="no user"
X            help="Hapus user PPPoE">
X        <PARAM name="Name"
X            help="nama user"
X            ptype="STRING"/>
X        <CONFIG operation="unset" pattern="^user ${Name}"/>
X        <ACTION>
X            ${RT_SBIN}/titian-pppoe.sh user-del "${Name}"
X        </ACTION>
X    </COMMAND>
X
X    <COMMAND name="radius-server"
X        help="Server RADIUS untuk auth PPPoE (tanpa CoA)">
X        <PARAM name="Server"
X            help="alamat IPv4 server RADIUS"
X            ptype="IP_ADDR"/>
X        <CONFIG/>
X        <ACTION>
X            ${RT_SBIN}/titian-pppoe.sh set-radius-server "${Server}"
X        </ACTION>
X    </COMMAND>
X    <COMMAND name="no radius-server"
X        help="Hapus server RADIUS (kembali ke auth lokal)">
X        <CONFIG operation="unset" pattern="^radius-server"/>
X        <ACTION>
X            ${RT_SBIN}/titian-pppoe.sh del-radius-server
X        </ACTION>
X    </COMMAND>
X
X    <COMMAND name="radius-secret"
X        help="Shared secret RADIUS (tersimpan di mpd.conf, mode 600)">
X        <PARAM name="Secret"
X            help="shared secret"
X            ptype="STRING"/>
X        <CONFIG/>
X        <ACTION>
X            ${RT_SBIN}/titian-pppoe.sh set-radius-secret "${Secret}"
X        </ACTION>
X    </COMMAND>
X    <COMMAND name="no radius-secret"
X        help="Hapus shared secret RADIUS">
X        <CONFIG operation="unset" pattern="^radius-secret"/>
X        <ACTION>
X            ${RT_SBIN}/titian-pppoe.sh del-radius-secret
X        </ACTION>
X    </COMMAND>
X</VIEW>
X
X<VIEW name="configure-pppoe-user-view"
X    prompt="${SYSTEM_NAME}(config-pppoe-user-${pppoe_user})# "
X    depth="2">
X    <NAMESPACE ref="configure-pppoe-view"
X        help="false"
X        completion="true"/>
X    <COMMAND name="exit"
X        help="Kembali ke pppoe-server mode"
X        lock="false">
X        <ACTION builtin="clish_nested_up"/>
X    </COMMAND>
X    <HOTKEY key="^Z" cmd="exit"/>
X
X    <COMMAND name="password"
X        help="Password user (tersimpan di mpd.secret, mode 600)">
X        <PARAM name="Pass"
X            help="password"
X            ptype="STRING"/>
X        <CONFIG/>
X        <ACTION>
X            ${RT_SBIN}/titian-pppoe.sh user-set-password "${pppoe_user}" "${Pass}"
X        </ACTION>
X    </COMMAND>
X    <COMMAND name="ip"
X        help="Alamat IP statis untuk user ini (kosong = dari pool)">
X        <PARAM name="Addr"
X            help="alamat IPv4"
X            ptype="IP_ADDR"/>
X        <CONFIG/>
X        <ACTION>
X            ${RT_SBIN}/titian-pppoe.sh user-set-ip "${pppoe_user}" "${Addr}"
X        </ACTION>
X    </COMMAND>
X    <COMMAND name="no ip"
X        help="Hapus IP statis user (kembali ke pool)">
X        <CONFIG operation="unset" pattern="^ip"/>
X        <ACTION>
X            ${RT_SBIN}/titian-pppoe.sh user-del-ip "${pppoe_user}"
X        </ACTION>
X    </COMMAND>
X</VIEW>
X
X<VIEW name="enable-view">
X    <COMMAND name="show pppoe-server"
X        help="Status PPPoE server (enable, interface, pool, jumlah user)"
X        lock="false"
X        interrupt="true">
X        <ACTION>
X            ${RT_SBIN}/titian-pppoe.sh show
X        </ACTION>
X    </COMMAND>
X    <COMMAND name="show pppoe-server users"
X        help="Daftar user PPPoE (nama + IP statis; password tidak ditampilkan)"
X        lock="false"
X        interrupt="true">
X        <ACTION>
X            ${RT_SBIN}/titian-pppoe.sh show-users
X        </ACTION>
X    </COMMAND>
X    <COMMAND name="show pppoe-server sessions"
X        help="Sesi PPPoE yang aktif (interface ng*)"
X        lock="false"
X        interrupt="true">
X        <ACTION>
X            ${RT_SBIN}/titian-pppoe.sh show-sessions
X        </ACTION>
X    </COMMAND>
X</VIEW>
X
X</CLISH_MODULE>
cf571a15cab4506e154a9fec424630b1
echo x - net/titian/files/tree/conf-route-fbsd.xml
sed 's/^X//' >net/titian/files/tree/conf-route-fbsd.xml << 'fd79148e07ef55f8e43f44fb24b304fc'
X<?xml version="1.0" encoding="UTF-8"?>
X<CLISH_MODULE xmlns="http://clish.sourceforge.net/XMLSchema"
X          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
X xsi:schemaLocation="http://clish.sourceforge.net/XMLSchema
X                     http://clish.sourceforge.net/XMLSchema/clish.xsd">
X	<!--=======================================================-->
X	<!-- TITIAN Fase 1: padanan FreeBSD dari conf-route.xml
X	     (route(8)). Hanya diinstal di FreeBSD. -->
X
X<VIEW name="configure-view">
X
X<!-- Default gateway -->
X	<COMMAND name="ip default-gateway"
X		help="Specify default gateway (if not routing IP)">
X		<PARAM name="ip"
X			help="IP address of default gateway"
X			ptype="IP_ADDR"/>
X		<CONFIG priority="0x9000" splitter="false"/>
X		<ACTION>
X			route -n get default >/dev/null 2>&amp;1 &amp;&amp; route change default ${ip} || route add default ${ip}
X		</ACTION>
X	</COMMAND>
X
X	<COMMAND name="no ip default-gateway"
X		help="Specify default gateway (if not routing IP)">
X		<CONFIG operation="unset" pattern="^ip default-gateway"/>
X		<ACTION>
X			route delete default
X		</ACTION>
X	</COMMAND>
X
X<!-- Static route -->
X	<COMMAND name="ip route"
X		help="Establish static routes">
X		<PARAM name="ip"
X			help="Destination prefix"
X			ptype="IP_ADDR_MASK"/>
X		<PARAM name="route_target"
X			help="Route target"
X			ptype="STRING"
X			mode="switch">
X			<PARAM name="dev"
X				help="to interfaces"
X				ptype="SUBCOMMAND"
X				mode="subcommand">
X					<PARAM name="iface_any"
X						help="Target interface"
X						completion="${Get_if_all}"
X						ptype="IFACE_SYS"/>
X			</PARAM>
X			<PARAM name="forward"
X				help="Forwarding router's address"
X				ptype="IP_ADDR"/>
X		</PARAM>
X		<CONFIG priority="0x9002" pattern="^ip route ${ip} " splitter="false"/>
X		<ACTION>
X		if test "${route_target}" = "dev"; then
X			route change -inet ${ip} -interface ${iface_any} 2>/dev/null || route add -inet ${ip} -interface ${iface_any}
X			exit $?
X		elif test "${route_target}" = "forward"; then
X			route change -inet ${ip} ${forward} 2>/dev/null || route add -inet ${ip} ${forward}
X			exit $?
X		fi
X		</ACTION>
X	</COMMAND>
X
X	<COMMAND name="no ip route"
X		help="Establish static routes">
X		<PARAM name="ip"
X			help="Destination prefix"
X			ptype="IP_ADDR_MASK"/>
X		<CONFIG operation="unset" pattern="^ip route ${ip} "/>
X		<ACTION>
X			route delete -inet ${ip}
X		</ACTION>
X	</COMMAND>
X
X<!-- blackhole/ -->
X	<COMMAND name="ip route blackhole"
X			help="Blackhole routes">
X		<PARAM name="ip"
X			help="IP address to blackhole"
X			ptype="IP_ADDR_ANY"/>
X		<CONFIG priority="0x9003" pattern="ip route blackhole ${ip}" splitter="false"/>
X		<ACTION>
X			route add -inet ${ip} 127.0.0.1 -blackhole
X		</ACTION>
X	</COMMAND>
X
X	<COMMAND name="no ip route blackhole"
X			help="Specify default gateway (if not routing IP)">
X		<PARAM name="ip"
X			help="IP address to blackhole"
X			ptype="IP_ADDR_ANY"/>
X		<CONFIG operation="unset" pattern="ip route blackhole ${ip}"/>
X		<ACTION>
X			route delete -inet ${ip}
X		</ACTION>
X	</COMMAND>
X
X</VIEW>
X
X</CLISH_MODULE>
fd79148e07ef55f8e43f44fb24b304fc
echo x - net/titian/files/tree/conf-route6.xml
sed 's/^X//' >net/titian/files/tree/conf-route6.xml << '86261f4d08feda1e102d5f01fae81fcf'
X<?xml version="1.0" encoding="UTF-8"?>
X<CLISH_MODULE xmlns="http://clish.sourceforge.net/XMLSchema"
X          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
X xsi:schemaLocation="http://clish.sourceforge.net/XMLSchema
X                     http://clish.sourceforge.net/XMLSchema/clish.xsd">
X	<!--=======================================================-->
X	<!-- TITIAN Fase 1: keluarga perintah IPv6 (baru; padanan v4
X	     tetap di conf-route.xml Linux / conf-route-fbsd.xml).
X	     Aksi lewat titian-route.sh (cabang Linux ip -6 /
X	     FreeBSD route -6). -->
X
X<VIEW name="configure-view">
X
X    <COMMAND name="ipv6"
X        help="IPv6 configuration"/>
X
X    <COMMAND name="no ipv6"
X        help="Negate IPv6 commands"/>
X
X<!-- Default gateway IPv6 -->
X	<COMMAND name="ipv6 default-gateway"
X		help="Specify IPv6 default gateway">
X		<PARAM name="ip"
X			help="IPv6 address of default gateway"
X			ptype="IP6_ADDR"/>
X		<CONFIG priority="0x9000" splitter="false"/>
X		<ACTION>
X			${RT_SBIN}/titian-route.sh gw6 "${ip}"
X		</ACTION>
X	</COMMAND>
X
X	<COMMAND name="no ipv6 default-gateway"
X		help="Remove IPv6 default gateway">
X		<CONFIG operation="unset" pattern="^ipv6 default-gateway"/>
X		<ACTION>
X			${RT_SBIN}/titian-route.sh gw6-del
X		</ACTION>
X	</COMMAND>
X
X<!-- Static route IPv6 -->
X	<COMMAND name="ipv6 route"
X		help="Establish IPv6 static routes">
X		<PARAM name="ip"
X			help="Destination prefix"
X			ptype="IP6_ADDR_MASK"/>
X		<PARAM name="route_target"
X			help="Route target"
X			ptype="STRING"
X			mode="switch">
X			<PARAM name="dev"
X				help="to interfaces"
X				ptype="SUBCOMMAND"
X				mode="subcommand">
X					<PARAM name="iface_any"
X						help="Target interface"
X						completion="${Get_if_all}"
X						ptype="IFACE_SYS"/>
X			</PARAM>
X			<PARAM name="forward"
X				help="Forwarding router's address"
X				ptype="IP6_ADDR"/>
X		</PARAM>
X		<CONFIG priority="0x9002" pattern="^ipv6 route ${ip} " splitter="false"/>
X		<ACTION>
X		if test "${route_target}" = "dev"; then
X			${RT_SBIN}/titian-route.sh route6-dev "${ip}" "${iface_any}"
X			exit $?
X		elif test "${route_target}" = "forward"; then
X			${RT_SBIN}/titian-route.sh route6-via "${ip}" "${forward}"
X			exit $?
X		fi
X		</ACTION>
X	</COMMAND>
X
X	<COMMAND name="no ipv6 route"
X		help="Remove IPv6 static routes">
X		<PARAM name="ip"
X			help="Destination prefix"
X			ptype="IP6_ADDR_MASK"/>
X		<CONFIG operation="unset" pattern="^ipv6 route ${ip} "/>
X		<ACTION>
X			${RT_SBIN}/titian-route.sh route6-del "${ip}"
X		</ACTION>
X	</COMMAND>
X
X<!-- blackhole IPv6 -->
X	<COMMAND name="ipv6 route blackhole"
X			help="Blackhole IPv6 routes">
X		<PARAM name="ip"
X			help="IPv6 address to blackhole"
X			ptype="IP6_ADDR_ANY"/>
X		<CONFIG priority="0x9003" pattern="ipv6 route blackhole ${ip}" splitter="false"/>
X		<ACTION>
X			${RT_SBIN}/titian-route.sh route6-blackhole "${ip}"
X		</ACTION>
X	</COMMAND>
X
X	<COMMAND name="no ipv6 route blackhole"
X			help="Remove blackhole IPv6 routes">
X		<PARAM name="ip"
X			help="IPv6 address to blackhole"
X			ptype="IP6_ADDR_ANY"/>
X		<CONFIG operation="unset" pattern="ipv6 route blackhole ${ip}"/>
X		<ACTION>
X			${RT_SBIN}/titian-route.sh route6-blackhole-del "${ip}"
X		</ACTION>
X	</COMMAND>
X
X</VIEW>
X
X</CLISH_MODULE>
86261f4d08feda1e102d5f01fae81fcf
echo x - net/titian/files/tree/conf-router.xml
sed 's/^X//' >net/titian/files/tree/conf-router.xml << '63d7f4499b5806586dae420e2a949358'
X<?xml version="1.0" encoding="UTF-8"?>
X<CLISH_MODULE xmlns="http://clish.sourceforge.net/XMLSchema"
X          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
X xsi:schemaLocation="http://clish.sourceforge.net/XMLSchema
X                     http://clish.sourceforge.net/XMLSchema/clish.xsd">
X    <!--=======================================================-->
X    <!-- router bird / router frr — BSDRP port (BARU).
X         Aturan keras (feature-list §2-§3, klish-bird2-bird3.md §2f):
X         BIRD dan FRR TIDAK BOLEH aktif bersamaan. `enable` di sini
X         hanya mencatat niat + menandai dirty; service baru naik saat
X         `commit` (titian-commit.sh), yang memeriksa ulang konflik di
X         sana. `enable` juga memeriksa konflik langsung saat dimasukkan
X         (peringatan + tolak bila lawan jalan).
X         `router bird threads` hanya bird3 — di bird2 ditolak backend
X         dengan pesan jelas (klish-bird2-bird3.md §2c).
X         JANGAN buat perintah `cli` di sini — itu milik FRR/vtysh. -->
X
X<VIEW name="configure-view">
X    <COMMAND name="router"
X        help="Routing daemon configuration (bird / frr)"/>
X
X    <COMMAND name="no router"
X        help="Negate router configuration"/>
X    <COMMAND name="no router bird"
X        help="Negate BIRD router configuration"/>
X    <COMMAND name="no router frr"
X        help="Negate FRR router configuration"/>
X
X    <COMMAND name="router bird"
X        help="BIRD routing daemon (BGP/OSPF/static)"/>
X
X    <COMMAND name="router bird enable"
X        help="Enable BIRD (pending commit — service naik saat commit; diblokir bila FRR jalan)">
X        <CONFIG priority="0x1500" pattern="^${__line}$"/>
X        <ACTION>
X            ${RT_SBIN}/titian-bird.sh bird-enable
X        </ACTION>
X    </COMMAND>
X    <COMMAND name="no router bird enable"
X        help="Disable BIRD (pending commit — service berhenti saat commit)">
X        <CONFIG operation="unset" pattern="^router bird enable"/>
X        <ACTION>
X            ${RT_SBIN}/titian-bird.sh bird-disable
X        </ACTION>
X    </COMMAND>
X
X    <COMMAND name="router bird threads"
X        help="BIRD 3 worker threads (hanya bird3; di bird2 ditolak)">
X        <PARAM name="count"
X            help="jumlah thread 1-32"
X            ptype="UINT"/>
X        <CONFIG pattern="^${__line}$"/>
X        <ACTION>
X            ${RT_SBIN}/titian-bird.sh set-threads "${count}"
X        </ACTION>
X    </COMMAND>
X
X    <COMMAND name="router frr enable"
X        help="Enable FRR (pending commit — service naik saat commit; diblokir bila BIRD jalan)">
X        <CONFIG priority="0x1510" pattern="^${__line}$"/>
X        <ACTION>
X            ${RT_SBIN}/titian-frr.sh frr-enable
X        </ACTION>
X    </COMMAND>
X    <COMMAND name="no router frr enable"
X        help="Disable FRR (pending commit — service berhenti saat commit)">
X        <CONFIG operation="unset" pattern="^router frr enable"/>
X        <ACTION>
X            ${RT_SBIN}/titian-frr.sh frr-disable
X        </ACTION>
X    </COMMAND>
X</VIEW>
X
X</CLISH_MODULE>
63d7f4499b5806586dae420e2a949358
echo x - net/titian/files/tree/conf-serv-ssh.xml
sed 's/^X//' >net/titian/files/tree/conf-serv-ssh.xml << 'c98a2118a2131d81fc6f25deed5992ba'
X<?xml version="1.0" encoding="UTF-8"?>
X<CLISH_MODULE xmlns="http://clish.sourceforge.net/XMLSchema" 
X          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
X xsi:schemaLocation="http://clish.sourceforge.net/XMLSchema
X                     http://clish.sourceforge.net/XMLSchema/clish.xsd">
X    <!--=======================================================-->
X
X<VIEW name="configure-view">
X
X    <COMMAND name="service"
X        help="Service parameters"/>
X
X    <COMMAND name="service ssh"
X            help="Secure SHell (SSH) protocol"
X            view="configure-ssh-view"
X            viewid="sysview=ssh"
X            ptype="SUBCOMMAND"
X            mode="subcommand">
X        <CONFIG priority="0x1200" pattern="^${__line}$"/>
X        <ACTION>
X            ${RT_SBIN}/titian-sys.sh ssh-check
X        </ACTION>
X    </COMMAND>
X
X</VIEW>
X
X<VIEW name="configure-ssh-view"
X    prompt="${SYSTEM_NAME}(config-system-${sysview})# "
X    depth="1">
X
X<!-- Inheritance -->
X    <NAMESPACE ref="configure-view"
X        help="false"
X        completion="true"/>
X
X    <COMMAND name="exit"
X        help="Exit configuration mode"
X        lock="false">
X        <ACTION builtin="clish_nested_up"/>
X    </COMMAND>
X    <HOTKEY key="^Z" cmd="exit"/>
X
X    <COMMAND name="no"
X        help="Negate a command or set its defaults"/>
X
X    <COMMAND name="port"
X            help="Port for SSH service">
X            <PARAM name="Port"
X                help="[0-9]+"
X                ptype="SERVICE"/>
X        <CONFIG/>
X        <ACTION>
X            Cur_set=$(egrep -v "^#" /etc/ssh/sshd_config |grep ^Port |awk '{print $2}')
X            if [ "$Cur_set" = "${Port}" ]; then
X                exit 0
X            fi
X            ${RT_SBIN}/titian-sys.sh port-in-use "${Port}"
X            if grep -q '^Port' /etc/ssh/sshd_config; then
X                ${RT_SBIN}/titian-sys.sh sed-replace /etc/ssh/sshd_config "s|^Port.*|Port ${Port}|"
X            else
X                echo "Port ${Port}" >> /etc/ssh/sshd_config
X            fi
X            ${RT_SBIN}/titian-sys.sh ssh-restart
X        </ACTION>
X    </COMMAND>
X
X    <COMMAND name="allow-root"
X          help="Enable root login over ssh">
X        <CONFIG/>
X        <ACTION>
X            Cur_set=$(egrep -v "^#" /etc/ssh/sshd_config |grep PermitRootLogin |awk '{print $2}')
X            if [ "$Cur_set" = "yes" ]; then
X                exit 0
X            fi
X            if grep -q '^PermitRootLogin' /etc/ssh/sshd_config; then
X                ${RT_SBIN}/titian-sys.sh sed-replace /etc/ssh/sshd_config "s|^PermitRootLogin.*|PermitRootLogin yes|"
X            else
X                echo "PermitRootLogin yes" >> /etc/ssh/sshd_config
X            fi
X            ${RT_SBIN}/titian-sys.sh ssh-restart
X        </ACTION>
X    </COMMAND>
X    <COMMAND name="no allow-root"
X          help="Disable root login over ssh">
X        <CONFIG operation="unset" pattern="^allow-root"/>
X            <ACTION>
X            Cur_set=$(egrep -v "^#" /etc/ssh/sshd_config |grep PermitRootLogin |awk '{print $2}')
X            if [ "$Cur_set" = "no" ]; then
X                exit 0
X            fi
X            if grep -q '^PermitRootLogin' /etc/ssh/sshd_config; then
X                ${RT_SBIN}/titian-sys.sh sed-replace /etc/ssh/sshd_config "s|^PermitRootLogin.*|PermitRootLogin no|"
X            else
X                echo "PermitRootLogin no" >> /etc/ssh/sshd_config
X            fi
X            ${RT_SBIN}/titian-sys.sh ssh-restart
X            </ACTION>
X    </COMMAND>
X
X    <COMMAND name="disable-host-validation"
X          help="Don't validate the remote host name with DNS">
X        <CONFIG/>
X        <ACTION>
X            Cur_stat=$(egrep -v "^#" /etc/ssh/sshd_config |egrep "^UseDNS" |awk '{print $2}')
X            if [ -z "$Cur_stat" ]; then
X                echo "UseDNS no" >> /etc/ssh/sshd_config
X                ${RT_SBIN}/titian-sys.sh ssh-restart
X            elif [ "$Cur_stat" = "no" ]; then
X                exit 0
X            else 
X                ${RT_SBIN}/titian-sys.sh sed-replace /etc/ssh/sshd_config "s|^UseDNS.*|UseDNS no|"
X                ${RT_SBIN}/titian-sys.sh ssh-restart
X            fi
X        </ACTION>
X    </COMMAND>
X    <COMMAND name="no disable-host-validation"
X          help="Validate the remote host name with DNS">
X        <CONFIG operation="unset" pattern="^disable-host-validation"/>
X            <ACTION>
X            Cur_stat=$(egrep -v "^#" /etc/ssh/sshd_config |egrep "^UseDNS" |awk '{print $2}')
X            if [ -z "$Cur_stat" ]; then
X                echo "UseDNS yes" >> /etc/ssh/sshd_config
X                ${RT_SBIN}/titian-sys.sh ssh-restart
X            elif [ "$Cur_stat" = "yes" ]; then
X                exit 0
X            else
X                ${RT_SBIN}/titian-sys.sh sed-replace /etc/ssh/sshd_config "s|^UseDNS.*|UseDNS yes|"
X                ${RT_SBIN}/titian-sys.sh ssh-restart
X            fi
X            </ACTION>
X    </COMMAND>
X
X</VIEW>
X</CLISH_MODULE>
c98a2118a2131d81fc6f25deed5992ba
echo x - net/titian/files/tree/conf-sys-dns.xml
