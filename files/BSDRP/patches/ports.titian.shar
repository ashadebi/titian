X                     http://clish.sourceforge.net/XMLSchema/clish.xsd">
X    <!--=======================================================-->
X	<PTYPE name="VLAN_ID" 
X		pattern="(409[0-5]|40[0-8][0-9]|[1-3][0-9]{3}|[1-9][0-9]{2}|[1-9][0-9]|[1-9])"
X		help="Number in the range 1-4095"/>
X	<!--=======================================================-->
X	<PTYPE name="IP_ADDR"
X		pattern="(((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?))"
X		help="A.B.C.D"/>
X	<!--=======================================================-->
X	<PTYPE name="UINT"
X		pattern="[0-9]+"
X		help="Unsigned integer"/>
X	<!--=======================================================-->
X	<PTYPE name="STRING"
X		pattern=".+"
X		help="String"/>
X	<!--=======================================================-->
X	<PTYPE name="SUBCOMMAND"
X		pattern="[^\]+"
X		help="String"/>
X	<!--=======================================================-->
X	<PTYPE name="BOOL"
X		method="select"
X		pattern="true(1) false(0)"
X		help="Boolean choice"/>
X	<!--=======================================================-->
X	<PTYPE name="IFACE_NUM"
X		pattern="[0-9]+"
X		help="Interface number"/>
X	<!--=======================================================-->
X	<PTYPE name="PROTO"
X		method="select"
X		pattern="ip(ip) ipencap(ipencap) icmp(icmp) igmp(igmp) tcp(tcp) udp(udp)"
X		help="Protocol choice"/>
X	<!--=======================================================-->
X	<PTYPE name="SERVICE"
X		pattern="((ftp)|(telnet)|(sntp)|(smtp)|(http)|([0-9]+))"
X		help="Port"/>
X	<!--=======================================================-->
X	<PTYPE name="IP_ADDR_MASK"
X		pattern="(((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?))(/(1[0-9]|2[0-9]|3[0-2]|[0-9]))?"
X		help="A.B.C.D[/mask]"/>
X	<!--=======================================================-->
X	<PTYPE name="IP_ADDR_ANY"
X		pattern="(((((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?))(/(1[0-9]|2[0-9]|3[0-2]|[0-9]))?)|any)"
X		help="A.B.C.D[/mask] or any"/>
X	<!--=======================================================-->
X	<PTYPE name="PORT_MASK_ANY"
X		pattern="^(([0-9]+(/0x[0-9a-f]+)?)|(any))$"
X		help="Port[/mask]" />
X	<!--=======================================================-->
X	<PTYPE name="SEQ"
X		pattern="^[0-9]*[1-9][0-9]*"
X		help="Entry number"/>
X	<!--=======================================================-->
X
X</CLISH_MODULE>
