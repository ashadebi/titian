X# TITIAN bird.d/protocol.conf — device + kernel.
X# Lab: import/export none (BIRD tidak menyentuh tabel kernel);
X# produksi: sesuaikan import/export di sini lalu `generate protocol`.
Xprotocol device {
X    scan time 10;
X}
X
Xprotocol kernel {
X    ipv4 { import none; export none; };
X}
Xprotocol kernel {
X    ipv6 { import none; export none; };
X}
