X#!/bin/sh
X# TITIAN — dibuka ulang file log BIRD sesudah newsyslog merotasi.
X# Dijalankan newsyslog sebagai root (flag R di titian-bird.conf).
X# BIRD membuka ulang file log saat reconfigure.
X/usr/local/sbin/birdc configure >/dev/null 2>&1 || true
1f08418f394c48087030695b4500c067
echo x - net/titian/files/newsyslog/titian-bird.conf
sed 's/^X//' >net/titian/files/newsyslog/titian-bird.conf << '86f4bbea42d4662c9264a2e87d296bca'
X# TITIAN — rotasi log BIRD via newsyslog (FreeBSD).
X# Pasang di /usr/local/etc/newsyslog.conf.d/titian-bird.conf.
X# Default: harian (@T00), simpan 3 arsip terkompresi gzip (Z) + file aktif.
X# Ubah sesuai keinginan: "@T00" -> "@W0T00" untuk mingguan,
X# angka "3" -> jumlah arsip yang disimpan.
X# Flag R: sesudah rotasi, jalankan titian-bird-reopen (birdc configure)
X# supaya BIRD membuka ulang file log yang baru.
X/var/log/bird/bird.log 644 3 * @T00 ZR /usr/local/sbin/titian-bird-reopen
86f4bbea42d4662c9264a2e87d296bca
echo x - net/titian/files/rc.d/firewall
sed 's/^X//' >net/titian/files/rc.d/firewall << '0386190da3481a7ae2d2ce6d2c4b0664'
X#!/bin/sh
X# PROVIDE: firewall
X# REQUIRE: netif pf
X# KEYWORD: shutdown
X#
X# firewall (BSDRP_klish) — apply pf firewall + NAT anchors at boot.
X# BSDRP port: backend is /opt/titian/sbin/titian-fw.sh (merged firewall-cfg
X# + firewall-apply); `apply` = full rebuild, `apply --flush` = flush anchors.
X# Config: /usr/local/etc/firewall.conf (written by klish).
X# Enable: firewall_enable="YES" in rc.conf (set by klish commit hook via
X# sysrc when `firewall enable` is committed).
X#
X# This script does NOT disable pf when firewall is disabled: the
X# traffic-shape subsystem may still need it. `service firewall stop`
X# only flushes the firewall + nat anchors.
X. /etc/rc.subr
X
Xname="firewall"
Xrcvar="firewall_enable"
Xcommand="/opt/titian/sbin/titian-fw.sh"
Xload_rc_config $name
X
X: ${firewall_enable:="NO"}
X
Xstart_cmd="firewall_start"
Xstop_cmd="firewall_stop"
Xextra_commands="reload"
Xreload_cmd="firewall_start"
X
Xfirewall_start()
X{
X    if ! kldstat -q -m pf 2>/dev/null; then
X        kldload pf || { echo "firewall: cannot load pf module"; return 1; }
X    fi
X    $command apply
X}
X
Xfirewall_stop()
X{
X    $command apply --flush
X}
X
Xrun_rc_command "$1"
0386190da3481a7ae2d2ce6d2c4b0664
echo x - net/titian/files/rc.d/traffic-shape
sed 's/^X//' >net/titian/files/rc.d/traffic-shape << '4b1d54a73151e108ee1f21ef05eba0e0'
X#!/bin/sh
X# PROVIDE: traffic-shape
X# REQUIRE: netif pf
X# KEYWORD: nojail
X#
X# traffic-shape — dummynet bandwidth limiter (klish).
X# BSDRP port: backend is /opt/titian/sbin/titian-traffic-shape.sh
X# (merged traffic-shape-cfg + traffic-shape-apply).
X# Applies /usr/local/etc/traffic-shape.conf at boot via
X# /usr/local/sbin/traffic-shape-apply.
X#
X# Add to /etc/rc.conf:
X#   traffic_shape_enable="YES"
X#
X# BSDRP_klish, prepared 2026-11-08.
X
X. /etc/rc.subr
X
Xname="traffic_shape"
Xdesc="Dummynet traffic shaping (klish)"
Xrcvar="traffic_shape_enable"
X
Xload_rc_config $name
X
X: ${traffic_shape_enable:="NO"}
X: ${traffic_shape_config:="/usr/local/etc/traffic-shape.conf"}
X: ${traffic_shape_program:="/opt/titian/sbin/titian-traffic-shape.sh"}
X
Xstart_cmd="traffic_shape_start"
Xstop_cmd="traffic_shape_stop"
Xextra_commands="reload"
Xreload_cmd="traffic_shape_start"
X
Xtraffic_shape_start() {
X    "$traffic_shape_program" apply "$traffic_shape_config"
X}
X
Xtraffic_shape_stop() {
X    "$traffic_shape_program" apply --flush
X}
X
Xrun_rc_command "$1"
4b1d54a73151e108ee1f21ef05eba0e0
echo x - net/titian/files/sbin/titian-bird.sh
