X                mode="subcommand">
X            <PARAM name="Name"
X                help="nama queue"
X                ptype="TS_NAME"/>
X            <CONFIG priority="0x1320" pattern="^queue ${Name}$"/>
X            <ACTION>
X                ${RT_SBIN}/titian-traffic-shape.sh check-queue "${Name}"
X            </ACTION>
X        </COMMAND>
X        <COMMAND name="no queue"
X                help="Delete a dummynet queue">
X            <PARAM name="Name"
X                help="nama queue"
X                ptype="TS_NAME"/>
X            <CONFIG operation="unset" pattern="^queue ${Name}"/>
X            <ACTION>
X                ${RT_SBIN}/titian-traffic-shape.sh del-queue "${Name}"
X            </ACTION>
X        </COMMAND>
X
