echo x - net/titian/files/tree/conf-if-vlan-fbsd.xml
sed 's/^X//' >net/titian/files/tree/conf-if-vlan-fbsd.xml << 'c6d99fd382b82b394cc66ed368e06f01'
X<?xml version="1.0" encoding="UTF-8"?>
X<CLISH_MODULE xmlns="http://clish.sourceforge.net/XMLSchema"
X          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
X xsi:schemaLocation="http://clish.sourceforge.net/XMLSchema
X                     http://clish.sourceforge.net/XMLSchema/clish.xsd">
X    <!--=======================================================-->
X    <!-- TITIAN Fase 1: padanan FreeBSD dari conf-if-vlan.xml.
X         FreeBSD menamai vlan sebagai vlan<N> (bukan parent.tag);
X         perintah: interface vlan <id> <parent>. -->
X
X<VIEW name="configure-view">
X
X    <COMMAND name="interface vlan"
X        help="vlan interface"
X        view="configure-vlan-view"
X        viewid="iface=vlan${vlan_id}">
X        <PARAM name="vlan_id"
X            help="VLAN id 1-4094"
X            ptype="VLAN_ID"/>
X        <PARAM name="parent"
X            help="Parent interface"
X            completion="${Get_if_eth}"
X            ptype="IFACE_SYS"/>
X        <CONFIG priority="0x2200" pattern="^${__line}$"/>
X        <ACTION>
X            if ! ifconfig "${parent}" >/dev/null 2>&amp;1; then
X                printf "%s \n" "Error: interface ${parent} tidak ditemukan di sistem (lihat 'show interfaces' untuk daftar)."
X                exit 33
X            fi
X            if ! ifconfig "vlan${vlan_id}" >/dev/null 2>&amp;1; then
X                if ! ifconfig "vlan${vlan_id}" create vlan ${vlan_id} vlandev ${parent}; then
X                    printf "%s \n" "Error: gagal membuat vlan${vlan_id} pada ${parent}.."
X                    exit 33
X                fi
X                ${RT_SBIN}/titian-persist.sh mark-if "vlan${vlan_id}"
X            fi
X        </ACTION>
X    </COMMAND>
X
X<!-- no vlan config-->
X    <COMMAND name="no interface vlan"
X            help="delete vlan interface">
X            <PARAM name="vlan_id"
X                help="VLAN id 1-4094"
X                ptype="VLAN_ID"/>
X        <CONFIG operation="unset" pattern="interface vlan ${vlan_id} "/>
X        <ACTION>
X            if ifconfig "vlan${vlan_id}" >/dev/null 2>&amp;1; then
X                ifconfig "vlan${vlan_id}" destroy
X                ${RT_SBIN}/titian-persist.sh drop-if "vlan${vlan_id}"
X            else
X                printf "%s \n" "vlan${vlan_id} not found.."
X                exit 0
X            fi
X        </ACTION>
X    </COMMAND>
X
X</VIEW>
X
X<VIEW name="configure-vlan-view"
X    prompt="${SYSTEM_NAME}(config-vlan-${iface})# "
X    depth="1">
X    <COMMAND name="ipv6"
X        help="Interface IPv6 config commands"/>
X
X    <COMMAND name="no ipv6"
X        help="Negate IPv6 commands"/>
X
X
X<!-- Inheritance -->
X    <NAMESPACE ref="configure-view"
X        help="false"
X        completion="true"/>
X
X<!-- configure-vlan-view commands -->
X    <COMMAND name="exit"
X        help="Exit from interface configuration mode"
X        lock="false">
X        <ACTION builtin="clish_nested_up"/>
X    </COMMAND>
X    <HOTKEY key="^Z" cmd="exit"/>
X
X    <COMMAND name="no"
X        help="Negate a command or set its defaults"/>
X
X    <COMMAND name="ip"
X        help="Interface Internet Protocol config commands"/>
X
X    <COMMAND name="no ip"
X        help="Interface Internet Protocol config commands"/>
X
X<!-- Enable/Disable -->
X    <COMMAND name="disable"
X          help="Disable the selected interface">
X        <CONFIG operation="unset" pattern="^enable"/>
X        <ACTION>
X            ifconfig ${iface} down
X        </ACTION>
X    </COMMAND>
X
X    <COMMAND name="enable"
X        help="Enable the selected interface">
X        <CONFIG/>
X        <ACTION>
X            ifconfig ${iface} up
X        </ACTION>
X    </COMMAND>
X
X<!-- IP address -->
X    <COMMAND name="ip address"
X            help="Set the IP address of an interface">
X            <PARAM name="ip"
X                help="IP address"
X                ptype="IP_ADDR_MASK_OPT"/>
X        <PARAM name="peer"
X                help="Peer address for point-to-point link (ex: ip address 103.50.128.1 peer 10.10.10.10)"
X                optional="true"
X                mode="subcommand"
X                ptype="SUBCOMMAND">
X            <PARAM name="peer_ip"
X                help="Peer IP address"
X                ptype="IP_ADDR"/>
X        </PARAM>
X        <CONFIG pattern="ip address ${ip}" splitter="false"/>
X        <ACTION>
X            ${RT_SBIN}/titian-if.sh addr-add "${iface}" "${ip}" "${peer_ip}" &amp;&amp; ${RT_SBIN}/titian-persist.sh sync-if "${iface}"
X        </ACTION>
X    </COMMAND>
X
X    <COMMAND name="no ip address"
X           help="Delete IP address of an interface"
X           lock="false">
X           <PARAM name="ip"
X                help="IP address"
X                ptype="IP_ADDR_MASK_OPT"/>
X        <PARAM name="peer"
X                help="Peer address for point-to-point link"
X                optional="true"
X                mode="subcommand"
X                ptype="SUBCOMMAND">
X            <PARAM name="peer_ip"
X                help="Peer IP address"
X                ptype="IP_ADDR"/>
X        </PARAM>
X        <CONFIG operation="unset" pattern="ip address ${ip}"/>
X        <ACTION>
X            ${RT_SBIN}/titian-if.sh addr-del "${iface}" "${ip}" "${peer_ip}" &amp;&amp; ${RT_SBIN}/titian-persist.sh sync-if "${iface}"
X        </ACTION>
X    </COMMAND>
X
X<!-- IPv6 address (TITIAN Fase 1; tanpa peer di FreeBSD — gated) -->
X    <COMMAND name="ipv6 address"
X            help="Set the IPv6 address of an interface">
X            <PARAM name="ip"
X                help="IPv6 address"
X                ptype="IP6_ADDR_MASK_OPT"/>
X        <CONFIG pattern="ipv6 address ${ip}" splitter="false"/>
X        <ACTION>
X            ${RT_SBIN}/titian-if.sh addr6-add "${iface}" "${ip}" "" &amp;&amp; ${RT_SBIN}/titian-persist.sh sync-if "${iface}"
X        </ACTION>
X    </COMMAND>
X
X    <COMMAND name="no ipv6 address"
X           help="Delete IPv6 address of an interface"
X           lock="false">
X           <PARAM name="ip"
X                help="IPv6 address"
X                ptype="IP6_ADDR_MASK_OPT"/>
X        <CONFIG operation="unset" pattern="ipv6 address ${ip}"/>
X        <ACTION>
X            ${RT_SBIN}/titian-if.sh addr6-del "${iface}" "${ip}" "" &amp;&amp; ${RT_SBIN}/titian-persist.sh sync-if "${iface}"
X        </ACTION>
X    </COMMAND>
X
X    <COMMAND name="description"
X            help="human-readable Alias link description">
X        <PARAM name="desc"
X              help="Description/Alias"
X              ptype="STRING"/>
X        <CONFIG/>
X        <ACTION>
X            ifconfig ${iface} description "${desc}"
X        </ACTION>
X    </COMMAND>
X
X    <COMMAND name="mtu"
X              help="MTU: ukuran paket terbesar lewat interface (live + persisten). 1500 = default Ethernet; 9000 = jumbo, wajib didukung seluruh path.">
X            <PARAM name="mtu"
X                help="range 68-9000"
X                ptype="MTU"/>
X        <CONFIG pattern="^mtu"/>
X        <ACTION>
X            ${RT_SBIN}/titian-tune.sh mtu "${iface}" "${mtu}"
X        </ACTION>
X    </COMMAND>
X
X    <COMMAND name="no mtu"
X              help="Hapus setelan MTU Titian (kembali ke nilai sebelum di-set Titian (umumnya 1500); cermin bersih)">
X        <CONFIG operation="unset" pattern="^mtu"/>
X        <ACTION>
X            ${RT_SBIN}/titian-tune.sh mtu-del "${iface}"
X        </ACTION>
X    </COMMAND>
X
X<!-- Depth2 options FreeBSD (tso/lro/rx/tx via ifconfig) -->
X    <COMMAND name="options"
X            help="Offload parameter (tso/lro/rx/tx via ifconfig)"
X            view="configure-if-options-fbsd"
X            viewid="iface=${iface}">
X            <CONFIG pattern="^${__line}$"/>
X    </COMMAND>
X
X</VIEW>
X</CLISH_MODULE>
