echo x - net/titian/files/sbin/titian-monitoring.sh
sed 's/^X//' >net/titian/files/sbin/titian-monitoring.sh << '8e6f6f0f1eb4113e7bc4951340a79e31'
X#!/bin/sh
X# TITIAN BSDRP — monitoring: snmpd / node_exporter / bird_exporter / nfacctd.
X# Semua OFF by default (feature-list §9). `set` hanya mencatat niat di
X# $ROOT/etc/netstate/monitoring.intent + menandai dirty; service
X# naik/berhenti saat `commit` (apply di sini). Community SNMP ditulis
X# ke /usr/local/etc/snmp/snmpd.conf saat apply (rocommunity).
X# Format intent:
X#   snmp yes|no
X#   node-exporter yes|no
X#   bird-exporter yes|no
X#   nfacctd yes|no
X#   snmp-community <string>
X# Nama rc script yang dipakai (snmpd, node_exporter, bird_exporter,
X# nfacctd) + port default (161/udp, 9100, 9324, 2100) — verifikasi live
X# di guest: nama service/port bisa berbeda menurut port yang terpasang.
X# POSIX sh.
XROOT=${TITIAN_ROOT:-/opt/titian}
XINTENT="$ROOT/etc/netstate/monitoring.intent"
XDIRTY=/var/run/monitoring.dirty
XSNMP_CONF=/usr/local/etc/snmp/snmpd.conf
XPROG="titian-monitoring"
Xerr() { echo "Error($PROG): $*" >&2; exit 33; }
Xdie() { echo "$PROG: $*" >&2; exit 1; }
X
Xsvc_name() {
X    case "$1" in
X        snmp) echo "snmpd" ;;
X        node-exporter) echo "node_exporter" ;;
X        bird-exporter) echo "bird_exporter" ;;
X        nfacctd) echo "nfacctd" ;;
X        *) die "service tidak dikenal: $1 (snmp|node-exporter|bird-exporter|nfacctd)" ;;
X    esac
X}
X
Xsvc_port() {
X    case "$1" in
X        snmp) echo "161/udp" ;;
X        node-exporter) echo "9100" ;;
X        bird-exporter) echo "9324" ;;
X        nfacctd) echo "2100" ;;
X    esac
X}
X
Xtouch_intent() {
X    mkdir -p "$(dirname "$INTENT")" 2>/dev/null
X    if [ ! -f "$INTENT" ]; then
X        printf '# monitoring.intent - generated by klish, do not edit by hand\nsnmp no\nnode-exporter no\nbird-exporter no\nnfacctd no\nsnmp-community bsdrp-ro\n' > "$INTENT" \
X            || die "cannot create $INTENT"
X    fi
X}
X
Xmark_dirty() { touch "$DIRTY" 2>/dev/null || true; }
X
Xintent_val() {
X    touch_intent
X    _v=$(sed -n "s/^$1 //p" "$INTENT" 2>/dev/null | head -1)
X    printf '%s' "${_v:-unset}"
X}
X
Xupsert() {
X    touch_intent
X    _tmp="$INTENT.tmp.$$"
X    grep -v "^$1 " "$INTENT" > "$_tmp" 2>/dev/null || true
X    printf '%s %s\n' "$1" "$2" >> "$_tmp"
X    mv "$_tmp" "$INTENT" || die "cannot write $INTENT"
X    mark_dirty
X}
X
Xsvc_running() {
X    # $1 = nama service rc; cek proses dulu (nama proses ~= nama service),
X    # lalu `service <name> status` bila ada.
X    _proc="$1"
X    case "$1" in snmpd) _proc="snmpd" ;; node_exporter) _proc="node_exporter" ;; bird_exporter) _proc="bird_exporter" ;; nfacctd) _proc="nfacctd" ;; esac
X    if command -v pgrep >/dev/null 2>&1; then
X        pgrep -x "$_proc" >/dev/null 2>&1 && return 0
X    fi
X    if command -v service >/dev/null 2>&1; then
X        service "$1" status >/dev/null 2>&1 && return 0
X    fi
X    return 1
X}
X
X# --- read-only ---
Xcmd_check() { touch_intent; exit 0; }
X
Xcmd_show() {
X    # $1 = kosong (semua) atau satu service
X    touch_intent
X    _list="snmp node-exporter bird-exporter nfacctd"
X    [ -n "${1:-}" ] && _list="$1"
X    for _s in $_list; do
X        _name=$(svc_name "$_s")
X        _want=$(intent_val "$_s")
X        _rc=$(command -v sysrc >/dev/null 2>&1 && sysrc -n "${_name}_enable" 2>/dev/null || echo "?")
X        if svc_running "$_name"; then _run="running"; else _run="not running"; fi
X        _port=$(svc_port "$_s")
X        if [ "$_s" = "snmp" ]; then
X            _comm=$(intent_val snmp-community)
X            echo "snmpd (port $_port): intent $_want, rc ${_rc:-?}, $_run, community ${_comm}"
X        else
X            echo "$_name (port $_port): intent $_want, rc ${_rc:-?}, $_run"
X        fi
X    done
X    exit 0
X}
X
X# --- mutations ---
Xcmd_set() {
X    # $1=service $2=yes|no
X    svc_name "$1" >/dev/null
X    case "$2" in yes|no) ;; *) die "set butuh yes|no" ;; esac
X    upsert "$1" "$2"
X    echo "monitoring $1 $2 (pending commit)"
X    exit 0
X}
X
Xcmd_set_community() {
X    case "$1" in ''|*' '*) die "community tidak boleh kosong/berspasi" ;; esac
X    upsert snmp-community "$1"
X    echo "monitoring snmp community diubah (pending commit — berlaku saat snmpd di-apply)"
X    exit 0
X}
X
X# --- apply (dipanggil commit) ---
Xcmd_apply() {
X    touch_intent
X    for _s in snmp node-exporter bird-exporter nfacctd; do
X        _name=$(svc_name "$_s")
X        _want=$(intent_val "$_s")
X        [ "$_want" = "unset" ] && _want=no
X        if [ "$_s" = "snmp" ] && [ "$_want" = "yes" ]; then
X            _comm=$(intent_val snmp-community)
X            mkdir -p "$(dirname "$SNMP_CONF")" 2>/dev/null
X            {
X                echo "# snmpd.conf - generated by titian-monitoring.sh"
X                echo "rocommunity ${_comm:-bsdrp-ro}"
X                echo "syslocation BSDRP"
X                echo "syscontact admin"
X            } > "$SNMP_CONF.tmp.$$" || die "cannot write $SNMP_CONF"
X            mv "$SNMP_CONF.tmp.$$" "$SNMP_CONF" || die "cannot write $SNMP_CONF"
X            chmod 600 "$SNMP_CONF" 2>/dev/null || true
X        fi
X        if command -v sysrc >/dev/null 2>&1; then
X            if [ "$_want" = "yes" ]; then sysrc "${_name}_enable=YES" >/dev/null || err "sysrc ${_name}_enable gagal"
X            else sysrc "${_name}_enable=NO" >/dev/null || err "sysrc ${_name}_enable gagal"; fi
X        fi
X        if command -v service >/dev/null 2>&1; then
X            if [ "$_want" = "yes" ]; then
X                if svc_running "$_name"; then service "$_name" restart || err "service $_name restart gagal"
X                else service "$_name" start || err "service $_name start gagal"; fi
X                echo "monitoring: $_name enabled + running"
X            else
X                service "$_name" stop 2>/dev/null || true
X                echo "monitoring: $_name disabled + stopped"
X            fi
X        else
X            echo "(service tidak ada di host ini — lewati: $_name $_want)"
X        fi
X    done
X    rm -f "$DIRTY"
X    exit 0
X}
X
Xcase "${1:-}" in
X    check) cmd_check ;;
X    show) cmd_show "${2:-}" ;;
X    set) cmd_set "${2:-}" "${3:-}" ;;
X    set-community) cmd_set_community "${2:-}" ;;
X    apply) cmd_apply ;;
X    apply-all) cmd_apply ;;
X    *) echo "Usage: $0 {check|show [service]|set <service> yes|no|set-community <string>|apply} ..." >&2; exit 2 ;;
Xesac
