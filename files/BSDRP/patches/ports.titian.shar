echo x - net/titian/files/tree/conf-sys.xml
sed 's/^X//' >net/titian/files/tree/conf-sys.xml << '0a2908b5b496bb96619775019085dfb6'
X<?xml version="1.0" encoding="UTF-8"?>
X<CLISH_MODULE xmlns="http://clish.sourceforge.net/XMLSchema" 
X          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
X xsi:schemaLocation="http://clish.sourceforge.net/XMLSchema
X                     http://clish.sourceforge.net/XMLSchema/clish.xsd">
X	<!--=======================================================-->
X
X<VIEW name="configure-view">
X
X	<COMMAND name="system"
X		help="System parameters"/>
X	<COMMAND name="no system"
X		help="no System parameters"/>
X        
X<!-- hostname config (per OS lewat helper) -->
X	<COMMAND name="system hostname"
X		help="Set system's network name">
X		<PARAM name="hostname"
X			help="This system's network name"
X			ptype="STRING"/>
X		<CONFIG priority="0x1001" splitter="true"/>
X		<ACTION>
X			${RT_SBIN}/titian-sys.sh hostname "${hostname}"
X		</ACTION>
X	</COMMAND>
X
X<!-- nameservers config priority="0x1011" file: conf-sys-ns.xml  -->
X
X<!-- time-zone config -->
X	<COMMAND name="system time-zone"
X		help="Set time-zone">
X		<PARAM name="tz_method"
X			help=""
X			ptype="SUBCOMMAND"
X			mode="switch">
X			<PARAM name="Asia/Jakarta"
X				help="WIB|pulau jawa|dsk"
X				ptype="SUBCOMMAND"
X				mode="subcommand"/>
X			<PARAM name="Asia/Makassar"
X				help="WITA|bali|Singapore|Malaysia"
X				ptype="SUBCOMMAND"
X				mode="subcommand"/>
X			<PARAM name="UTC"
X				help="Universal Time Coordinated"
X				ptype="SUBCOMMAND"
X				mode="subcommand"/>
X		</PARAM>
X                <CONFIG priority="0x1021"/>
X		<ACTION>
X			${RT_SBIN}/titian-sys.sh timezone "${tz_method}"
X		</ACTION>
X	</COMMAND>
X
X<!-- sysctl (fitur baru, bukan restorasi rtcli: tree lama tidak punya
X     perintah sysctl). Berlaku SEGERA system-wide (live) + persisten
X     (cermin OS-native: /etc/sysctl.d/99-titian.conf di Linux,
X     blok #-TITIAN-# di /etc/sysctl.conf FreeBSD; plus baris
X     running-config sehingga save+replay membawanya). Key HARUS
X     dikenali kernel yang jalan (net.ipv4.* = Linux, net.inet.* =
X     FreeBSD) — kunci OS lain ditolak bersih. Nilai vektor berspasi
X     (mis. tcp_rmem) ditulis pakai tanda kutip. Arti tiap kunci:
X     `show system sysctl`. -->
X	<COMMAND name="system sysctl"
X		help="Set kernel parameter (live + persisten; arti tiap kunci: show system sysctl)">
X		<PARAM name="key"
X			help="MIB key, ex: net.ipv4.ip_forward (Linux) / net.inet.ip.forwarding (FreeBSD)"
X			ptype="STRING"/>
X		<PARAM name="value"
X			help="Value, ex: 1 (vektor berspasi pakai tanda kutip, ex: &quot;4096 87380 16777216&quot;)"
X			ptype="STRING"/>
X		<CONFIG pattern="system sysctl ${key}"/>
X		<ACTION>
X			${RT_SBIN}/titian-sysctl.sh set "${key}" "${value}"
X		</ACTION>
X	</COMMAND>
X
X	<COMMAND name="no system sysctl"
X		help="Hapus setelan sysctl Titian (cermin bersih; nilai live kembali ke nilai sebelum-set, atau bertahan sampai reboot bila nilai awal tak tercatat)">
X		<PARAM name="key"
X			help="MIB key yang dihapus"
X			ptype="STRING"/>
X		<CONFIG operation="unset" pattern="system sysctl ${key}"/>
X		<ACTION>
X			${RT_SBIN}/titian-sysctl.sh del "${key}"
X		</ACTION>
X	</COMMAND>
X
X
X</VIEW>
X
X</CLISH_MODULE>
0a2908b5b496bb96619775019085dfb6
echo x - net/titian/files/tree/conf-wireguard.xml
sed 's/^X//' >net/titian/files/tree/conf-wireguard.xml << 'be61c384977560e07fe57d076ff29bb0'
X<?xml version="1.0" encoding="UTF-8"?>
X<CLISH_MODULE xmlns="http://clish.sourceforge.net/XMLSchema"
X          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
X xsi:schemaLocation="http://clish.sourceforge.net/XMLSchema
X                     http://clish.sourceforge.net/XMLSchema/clish.xsd">
X    <!--=======================================================-->
X    <!-- WireGuard native (if_wg) — BSDRP port (BARU).
X         Backend: ${RT_SBIN}/titian-wireguard.sh. State klish di
X         /opt/titian/etc/netstate/wireguard/<nama>.conf; private key
X         di /opt/titian/etc/wireguard/<nama>.key (mode 600, TIDAK
X         pernah dicetak ulang — `generate-key` hanya menampilkan
X         public key sekali).
X         `enable` hanya mencatat niat + dirty; interface dibuat +
X         peer dipasang saat `commit` (atau boot via titian-boot.sh
X         apply-all). `generate-key` + perubahan peer berlaku saat
X         commit berikutnya.
X         Sintaks ifconfig wg (wgkey/wgport/wgpeer/wgaip/wgendpoint/
X         wgpka) ditulis dari dokumentasi FreeBSD if_wg/ifconfig —
X         verifikasi live di guest wajib sebelum produksi. -->
X
X    <PTYPE name="WG_IFACE"
X        pattern="wg[0-9]+$"
X        help="wg[N] (interface WireGuard)"/>
X
X<VIEW name="configure-view">
X    <COMMAND name="wireguard"
X            help="WireGuard interface (native if_wg)"
X            view="configure-wg-view"
X            viewid="wg=${Name}"
X            ptype="SUBCOMMAND"
X            mode="subcommand">
X        <PARAM name="Name"
X            help="nama interface (wg0, wg1, ...)"
X            ptype="WG_IFACE"/>
X        <CONFIG priority="0x1700" pattern="^wireguard ${Name}$"/>
X        <ACTION>
X            ${RT_SBIN}/titian-wireguard.sh check "${Name}"
X        </ACTION>
X    </COMMAND>
X    <COMMAND name="no wireguard"
X            help="Hapus SELURUH konfigurasi WireGuard interface ini">
X        <PARAM name="Name"
X            help="nama interface"
X            ptype="WG_IFACE"/>
X        <CONFIG operation="unset" pattern="^wireguard ${Name}"/>
X        <ACTION>
X            ${RT_SBIN}/titian-wireguard.sh del-iface "${Name}"
X        </ACTION>
X    </COMMAND>
X</VIEW>
X
X<VIEW name="configure-wg-view"
X    prompt="${SYSTEM_NAME}(config-wg-${wg})# "
X    depth="1">
X    <NAMESPACE ref="configure-view"
X        help="false"
X        completion="true"/>
X
X    <COMMAND name="exit"
X        help="Kembali ke configure-view"
X        lock="false">
X        <ACTION builtin="clish_nested_up"/>
X    </COMMAND>
X    <COMMAND name="end"
X        help="Kembali ke enable-view"
X        view="enable-view"/>
X    <HOTKEY key="^Z" cmd="exit"/>
X
X    <COMMAND name="no"
X        help="Negate a command or set its defaults"/>
X
X    <COMMAND name="enable"
X          help="Enable interface WireGuard ini (pending commit)">
X        <CONFIG/>
X        <ACTION>
X            ${RT_SBIN}/titian-wireguard.sh set-enable "${wg}" yes
X        </ACTION>
X    </COMMAND>
X    <COMMAND name="no enable"
X          help="Disable interface WireGuard ini (pending commit)">
X        <CONFIG operation="unset" pattern="^enable"/>
X        <ACTION>
X            ${RT_SBIN}/titian-wireguard.sh set-enable "${wg}" no
X        </ACTION>
X    </COMMAND>
X
X    <COMMAND name="address"
X        help="Alamat IP interface WireGuard">
X        <PARAM name="Addr"
X            help="alamat/prefix (contoh 10.6.0.1/24)"
X            ptype="IP_ADDR_MASK"/>
X        <CONFIG/>
X        <ACTION>
X            ${RT_SBIN}/titian-wireguard.sh set-address "${wg}" "${Addr}"
X        </ACTION>
X    </COMMAND>
X    <COMMAND name="no address"
X        help="Hapus alamat IP interface">
X        <CONFIG operation="unset" pattern="^address"/>
X        <ACTION>
X            ${RT_SBIN}/titian-wireguard.sh del-address "${wg}"
X        </ACTION>
X    </COMMAND>
X
X    <COMMAND name="listen-port"
X        help="Port UDP listen WireGuard">
X        <PARAM name="Port"
X            help="1-65535"
X            ptype="DSTPORT"/>
X        <CONFIG/>
X        <ACTION>
X            ${RT_SBIN}/titian-wireguard.sh set-listen-port "${wg}" "${Port}"
X        </ACTION>
X    </COMMAND>
X    <COMMAND name="no listen-port"
X        help="Hapus listen-port (default wg 51820)">
X        <CONFIG operation="unset" pattern="^listen-port"/>
X        <ACTION>
X            ${RT_SBIN}/titian-wireguard.sh del-listen-port "${wg}"
X        </ACTION>
X    </COMMAND>
X
X    <COMMAND name="generate-key"
X        help="Buat keypair baru (private key tersimpan mode 600; public key ditampilkan sekali)">
X        <ACTION>
X            ${RT_SBIN}/titian-wireguard.sh generate-key "${wg}"
X        </ACTION>
X    </COMMAND>
X
X    <COMMAND name="peer"
X            help="Peer WireGuard (public key)"
X            view="configure-wg-peer-view"
X            viewid="wg_peer=${Pubkey}"
X            ptype="SUBCOMMAND"
X            mode="subcommand">
X        <PARAM name="Pubkey"
X            help="public key peer (base64)"
X            ptype="STRING"/>
X        <CONFIG priority="0x1710" pattern="^peer ${Pubkey}$"/>
X        <ACTION>
X            ${RT_SBIN}/titian-wireguard.sh peer-add "${wg}" "${Pubkey}"
X        </ACTION>
X    </COMMAND>
X    <COMMAND name="no peer"
X            help="Hapus peer WireGuard">
X        <PARAM name="Pubkey"
X            help="public key peer"
X            ptype="STRING"/>
X        <CONFIG operation="unset" pattern="^peer ${Pubkey}"/>
X        <ACTION>
X            ${RT_SBIN}/titian-wireguard.sh peer-del "${wg}" "${Pubkey}"
X        </ACTION>
X    </COMMAND>
X</VIEW>
X
X<VIEW name="configure-wg-peer-view"
X    prompt="${SYSTEM_NAME}(config-wg-peer)# "
X    depth="2">
X    <NAMESPACE ref="configure-wg-view"
X        help="false"
X        completion="true"/>
X    <COMMAND name="exit"
X        help="Kembali ke wireguard mode"
X        lock="false">
X        <ACTION builtin="clish_nested_up"/>
X    </COMMAND>
X    <HOTKEY key="^Z" cmd="exit"/>
X
X    <COMMAND name="allowed-ips"
X        help="Allowed IPs peer (CIDR)">
X        <PARAM name="Nets"
X            help="prefix yang boleh lewat peer ini"
X            ptype="IP_ADDR_MASK"/>
X        <CONFIG/>
X        <ACTION>
X            ${RT_SBIN}/titian-wireguard.sh peer-set "${wg}" "${wg_peer}" allowed-ips "${Nets}"
X        </ACTION>
X    </COMMAND>
X    <COMMAND name="no allowed-ips"
X        help="Hapus allowed-ips peer">
X        <CONFIG operation="unset" pattern="^allowed-ips"/>
X        <ACTION>
X            ${RT_SBIN}/titian-wireguard.sh peer-del-field "${wg}" "${wg_peer}" allowed-ips
X        </ACTION>
X    </COMMAND>
X
X    <COMMAND name="endpoint"
X        help="Endpoint peer (host:port)">
X        <PARAM name="Ep"
X            help="alamat:port (contoh 203.0.113.5:51820)"
X            ptype="STRING"/>
X        <CONFIG/>
X        <ACTION>
X            ${RT_SBIN}/titian-wireguard.sh peer-set "${wg}" "${wg_peer}" endpoint "${Ep}"
X        </ACTION>
X    </COMMAND>
X    <COMMAND name="no endpoint"
X        help="Hapus endpoint peer">
X        <CONFIG operation="unset" pattern="^endpoint"/>
X        <ACTION>
X            ${RT_SBIN}/titian-wireguard.sh peer-del-field "${wg}" "${wg_peer}" endpoint
X        </ACTION>
X    </COMMAND>
X
X    <COMMAND name="persistent-keepalive"
X        help="Persistent keepalive (detik, 0 = mati)">
X        <PARAM name="Secs"
X            help="detik"
X            ptype="UINT"/>
X        <CONFIG/>
X        <ACTION>
X            ${RT_SBIN}/titian-wireguard.sh peer-set "${wg}" "${wg_peer}" keepalive "${Secs}"
X        </ACTION>
X    </COMMAND>
X    <COMMAND name="no persistent-keepalive"
X        help="Hapus persistent keepalive">
X        <CONFIG operation="unset" pattern="^persistent-keepalive"/>
X        <ACTION>
X            ${RT_SBIN}/titian-wireguard.sh peer-del-field "${wg}" "${wg_peer}" keepalive
X        </ACTION>
X    </COMMAND>
X</VIEW>
X
X<VIEW name="enable-view">
X    <COMMAND name="show wireguard"
X        help="Status semua interface WireGuard (wg show)"
X        lock="false"
X        interrupt="true">
X        <ACTION>
X            ${RT_SBIN}/titian-wireguard.sh show
X        </ACTION>
X    </COMMAND>
X    <COMMAND name="show wireguard interface"
X        help="Status satu interface WireGuard"
X        lock="false"
X        interrupt="true">
X        <PARAM name="Name"
X            help="nama interface"
X            ptype="WG_IFACE"/>
X        <ACTION>
X            ${RT_SBIN}/titian-wireguard.sh show-one "${Name}"
X        </ACTION>
X    </COMMAND>
X</VIEW>
X
X</CLISH_MODULE>
