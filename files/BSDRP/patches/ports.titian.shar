echo x - net/titian/files/tree/enable-mode.xml
sed 's/^X//' >net/titian/files/tree/enable-mode.xml << 'f086165bca5eba5b7b3f3c7b406d39e1'
X<?xml version="1.0" encoding="UTF-8"?>
X<CLISH_MODULE xmlns="http://clish.sourceforge.net/XMLSchema" 
X          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
X xsi:schemaLocation="http://clish.sourceforge.net/XMLSchema
X                     http://clish.sourceforge.net/XMLSchema/clish.xsd">
X  <!--=======================================================-->
X<VIEW name="enable-view"
X     prompt="cli-${SYSTEM_NAME}# ">
X
X<!--//
X  bawa cmd-cmd dari NAMESPACE ref *, ke sini
X//-->
X  <NAMESPACE ref="ping-view" help="true" completion="true"/>
X  <NAMESPACE ref="syshw-view" help="true" completion="true"/>
X
X    <COMMAND name="help"
X             help="Display an overview of the RTCLI syntax">
X        <ACTION builtin="clish_overview"/>
X    </COMMAND>
X
X<!-- enable mode commands -->
X  <COMMAND name="logout"
X          help="Turn off privileged / Exit commands">
X  <ACTION builtin="clish_close"/>
X  </COMMAND>
X <HOTKEY key="^Z" cmd="logout"/>
X
X  <!-- reboot -->
X  <COMMAND name="reboot"
X          help="Halt and perform a cold restart">
X    <ACTION>echo reboot</ACTION>
X  </COMMAND>
X
X<!--Enter configure mode-->
X  <COMMAND name="configure"
X          help="Enter configuration mode"/>
X  <COMMAND name="configure terminal"
X          help="Configure from the terminal"
X          view="configure-view">
X  </COMMAND>
X
X<!--// save running config, insert ver + track commit //-->
X  <COMMAND name="save"
X          help="Save running-config to startup-config">
X    <CONFIG operation="dump" file="/opt/titian/etc/startup-config"/>
X      <ACTION>
X            if test ! -S "${RT_SOCK}"; then
X                echo "error: socket not ready.."
X                echo "${RT_SOCK}"
X                exit 33
X            elif test -S "${RT_SOCK}"; then
X                ${RT_BIN}/konf -s "${RT_SOCK}" -- -s -l "! version ${RT_CONF_VER}" -r "^! version"
X                ${RT_BIN}/konf -s "${RT_SOCK}" -- -s -l "! last commit: `date`" -r "^! last" "! version ${RT_CONF_VER}"
X            fi
X            echo "Save running-config to startup-config.."; sleep 0.35
X            # Titik tersembunyi .last-save untuk `rollback` polos
X            # (kembali ke startup-config dengan fidelitas penuh:
X            # bird.conf + bird.d + netstate + sysctl ikut dipotret,
X            # karena `save` sendiri tidak memotretnya). Best-effort:
X            # gagal memotret TIDAK PERNAH menggagalkan save.
X            ${RT_SBIN}/titian-checkpoint.sh snapshot-last-save 2>/dev/null || echo "peringatan: snapshot .last-save gagal (save tetap berhasil)"
X      </ACTION>
X  </COMMAND>
X
X<!-- Bird view: diaktifkan kembali (dulu dikomentari di rtcli) -->
X    <COMMAND name="bird"
X               help="Enter bird"/>
X    <COMMAND name="bird terminal"
X               help="Enter bird terminal"
X               view="bird-view">
X    </COMMAND>
X
X</VIEW>
X</CLISH_MODULE>
