echo x - net/titian/files/sbin/titian-persist.sh
sed 's/^X//' >net/titian/files/sbin/titian-persist.sh << 'd7a6a4b622a857d1e0362a5edb558e5c'
X#!/bin/sh
X# TITIAN Fase 1 — cermin persistensi untuk interface yang DIBUAT titian.
X#  - Debian: /etc/systemd/network/00-titian-<iface>.network (networkd
X#    hanya me-match interface titian; NIC sistem tidak pernah ditulis).
X#  - FreeBSD: blok marker #-TITIAN-# ... #-ENDTITIAN-# di /etc/rc.conf
X#    (baris di luar blok tidak pernah disentuh; backup + sh -n tiap tulis).
X# Sumber kebenaran = state file /opt/titian/etc/netstate/<iface>.addr
X# yang ditulis titian-if.sh (bukan parsing output tool).
X# Persistensi utama tetap replay startup-config saat boot; cermin ini
X# adalah artefak deklaratif kedua (keputusan default Fase 1).
X# Helper ini best-effort: gagal tulis -> peringatan, exit 0 (perintah
X# CLI tidak boleh gagal hanya karena cermin gagal).
X# POSIX sh.
XOS=$(uname -s)
XROOT=${TITIAN_ROOT:-/opt/titian}
XSTATE_DIR="$ROOT/etc/netstate"
Xwarn() { echo "Warning(persist): $*" >&2; }
X
Xmark_if() {
X    mkdir -p "$STATE_DIR" 2>/dev/null || return 0
X    touch "$STATE_DIR/$1.managed" 2>/dev/null || true
X    touch "$STATE_DIR/$1.addr" 2>/dev/null || true
X}
X
Xsync_debian() {
X    # $1=iface: regenerasi .network dari state file
X    local iface=$1 f net
X    f="$STATE_DIR/$iface.addr"
X    net="/etc/systemd/network/00-titian-$iface.network"
X    # GUARD (insiden rollback 2 Nov 2026 — guest kehilangan mgmt):
X    # JANGAN buat cermin untuk interface TANPA state titian
X    # (.addr kosong + .tuning kosong). Cermin kosong (lexical
X    # pertama, 00-titian-*) akan dibaca networkd SEBELUM konfigurasi
X    # OS (mis. DHCP cloud-init untuk enp1s0) sehingga interface
X    # sistem kehilangan alamatnya saat reload. Cermin yang sudah
X    # ada untuk interface seperti itu DIHAPUS. Aturan ini sejalan
X    # dengan guard sync_freebsd (lewati iface tanpa state).
X    # Cermin hanya boleh ada bila titian punya state untuk iface
X    # itu (alamat dan/atau tuning); tanpa state, tidak ada yang
X    # perlu dideklarasikan.
X    if [ ! -s "$f" ] && [ ! -s "$STATE_DIR/$iface.tuning" ]; then
X        rm -f "$net" 2>/dev/null || true
X        return 0
X    fi
X    mkdir -p /etc/systemd/network 2>/dev/null || { warn "tidak bisa mkdir /etc/systemd/network"; return 0; }
X    {
X        echo "[Match]"
X        echo "Name=$iface"
X        echo ""
X        echo "[Network]"
X        while IFS= read -r line; do
X            case "$line" in
X                'inet '*)
X                    rest=${line#inet }
X                    case "$rest" in
X                        *' peer '*)
X                            # PtP ditulis sebagai [Address] + Peer di bawah
X                            ;;
X                        *) echo "Address=$rest" ;;
X                    esac
X                    ;;
X                'inet6 '*) echo "Address=${line#inet6 }" ;;
X            esac
X        done < "$f" 2>/dev/null
X        # CATATAN: Bond= networkd TIDAK dipakai di sini — networkd hanya
X        # menghormati Bond= bila bond-nya sendiri didefinisikan lewat
X        # .netdev ("bond0 NetDev could not be found, ignoring
X        # assignment"); bond titian dibuat via ip link, jadi Bond=
X        # diabaikan. Keanggotaan ditegakkan ulang oleh attach-bond
X        # (dipanggil sync tuning + apply-bond saat boot), bukan oleh
X        # networkd.
X        # [Link] dari .tuning (mtu/qlen saja; offload/coalesce TIDAK
X        # punya padanan networkd — dibawa replay startup-config +
X        # apply-all di titian-boot.sh)
X        t="$STATE_DIR/$iface.tuning"
X        if [ -f "$t" ]; then
X            _mtu=$(grep '^mtu ' "$t" 2>/dev/null | tail -1 | awk '{print $2}')
X            _qlen=$(grep '^qlen ' "$t" 2>/dev/null | tail -1 | awk '{print $2}')
X            if [ -n "$_mtu" ] || [ -n "$_qlen" ]; then
X                echo ""
X                echo "[Link]"
X                [ -n "$_mtu" ] && echo "MTUBytes=$_mtu"
X                [ -n "$_qlen" ] && echo "TransmitQueueLength=$_qlen"
X            fi
X        fi
X        while IFS= read -r line; do
X            case "$line" in
X                'inet '*peer' '*)
X                    rest=${line#inet }
X                    local=${rest%% peer *}
X                    peer=${rest##* peer }
X                    echo ""
X                    echo "[Address]"
X                    echo "Address=$local/32"
X                    echo "Peer=$peer"
X                    ;;
X            esac
X        done < "$f" 2>/dev/null
X    } > "$net.tmp" 2>/dev/null && mv "$net.tmp" "$net" || { warn "gagal tulis $net"; return 0; }
X    if command -v systemctl >/dev/null 2>&1 && systemctl is-active -q systemd-networkd 2>/dev/null; then
X        networkctl reload 2>/dev/null || true
X    fi
X}
X
Xsync_freebsd() {
X    # regenerasi SELURUH blok marker dari semua state file
X    local rc=/etc/rc.conf tmp
X    tmp=$(mktemp /tmp/titian-rcconf.XXXXXX) || { warn "gagal mktemp"; return 0; }
X    {
X        # salin rc.conf tanpa blok titian lama (bila ada)
X        if [ -f "$rc" ]; then
X            awk '/^#-TITIAN-#/{skip=1; next} /^#-ENDTITIAN-#/{skip=0; next} !skip {print}' "$rc"
X        fi
X        echo "#-TITIAN-#"
X        # static_routes lama di luar blok titian dipertahankan (merge, bukan timpa);
X        # nama route titian lama (titian_p*) dibuang agar re-sync tidak menumpuk.
X        _old_routes=$(awk '/^#-TITIAN-#/{skip=1} /^#-ENDTITIAN-#/{skip=0} !skip && /^static_routes=/{print}' "$rc" 2>/dev/null | tail -1 | sed 's/^static_routes=//; s/"//g')
X        _kept=""
X        for _r in $_old_routes; do
X            case "$_r" in titian_p*) ;; *) _kept="$_kept $_r" ;; esac
X        done
X        _proutes=""; _pcount=0
X        for m in "$STATE_DIR"/*.managed; do
X            [ -e "$m" ] || continue
X            iface=$(basename "$m" .managed)
X            f="$STATE_DIR/$iface.addr"
X            tf="$STATE_DIR/$iface.tuning"
X            [ -s "$f" ] || [ -s "$tf" ] || continue
X            # suffix tuning untuk baris ifconfig pertama: mtu + flag
X            # offload (gro/gso/sg/coalesce/qlen tidak punya padanan
X            # ifconfig sehingga tidak pernah tercatat di FreeBSD)
X            _tsuffix=""
X            if [ -f "$tf" ]; then
X                _m=$(grep '^mtu ' "$tf" 2>/dev/null | tail -1 | awk '{print $2}')
X                [ -n "$_m" ] && _tsuffix="$_tsuffix mtu $_m"
X                while IFS= read -r _tl; do
X                    case "$_tl" in
X                        'offload tso on') _tsuffix="$_tsuffix tso" ;;
X                        'offload tso off') _tsuffix="$_tsuffix -tso" ;;
X                        'offload lro on') _tsuffix="$_tsuffix lro" ;;
X                        'offload lro off') _tsuffix="$_tsuffix -lro" ;;
X                        'offload rx on') _tsuffix="$_tsuffix rxcsum" ;;
X                        'offload rx off') _tsuffix="$_tsuffix -rxcsum" ;;
X                        'offload tx on') _tsuffix="$_tsuffix txcsum" ;;
X                        'offload tx off') _tsuffix="$_tsuffix -txcsum" ;;
X                    esac
X                done < "$tf"
X            fi
X            n=0
X            while IFS= read -r line; do
X                [ -n "$line" ] || continue
X                case "$line" in
X                    'inet '*)
X                        rest=${line#inet }
X                        case "$rest" in
X                            *' peer '*)
X                                local=${rest%% peer *}
X                                peer=${rest##* peer }
X                                frag="inet $local netmask 255.255.255.255"
X                                _proutes="$_proutes titian_p$_pcount"
X                                printf 'route_titian_p%s="-host %s -iface %s"\n' "$_pcount" "$peer" "$iface"
X                                _pcount=$((_pcount + 1))
X                                ;;
X                            *) frag="inet $rest" ;;
X                        esac
X                        ;;
X                    'inet6 '*) frag="inet6 ${line#inet6 }" ;;
X                    *) continue ;;
X                esac
X                if [ "$n" -eq 0 ]; then
X                    printf 'ifconfig_%s="%s"\n' "$iface" "$frag$_tsuffix"
X                else
X                    printf 'ifconfig_%s_alias%s="%s"\n' "$iface" "$((n - 1))" "$frag"
X                fi
X                n=$((n + 1))
X            done < "$f"
X            # tuning saja tanpa alamat: tetap tulis satu baris ifconfig
X            # (mis. ifconfig_vtnet1="mtu 9000") agar cermin tidak hilang
X            if [ "$n" -eq 0 ] && [ -n "$_tsuffix" ]; then
X                printf 'ifconfig_%s="%s"\n' "$iface" "${_tsuffix# }"
X            fi
X        done
X        _all_routes="$_kept$_proutes"
X        _all_routes=$(printf '%s' "$_all_routes" | sed 's/^ //')
X        if [ -n "$_all_routes" ]; then
X            printf 'static_routes="%s"\n' "$_all_routes"
X        fi
X        echo "#-ENDTITIAN-#"
X    } > "$tmp" 2>/dev/null
X    if ! sh -n "$tmp" 2>/dev/null; then
X        warn "rc.conf hasil regenerasi gagal sh -n, tidak ditulis"
X        rm -f "$tmp"
X        return 0
X    fi
X    if [ -f "$rc" ]; then
X        cp -f "$rc" /etc/rc.conf.titian-bak 2>/dev/null || true
X    fi
X    cat "$tmp" > "$rc" 2>/dev/null || { warn "gagal tulis $rc"; rm -f "$tmp"; return 0; }
X    rm -f "$tmp"
X}
X
Xdrop_if() {
X    # $1=iface: hapus marker+state, bersihkan cermin
X    rm -f "$STATE_DIR/$1.managed" "$STATE_DIR/$1.addr" "$STATE_DIR/$1.tuning" "$STATE_DIR/$1.tuning.prev" "$STATE_DIR/$1.bond" "$STATE_DIR/$1.vxlan" 2>/dev/null
X    if [ "$OS" = "FreeBSD" ]; then
X        sync_freebsd
X    else
X        rm -f "/etc/systemd/network/00-titian-$1.network" 2>/dev/null
X        if command -v systemctl >/dev/null 2>&1 && systemctl is-active -q systemd-networkd 2>/dev/null; then
X            networkctl reload 2>/dev/null || true
X        fi
X    fi
X}
X
Xattach_bond() {
X    # $1=slave: pasang ulang ke bond tercatat bila terlepas.
X    # Latar: networkd me-reset master sebuah interface setiap kali
X    # me-reconfigure-nya (regen cermin + reload, atau flap dengan
X    # config berubah) — karena bond titian bukan NetDev networkd,
X    # reconfigure itu melepas slave dari bond. Fungsi ini
X    # menegakkan ulang keanggotaan dari file .bond. No-op bila
X    # bukan slave bond / bond tidak ada / sudah terpasang.
X    # Selalu exit 0 (jaring pengaman, bukan perintah yang boleh gagal).
X    local b f
X    f="$STATE_DIR/$1.bond"
X    [ -f "$f" ] || return 0
X    b=$(head -n 1 "$f" 2>/dev/null)
X    [ -n "$b" ] || return 0
X    [ -d "/sys/class/net/$b" ] || return 0
X    [ -d "/sys/class/net/$b/lower_$1" ] && return 0
X    echo "+$1" > "/sys/class/net/$b/bonding/slaves" 2>/dev/null || return 0
X    ip link set "$1" up 2>/dev/null || true
X    ip link set "$b" up 2>/dev/null || true
X    # Bila reconfigure networkd masih tertunda saat pasang pertama,
X    # verifikasi gagal → tunggu sebentar lalu pasang sekali lagi.
X    if [ ! -d "/sys/class/net/$b/lower_$1" ]; then
X        sleep 2
X        echo "+$1" > "/sys/class/net/$b/bonding/slaves" 2>/dev/null || return 0
X        ip link set "$1" up 2>/dev/null || true
X        ip link set "$b" up 2>/dev/null || true
X    fi
X    return 0
X}
Xapply_bond() {
X    # Pasang ulang semua slave bond yang tercatat (jaring pengaman boot:
X    # dipanggil titian-boot.sh sesudah replay + apply-all).
X    local m iface
X    for m in "$STATE_DIR"/*.bond; do
X        [ -e "$m" ] || continue
X        iface=$(basename "$m" .bond)
X        attach_bond "$iface"
X    done
X}
Xbond_if() {
X    # $1=slave $2=bond: catat keanggotaan + regenerasi cermin slave,
X    # lalu pasang ulang (sync di atas memicu reconfigure networkd
X    # yang melepas slave — attach menutup celah itu seketika).
X    echo "$2" > "$STATE_DIR/$1.bond" 2>/dev/null
X    if [ -f "$STATE_DIR/$1.managed" ]; then
X        if [ "$OS" = "FreeBSD" ]; then sync_freebsd; else sync_debian "$1"; fi
X    fi
X    attach_bond "$1"
X}
Xunbond_if() {
X    # $1=slave: hapus catatan keanggotaan + regenerasi cermin slave.
X    rm -f "$STATE_DIR/$1.bond" 2>/dev/null
X    if [ -f "$STATE_DIR/$1.managed" ]; then
X        if [ "$OS" = "FreeBSD" ]; then sync_freebsd; else sync_debian "$1"; fi
X    fi
X}
X
Xcase "${1:-}" in
X    mark-if) mark_if "$2" ;;
X    drop-if) drop_if "$2" ;;
X    bond-if) bond_if "$2" "$3" ;;
X    unbond-if) unbond_if "$2" ;;
X    attach-bond) attach_bond "$2" ;;
X    apply-bond) apply_bond ;;
X    sync-if)
X        # no-op untuk interface sistem (tanpa marker)
X        if [ -f "$STATE_DIR/$2.managed" ]; then
X            if [ "$OS" = "FreeBSD" ]; then sync_freebsd; else sync_debian "$2"; fi
X        fi
X        ;;
X    *) echo "Usage: $0 {mark-if|drop-if|sync-if|bond-if|unbond-if|attach-bond|apply-bond} <iface> [bond]" >&2; exit 2 ;;
Xesac
Xexit 0
d7a6a4b622a857d1e0362a5edb558e5c
echo x - net/titian/files/sbin/titian-pppoe.sh
sed 's/^X//' >net/titian/files/sbin/titian-pppoe.sh << '437d91a5b0d62eaf428b3a576d53faf4'
X#!/bin/sh
X# TITIAN BSDRP — PPPoE server (mpd5 5.9, netgraph).
X# State klish: /usr/local/etc/pppoe.conf (mode 600 — berisi password
X# user + radius secret). Config mpd5 yang dihasilkan:
X#   /usr/local/etc/mpd5/mpd.conf + mpd.secret (mode 600).
X# Format state (satu baris per item):
X#   enable yes|no
X#   interface <if>
X#   pool <start-ip> <end-ip>
X#   radius-server <ip>
X#   radius-secret <secret>
X#   user <name> <password> <ip|->            (password tanpa spasi)
X# `enable` hanya mencatat niat + dirty; service mpd5 naik/berhenti
X# saat `commit` (titian-commit.sh -> apply di sini).
X# Sintaks mpd.conf di bawah ditulis dari dokumentasi mpd5 — BELUM
X# teruji live di guest; verifikasi live wajib sebelum produksi.
X# POSIX sh.
XROOT=${TITIAN_ROOT:-/opt/titian}
XCONF="${PPPOE_CONF:-/usr/local/etc/pppoe.conf}"
XMPD_DIR="${PPPOE_MPD_DIR:-/usr/local/etc/mpd5}"
XMPD_CONF="$MPD_DIR/mpd.conf"
XMPD_SECRET="$MPD_DIR/mpd.secret"
XDIRTY=/var/run/pppoe.dirty
XPROG="titian-pppoe"
Xerr() { echo "Error($PROG): $*" >&2; exit 33; }
Xdie() { echo "$PROG: $*" >&2; exit 1; }
X
Xtouch_conf() {
X    if [ ! -f "$CONF" ]; then
X        mkdir -p "$(dirname "$CONF")" 2>/dev/null
X        printf '# pppoe.conf - generated by klish, do not edit by hand\nenable no\n' > "$CONF" \
X            || die "cannot create $CONF"
X        chmod 600 "$CONF" 2>/dev/null || true
X    fi
X}
X
Xmark_dirty() { touch "$DIRTY" 2>/dev/null || true; }
X
Xupsert() {
X    _re="$1"; _line="$2"
X    touch_conf
X    _tmp="$CONF.tmp.$$"
X    grep -v "$_re" "$CONF" > "$_tmp" 2>/dev/null || true
X    printf '%s\n' "$_line" >> "$_tmp"
X    mv "$_tmp" "$CONF" || die "cannot write $CONF"
X    chmod 600 "$CONF" 2>/dev/null || true
X    mark_dirty
X}
X
Xdellines() {
X    _re="$1"; _what="$2"
X    touch_conf
X    grep -q "$_re" "$CONF" 2>/dev/null || die "$_what not found"
X    _tmp="$CONF.tmp.$$"
X    grep -v "$_re" "$CONF" > "$_tmp" || true
X    mv "$_tmp" "$CONF" || die "cannot write $CONF"
X    chmod 600 "$CONF" 2>/dev/null || true
X    mark_dirty
X}
X
Xvalid_v4() {
X    _a="$1"
X    case "$_a" in *.*.*.*) ;; *) return 1 ;; esac
X    _o1=${_a%%.*}; _r=${_a#*.}; _o2=${_r%%.*}; _r=${_r#*.}; _o3=${_r%%.*}; _o4=${_r#*.}
X    case "$_o4" in *.*) return 1 ;; esac
X    for _o in "$_o1" "$_o2" "$_o3" "$_o4"; do
X        case "$_o" in ''|*[!0-9]*) return 1 ;; esac
X        [ "$_o" -ge 0 ] 2>/dev/null && [ "$_o" -le 255 ] 2>/dev/null || return 1
X    done
X    return 0
X}
X
Xiface_exists() {
X    ifconfig "$1" >/dev/null 2>&1 || die "interface $1 not found (see 'show interfaces')"
X}
X
Xuser_exists() { grep -q "^user $1 " "$CONF" 2>/dev/null; }
X
X# --- read-only ---
Xcmd_check() { touch_conf; exit 0; }
X
Xcmd_show() {
X    touch_conf
X    _en=$(sed -n 's/^enable //p' "$CONF" | head -1)
X    _if=$(sed -n 's/^interface //p' "$CONF" | head -1)
X    _pool=$(sed -n 's/^pool //p' "$CONF" | head -1)
X    _rs=$(sed -n 's/^radius-server //p' "$CONF" | head -1)
X    _n=$(grep -c '^user ' "$CONF" 2>/dev/null || echo 0)
X    echo "pppoe-server: ${_en:-no}"
X    echo "interface: ${_if:-unset}"
X    echo "pool: ${_pool:-unset}"
X    echo "radius-server: ${_rs:-local auth}"
X    echo "users: $_n"
X    if command -v service >/dev/null 2>&1; then
X        service mpd5 status 2>&1 | sed 's/^/  /' || true
X    elif pgrep -x mpd5 >/dev/null 2>&1; then
X        echo "  mpd5 running (pid $(pgrep -x mpd5 | head -1))"
X    else
X        echo "  mpd5 not running"
X    fi
X    exit 0
X}
X
Xcmd_show_users() {
X    touch_conf
X    if ! grep -q '^user ' "$CONF" 2>/dev/null; then echo "(no users)"; exit 0; fi
X    printf '%-20s %s\n' "USER" "STATIC-IP"
X    grep '^user ' "$CONF" | while read -r _u _n _p _ip; do
X        printf '%-20s %s\n' "$_n" "${_ip:-pool}"
X    done
X    exit 0
X}
X
Xcmd_show_sessions() {
X    # Sesi PPPoE = interface netgraph ng* yang dibuat mpd5. Best-effort:
X    # tanpa mpd5 control socket, yang bisa ditampilkan adalah ng* yang ada.
X    _found=0
X    for _if in $(ifconfig -l 2>/dev/null); do
X        case "$_if" in
X            ng*) _found=1; ifconfig "$_if" 2>/dev/null | head -3 | sed 's/^/  /' ;;
X        esac
X    done
X    [ "$_found" = "1" ] || echo "(no active PPPoE sessions / no ng* interfaces)"
X    exit 0
X}
X
X# --- mutations ---
Xcmd_set_enable() {
X    case "$1" in yes|no) upsert '^enable ' "enable $1" ;; *) die "enable takes yes|no" ;; esac
X    echo "pppoe-server $1 (pending commit)"
X    exit 0
X}
X
Xcmd_set_interface() {
X    iface_exists "$1"
X    upsert '^interface ' "interface $1"
X    echo "pppoe-server interface $1 (pending commit)"
X    exit 0
X}
X
Xcmd_del_interface() { dellines '^interface ' "interface"; echo "pppoe-server interface dihapus"; exit 0; }
X
Xcmd_set_pool() {
X    valid_v4 "$1" || die "pool start harus IPv4: $1"
X    valid_v4 "$2" || die "pool end harus IPv4: $2"
X    upsert '^pool ' "pool $1 $2"
X    echo "pppoe-server pool $1 - $2 (pending commit)"
X    exit 0
X}
X
Xcmd_del_pool() { dellines '^pool ' "pool"; echo "pppoe-server pool dihapus"; exit 0; }
X
Xcmd_user_add() {
X    case "$1" in ''|*[!A-Za-z0-9_-]*) die "nama user tidak valid: $1" ;; esac
X    touch_conf
X    user_exists "$1" && { echo "pppoe user $1 sudah ada"; exit 0; }
X    printf 'user %s %s -\n' "$1" "changeme" >> "$CONF" || die "cannot write $CONF"
X    chmod 600 "$CONF" 2>/dev/null || true
X    mark_dirty
X    echo "pppoe user $1 ditambah (password default 'changeme' — segera set via password)"
X    exit 0
X}
X
Xcmd_user_del() {
X    dellines "^user $1 " "user $1"
X    echo "pppoe user $1 dihapus"
X    exit 0
X}
X
Xcmd_user_set_password() {
X    # $1=user $2=password (tanpa spasi — format state satu baris)
X    _name="$1"; _pass="$2"
X    case "$_pass" in *' '*) die "password tidak boleh mengandung spasi" ;; '' ) die "password tidak boleh kosong" ;; esac
X    touch_conf
X    user_exists "$_name" || die "user $_name tidak ada (buat dulu: user $_name)"
X    _line=$(grep "^user $_name " "$CONF" | head -1)
X    set -- $_line
X    _ip="${4:--}"
X    upsert "^user $_name " "user $_name $_pass $_ip"
X    echo "pppoe user $_name: password diubah"
X    exit 0
X}
X
Xcmd_user_set_ip() {
X    _name="$1"; _addr="$2"
X    valid_v4 "$_addr" || die "IP harus IPv4: $_addr"
X    touch_conf
X    user_exists "$_name" || die "user $_name tidak ada"
X    _line=$(grep "^user $_name " "$CONF" | head -1)
X    set -- $_line
X    _pw="${3:-changeme}"
X    upsert "^user $_name " "user $_name $_pw $_addr"
X    echo "pppoe user $_name: static IP $_addr"
X    exit 0
X}
X
Xcmd_user_del_ip() {
X    _name="$1"
X    touch_conf
X    user_exists "$_name" || die "user $_name tidak ada"
X    _line=$(grep "^user $_name " "$CONF" | head -1)
X    set -- $_line
X    _pw="${3:-changeme}"
X    upsert "^user $_name " "user $_name $_pw -"
X    echo "pppoe user $_name: IP statis dihapus (kembali ke pool)"
X    exit 0
X}
X
Xcmd_set_radius_server() {
X    valid_v4 "$1" || die "radius-server harus IPv4: $1"
X    upsert '^radius-server ' "radius-server $1"
X    echo "pppoe radius-server $1 (pending commit)"
X    exit 0
X}
X
Xcmd_del_radius_server() { dellines '^radius-server ' "radius-server"; echo "radius-server dihapus (auth lokal)"; exit 0; }
X
Xcmd_set_radius_secret() {
X    case "$1" in ''|*' '*) die "radius-secret tidak boleh kosong/berspasi" ;; esac
X    upsert '^radius-secret ' "radius-secret $1"
X    echo "pppoe radius-secret diubah (pending commit)"
X    exit 0
X}
X
Xcmd_del_radius_secret() { dellines '^radius-secret ' "radius-secret"; echo "radius-secret dihapus"; exit 0; }
X
Xcmd_flush() {
X    printf '# pppoe.conf - generated by klish, do not edit by hand\nenable no\n' > "$CONF" \
X        || die "cannot write $CONF"
X    chmod 600 "$CONF" 2>/dev/null || true
X    mark_dirty
X    echo "pppoe-server: semua konfigurasi dihapus (pending commit)"
X    exit 0
X}
X
X# --- apply (dipanggil commit) ---
Xcmd_apply() {
X    touch_conf
X    _en=$(sed -n 's/^enable //p' "$CONF" | head -1)
X    _if=$(sed -n 's/^interface //p' "$CONF" | head -1)
X    _pool=$(sed -n 's/^pool //p' "$CONF" | head -1)
X    _rs=$(sed -n 's/^radius-server //p' "$CONF" | head -1)
X    _rsec=$(sed -n 's/^radius-secret //p' "$CONF" | head -1)
X    if [ "$_en" != "yes" ]; then
X        if command -v sysrc >/dev/null 2>&1; then sysrc mpd_enable="NO" >/dev/null; fi
X        if command -v service >/dev/null 2>&1; then service mpd5 stop 2>/dev/null || true; fi
X        echo "pppoe-server: disabled + stopped"
X        return 0
X    fi
X    [ -n "$_if" ] || die "pppoe-server enable tapi interface belum di-set (interface <if>)"
X    [ -n "$_pool" ] || die "pppoe-server enable tapi pool belum di-set (pool <start> <end>)"
X    set -- $_pool; _pstart="$1"; _pend="$2"
X    mkdir -p "$MPD_DIR" 2>/dev/null || die "cannot mkdir $MPD_DIR"
X    {
X        echo "# mpd.conf - generated by titian-pppoe.sh, do not edit by hand"
X        echo "startup:"
X        echo "    set console ip 127.0.0.1 5005"
X        echo "    set console open"
X        echo "default:"
X        echo "    load pppoe_server"
X        echo "pppoe_server:"
X        echo "    create bundle template B"
X        echo "    set bundle enable compression"
X        echo "    set iface enable proxy-arp"
X        echo "    set ipcp ranges 10.254.254.1/32 ${_pstart}-${_pend}"
X        echo "    create link template L pppoe"
X        echo "    set link action bundle B"
X        echo "    set pppoe service \"*\""
X        echo "    set pppoe iface ${_if}"
X        if [ -n "$_rs" ]; then
X            echo "    set radius server ${_rs} ${_rsec:-secret} 1812 1813"
X            echo "    set radius retries 3"
X            echo "    set radius timeout 3"
X            echo "    set auth enable radius"
X        else
X            echo "    set auth enable local"
X        fi
X        echo "    set link enable incoming"
X    } > "$MPD_CONF.tmp.$$" || die "cannot write $MPD_CONF"
X    mv "$MPD_CONF.tmp.$$" "$MPD_CONF" || die "cannot write $MPD_CONF"
X    : > "$MPD_SECRET.tmp.$$" || die "cannot write $MPD_SECRET"
X    grep '^user ' "$CONF" 2>/dev/null | while read -r _u _n _p _ip; do
X        if [ "$_ip" = "-" ] || [ -z "$_ip" ]; then
X            printf '%s "%s"\n' "$_n" "$_p" >> "$MPD_SECRET.tmp.$$"
X        else
X            printf '%s "%s" %s\n' "$_n" "$_p" "$_ip" >> "$MPD_SECRET.tmp.$$"
X        fi
X    done
X    mv "$MPD_SECRET.tmp.$$" "$MPD_SECRET" || die "cannot write $MPD_SECRET"
X    chmod 600 "$MPD_CONF" "$MPD_SECRET" 2>/dev/null || true
X    if command -v sysrc >/dev/null 2>&1; then sysrc mpd_enable="YES" >/dev/null || die "sysrc mpd_enable gagal"; fi
X    if command -v service >/dev/null 2>&1; then
X        if pgrep -x mpd5 >/dev/null 2>&1; then service mpd5 restart || die "service mpd5 restart gagal"
X        else service mpd5 start || die "service mpd5 start gagal"; fi
X    else
X        echo "(service tidak ada di host ini — lewati start mpd5; config tertulis di $MPD_CONF)"
X    fi
X    echo "pppoe-server: enabled + applied (iface $_if, pool $_pstart-$_pend)"
X    return 0
X}
X
Xcase "${1:-}" in
X    check) cmd_check ;;
X    show) cmd_show ;;
X    show-users) cmd_show_users ;;
X    show-sessions) cmd_show_sessions ;;
X    set-enable) cmd_set_enable "${2:-}" ;;
X    set-interface) cmd_set_interface "${2:-}" ;;
X    del-interface) cmd_del_interface ;;
X    set-pool) cmd_set_pool "${2:-}" "${3:-}" ;;
X    del-pool) cmd_del_pool ;;
X    user-add) cmd_user_add "${2:-}" ;;
X    user-del) cmd_user_del "${2:-}" ;;
X    user-set-password) cmd_user_set_password "${2:-}" "${3:-}" ;;
X    user-set-ip) cmd_user_set_ip "${2:-}" "${3:-}" ;;
X    user-del-ip) cmd_user_del_ip "${2:-}" ;;
X    set-radius-server) cmd_set_radius_server "${2:-}" ;;
X    del-radius-server) cmd_del_radius_server ;;
X    set-radius-secret) cmd_set_radius_secret "${2:-}" ;;
X    del-radius-secret) cmd_del_radius_secret ;;
X    flush) cmd_flush ;;
X    apply) cmd_apply ;;
X    apply-all) cmd_apply ;;
X    *) echo "Usage: $0 {check|show|show-users|show-sessions|set-enable|set-interface|del-interface|set-pool|del-pool|user-add|user-del|user-set-password|user-set-ip|user-del-ip|set-radius-server|del-radius-server|set-radius-secret|del-radius-secret|flush|apply} ..." >&2; exit 2 ;;
Xesac
437d91a5b0d62eaf428b3a576d53faf4
echo x - net/titian/files/sbin/titian-redist.sh
sed 's/^X//' >net/titian/files/sbin/titian-redist.sh << '28e24742f5e789591679f08864bdc567'
X#!/bin/sh
X# TITIAN — kelola redistribusi route ke peer BGP lewat CLI (bird-view).
X#   redistribute static enable|disable : ekspor route RTS_STATIC ke BGP
X#     (toggle via guard line di bgp_export_attr; isi cabang dipertahankan)
X#   redistribute direct enable|disable : protokol direct + cabang RTS_DEVICE
X#     (route connected interface -> BGP)
X#   redistribute show : status static/direct + cabang export terkait
X# Pola: edit section -> generate check (parse saja) -> lolos baru generate.
X# POSIX sh. Dipanggil dari bird-view sebagai ${RT_SBIN}/titian-redist.sh.
XDIR=$(dirname "$0")
XROOT=$(dirname "$DIR")
XFILTER="$ROOT/etc/bird.d/filter.conf"
XDIRECT="$ROOT/etc/bird.d/direct.conf"
XBIRD_SH="$DIR/titian-bird.sh"
Xerr() { echo "Error: $*" >&2; exit 33; }
X[ -f "$FILTER" ] || err "filter.conf tidak ada: $FILTER"
X[ -x "$BIRD_SH" ] || err "titian-bird.sh tidak ada: $BIRD_SH"
X
X# apply SECTION: check dulu, lolos baru generate; gagal -> tidak terap.
Xapply() {
X    if ! "$BIRD_SH" check "$1" >/tmp/titian-redist-check.out 2>&1; then
X        cat /tmp/titian-redist-check.out >&2
X        err "parse GAGAL section $1 (tidak ada perubahan diterapkan)"
X    fi
X    "$BIRD_SH" generate "$1" || err "generate $1 gagal setelah check lolos"
X}
X
X# --- static: guard line di ATAS bgp_export_attr (blokir SEMUA cabang static,
X# termasuk cabang net-spesifik seperti /25 yang dievaluasi sebelum cabang
X# RTS_STATIC; guard lokal-cabang tidak cukup) ---
XGUARD="    if source = RTS_STATIC then reject;"
Xstatic_state() {
X    if grep -qF -- "$GUARD" "$FILTER"; then echo "disabled"; else echo "enabled"; fi
X}
Xstatic_enable() {
X    if [ "$(static_state)" = "enabled" ]; then echo "static export sudah aktif"; return 0; fi
X    awk -v g="$GUARD" '
X        /^filter bgp_export_attr/ { infilter = 1 }
X        infilter && $0 == g { next }
X        { print }
X    ' "$FILTER" > "$FILTER.tmp" || err "gagal edit $FILTER"
X    mv "$FILTER.tmp" "$FILTER" || err "gagal tulis $FILTER"
X    apply filter
X    echo "static export: enabled"
X}
Xstatic_disable() {
X    if [ "$(static_state)" = "disabled" ]; then echo "static export sudah nonaktif"; return 0; fi
X    awk -v g="$GUARD" '
X        /^filter bgp_export_attr/ { infilter = 1; print; print g; inserted = 1; next }
X        { print }
X        END { if (!infilter || !inserted) exit 3 }
X    ' "$FILTER" > "$FILTER.tmp"; rc=$?
X    case $rc in
X        3) rm -f "$FILTER.tmp"; err "filter bgp_export_attr tidak ditemukan di $FILTER" ;;
X        0) mv "$FILTER.tmp" "$FILTER" || err "gagal tulis $FILTER"; apply filter; echo "static export: disabled" ;;
X        *) rm -f "$FILTER.tmp"; err "gagal edit $FILTER" ;;
X    esac
X}
X
X# --- direct: protocol direct + cabang RTS_DEVICE di bgp_export_attr ---
XDEVBR="    if source = RTS_DEVICE then accept;"
Xdirect_state() {
X    if grep -q "protocol direct" "$DIRECT" 2>/dev/null && grep -qF -- "$DEVBR" "$FILTER"; then echo "enabled"; else echo "disabled"; fi
X}
Xdirect_enable() {
X    if [ "$(direct_state)" = "enabled" ]; then echo "direct export sudah aktif"; return 0; fi
X    # 1) cabang RTS_DEVICE di filter (sisip sebelum reject akhir bgp_export_attr)
X    if ! grep -qF -- "$DEVBR" "$FILTER"; then
X        awk -v b="$DEVBR" '
X            /^filter bgp_export_attr/ { infilter = 1 }
X            infilter && !inserted && /^ *reject;$/ { print b; inserted = 1 }
X            { print }
X            END { if (!infilter || !inserted) exit 3 }
X        ' "$FILTER" > "$FILTER.tmp"; rc=$?
X        case $rc in
X            3) rm -f "$FILTER.tmp"; err "filter bgp_export_attr tidak ditemukan di $FILTER" ;;
X            0) mv "$FILTER.tmp" "$FILTER" || err "gagal tulis $FILTER" ;;
X            *) rm -f "$FILTER.tmp"; err "gagal edit $FILTER" ;;
X        esac
X        apply filter
X    fi
X    # 2) protokol direct (interface PtP lab; default per-OS bila tanpa argumen)
X    if [ -n "$1" ]; then iface=$1; elif [ "$(uname -s)" = "FreeBSD" ]; then iface=vtnet1; else iface=enp9s0; fi
X    printf 'protocol direct direct1 {\n    interface "%s";\n    ipv4;\n}\n' "$iface" > "$DIRECT" || err "gagal tulis $DIRECT"
X    apply direct
X    echo "direct export: enabled (interface $iface)"
X}
Xdirect_disable() {
X    if [ "$(direct_state)" = "disabled" ]; then echo "direct export sudah nonaktif"; return 0; fi
X    awk -v b="$DEVBR" '
X        $0 == b { next }
X        { print }
X    ' "$FILTER" > "$FILTER.tmp" || err "gagal edit $FILTER"
X    mv "$FILTER.tmp" "$FILTER" || err "gagal tulis $FILTER"
X    apply filter
X    printf '# TITIAN bird.d/direct.conf — protokol direct nonaktif.\n' > "$DIRECT" || err "gagal tulis $DIRECT"
X    apply direct
X    echo "direct export: disabled"
X}
X
Xredist_show() {
X    echo "static export: $(static_state)"
X    echo "direct export: $(direct_state)"
X    echo "--- cabang export (filter) ---"
X    grep -E "RTS_STATIC|RTS_DEVICE" "$FILTER" || echo "(tidak ada cabang RTS_*)"
X    echo "--- direct.conf ---"
X    cat "$DIRECT" 2>/dev/null || echo "(tidak ada direct.conf)"
X}
X
Xcase "${1:-}" in
X    static-enable)  static_enable ;;
X    static-disable) static_disable ;;
X    direct-enable)  direct_enable "$2" ;;
X    direct-disable) direct_disable ;;
X    show)           redist_show ;;
X    *) echo "Usage: $0 {static-enable|static-disable|direct-enable [iface]|direct-disable|show}" >&2; exit 2 ;;
Xesac
28e24742f5e789591679f08864bdc567
echo x - net/titian/files/sbin/titian-rename.sh
sed 's/^X//' >net/titian/files/sbin/titian-rename.sh << '81549e89b8561d0f18ddb463cdf44759'
X#!/bin/sh
X# TITIAN — rename interface sistem + migrasi state Titian (Linux + FreeBSD).
X# Dipanggil perintah exec `rename <lama> <baru>` (tree/en-rename.xml).
X#
X# PERSISTEN (seperti rollback, bukan sekadar live): startup-config
X# ditulis ulang (section + referensi nama) + aturan boot ditulis
X# (Linux: berkas .link berdasarkan MAC; FreeBSD: baris
X# ifconfig_<asal>_name di blok #-TITIAN-RENAME-# rc.conf), lalu
X# restart service titian (replay startup-config baru). Sesi CLI yang
X# menjalankan rename ikut ter-restart (pola yang sama seperti
X# rollback) — sambung lagi lalu verifikasi dengan `show interfaces`
X# / `show running-config`. Baris pra-restart dicatat di
X# /var/log/titian-rename.log.
X#
X# ATURAN AMAN (ditolak lantang, tanpa perubahan):
X#  - nama lama tidak ada di sistem; nama baru sudah dipakai sistem;
X#  - nama gagal charset IFACE_SYS (huruf/angka/_ di awal, lalu
X#    huruf/angka/_/./-, maks 15 karakter — sama dengan PTYPE);
X#  - nama lama == nama baru;
X#  - objek buatan Titian (bond[N]/vxlan[N]/lagg[N]/vlan[N]) dan
X#    loopback (lo/lo0/lo[N]): rename HANYA untuk interface SISTEM.
X#    Objek Titian di-rename dengan menghapus + membuat ulang
X#    (namanya kunci bookkeeping netstate/cermin/replay); loopback
X#    clone dihapus + dibuat ulang. Nama bertitik (perangkat vlan
X#    Linux) ditolak dengan alasan yang sama.
X#  - startup-config tidak ada (jalankan `save` dulu — rename butuh
X#    baseline persistensi untuk ditulis ulang).
X#
X# YANG DIIZINKAN (siklus down -> rename -> kembalikan state admin):
X#  - interface UP membawa alamat: alamat + route melekat ke ifindex
X#    (kernel), sehingga selamat dari rename; helper memverifikasi
X#    sesudah restart. Interupsi sesaat (down/up) adalah konsekuensi
X#    yang didokumentasikan — JANGAN rename interface yang sedang
X#    membawa traffic mgmt/produksi. Perintah ini tidak tahu interface
X#    mana yang mgmt; itu tanggung jawab operator.
X#  - slave bond / member lagg / parent vlan: keanggotaan kernel
X#    melekat ke ifindex (selamat); referensi nama di startup-config
X#    (section + laggport + parent vlan FreeBSD + route dev + vxlan
X#    group dev) ditulis ulang.
X#
X# ASIMETRI YANG DISENGAJA (didokumentasikan, bukan bug):
X#  - Linux: nama perangkat vlan (<parent>.<tag>) TIDAK mengikuti
X#    rename parent (perangkat vlan menyimpan link ke parent lewat
X#    ifindex, bukan nama). Section vlan Linux tidak diubah.
X#  - FreeBSD: section `interface vlan <id> <parent>` token parent-nya
X#    ditulis ulang (parent eksplisit di konfigurasi).
X#  - Objek runtime (dummy/epair/vlan/lo-clone) tidak bertahan
X#    melewati reboot — rename-nya pun hilang bersama objeknya (nama
X#    kembali ke penamaan sistem saat objek dibuat ulang). State
X#    Titian yang mengendap untuk interface yang sudah hilang
X#    DIABAIKAN apply-all (apply_iface melewati interface yang tidak
X#    ada) — tidak merusak boot. Objek persisten (NIC nyata, MAC
X#    stabil) + aturan boot di atas = rename bertahan melewati reboot.
X#  - Checkpoint lama TIDAK ditulis ulang (titik beku): rollback ke
X#    titik pra-rename mengembalikan nama lama — itu perilaku yang
X#    benar untuk sebuah titik simpan.
X#  - bird.conf TIDAK disentuh (pola interface di bird, bila ada,
X#    adalah glob, bukan referensi nama — di luar cakupan rename).
X# POSIX sh.
XROOT=${TITIAN_ROOT:-/opt/titian}
XSTATE_DIR=$ROOT/etc/netstate
XSTARTUP=$ROOT/etc/startup-config
XSBIN=$ROOT/sbin
XSOCKFILE=/tmp/konfd.socket
XPATH=/sbin:/usr/sbin:/bin:/usr/bin:/usr/local/sbin:/usr/local/bin:$PATH
XOS=$(uname -s)
X
Xerr() { printf 'Error: %s\n' "$*" >&2; exit 33; }
Xwarn() { printf 'peringatan: %s\n' "$*" >&2; }
X
Xiface_exists() {
X    if [ "$OS" = "FreeBSD" ]; then ifconfig "$1" >/dev/null 2>&1;
X    else [ -d "/sys/class/net/$1" ]; fi
X}
X
Xadmin_up() {
X    _f=$( (if [ "$OS" = "FreeBSD" ]; then ifconfig "$1"; else ip link show dev "$1"; fi) 2>/dev/null | head -1 | sed -n 's/.*<\([^>]*\)>.*/\1/p')
X    case ",$_f," in *,UP,*) return 0 ;; *) return 1 ;; esac
X}
X
Xiface_down() {
X    if [ "$OS" = "FreeBSD" ]; then ifconfig "$1" down 2>/dev/null || true;
X    else ip link set dev "$1" down 2>/dev/null || true; fi
X}
X
Xiface_up() {
X    if [ "$OS" = "FreeBSD" ]; then ifconfig "$1" up 2>/dev/null || true;
X    else ip link set dev "$1" up 2>/dev/null || true; fi
X}
X
X# charset IFACE_SYS (tree/types-dev.xml): awal huruf/angka/underscore,
X# lalu huruf/angka/underscore/titik/strip, total maks 15 karakter.
Xvalid_name() {
X    expr "$1" : '^[A-Za-z0-9_][A-Za-z0-9_.-]\{0,14\}$' >/dev/null 2>&1
X}
X
X# Objek buatan Titian + loopback + nama bertitik: bukan sasaran rename.
Xis_object_or_loopback() {
X    case "$1" in *.*) return 0 ;; esac
X    expr "$1" : '^bond[0-9][0-9]*$' >/dev/null 2>&1 && return 0
X    expr "$1" : '^vxlan[0-9][0-9]*$' >/dev/null 2>&1 && return 0
X    expr "$1" : '^lagg[0-9][0-9]*$' >/dev/null 2>&1 && return 0
X    expr "$1" : '^vlan[0-9][0-9]*$' >/dev/null 2>&1 && return 0
X    expr "$1" : '^lo[0-9]*$' >/dev/null 2>&1 && return 0
X    return 1
X}
X
X# --- tulis ulang startup-config (awk; field-exact, baris lain verbatim) ---
X# Aturan: section ethernet; section vlan FreeBSD (NF==4, token parent);
X# laggport; route dev (ip/ipv6); vxlan group dev. Section vlan Linux
X# (NF==3, nama perangkat) SENGAJA tidak diubah (lihat header).
Xrewrite_startup() {
X    # $1=in $2=out $3=old $4=new
X    awk -v old="$3" -v new="$4" '
X    {
X        line=$0
X        match($0, /^ */)
X        lead=substr($0, 1, RLENGTH)
X        if ($1=="interface" && $2=="ethernet" && $3==old) { $3=new; print lead $0; next }
X        if ($1=="interface" && $2=="vlan" && NF==4 && $4==old) { $4=new; print lead $0; next }
X        if ($1=="laggport" && $2==old) { $2=new; print lead $0; next }
X        if (($1=="ip" || $1=="ipv6") && $2=="route" && $(NF-1)=="dev" && $NF==old) { $NF=new; print lead $0; next }
X        if ($1=="group" && $(NF-1)=="dev" && $NF==old) { $NF=new; print lead $0; next }
X        print line
X    }' "$1" > "$2" || return 1
X    return 0
X}
X
Xcount_matches() {
X    # $1=file $2=old: hitung baris yang akan ditulis ulang (self-check)
X    awk -v old="$2" '
X    ($1=="interface" && $2=="ethernet" && $3==old) { c++ }
X    ($1=="interface" && $2=="vlan" && NF==4 && $4==old) { c++ }
X    ($1=="laggport" && $2==old) { c++ }
X    (($1=="ip" || $1=="ipv6") && $2=="route" && $(NF-1)=="dev" && $NF==old) { c++ }
X    ($1=="group" && $(NF-1)=="dev" && $NF==old) { c++ }
X    END { print c+0 }' "$1"
X}
X
X# --- aturan persistensi FreeBSD: blok #-TITIAN-RENAME-# di rc.conf ---
X# Baris: ifconfig_<asal>_name="<kini>". Aturan yang nilai kini-nya ==
X# nama lama diperbarui (atau dihapus bila nama baru == asal); bila
X# tidak ada aturan untuk nama lama, aturan baru ditambahkan.
Xwrite_persist_freebsd() {
X    # $1=old $2=new
X    _rc=/etc/rc.conf
X    [ -f "$_rc" ] || return 1
X    _tmp=$(mktemp /tmp/titian-rename-rc.XXXXXX) || return 1
X    awk -v old="$1" -v new="$2" '
X    /^#-TITIAN-RENAME-#/ { inb=1; seen=1; print; next }
X    /^#-ENDTITIAN-RENAME-#/ {
X        if (!found) printf "ifconfig_%s_name=\"%s\"\n", old, new
X        inb=0; print; next
X    }
X    inb && /^ifconfig_.*_name=".*"$/ {
X        cur=$0; sub(/^.*_name="/, "", cur); sub(/"$/, "", cur)
X        orig=$0; sub(/^ifconfig_/, "", orig)
X        suffix="_name=\"" cur "\""
X        orig=substr(orig, 1, length(orig)-length(suffix))
X        if (cur==old) {
X            found=1
X            if (new!=orig) printf "ifconfig_%s_name=\"%s\"\n", orig, new
X            next
X        }
X        print; next
X    }
X    { print }
X    END {
X        if (!seen) {
X            print "#-TITIAN-RENAME-#"
X            printf "ifconfig_%s_name=\"%s\"\n", old, new
X            print "#-ENDTITIAN-RENAME-#"
X        }
X    }' "$_rc" > "$_tmp" || { rm -f "$_tmp"; return 1; }
X    _mode=$(stat -f %Lp "$_rc" 2>/dev/null || echo 644)
X    chmod "$_mode" "$_tmp" 2>/dev/null || true
X    cp "$_tmp" "$_rc" 2>/dev/null || { rm -f "$_tmp"; return 1; }
X    chmod "$_mode" "$_rc" 2>/dev/null || true
X    rm -f "$_tmp"
X    return 0
X}
X
Xwrite_persist_linux() {
X    # $1=old $2=new
X    _mac=$(cat "/sys/class/net/$2/address" 2>/dev/null)
X    [ -n "$_mac" ] || return 1
X    mkdir -p /etc/systemd/network 2>/dev/null || return 1
X    rm -f "/etc/systemd/network/10-titian-rename-$1.link" 2>/dev/null
X    {
X        echo "[Match]"
X        echo "MACAddress=$_mac"
X        echo ""
X        echo "[Link]"
X        echo "Name=$2"
X    } > "/etc/systemd/network/10-titian-rename-$2.link" || return 1
X    chmod 644 "/etc/systemd/network/10-titian-rename-$2.link" 2>/dev/null || true
X    udevadm control --reload-rules 2>/dev/null || true
X    return 0
X}
X
X# --- rollback pra-restart: kembalikan OS + netstate + startup + rc ---
X# Dipanggil HANYA untuk kegagalan sesudah rename OS (sebelum restart).
X# Variabel global: old, new, was_up, bak, rcbak, linkbak, persist_done.
Xfail_rollback() {
X    echo "GAGAL: $1 — mengembalikan keadaan (tanpa perubahan Titian)..." >&2
X    if iface_exists "$new"; then
X        if [ "$OS" = "FreeBSD" ]; then ifconfig "$new" name "$old" 2>/dev/null || true;
X        else ip link set dev "$new" name "$old" 2>/dev/null || true; fi
X    fi
X    if [ "$was_up" = "1" ] && iface_exists "$old"; then iface_up "$old"; fi
X    for _f in "$STATE_DIR/$new".*; do
X        [ -e "$_f" ] || continue
X        _b=${_f##*/}; _r=${_b#$new.}
X        mv "$_f" "$STATE_DIR/$old.$_r" 2>/dev/null || true
X    done
X    if [ -n "$bak" ] && [ -f "$bak" ]; then
X        cp "$bak" "$STARTUP" 2>/dev/null || true
X        chmod 644 "$STARTUP" 2>/dev/null || true
X    fi
X    if [ "$OS" = "FreeBSD" ]; then
X        [ -n "$rcbak" ] && [ -f "$rcbak" ] && cp "$rcbak" /etc/rc.conf 2>/dev/null || true
X    else
X        rm -f "/etc/systemd/network/10-titian-rename-$new.link" 2>/dev/null
X        [ -n "$linkbak" ] && [ -f "$linkbak" ] && cp "$linkbak" "/etc/systemd/network/10-titian-rename-$old.link" 2>/dev/null || true
X    fi
X    exit 33
X}
X
X# ================= main =================
X[ $# -eq 2 ] || err "pakai: rename <lama> <baru>"
Xold=$1; new=$2
X[ "$old" != "$new" ] || err "nama lama dan nama baru sama ($old) — tidak ada yang diubah"
Xvalid_name "$old" || err "nama lama '$old' bukan nama interface yang sah (charset IFACE_SYS)"
Xvalid_name "$new" || err "nama baru '$new' bukan nama interface yang sah (charset IFACE_SYS: huruf/angka/_ di awal, lalu huruf/angka/_/./-, maks 15 karakter)"
Xis_object_or_loopback "$old" && err "rename menolak '$old' (objek Titian bond/vxlan/lagg/vlan, loopback, atau nama bertitik) — hapus + buat ulang, bukan rename"
Xis_object_or_loopback "$new" && err "nama baru '$new' bertabrakan dengan namespace objek Titian/loopback (bond/vxlan/lagg/vlan/lo) atau mengandung titik — pilih nama lain"
Xiface_exists "$old" || err "interface $old tidak ditemukan di sistem (lihat 'show interfaces' untuk daftar)"
Xiface_exists "$new" && err "nama baru '$new' sudah dipakai sistem — pilih nama lain"
X[ -f "$STARTUP" ] || err "startup-config tidak ada — jalankan 'save' dulu (rename butuh baseline persistensi)"
X
X# Cegah kehilangan state live yang belum di-save pada interface yang
X# di-rename: restart sesudah rename me-replay startup-config, jadi
X# state live-only (netstate non-kosong tapi tidak ada section /
X# referensi di startup-config) akan hilang + meninggalkan netstate /
X# cermin yatim. Tolak lantang dengan perintah 'save' dulu.
X# (State live interface LAIN juga hilang saat restart — itu semantik
X# restart Titian secara umum, didokumentasikan di help; tidak ditolak
X# di sini karena deteksinya butuh dump running-config dari dalam
X# ACTION, yang berisiko deadlock kunci konfd.)
Xif [ -s "$STATE_DIR/$old.addr" ] || [ -s "$STATE_DIR/$old.tuning" ]; then
X    if [ "$(count_matches "$STARTUP" "$old")" = "0" ]; then
X        err "interface $old punya state Titian (.addr/.tuning non-kosong) tapi tidak ada section/referensi di startup-config — kemungkinan konfigurasi live yang belum di-save (restart sesudah rename akan menghilangkannya). Jalankan 'save' dulu bila state masih live (bila state yatim, terapkan ulang di view lalu 'save'), baru 'rename'."
X    fi
Xfi
X
X# Backup (untuk fail_rollback) + hitung + tulis ulang startup ke temp
X# SEBELUM mutasi apa pun (rewrite gagal = tanpa perubahan).
Xbak=$(mktemp /tmp/titian-rename-startup.XXXXXX) || err "gagal mktemp"
Xcp "$STARTUP" "$bak" 2>/dev/null || err "gagal membackup startup-config"
Xrcbak=""; linkbak=""
Xif [ "$OS" = "FreeBSD" ]; then
X    rcbak=$(mktemp /tmp/titian-rename-rcbak.XXXXXX) 2>/dev/null || true
X    [ -n "$rcbak" ] && cp /etc/rc.conf "$rcbak" 2>/dev/null || true
Xelse
X    if [ -f "/etc/systemd/network/10-titian-rename-$old.link" ]; then
X        linkbak=$(mktemp /tmp/titian-rename-linkbak.XXXXXX) 2>/dev/null || true
X        [ -n "$linkbak" ] && cp "/etc/systemd/network/10-titian-rename-$old.link" "$linkbak" 2>/dev/null || true
X    fi
Xfi
Xtmpnew=$(mktemp /tmp/titian-rename-new.XXXXXX) || err "gagal mktemp"
Xrewrite_startup "$STARTUP" "$tmpnew" "$old" "$new" || err "gagal menulis ulang startup-config (tanpa perubahan)"
X[ -s "$tmpnew" ] || err "hasil tulis ulang startup-config kosong (tanpa perubahan)"
Xmatches=$(count_matches "$STARTUP" "$old")
Xif [ "$matches" = "0" ]; then
X    cmp -s "$tmpnew" "$STARTUP" || err "self-check rewrite gagal (tanpa perubahan)"
X    echo "catatan: $old tidak punya section/referensi di startup-config (tanpa state Titian) — rename OS + aturan boot saja"
Xelse
X    echo "tulis ulang startup-config: $matches baris section/referensi $old -> $new"
Xfi
X
X# Siklus down -> rename -> kembalikan state admin (uniform kedua OS).
Xif admin_up "$old"; then was_up=1; else was_up=0; fi
X[ "$was_up" = "1" ] && iface_down "$old"
Xif [ "$OS" = "FreeBSD" ]; then
X    ifconfig "$old" name "$new" 2>/dev/null || {
X        [ "$was_up" = "1" ] && iface_up "$old"
X        err "gagal rename OS $old -> $new (tanpa perubahan Titian)"
X    }
Xelse
X    ip link set dev "$old" name "$new" 2>/dev/null || {
X        [ "$was_up" = "1" ] && iface_up "$old"
X        err "gagal rename OS $old -> $new (tanpa perubahan Titian)"
X    }
Xfi
X[ "$was_up" = "1" ] && iface_up "$new"
Xiface_exists "$new" || fail_rollback "rename OS dilaporkan sukses tapi $new tidak ditemukan"
Xecho "rename OS: $old -> $new (state admin dikembalikan: $([ "$was_up" = "1" ] && echo up || echo down))"
X
X# Pindah netstate keyed by name (semua <old>.* -> <new>.*).
Xfor _f in "$STATE_DIR/$old".*; do
X    [ -e "$_f" ] || continue
X    _b=${_f##*/}; _r=${_b#$old.}
X    mv "$_f" "$STATE_DIR/$new.$_r" 2>/dev/null || fail_rollback "gagal memindah netstate $_f"
Xdone
X
X# Pasang startup-config baru (mode eksplisit — pelajaran mode FreeBSD:
X# cp menularkan mode sumber; sumber di-chmod 644 dulu + chmod sesudah).
Xchmod 644 "$tmpnew" 2>/dev/null || true
Xcp "$tmpnew" "$STARTUP" 2>/dev/null || fail_rollback "gagal memasang startup-config baru"
Xchmod 644 "$STARTUP" 2>/dev/null || true
Xecho "startup-config ditulis ulang ($old -> $new)"
X
X# Aturan persistensi boot.
Xif [ "$OS" = "FreeBSD" ]; then
X    write_persist_freebsd "$old" "$new" || fail_rollback "gagal menulis aturan rename di rc.conf"
X    echo "aturan boot FreeBSD: ifconfig_<asal>_name=\"$new\" (blok #-TITIAN-RENAME-# rc.conf)"
Xelse
X    write_persist_linux "$old" "$new" || fail_rollback "gagal menulis berkas .link persistensi"
X    echo "aturan boot Linux: /etc/systemd/network/10-titian-rename-$new.link (match MAC)"
Xfi
X
X# Cermin: regenerasi untuk nama baru, hapus untuk nama lama
X# (best-effort — replay sesudah restart meregenerasi cermin baru).
X"$SBIN/titian-persist.sh" sync-if "$new" 2>/dev/null || warn "sync-if $new gagal (replay sesudah restart meregenerasi cermin)"
X"$SBIN/titian-persist.sh" drop-if "$old" 2>/dev/null || warn "drop-if $old gagal (cermin lama mungkin mengendap)"
X
X# Restart service (pola rollback) — sesi CLI terputus sesaat.
Xecho "rename $old -> $new — restart service titian (sesi CLI terputus sesaat; sambung lagi lalu cek 'show interfaces')..."
Xecho "$(date '+%Y-%m-%d %H:%M:%S %Z') rename $old -> $new (restart issued)" >> /var/log/titian-rename.log 2>/dev/null || true
Xif [ "$OS" = "FreeBSD" ]; then
X    service titian restart 2>&1 || err "restart service GAGAL — state sudah PERSISTEN-baru (startup-config + netstate + aturan boot untuk $new); perbaiki service (start akan me-replay config baru), lalu verifikasi dengan 'show interfaces'"
Xelse
X    systemctl restart titian 2>&1 || err "restart service GAGAL — state sudah PERSISTEN-baru (startup-config + netstate + aturan boot untuk $new); perbaiki service (start akan me-replay config baru), lalu verifikasi dengan 'show interfaces'"
Xfi
Xi=0
Xwhile [ ! -S "$SOCKFILE" ] && [ "$i" -lt 60 ]; do sleep 0.5; i=$((i + 1)); done
Xrm -f "$bak" "$rcbak" "$linkbak" "$tmpnew" 2>/dev/null || true
Xif iface_exists "$new" && ! iface_exists "$old"; then
X    echo "rename OK: $old -> $new (sistem + startup-config + netstate + aturan boot; verifikasi lengkap: 'show interfaces' + 'show running-config')"
Xelse
X    warn "verifikasi pasca-restart tidak keduanya benar ($new ada / $old hilang) — periksa 'show interfaces' + 'show running-config'"
Xfi
Xexit 0
