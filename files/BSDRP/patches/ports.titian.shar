echo x - net/titian/files/sbin/titian-vxlan.sh
sed 's/^X//' >net/titian/files/sbin/titian-vxlan.sh << '354ed9fd46d9d282217a167c02f1ebd0'
X#!/bin/sh
X# TITIAN — operasi interface VXLAN (Linux + FreeBSD).
X# Model: netstate <iface>.vxlan (baris "kunci nilai") = sumber kebenaran
X# parameter; setiap perubahan parameter = recreate interface dari netstate.
X# Alasan recreate seragam kedua OS (terbukti saat prototipe 1 Nov 2026):
X#  - Linux: id VNI dan dstport TIDAK bisa diubah live
X#    ("Error: Cannot change VNI." / "Cannot change port."); tidak ada
X#    perintah noremote/nogroup; "local none" ditolak (harus alamat valid).
X#  - FreeBSD: "-vxlanlocal" ditolak ("bad value"); vxlanport bukan
X#    parameter settable (port tetap 4789).
X# Jadi: vni/local/remote/group/dstport diubah lewat hapus + buat ulang
X# dengan parameter baru. Alamat dipulihkan dari netstate <iface>.addr
X# via titian-if.sh (state_add idempotent, tidak duplikat); MTU dari
X# <iface>.tuning (set langsung, tanpa menyentuh bookkeeping
X# .tuning.prev titian-tune.sh). Recreate = flap singkat. MAC interface
X# TERNYATA STABIL untuk nama yang sama di lab ini (terbukti: hapus+buat
X# ulang + reboot penuh tidak mengubah MAC di kedua OS; nama sama + VNI
X# berbeda pun MAC-nya sama — jadi bukan turunan VNI; mekanisme pastinya
X# tidak diidentifikasi, jangan jadikan jaminan umum).
X# POSIX sh (jalan di dash Debian dan sh FreeBSD).
Xset -u
XOS=$(uname -s)
XROOT=${TITIAN_ROOT:-/opt/titian}
XSBIN=$ROOT/sbin
XSTATE_DIR=${TITIAN_STATE_DIR:-$ROOT/etc/netstate}
X
Xerr() { echo "Error: $*" >&2; exit 33; }
Xwarn() { echo "Warning(vxlan): $*" >&2; }
X
Xvalid_v4() {
X    # $1 = dotted quad; return 0 bila valid (salinan titian-if.sh)
X    local rest o i
X    rest=$1
X    for i in 1 2 3 4; do
X        case "$rest" in
X            *.*) o=${rest%%.*}; rest=${rest#*.} ;;
X            *)   o=$rest; rest="" ;;
X        esac
X        case "$o" in
X            ''|*[!0-9]*) return 1 ;;
X        esac
X        if [ "$o" -gt 255 ] 2>/dev/null; then return 1; fi
X        if [ "$i" -eq 4 ] && [ -n "$rest" ]; then return 1; fi
X    done
X    case "$1" in
X        *.*.*.*) return 0 ;;
X        *) return 1 ;;
X    esac
X}
X
Xis_mcast() {
X    # $1 dotted quad -> 0 bila 224.0.0.0-239.255.255.255
X    local o
X    o=${1%%.*}
X    [ "$o" -ge 224 ] 2>/dev/null && [ "$o" -le 239 ] 2>/dev/null
X}
X
Xvxfile() { printf '%s/%s.vxlan' "$STATE_DIR" "$1"; }
X
Xvx_get() {
X    # $1=iface $2=key -> nilai (kosong bila tidak ada)
X    grep "^$2 " "$(vxfile "$1")" 2>/dev/null | tail -1 | awk '{print $2}'
X}
X
Xvx_set() {
X    # $1=iface $2=key $3=value — ganti-atau-tambah
X    local f tmp
X    f=$(vxfile "$1")
X    mkdir -p "$STATE_DIR" 2>/dev/null
X    touch "$f" 2>/dev/null
X    tmp="$f.tmp"
X    grep -v "^$2 " "$f" 2>/dev/null > "$tmp" || true
X    echo "$2 $3" >> "$tmp"
X    mv "$tmp" "$f" 2>/dev/null || true
X}
X
Xvx_unset() {
X    # $1=iface $2=key — hapus baris kunci (no-op bila file tidak ada)
X    local f
X    f=$(vxfile "$1")
X    [ -f "$f" ] || return 0
X    grep -v "^$2 " "$f" 2>/dev/null > "$f.tmp" || true
X    mv "$f.tmp" "$f" 2>/dev/null || true
X}
X
Xiface_exists() {
X    if [ "$OS" = "FreeBSD" ]; then
X        ifconfig "$1" >/dev/null 2>&1
X    else
X        [ -d "/sys/class/net/$1" ]
X    fi
X}
X
Xiface_up() {
X    # return 0 bila interface UP (admin up, bukan LOWER_UP saja)
X    if [ "$OS" = "FreeBSD" ]; then
X        ifconfig "$1" 2>/dev/null | head -1 | grep -q "UP,"
X    else
X        ip link show "$1" 2>/dev/null | head -1 | grep -qE "[<,]UP[,>]"
X    fi
X}
X
Xiface_up_set() {
X    if [ "$OS" = "FreeBSD" ]; then
X        ifconfig "$1" up 2>/dev/null || true
X    else
X        ip link set "$1" up 2>/dev/null || true
X    fi
X}
X
Xdo_create() {
X    # $1=iface — buat bila belum ada (placeholder: Linux id 1 dstport
X    # 4789; FreeBSD bare create), lalu tandai managed + sentuh .vxlan.
X    # Bila interface sudah ada (mis. sisa prototipe mentah), adopsi:
X    # tandai managed + sentuh .vxlan tanpa mengubah parameter live-nya.
X    local iface=$1
X    if [ "$OS" = "FreeBSD" ]; then
X        kldload if_vxlan 2>/dev/null || true
X        if ! grep -qx 'if_vxlan_load="YES"' /boot/loader.conf 2>/dev/null; then
X            echo 'if_vxlan_load="YES"' >> /boot/loader.conf 2>/dev/null || \
X                warn "gagal tulis /boot/loader.conf (modul tidak persisten reboot)"
X        fi
X        if ! iface_exists "$iface"; then
X            ifconfig "$iface" create || err "gagal create $iface"
X        fi
X    else
X        if ! iface_exists "$iface"; then
X            ip link add "$iface" type vxlan id 1 dstport 4789 || err "gagal create $iface"
X            ip link set "$iface" down 2>/dev/null || true
X        fi
X    fi
X    "$SBIN/titian-persist.sh" mark-if "$iface" 2>/dev/null || true
X    mkdir -p "$STATE_DIR" 2>/dev/null
X    touch "$(vxfile "$iface")" 2>/dev/null
X}
X
Xdo_recreate() {
X    # $1=iface — hapus + buat ulang dari netstate (.vxlan + .addr +
X    # .tuning), pulihkan up-state live. Dipanggil setiap perubahan
X    # parameter dan oleh apply-all bila interface hilang.
X    local iface=$1 vni loc remote group dev dstport up f line rest a p mtu
X    vni=$(vx_get "$iface" vni)
X    loc=$(vx_get "$iface" local)
X    remote=$(vx_get "$iface" remote)
X    group=$(vx_get "$iface" group)
X    dev=$(vx_get "$iface" dev)
X    dstport=$(vx_get "$iface" dstport)
X    [ -n "$dstport" ] || dstport=4789
X    up=0
X    if iface_exists "$iface"; then
X        if iface_up "$iface"; then up=1; fi
X    fi
X    if [ "$OS" = "FreeBSD" ]; then
X        kldload if_vxlan 2>/dev/null || true
X        if iface_exists "$iface"; then
X            ifconfig "$iface" destroy 2>/dev/null || true
X        fi
X        ifconfig "$iface" create || err "gagal recreate $iface"
X        if [ -n "$vni" ]; then
X            ifconfig "$iface" vxlanid "$vni" || err "gagal set vni $vni"
X        fi
X        if [ -n "$loc" ]; then
X            ifconfig "$iface" vxlanlocal "$loc" || err "gagal set local $loc"
X        fi
X        if [ -n "$remote" ]; then
X            ifconfig "$iface" vxlanremote "$remote" || err "gagal set remote $remote"
X        elif [ -n "$group" ]; then
X            if [ -z "$dev" ]; then err "group butuh dev (netstate rusak?)"; fi
X            ifconfig "$iface" vxlangroup "$group" vxlandev "$dev" || err "gagal set group $group dev $dev"
X        fi
X        # dstport FreeBSD tetap 4789 (bukan parameter settable) — tidak ada aksi
X    else
X        if iface_exists "$iface"; then
X            ip link del "$iface" 2>/dev/null || true
X        fi
X        # bangun perintah add tanpa eval (set -- bergeser)
X        if [ -n "$vni" ]; then
X            set -- ip link add "$iface" type vxlan id "$vni"
X        else
X            set -- ip link add "$iface" type vxlan id 1
X        fi
X        if [ -n "$remote" ]; then
X            set -- "$@" remote "$remote"
X        elif [ -n "$group" ]; then
X            set -- "$@" group "$group"
X            if [ -n "$dev" ]; then set -- "$@" dev "$dev"; fi
X        fi
X        if [ -n "$loc" ]; then set -- "$@" local "$loc"; fi
X        set -- "$@" dstport "$dstport"
X        "$@" || err "gagal recreate $iface"
X    fi
X    # MTU dari .tuning (set langsung; jangan panggil titian-tune.sh
X    # agar bookkeeping .tuning.prev tidak berubah saat recreate)
X    f="$STATE_DIR/$iface.tuning"
X    if [ -f "$f" ]; then
X        mtu=$(grep '^mtu ' "$f" 2>/dev/null | tail -1 | awk '{print $2}')
X        if [ -n "$mtu" ]; then
X            if [ "$OS" = "FreeBSD" ]; then
X                ifconfig "$iface" mtu "$mtu" 2>/dev/null || true
X            else
X                ip link set dev "$iface" mtu "$mtu" 2>/dev/null || true
X            fi
X        fi
X    fi
X    # alamat dari .addr (titian-if.sh state_add idempotent)
X    f="$STATE_DIR/$iface.addr"
X    if [ -f "$f" ]; then
X        while IFS= read -r line; do
X            case "$line" in
X                'inet '*)
X                    rest=${line#inet }
X                    case "$rest" in
X                        *' peer '*)
X                            a=${rest%% peer *}; p=${rest##* peer }
X                            "$SBIN/titian-if.sh" addr-add "$iface" "$a" "$p" 2>/dev/null || warn "gagal pulihkan $line"
X                            ;;
X                        *) "$SBIN/titian-if.sh" addr-add "$iface" "$rest" "" 2>/dev/null || warn "gagal pulihkan $line" ;;
X                    esac
X                    ;;
X                'inet6 '*)
X                    rest=${line#inet6 }
X                    case "$rest" in
X                        *' peer '*)
X                            a=${rest%% peer *}; p=${rest##* peer }
X                            "$SBIN/titian-if.sh" addr6-add "$iface" "$a" "$p" 2>/dev/null || warn "gagal pulihkan $line"
X                            ;;
X                        *) "$SBIN/titian-if.sh" addr6-add "$iface" "$rest" "" 2>/dev/null || warn "gagal pulihkan $line" ;;
X                    esac
X                    ;;
X            esac
X        done < "$f"
X    fi
X    # segarkan cermin deklaratif sekali (bukan per alamat)
X    "$SBIN/titian-persist.sh" sync-if "$iface" 2>/dev/null || true
X    if [ "$up" -eq 1 ]; then iface_up_set "$iface"; fi
X}
X
Xdo_set() {
X    # $1=iface $2=key $3=value [$4=value2 untuk group: dev]
X    local iface=$1 key=$2 val=$3 val2=${4:-}
X    case "$key" in
X        vni)
X            case "$val" in ''|*[!0-9]*) err "vni harus angka 1-16777215" ;; esac
X            if ! [ "$val" -ge 1 ] 2>/dev/null || ! [ "$val" -le 16777215 ] 2>/dev/null; then
X                err "vni di luar 1-16777215: $val"
X            fi
X            ;;
X        local|remote)
X            valid_v4 "$val" || err "$key bukan IPv4 valid: $val"
X            if is_mcast "$val"; then err "$key tidak boleh multicast: $val"; fi
X            ;;
X        group)
X            valid_v4 "$val" || err "group bukan IPv4 valid: $val"
X            is_mcast "$val" || err "group harus multicast 224.0.0.0-239.255.255.255: $val"
X            if [ -z "$val2" ]; then err "group butuh dev: group <mcast> dev <iface>"; fi
X            if [ "$OS" = "FreeBSD" ]; then
X                ifconfig "$val2" >/dev/null 2>&1 || err "dev tidak ada: $val2 (lihat 'show interfaces' untuk daftar)"
X            else
X                [ -d "/sys/class/net/$val2" ] || err "dev tidak ada: $val2 (lihat 'show interfaces' untuk daftar)"
X            fi
X            ;;
X        dstport)
X            case "$val" in ''|*[!0-9]*) err "dstport harus angka 1-65535" ;; esac
X            if ! [ "$val" -ge 1 ] 2>/dev/null || ! [ "$val" -le 65535 ] 2>/dev/null; then
X                err "dstport di luar 1-65535: $val"
X            fi
X            if [ "$OS" = "FreeBSD" ] && [ "$val" != "4789" ]; then
X                err "FreeBSD: vxlan port tetap 4789 (tidak bisa diubah via ifconfig)"
X            fi
X            ;;
X        *) err "kunci tidak dikenal: $key" ;;
X    esac
X    # remote <-> group saling eksklusif
X    if [ "$key" = "remote" ]; then
X        vx_unset "$iface" group; vx_unset "$iface" dev
X    fi
X    if [ "$key" = "group" ]; then
X        vx_unset "$iface" remote
X        vx_set "$iface" dev "$val2"
X    fi
X    vx_set "$iface" "$key" "$val"
X    if ! iface_exists "$iface"; then do_create "$iface"; fi
X    do_recreate "$iface"
X}
X
Xdo_unset() {
X    # $1=iface $2=key — hapus kunci dari netstate lalu recreate tanpa kunci itu
X    local iface=$1 key=$2
X    case "$key" in
X        vni|local|remote|dstport) vx_unset "$iface" "$key" ;;
X        group) vx_unset "$iface" group; vx_unset "$iface" dev ;;
X        *) err "kunci tidak dikenal: $key" ;;
X    esac
X    if iface_exists "$iface"; then do_recreate "$iface"; fi
X}
X
Xdo_delete() {
X    # $1=iface — hapus device saja (drop-if dipegang ACTION tree)
X    if [ "$OS" = "FreeBSD" ]; then
X        if iface_exists "$1"; then ifconfig "$1" destroy 2>/dev/null || true; fi
X    else
X        if iface_exists "$1"; then ip link del "$1" 2>/dev/null || true; fi
X    fi
X}
X
Xapply_all() {
X    # jaring pengaman boot: vxlan yang tercatat di netstate tapi
X    # interfacenya hilang (replay gagal) dibangun ulang + di-up.
X    # No-op bila interface sudah ada (replay berhasil).
X    local m iface
X    for m in "$STATE_DIR"/*.vxlan; do
X        [ -e "$m" ] || continue
X        iface=$(basename "$m" .vxlan)
X        if ! iface_exists "$iface"; then
X            do_recreate "$iface" 2>/dev/null || warn "apply-vxlan gagal untuk $iface"
X            iface_up_set "$iface"
X        fi
X    done
X}
X
Xshow_one() {
X    # $1=iface — satu blok seragam kedua OS
X    local iface=$1 out state mtu vni loc remote group dev port addrs fdb unit vx
X    if [ "$OS" = "FreeBSD" ]; then
X        out=$(ifconfig "$iface" 2>/dev/null) || { echo "$iface: tidak ada"; return 0; }
X        state=DOWN
X        echo "$out" | head -1 | grep -q "UP," && state=UP
X        mtu=$(echo "$out" | sed -n 's/.*mtu \([0-9][0-9]*\).*/\1/p' | head -1)
X        vx=$(echo "$out" | grep -a "vxlan " | head -1)
X        vni=$(echo "$vx" | sed -n 's/.*vni \([0-9][0-9]*\).*/\1/p')
X        loc=$(echo "$vx" | sed -n 's/.*local \([0-9.]*\):.*/\1/p')
X        port=$(echo "$vx" | sed -n 's/.*local [0-9.]*:\([0-9][0-9]*\).*/\1/p')
X        remote=$(echo "$vx" | sed -n 's/.*remote \([0-9.]*\):.*/\1/p')
X        group=$(echo "$vx" | sed -n 's/.*group \([0-9.]*\):.*/\1/p')
X        addrs=$(echo "$out" | grep -a -E "^[[:space:]]*inet6? " | sed 's/^[[:space:]]*//')
X        unit=${iface#vxlan}
X        fdb=$(sysctl "net.link.vxlan.$unit.ftable.dump" 2>/dev/null | grep -a "0x" | sed 's/^ *//')
X        printf '%s: %s, mtu %s\n' "$iface" "$state" "${mtu:-?}"
X        if [ -n "$remote" ]; then
X            printf '  VNI %s  local %s  remote %s  dstport %s\n' "${vni:-?}" "${loc:-?}" "$remote" "${port:-4789}"
X        elif [ -n "$group" ]; then
X            printf '  VNI %s  local %s  group %s  dstport %s\n' "${vni:-?}" "${loc:-?}" "$group" "${port:-4789}"
X        else
X            printf '  VNI %s  local %s  peer -  dstport %s\n' "${vni:-?}" "${loc:-?}" "${port:-4789}"
X        fi
X        [ -n "$addrs" ] && echo "$addrs" | sed 's/^/  /'
X        if [ -n "$fdb" ]; then echo "$fdb" | sed 's/^/  FDB: /'; else echo "  FDB: (kosong)"; fi
X    else
X        if ! iface_exists "$iface"; then echo "$iface: tidak ada"; return 0; fi
X        out=$(ip -d link show "$iface" 2>/dev/null)
X        state=DOWN
X        echo "$out" | head -1 | grep -qE "[<,]UP[,>]" && state=UP
X        mtu=$(echo "$out" | sed -n 's/.*mtu \([0-9][0-9]*\).*/\1/p' | head -1)
X        vx=$(echo "$out" | grep -a "vxlan " | head -1)
X        vni=$(echo "$vx" | sed -n 's/.*id \([0-9][0-9]*\).*/\1/p')
X        loc=$(echo "$vx" | sed -n 's/.*local \([0-9.]*\).*/\1/p')
X        remote=$(echo "$vx" | sed -n 's/.*remote \([0-9.]*\).*/\1/p')
X        group=$(echo "$vx" | sed -n 's/.*group \([0-9.]*\).*/\1/p')
X        dev=$(echo "$vx" | sed -n 's/.*dev \([A-Za-z0-9_@.-]*\).*/\1/p')
X        port=$(echo "$vx" | sed -n 's/.*dstport \([0-9][0-9]*\).*/\1/p')
X        addrs=$(ip addr show "$iface" 2>/dev/null | grep -a -E "^[[:space:]]*inet6? " | sed 's/^[[:space:]]*//')
X        printf '%s: %s, mtu %s\n' "$iface" "$state" "${mtu:-?}"
X        if [ -n "$remote" ]; then
X            printf '  VNI %s  local %s  remote %s  dstport %s\n' "${vni:-?}" "${loc:-?}" "$remote" "${port:-?}"
X        elif [ -n "$group" ]; then
X            printf '  VNI %s  local %s  group %s dev %s  dstport %s\n' "${vni:-?}" "${loc:-?}" "$group" "${dev:-?}" "${port:-?}"
X        else
X            printf '  VNI %s  local %s  peer -  dstport %s\n' "${vni:-?}" "${loc:-?}" "${port:-?}"
X        fi
X        [ -n "$addrs" ] && echo "$addrs" | sed 's/^/  /'
X        fdb=$(bridge fdb show dev "$iface" 2>/dev/null)
X        if [ -n "$fdb" ]; then echo "$fdb" | sed 's/^/  FDB: /'; else echo "  FDB: (kosong)"; fi
X    fi
X}
X
Xdo_show() {
X    # $1=iface opsional (kosong = semua interface vxlan)
X    local list iface
X    if [ -n "${1:-}" ]; then
X        list="$1"
X    else
X        if [ "$OS" = "FreeBSD" ]; then
X            list=$(ifconfig -l 2>/dev/null | tr ' ' '\n' | grep -E '^vxlan[0-9]+$' | sort)
X        else
X            list=$(ls /sys/class/net 2>/dev/null | grep -E '^vxlan[0-9]+$' | sort)
X        fi
X    fi
X    if [ -z "$list" ]; then echo "tidak ada interface vxlan"; return 0; fi
X    for iface in $list; do show_one "$iface"; done
X}
X
Xcase "${1:-}" in
X    create) do_create "$2" ;;
X    set) do_set "$2" "$3" "$4" "${5:-}" ;;
X    unset) do_unset "$2" "$3" ;;
X    delete) do_delete "$2" ;;
X    exists) iface_exists "$2" ;;
X    recreate) do_recreate "$2" ;;
X    apply-all) apply_all ;;
X    show) do_show "${2:-}" ;;
X    *) echo "Usage: $0 {create|set|unset|delete|exists|recreate|apply-all|show} <iface> [key value...]" >&2; exit 2 ;;
Xesac
Xexit 0
354ed9fd46d9d282217a167c02f1ebd0
echo x - net/titian/files/sbin/titian-wireguard.sh
sed 's/^X//' >net/titian/files/sbin/titian-wireguard.sh << '8b62d9d3414f6262c0d0c1fa59d68e95'
X#!/bin/sh
X# TITIAN BSDRP — WireGuard native (if_wg).
X# State klish: $ROOT/etc/netstate/wireguard/<nama>.conf (satu baris
X# per item); private key: $ROOT/etc/wireguard/<nama>.key (mode 600,
X# TIDAK PERNAH dicetak ulang — generate-key hanya menampilkan public
X# key sekali).
X# Format state:
X#   enable yes|no
X#   address <cidr>
X#   listen-port <n>
X#   public-key <base64>
X#   peer <pubkey> allowed-ips <cidr|-> endpoint <host:port|-> keepalive <n>
X# `enable`/perubahan peer hanya mencatat niat + dirty; interface
X# dibuat + peer dipasang saat `commit` (apply-all di sini) atau boot
X# (titian-boot.sh -> apply-all).
X# Sintaks ifconfig wg (wgkey/wgport/wgpeer/wgaip/wgendpoint/wgpka)
X# ditulis dari dokumentasi FreeBSD if_wg/ifconfig — verifikasi live
X# di guest wajib sebelum produksi.
X# POSIX sh.
XROOT=${TITIAN_ROOT:-/opt/titian}
XSTATE_DIR="$ROOT/etc/netstate/wireguard"
XKEY_DIR="$ROOT/etc/wireguard"
XDIRTY=/var/run/wireguard.dirty
XPROG="titian-wireguard"
Xerr() { echo "Error($PROG): $*" >&2; exit 33; }
Xdie() { echo "$PROG: $*" >&2; exit 1; }
X
Xstate_file() { printf '%s/%s.conf' "$STATE_DIR" "$1"; }
X
Xvalid_wg() {
X    case "$1" in wg[0-9]) ;; wg[0-9][0-9]) ;; *) die "nama interface WireGuard harus wg<N>: $1" ;; esac
X}
X
Xtouch_state() {
X    valid_wg "$1"
X    mkdir -p "$STATE_DIR" 2>/dev/null || die "cannot mkdir $STATE_DIR"
X    _f=$(state_file "$1")
X    if [ ! -f "$_f" ]; then
X        printf '# wireguard %s - generated by klish, do not edit by hand\nenable no\n' "$1" > "$_f" \
X            || die "cannot create $_f"
X    fi
X}
X
Xmark_dirty() { touch "$DIRTY" 2>/dev/null || true; }
X
Xupsert() {
X    # $1=iface $2=regex $3=line
X    touch_state "$1"
X    _f=$(state_file "$1"); _tmp="$_f.tmp.$$"
X    grep -v "$2" "$_f" > "$_tmp" 2>/dev/null || true
X    printf '%s\n' "$3" >> "$_tmp"
X    mv "$_tmp" "$_f" || die "cannot write $_f"
X    mark_dirty
X}
X
Xdellines() {
X    # $1=iface $2=regex $3=what
X    touch_state "$1"
X    _f=$(state_file "$1")
X    grep -q "$2" "$_f" 2>/dev/null || die "$3 not found"
X    _tmp="$_f.tmp.$$"
X    grep -v "$2" "$_f" > "$_tmp" || true
X    mv "$_tmp" "$_f" || die "cannot write $_f"
X    mark_dirty
X}
X
Xvalid_v4_cidr() {
X    case "$1" in */*) ;; *) return 1 ;; esac
X    _ip=${1%%/*}; _n=${1##*/}
X    case "$_n" in ''|*[!0-9]*) return 1 ;; esac
X    [ "$_n" -ge 0 ] 2>/dev/null && [ "$_n" -le 32 ] 2>/dev/null || return 1
X    _a="$_ip"
X    case "$_a" in *.*.*.*) ;; *) return 1 ;; esac
X    _o1=${_a%%.*}; _r=${_a#*.}; _o2=${_r%%.*}; _r=${_r#*.}; _o3=${_r%%.*}; _o4=${_r#*.}
X    case "$_o4" in *.*) return 1 ;; esac
X    for _o in "$_o1" "$_o2" "$_o3" "$_o4"; do
X        case "$_o" in ''|*[!0-9]*) return 1 ;; esac
X        [ "$_o" -ge 0 ] 2>/dev/null && [ "$_o" -le 255 ] 2>/dev/null || return 1
X    done
X    return 0
X}
X
X# --- read-only ---
Xcmd_check() { touch_state "${1:-wg0}"; exit 0; }
X
Xcmd_show() {
X    _any=0
X    for _f in "$STATE_DIR"/wg*.conf; do
X        [ -f "$_f" ] || continue
X        _any=1
X        _n=$(basename "$_f" .conf)
X        _en=$(sed -n 's/^enable //p' "$_f" | head -1)
X        _addr=$(sed -n 's/^address //p' "$_f" | head -1)
X        _port=$(sed -n 's/^listen-port //p' "$_f" | head -1)
X        _peers=$(grep -c '^peer ' "$_f" 2>/dev/null || echo 0)
X        if ifconfig "$_n" >/dev/null 2>&1; then _live="up (interface ada)"; else _live="down (interface belum dibuat)"; fi
X        echo "$_n: ${_en:-no}, addr ${_addr:-unset}, port ${_port:-51820}, peers $_peers, $_live"
X    done
X    [ "$_any" = "1" ] || echo "(no WireGuard interfaces configured)"
X    if command -v wg >/dev/null 2>&1; then
X        echo "-- wg show:"
X        wg show 2>&1 | sed 's/^/  /'
X    fi
X    exit 0
X}
X
Xcmd_show_one() {
X    touch_state "$1"
X    _f=$(state_file "$1")
X    cat "$_f" | grep -v '^public-key' | sed 's/^/  /'
X    echo "-- live:"
X    if command -v wg >/dev/null 2>&1; then wg show "$1" 2>&1 | sed 's/^/  /'
X    elif ifconfig "$1" >/dev/null 2>&1; then ifconfig "$1" 2>&1 | sed 's/^/  /'
X    else echo "  (interface $1 belum dibuat / wg tidak ada)"; fi
X    exit 0
X}
X
X# --- mutations ---
Xcmd_set_enable() {
X    case "$2" in yes|no) upsert "$1" '^enable ' "enable $2" ;; *) die "enable takes yes|no" ;; esac
X    echo "wireguard $1 $2 (pending commit)"
X    exit 0
X}
X
Xcmd_set_address() {
X    valid_v4_cidr "$2" || die "address harus CIDR IPv4: $2"
X    upsert "$1" '^address ' "address $2"
X    echo "wireguard $1 address $2 (pending commit)"
X    exit 0
X}
X
Xcmd_del_address() { dellines "$1" '^address ' "address"; echo "wireguard $1 address dihapus"; exit 0; }
X
Xcmd_set_listen_port() {
X    case "$2" in ''|*[!0-9]*) die "port harus 1-65535: $2" ;; esac
X    [ "$2" -ge 1 ] 2>/dev/null && [ "$2" -le 65535 ] 2>/dev/null || die "port harus 1-65535: $2"
X    upsert "$1" '^listen-port ' "listen-port $2"
X    echo "wireguard $1 listen-port $2 (pending commit)"
X    exit 0
X}
X
Xcmd_del_listen_port() { dellines "$1" '^listen-port ' "listen-port"; echo "wireguard $1 listen-port dihapus (default 51820)"; exit 0; }
X
Xcmd_generate_key() {
X    touch_state "$1"
X    command -v wg >/dev/null 2>&1 || die "wg tidak ditemukan (WireGuard belum terpasang?)"
X    mkdir -p "$KEY_DIR" 2>/dev/null || die "cannot mkdir $KEY_DIR"
X    _priv=$(wg genkey 2>/dev/null) || die "wg genkey gagal"
X    _pub=$(printf '%s' "$_priv" | wg pubkey 2>/dev/null) || die "wg pubkey gagal"
X    umask 077
X    printf '%s\n' "$_priv" > "$KEY_DIR/$1.key" || die "cannot write key"
X    chmod 600 "$KEY_DIR/$1.key" 2>/dev/null || true
X    upsert "$1" '^public-key ' "public-key $_pub"
X    echo "wireguard $1: keypair baru dibuat (private key tersimpan mode 600, tidak ditampilkan)"
X    echo "public key: $_pub"
X    exit 0
X}
X
Xpeer_exists() { grep -q "^peer $2 " "$(state_file "$1")" 2>/dev/null; }
X
Xcmd_peer_add() {
X    touch_state "$1"
X    case "$2" in ''|*' '*) die "public key tidak valid" ;; esac
X    peer_exists "$1" "$2" && { echo "wireguard $1 peer sudah ada"; exit 0; }
X    printf 'peer %s allowed-ips - endpoint - keepalive 0\n' "$2" >> "$(state_file "$1")" \
X        || die "cannot write state"
X    mark_dirty
X    echo "wireguard $1 peer ditambah (pending commit — set allowed-ips dulu)"
X    exit 0
X}
X
Xcmd_peer_del() {
X    dellines "$1" "^peer $2 " "peer $2"
X    echo "wireguard $1 peer dihapus"
X    exit 0
X}
X
Xcmd_peer_set() {
X    # $1=iface $2=pubkey $3=field $4=value — simpan dulu sebelum set --
X    _if="$1"; _pub="$2"; _field="$3"; _val="$4"
X    touch_state "$_if"
X    peer_exists "$_if" "$_pub" || die "peer $_pub tidak ada di $_if"
X    _line=$(grep "^peer $_pub " "$(state_file "$_if")" | head -1)
X    set -- $_line
X    # $1=peer $2=pubkey $3=allowed-ips $4=aip $5=endpoint $6=ep $7=keepalive $8=n
X    _aip="$4"; _ep="$6"; _ka="$8"
X    case "$_field" in
X        allowed-ips)
X            valid_v4_cidr "$_val" || die "allowed-ips harus CIDR IPv4: $_val"
X            _aip="$_val" ;;
X        endpoint)
X            case "$_val" in *:* ) ;; *) die "endpoint harus host:port: $_val" ;; esac
X            _ep="$_val" ;;
X        keepalive)
X            case "$_val" in ''|*[!0-9]*) die "keepalive harus detik (angka): $_val" ;; esac
X            _ka="$_val" ;;
X        *) die "field tidak dikenal: $_field (allowed-ips|endpoint|keepalive)" ;;
X    esac
X    upsert "$_if" "^peer $_pub " "peer $_pub allowed-ips $_aip endpoint $_ep keepalive $_ka"
X    echo "wireguard $_if peer $_pub: $_field = $_val"
X    exit 0
X}
X
Xcmd_peer_del_field() {
X    # $1=iface $2=pubkey $3=field — simpan dulu sebelum set --
X    _if="$1"; _pub="$2"; _field="$3"
X    touch_state "$_if"
X    peer_exists "$_if" "$_pub" || die "peer $_pub tidak ada di $_if"
X    _line=$(grep "^peer $_pub " "$(state_file "$_if")" | head -1)
X    set -- $_line
X    _aip="$4"; _ep="$6"; _ka="$8"
X    case "$_field" in
X        allowed-ips) _aip="-" ;;
X        endpoint) _ep="-" ;;
X        keepalive) _ka="0" ;;
X        *) die "field tidak dikenal: $_field" ;;
X    esac
X    upsert "$_if" "^peer $_pub " "peer $_pub allowed-ips $_aip endpoint $_ep keepalive $_ka"
X    echo "wireguard $_if peer $_pub: $_field dihapus"
X    exit 0
X}
X
Xcmd_del_iface() {
X    valid_wg "$1"
X    _f=$(state_file "$1")
X    [ -f "$_f" ] || { echo "wireguard $1 tidak ada"; exit 0; }
X    rm -f "$_f" "$KEY_DIR/$1.key"
X    if ifconfig "$1" >/dev/null 2>&1; then ifconfig "$1" destroy 2>/dev/null || true; fi
X    mark_dirty
X    echo "wireguard $1 dihapus (config + key + interface)"
X    exit 0
X}
X
X# --- apply ---
Xapply_one() {
X    # $1 = nama iface; buat + konfigurasi dari state. Idempotent.
X    _n="$1"; _f=$(state_file "$_n")
X    [ -f "$_f" ] || return 0
X    _en=$(sed -n 's/^enable //p' "$_f" | head -1)
X    if [ "$_en" != "yes" ]; then
X        ifconfig "$_n" >/dev/null 2>&1 && ifconfig "$_n" destroy 2>/dev/null || true
X        echo "wireguard $_n: disabled (interface dihancurkan bila ada)"
X        return 0
X    fi
X    _addr=$(sed -n 's/^address //p' "$_f" | head -1)
X    _port=$(sed -n 's/^listen-port //p' "$_f" | head -1)
X    _keyf="$KEY_DIR/$_n.key"
X    [ -f "$_keyf" ] || die "wireguard $_n enable tapi belum punya key (generate-key dulu)"
X    _priv=$(cat "$_keyf")
X    if ! ifconfig "$_n" >/dev/null 2>&1; then
X        ifconfig "$_n" create || die "ifconfig $_n create gagal"
X    fi
X    ifconfig "$_n" wgkey "$_priv" || die "ifconfig $_n wgkey gagal"
X    if [ -n "$_port" ]; then ifconfig "$_n" wgport "$_port" || die "ifconfig $_n wgport gagal"; fi
X    if [ -n "$_addr" ]; then ifconfig "$_n" inet "$_addr" alias || die "ifconfig $_n inet gagal"; fi
X    grep '^peer ' "$_f" 2>/dev/null | while read -r _p _pub _a _aip _e _ep _k _ka; do
X        _args="wgpeer $_pub"
X        [ "$_aip" != "-" ] && _args="$_args wgaip $_aip"
X        [ "$_ep" != "-" ] && _args="$_args wgendpoint $_ep"
X        [ "$_ka" != "0" ] && [ -n "$_ka" ] && _args="$_args wgpka $_ka"
X        # shellcheck disable=SC2086 (word-splitting disengaja)
X        ifconfig "$_n" $_args || echo "wireguard $_n: peer $_pub gagal dipasang" >&2
X    done
X    echo "wireguard $_n: applied (addr ${_addr:-unset}, port ${_port:-51820})"
X    return 0
X}
X
Xcmd_apply_all() {
X    _any=0
X    for _f in "$STATE_DIR"/wg*.conf; do
X        [ -f "$_f" ] || continue
X        _any=1
X        apply_one "$(basename "$_f" .conf)" || exit 33
X    done
X    [ "$_any" = "1" ] || echo "wireguard: tidak ada interface terkonfigurasi"
X    rm -f "$DIRTY"
X    exit 0
X}
X
Xcase "${1:-}" in
X    check) cmd_check "${2:-wg0}" ;;
X    show) cmd_show ;;
X    show-one) cmd_show_one "${2:-}" ;;
X    set-enable) cmd_set_enable "${2:-}" "${3:-}" ;;
X    set-address) cmd_set_address "${2:-}" "${3:-}" ;;
X    del-address) cmd_del_address "${2:-}" ;;
X    set-listen-port) cmd_set_listen_port "${2:-}" "${3:-}" ;;
X    del-listen-port) cmd_del_listen_port "${2:-}" ;;
X    generate-key) cmd_generate_key "${2:-}" ;;
X    peer-add) cmd_peer_add "${2:-}" "${3:-}" ;;
X    peer-del) cmd_peer_del "${2:-}" "${3:-}" ;;
X    peer-set) cmd_peer_set "${2:-}" "${3:-}" "${4:-}" "${5:-}" ;;
X    peer-del-field) cmd_peer_del_field "${2:-}" "${3:-}" "${4:-}" ;;
X    del-iface) cmd_del_iface "${2:-}" ;;
X    apply-all) cmd_apply_all ;;
X    *) echo "Usage: $0 {check|show|show-one|set-enable|set-address|del-address|set-listen-port|del-listen-port|generate-key|peer-add|peer-del|peer-set|peer-del-field|del-iface|apply-all} ..." >&2; exit 2 ;;
Xesac
