echo x - net/titian/files/tree/conf-commit.xml
sed 's/^X//' >net/titian/files/tree/conf-commit.xml << 'b55b2033b966eb67c8a76c0a50d16bf5'
X<?xml version="1.0" encoding="UTF-8"?>
X<CLISH_MODULE xmlns="http://clish.sourceforge.net/XMLSchema"
X          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
X xsi:schemaLocation="http://clish.sourceforge.net/XMLSchema
X                     http://clish.sourceforge.net/XMLSchema/clish.xsd">
X    <!--=======================================================-->
X    <!-- commit — BSDRP port (BARU).
X         Semantik (feature-list §1): commit = tulis file + service
X         langsung naik. `save` = `config save` (persist ke partisi
X         cfg); commit tanpa save = jalan sekarang, hilang setelah
X         reboot karena rc.conf ada di RAM disk.
X         Yang dilakukan commit (titian-commit.sh):
X           1. mutual-exclusion bird vs FRR (blokir + pesan jelas
X              bila konflik — dua arah);
X           2. validasi varian bird3 atas bird.conf (braces `case`,
X              atribut `scope`);
X           3. terapkan semua niat yang ditandai dirty: bird/frr
X              (sysrc + service), firewall, traffic-shape, pppoe,
X              wireguard, monitoring.
X         Bila ada langkah yang gagal, commit BERHENTI dan melaporkannya;
X         tidak ada terap paksa. -->
X
X<VIEW name="configure-view">
X    <COMMAND name="commit"
X        help="Terapkan perubahan pending: cek bird-vs-FRR, validasi bird.conf, naikkan service (firewall/traffic-shape/pppoe/wireguard/monitoring/bird/frr)"
X        lock="false"
X        interrupt="true">
X        <ACTION>
X            ${RT_SBIN}/titian-commit.sh commit
X        </ACTION>
X    </COMMAND>
X    <COMMAND name="commit check"
X        help="Cek saja (mutual exclusion + validasi bird.conf) tanpa menerapkan apa pun"
X        lock="false"
X        interrupt="true">
X        <ACTION>
X            ${RT_SBIN}/titian-commit.sh check
X        </ACTION>
X    </COMMAND>
X</VIEW>
X
X</CLISH_MODULE>
