X# Created by: Titian Project <titian@bsdrp.local>
X# $FreeBSD$
X
XPORTNAME=	titian
XPORTVERSION=	0.1.0
XCATEGORIES=	net
XMASTER_SITES=	https://src.libcode.org/download/klish/
XDISTNAME=	klish-2.2.5
X# Distfile is .tar.xz, NOT the default .tar.gz — without this, make
X# looks for klish-2.2.5.tar.gz and fails ("not in distinfo").
X# (Build ke-10 gagal fetch karena ini; 11 Nov 2026.)
XEXTRACT_SUFX=	.tar.xz
X
XMAINTAINER=	titian@bsdrp.local
XCOMMENT=	Cisco/Junos-style router CLI over klish and BIRD (BSDRP)
X
XLICENSE=	BSD3CLAUSE
XLICENSE_FILE=	${WRKSRC}/LICENCE
X
XLIB_DEPENDS=	libexpat.so:textproc/expat2
XRUN_DEPENDS=	birdc:net/bird2 \
X		sudo:security/sudo
X
XUSES=		gmake
XGNU_CONFIGURE=	yes
XCONFIGURE_ARGS=	--with-libexpat=${LOCALBASE} \
X		--disable-dependency-tracking
XCONFIGURE_ENV=	CPPFLAGS="-I${LOCALBASE}/include" \
X		LDFLAGS="-L${LOCALBASE}/lib"
X
X# Titian installs under /opt/titian, NOT ${LOCALBASE}: the klish
X# runtime, the XML command tree, the helper scripts and the BIRD
X# section templates all live under ${PREFIX}. Only the wrapper,
X# the rc script and the newsyslog bits live under ${LOCALBASE}
X# (they must be on the default PATH / in the rc search path).
XPREFIX=		/opt/titian
X
XSUB_FILES=	titian titian-tune-recommend titian.rc
X
X# --- klish 2.2.5 install set (verified against the tested 0.1.0 .pkg) ---
X# gmake install also drops lib/*.la and include/ headers; both are
X# removed in do-install on purpose (parity with the 0.1.0 .pkg:
X# .so files only, no headers, no .la). Lua plugin is NOT built
X# (klish default: --without-lua), so no clish_plugin_lua.so.
XKLISH_BIN=	clish konf konfd sigexec
XKLISH_LIB=	clish_plugin_clish.so \
X		libclish.so libclish.so.2 libclish.so.2.0.0 \
X		libkonf.so libkonf.so.2 libkonf.so.2.0.0 \
X		liblub.so liblub.so.2 liblub.so.2.0.0 \
X		libtinyrl.so libtinyrl.so.2 libtinyrl.so.2.0.0
X
X# --- Titian XML tree (root tree = COMMON + FreeBSD-only) ---
X# Fase 2 merged 11 Nov 2026 (from ~/workspace/titian-bsdRP-xml/):
X# traffic-shape.xml + conf-fw.xml (BSDRP pf-only merge, replaces the
X# tree conf-fw.xml) + 7 NEW: conf-commit, conf-frr, conf-monitoring,
X# conf-pppoe, conf-router, conf-wireguard, en-show-routing.
X# NO separate firewall.xml — the staging firewall was merged INTO
X# conf-fw.xml (see PENDING-FILES.md). Verified by the XML subagent:
X# 36 XML, 420 COMMAND, verify.py PASS (lab clish, incl. bare-parent
X# rule + mutual-exclusion commit flow).
XTITIAN_XML_COMMON=	bird.xml common.xml conf-commit.xml conf-frr.xml \
X		conf-fw.xml conf-monitoring.xml conf-pppoe.xml \
X		conf-route6.xml conf-router.xml conf-serv-ssh.xml \
X		conf-sys-dns.xml conf-sys.xml conf-wireguard.xml \
X		configure-mode.xml en-checkpoint.xml en-rename.xml \
X		en-show.xml en-show-hw.xml en-show-routing.xml \
X		enable-mode.xml ping.xml startup.xml traffic-shape.xml \
X		types.xml types-dev.xml types-ip6.xml
XTITIAN_XML_FBSD=	conf-if-eth-fbsd.xml conf-if-vlan-fbsd.xml \
X		conf-if-lagg-fbsd.xml conf-if-vxlan-fbsd.xml \
X		conf-if-lo-fbsd.xml conf-if-opt-fbsd.xml \
X		conf-route-fbsd.xml en-show-if-vlan-fbsd.xml \
X		en-show-if-lagg.xml en-show-if-vxlan-fbsd.xml
X# Non-root tree (tree-nonroot/): subset for unprivileged users.
XTITIAN_XML_NONROOT=	common.xml info-mode.xml overview.xml ping.xml \
X		startup.xml types.xml
X
X# --- Titian helper scripts + BIRD section templates ---
X# Fase 2 merged 11 Nov 2026: titian-commit.sh (commit + mutual
X# exclusion bird/FRR), titian-frr.sh, titian-monitoring.sh,
X# titian-pppoe.sh, titian-traffic-shape.sh (merge cfg+apply),
X# titian-wireguard.sh. titian-tune-recommend.sh is NOT referenced
X# by the XML tree; it is the backend of /usr/local/bin/titian-tune-recommend.
XTITIAN_SBIN=	titian-bird.sh titian-boot.sh titian-checkpoint.sh \
X		titian-comm.sh titian-commit.sh titian-filter.sh \
X		titian-frr.sh titian-fw.sh titian-if-list.sh titian-if.sh \
X		titian-monitoring.sh titian-persist.sh titian-pppoe.sh \
X		titian-redist.sh titian-rename.sh titian-route.sh \
X		titian-show.sh titian-sys.sh titian-sysctl.sh \
X		titian-sysinfo.sh titian-traffic-shape.sh \
X		titian-tune-recommend.sh titian-tune.sh titian-vxlan.sh \
X		titian-wireguard.sh
XTITIAN_BIRDD=	bgp.conf filter.conf function.conf ospf.conf \
X		protocol.conf static.conf
X# --- Titian rc scripts (LOCALBASE/etc/rc.d) ---
X# firewall: apply pf firewall + NAT anchors at boot (backend
X# titian-fw.sh; config /usr/local/etc/firewall.conf).
X# traffic-shape: apply dummynet config at boot (backend
X# titian-traffic-shape.sh; config /usr/local/etc/traffic-shape.conf).
X# Both default to NO in rc.conf; klish `commit` enables them via sysrc.
XTITIAN_RCD=	firewall traffic-shape
X
Xdo-install:
X	(cd ${WRKSRC} && ${MAKE_CMD} install DESTDIR=${STAGEDIR})
X	${RM} ${STAGEDIR}${PREFIX}/lib/*.la
X	${RM} -r ${STAGEDIR}${PREFIX}/include
X	${MKDIR} ${STAGEDIR}${PREFIX}/etc/clish-en \
X		${STAGEDIR}${PREFIX}/etc/clish \
X		${STAGEDIR}${PREFIX}/sbin \
X		${STAGEDIR}${PREFIX}/etc/bird.d \
X		${STAGEDIR}${PREFIX}/etc/db \
X		${STAGEDIR}${PREFIX}/etc/netstate \
X		${STAGEDIR}${PREFIX}/etc/checkpoints \
X		${STAGEDIR}${PREFIX}/etc/bird-backup \
X		${STAGEDIR}${LOCALBASE}/bin \
X		${STAGEDIR}${LOCALBASE}/etc/rc.d \
X		${STAGEDIR}${LOCALBASE}/etc/newsyslog.conf.d \
X		${STAGEDIR}${LOCALBASE}/sbin \
X		${STAGEDIR}/var/log/bird
X.for f in ${TITIAN_XML_COMMON} ${TITIAN_XML_FBSD}
X	${INSTALL_DATA} ${FILESDIR}/tree/${f} ${STAGEDIR}${PREFIX}/etc/clish-en/
X.endfor
X.for f in ${TITIAN_XML_NONROOT}
X	${INSTALL_DATA} ${FILESDIR}/tree-nonroot/${f} ${STAGEDIR}${PREFIX}/etc/clish/
X.endfor
X.for f in ${TITIAN_SBIN}
X	${INSTALL_SCRIPT} ${FILESDIR}/sbin/${f} ${STAGEDIR}${PREFIX}/sbin/
X.endfor
X.for f in ${TITIAN_BIRDD}
X	${INSTALL_DATA} ${FILESDIR}/bird.d/${f} ${STAGEDIR}${PREFIX}/etc/bird.d/
X.endfor
X	${INSTALL_SCRIPT} ${WRKDIR}/titian ${STAGEDIR}${LOCALBASE}/bin/titian
X	${INSTALL_SCRIPT} ${WRKDIR}/titian-tune-recommend ${STAGEDIR}${LOCALBASE}/bin/titian-tune-recommend
X	${INSTALL_SCRIPT} ${WRKDIR}/titian.rc ${STAGEDIR}${LOCALBASE}/etc/rc.d/titian
X.for f in ${TITIAN_RCD}
X	${INSTALL_SCRIPT} ${FILESDIR}/rc.d/${f} ${STAGEDIR}${LOCALBASE}/etc/rc.d/${f}
X.endfor
X	${INSTALL_DATA} ${FILESDIR}/newsyslog/titian-bird.conf ${STAGEDIR}${LOCALBASE}/etc/newsyslog.conf.d/titian-bird.conf
X	${INSTALL_SCRIPT} ${FILESDIR}/newsyslog/titian-bird-reopen ${STAGEDIR}${LOCALBASE}/sbin/titian-bird-reopen
X
X.include <bsd.port.mk>
