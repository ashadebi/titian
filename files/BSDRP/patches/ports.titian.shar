echo x - net/titian/files/sbin/titian-sysctl.sh
sed 's/^X//' >net/titian/files/sbin/titian-sysctl.sh << 'f0cb037cfc7adc7cfc8139d74750ab60'
X#!/bin/sh
X# TITIAN — perintah `system sysctl` (kernel parameter, kedua OS).
X# Bukan restorasi rtcli: tree lama TIDAK punya perintah sysctl sama
X# sekali; ini fitur baru.
X#
X# Jalur persistensi (tanpa daemon/service baru):
X#  1. running-config: perintah punya CONFIG di tree, jadi `save` +
X#     replay startup-config menjalankannya lagi.
X#  2. cermin OS-native (diterapkan otomatis saat boot oleh OS sendiri):
X#       Debian: /etc/sysctl.d/99-titian.conf (systemd-sysctl)
X#       FreeBSD: blok marker #-TITIAN-# ... #-ENDTITIAN-# di
X#               /etc/sysctl.conf (rc sysctl). Baris di luar blok
X#               tidak pernah disentuh.
X#  Sumber cermin = state file $ROOT/etc/sysctl.titian (bukan parsing
X#  file OS). Nilai sebelum-set pertama dicatat di sysctl.titian.prev
X#  agar `no system sysctl` bisa mengembalikan nilai live semula;
X#  bila nilai awal tidak tercatat, nilai live bertahan sampai reboot
X#  (cermin sudah bersih sehingga boot berikutnya memakai default).
X#
X# Validasi: key harus berbentuk MIB bertitik dan HARUS dikenali kernel
X# yang sedang jalan (`sysctl -n key` sukses) — ini otomatis membedakan
X# kunci Linux (net.ipv4.*) dari FreeBSD (net.inet.*). Nilai menolak
X# karakter kontrol dan metakarakter shell (; | & ` $ < > \ " ') agar
X# aman ditulis ke file cermin; vektor berspasi (mis. tcp_rmem
X# "4096 87380 6291456") diizinkan — tulis pakai tanda kutip di CLI.
X# POSIX sh (jalan di dash Debian dan sh FreeBSD).
Xset -u
XOS=$(uname -s)
XROOT=${TITIAN_ROOT:-/opt/titian}
XSTATE="$ROOT/etc/sysctl.titian"
XPREV="$ROOT/etc/sysctl.titian.prev"
X
Xerr() { echo "Error: $*" >&2; exit 33; }
Xwarn() { echo "Warning(sysctl): $*" >&2; }
X
Xvalid_key() {
X    # MIB bertitik: segmen alfanumerik/underscore, minimal satu titik
X    case "$1" in
X        *.*)
X            case "$1" in
X                *[!A-Za-z0-9_.]*) return 1 ;;
X                *..*|.*|*.) return 1 ;;
X                *) return 0 ;;
X            esac
X            ;;
X        *) return 1 ;;
X    esac
X}
Xvalid_value() {
X    # tolak kosong dan metakarakter shell (karakter kontrol praktis
X    # tidak mungkin lewat baris perintah klish; nilai vektor berspasi
X    # diizinkan)
X    case "$1" in
X        '') return 1 ;;
X        *';'*|*'|'*|*'&'*|*'`'*|*'$'*|*'<'*|*'>'*|*'\'*|*'"'*|*"'"*) return 1 ;;
X        *) return 0 ;;
X    esac
X}
X
Xstate_set() {
X    # $1=key $2=value: ganti baris key di state (tanpa duplikat)
X    local esc
X    mkdir -p "$ROOT/etc" 2>/dev/null || return 0
X    touch "$STATE" 2>/dev/null || return 0
X    esc=$(printf '%s' "$1" | sed 's/[.[\*^$]/\\&/g')
X    grep -v "^$esc=" "$STATE" > "$STATE.tmp" 2>/dev/null; mv "$STATE.tmp" "$STATE" 2>/dev/null || true
X    echo "$1=$2" >> "$STATE"
X}
Xstate_del() {
X    local esc
X    [ -f "$STATE" ] || return 0
X    esc=$(printf '%s' "$1" | sed 's/[.[\*^$]/\\&/g')
X    grep -v "^$esc=" "$STATE" > "$STATE.tmp" 2>/dev/null; mv "$STATE.tmp" "$STATE" 2>/dev/null || true
X}
Xprev_get() {
X    # format file: key=nilai-awal (nilai sysctl praktis tak mengandung '=')
X    local esc
X    [ -f "$PREV" ] || return 0
X    esc=$(printf '%s' "$1" | sed 's/[.[\*^$]/\\&/g')
X    grep "^$esc=" "$PREV" 2>/dev/null | tail -1 | cut -d= -f2-
X}
Xprev_set() {
X    # catat nilai awal hanya bila key belum pernah dicatat
X    local cur esc
X    [ -n "$(prev_get "$1")" ] && return 0
X    cur=$(sysctl -n "$1" 2>/dev/null) || return 0
X    mkdir -p "$ROOT/etc" 2>/dev/null || return 0
X    touch "$PREV" 2>/dev/null || return 0
X    esc=$(printf '%s' "$1" | sed 's/[.[\*^$]/\\&/g')
X    grep -v "^$esc=" "$PREV" > "$PREV.tmp" 2>/dev/null; mv "$PREV.tmp" "$PREV" 2>/dev/null || true
X    echo "$1=$cur" >> "$PREV"
X}
Xprev_del() {
X    local esc
X    [ -f "$PREV" ] || return 0
X    esc=$(printf '%s' "$1" | sed 's/[.[\*^$]/\\&/g')
X    grep -v "^$esc=" "$PREV" > "$PREV.tmp" 2>/dev/null; mv "$PREV.tmp" "$PREV" 2>/dev/null || true
X}
X
Xmirror_linux() {
X    local f=/etc/sysctl.d/99-titian.conf
X    mkdir -p /etc/sysctl.d 2>/dev/null || { warn "tidak bisa mkdir /etc/sysctl.d"; return 0; }
X    {
X        echo "# TITIAN — dikelola perintah 'system sysctl'; jangan edit manual"
X        echo "# (diterapkan saat boot oleh systemd-sysctl; hapus lewat 'no system sysctl <key>')"
X        if [ -f "$STATE" ]; then
X            # grep exit 1 bila state kosong (semua key dihapus) — itu
X            # BUKAN gagal tulis; jangan biarkan statusnya menggagalkan mv
X            grep -v '^$' "$STATE" 2>/dev/null || true
X        fi
X    } > "$f.tmp" 2>/dev/null && mv "$f.tmp" "$f" || { warn "gagal tulis $f"; return 0; }
X}
Xmirror_freebsd() {
X    local rc=/etc/sysctl.conf tmp
X    tmp=$(mktemp /tmp/titian-sysctl.XXXXXX) || { warn "gagal mktemp"; return 0; }
X    {
X        if [ -f "$rc" ]; then
X            awk '/^#-TITIAN-#/{skip=1; next} /^#-ENDTITIAN-#/{skip=0; next} !skip {print}' "$rc"
X        fi
X        echo "#-TITIAN-#"
X        if [ -f "$STATE" ]; then
X            # lihat mirror_linux: grep exit 1 saat state kosong != gagal
X            grep -v '^$' "$STATE" 2>/dev/null || true
X        fi
X        echo "#-ENDTITIAN-#"
X    } > "$tmp" 2>/dev/null
X    if [ -f "$rc" ]; then
X        cp -f "$rc" /etc/sysctl.conf.titian-bak 2>/dev/null || true
X    fi
X    cat "$tmp" > "$rc" 2>/dev/null || { warn "gagal tulis $rc"; rm -f "$tmp"; return 0; }
X    rm -f "$tmp"
X}
Xmirror() { if [ "$OS" = "FreeBSD" ]; then mirror_freebsd; else mirror_linux; fi; }
X
Xsysctl_set() {
X    # $1=key $2=value
X    local key=$1 val=$2 cur
X    valid_key "$key" || err "key sysctl tidak valid (harus MIB bertitik, ex: net.ipv4.ip_forward): $key"
X    valid_value "$val" || err "nilai sysctl ditolak (kosong / mengandung karakter kontrol atau metakarakter shell): $val"
X    cur=$(sysctl -n "$key" 2>/dev/null) || err "key tidak dikenali kernel $OS ini: $key (kunci Linux net.ipv4.* tidak ada di FreeBSD dan sebaliknya)"
X    prev_set "$key"
X    if [ "$OS" = "FreeBSD" ]; then
X        sysctl "$key=$val" >/dev/null 2>&1 || err "gagal set $key=$val (nilai di luar rentang yang diizinkan kernel?)"
X    else
X        sysctl -w "$key=$val" >/dev/null 2>&1 || err "gagal set $key=$val (nilai di luar rentang yang diizinkan kernel?)"
X    fi
X    state_set "$key" "$val"
X    mirror
X    echo "sysctl $key: $cur -> $val (live + persisten)"
X}
Xsysctl_del() {
X    # $1=key: hapus dari state+cermin; kembalikan nilai live semula bila tercatat
X    local key=$1 prev
X    valid_key "$key" || err "key sysctl tidak valid: $key"
X    prev=$(prev_get "$key")
X    state_del "$key"
X    prev_del "$key"
X    mirror
X    if [ -n "$prev" ]; then
X        if [ "$OS" = "FreeBSD" ]; then
X            sysctl "$key=$prev" >/dev/null 2>&1 || warn "gagal kembalikan $key live ke $prev"
X        else
X            sysctl -w "$key=$prev" >/dev/null 2>&1 || warn "gagal kembalikan $key live ke $prev"
X        fi
X        echo "sysctl $key: dihapus dari cermin, nilai live dikembalikan ke $prev"
X    else
X        echo "sysctl $key: dihapus dari cermin; nilai live bertahan sampai reboot (boot berikutnya memakai default OS)"
X    fi
X}
X
Xmeaning() {
X    # $1=key -> satu baris arti (kunci yang dikenal; sisanya "-")
X    case "$1" in
X        net.ipv4.ip_forward|net.inet.ip.forwarding) echo "router wajib 1: kernel meneruskan paket antar interface; 0 = host biasa (endpoint)." ;;
X        net.ipv6.conf.all.forwarding|net.inet6.ip6.forwarding) echo "seperti ip_forward, untuk IPv6." ;;
X        net.ipv4.conf.all.rp_filter|net.ipv4.conf.default.rp_filter) echo "reverse-path filter: 1=strict (tolak paket dari jalur tak terduga — merusak routing asimetris), 2=loose (disarankan untuk router), 0=mati." ;;
X        net.core.netdev_max_backlog) echo "panjang antrean paket masuk sebelum diproses; naikkan bila drop RX saat burst." ;;
X        net.core.rmem_max|net.core.wmem_max) echo "buffer socket maksimum yang boleh diminta aplikasi (menaikkan ini saja tanpa tcp_rmem/tcp_wmem tidak berefek)." ;;
X        net.ipv4.tcp_rmem|net.ipv4.tcp_wmem) echo "buffer TCP min/default/maks (tiga angka); naikkan maks untuk sesi throughput tinggi/latensi tinggi (BGP jarak jauh, transfer besar)." ;;
X        net.inet.tcp.sendbuf_max|net.inet.tcp.recvbuf_max) echo "buffer TCP maksimum FreeBSD; naikkan untuk sesi throughput tinggi/latensi tinggi." ;;
X        net.ipv4.tcp_congestion_control) echo "algoritma congestion control TCP (cubic/bbr bila tersedia)." ;;
X        *) echo "-" ;;
X    esac
X}
Xsysctl_show() {
X    echo "Sysctl yang dikelola Titian ($OS) — nilai live saat ini:"
X    if [ ! -s "$STATE" ]; then
X        echo "  (belum ada — pakai 'system sysctl <key> <value>' untuk menambah)"
X        return 0
X    fi
X    while IFS='=' read -r k v; do
X        [ -n "$k" ] || continue
X        live=$(sysctl -n "$k" 2>/dev/null || echo "?")
X        echo "  $k = $live  (tersimpan: $v)"
X        echo "    arti: $(meaning "$k")"
X    done < "$STATE"
X}
Xsysctl_apply() {
X    # terapkan ulang semua baris state (perbaikan manual; boot OS
X    # sudah menerapkan cermin sendiri sehingga tidak di-hook ke boot)
X    [ -f "$STATE" ] || return 0
X    while IFS='=' read -r k v; do
X        [ -n "$k" ] || continue
X        if [ "$OS" = "FreeBSD" ]; then
X            sysctl "$k=$v" >/dev/null 2>&1 || true
X        else
X            sysctl -w "$k=$v" >/dev/null 2>&1 || true
X        fi
X    done < "$STATE"
X}
X
Xcase "${1:-}" in
X    set) sysctl_set "$2" "$3" ;;
X    del) sysctl_del "$2" ;;
X    show) sysctl_show ;;
X    apply) sysctl_apply ;;
X    mirror) mirror ;;
X    *) echo "Usage: $0 {set|del|show|apply|mirror} ..." >&2; exit 2 ;;
Xesac
