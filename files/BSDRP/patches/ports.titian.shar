echo x - net/titian/files/sbin/titian-route.sh
sed 's/^X//' >net/titian/files/sbin/titian-route.sh << '09b9862eae960fd6d1b9fe072d7b0aa8'
X#!/bin/sh
X# TITIAN Fase 1 — route IPv6 (conf-route6.xml). v4 tetap inline di
X# conf-route.xml (Linux) / conf-route-fbsd.xml (FreeBSD).
X# POSIX sh.
XOS=$(uname -s)
Xerr() { echo "Error: $*" >&2; exit 33; }
X
Xfbsd_change_or_add() {
X    # $1.. = argumen route (tanpa subcommand change/add)
X    route change "$@" 2>/dev/null || route add "$@" || err "route gagal: $*"
X}
X
Xcase "${1:-}" in
X    gw6)
X        if [ "$OS" = "FreeBSD" ]; then
X            route -n get -inet6 default >/dev/null 2>&1 && route change -inet6 default "$2" || route add -inet6 default "$2" || err "gagal set default-gateway v6 $2"
X        else
X            ip -6 route replace default via "$2" || err "gagal set default-gateway v6 $2"
X        fi
X        ;;
X    gw6-del)
X        if [ "$OS" = "FreeBSD" ]; then
X            route delete -inet6 default || err "gagal hapus default-gateway v6"
X        else
X            ip -6 route del default || err "gagal hapus default-gateway v6"
X        fi
X        ;;
X    route6-dev)
X        if [ "$OS" = "FreeBSD" ]; then
X            fbsd_change_or_add -inet6 "$2" -interface "$3"
X        else
X            ip -6 route replace "$2" dev "$3" || err "gagal route v6 $2 dev $3"
X        fi
X        ;;
X    route6-via)
X        if [ "$OS" = "FreeBSD" ]; then
X            fbsd_change_or_add -inet6 "$2" "$3"
X        else
X            ip -6 route replace "$2" via "$3" || err "gagal route v6 $2 via $3"
X        fi
X        ;;
X    route6-del)
X        if [ "$OS" = "FreeBSD" ]; then
X            route delete -inet6 "$2" || err "gagal hapus route v6 $2"
X        else
X            ip -6 route del "$2" || err "gagal hapus route v6 $2"
X        fi
X        ;;
X    route6-blackhole)
X        if [ "$OS" = "FreeBSD" ]; then
X            route add -inet6 "$2" ::1 -blackhole || err "gagal blackhole v6 $2"
X        else
X            ip -6 route replace blackhole "$2" || err "gagal blackhole v6 $2"
X        fi
X        ;;
X    route6-blackhole-del)
X        if [ "$OS" = "FreeBSD" ]; then
X            route delete -inet6 "$2" || err "gagal hapus blackhole v6 $2"
X        else
X            ip -6 route del blackhole "$2" || err "gagal hapus blackhole v6 $2"
X        fi
X        ;;
X    *) echo "Usage: $0 {gw6|gw6-del|route6-dev|route6-via|route6-del|route6-blackhole|route6-blackhole-del} ..." >&2; exit 2 ;;
Xesac
