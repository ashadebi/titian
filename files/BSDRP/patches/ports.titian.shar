echo x - net/titian/files/sbin/titian-filter.sh
sed 's/^X//' >net/titian/files/sbin/titian-filter.sh << '7cfe35d6635eb21afd548553febf0439'
X#!/bin/sh
X# TITIAN — tempel/lepas filter BIRD ke protokol lewat CLI (bird-view).
X# Pola: cari blok protokol di bird.d/*.conf -> edit baris import/export
X# blok ipv4 -> check section (parse saja) -> lolos baru generate section.
X# Gagal check = fragment dikembalikan dari backup, tidak ada perubahan
X# diterapkan. Generate gagal setelah check lolos hanya diperingatkan,
X# sama seperti titian-comm.sh (fragmen sudah teredit, bird.conf sudah
X# tertulis tapi belum di-configure; ulangi generate).
X# Detach mengembalikan default: import all / export none (keadaan
X# pra-tempel bgp_mikrotik; diumumkan di output).
X# Perintah ini menerima NAMA FILTER, bukan nilai community. Dukungan
X# well-known attribute hidup di titian-comm.sh (community add menerima
X# no-export/no-advertise/no-peer/blackhole) dan tetap berlaku sesudah
X# filter ditempel, karena community add me-regenerate section filter
X# yang kini dirujuk protokol.
X# Batasan: hanya baris import/export satu baris di blok ipv4 yang
X# didukung (indentasi spasi, sesuai fragmen yang ada). Filter inline
X# multi-baris (import filter { ... }) ditolak tertutup, tanpa perubahan.
X# POSIX sh. Dipanggil dari bird-view sebagai ${RT_SBIN}/titian-filter.sh.
XDIR=$(dirname "$0")
XROOT=$(dirname "$DIR")
XBIRDD="$ROOT/etc/bird.d"
XFILTER="$BIRDD/filter.conf"
XBIRD_SH="$DIR/titian-bird.sh"
Xerr() { echo "Error: $*" >&2; exit 33; }
X[ -d "$BIRDD" ] || err "bird.d tidak ada: $BIRDD"
X[ -f "$FILTER" ] || err "filter.conf tidak ada: $FILTER"
X[ -x "$BIRD_SH" ] || err "titian-bird.sh tidak ada: $BIRD_SH"
X
Xvalid_name() {
X    case "$1" in ''|*[!A-Za-z0-9_]*) return 1 ;; *) return 0 ;; esac
X}
X
X# find_proto NAME -> cetak path fragmen (satu baris). Gagal bila tidak
X# ditemukan, atau ditemukan di lebih dari satu fragmen.
Xfind_proto() {
X    local name=$1 f n files
X    files=""
X    n=0
X    for f in "$BIRDD"/*.conf; do
X        [ -f "$f" ] || continue
X        if grep -Eq "^ *protocol +[A-Za-z0-9_]+ +$name *[{]" "$f" 2>/dev/null; then
X            files="$files $f"
X            n=$((n + 1))
X        fi
X    done
X    case $n in
X        0) err "protokol $name tidak ditemukan di $BIRDD/*.conf (tulis dulu ke fragmen, lalu generate)" ;;
X        1) ;;
X        *) err "protokol $name ditemukan di lebih dari satu fragmen:$files (rapikan dulu)" ;;
X    esac
X    echo "${files# }"
X}
X
X# section_of FRAG -> nama section (basename tanpa .conf). Gagal bila
X# bukan section yang bisa di-generate titian-bird.sh.
Xsection_of() {
X    local base=${1##*/}
X    local sec=${base%.conf}
X    case "$sec" in
X        function|filter|protocol|static|bgp|ospf|direct|bfd|pipe) echo "$sec" ;;
X        *) err "fragmen $base bukan section generate (function|filter|protocol|static|bgp|ospf|direct|bfd|pipe)" ;;
X    esac
X}
X
Xfilter_defined() {
X    grep -Eq "^filter $1 *[{]" "$FILTER" 2>/dev/null
X}
X
X# edit_frag FRAG PROTO DIR STMT -> ganti baris import/export di blok ipv4.
X# rc: 0 diganti, 5 sudah sama (no-op), 2 protokol tak ada, 3 blok ipv4
X# tak ada, 4 baris import/export tak ada, 6 protokol ganda dalam satu
X# fragmen, 7 filter inline (tidak didukung).
Xedit_frag() {
X    local frag=$1 proto=$2 dir=$3 stmt=$4 kw
X    if [ "$dir" = import ]; then kw=import; else kw=export; fi
X    awk -v proto="$proto" -v kw="$kw" -v stmt="$stmt" '
X        BEGIN {
X            pstart = "^ *protocol +[A-Za-z0-9_]+ +" proto " *[{]"
X            inproto = 0; depth = 0; inipv4 = 0; ipv4base = 0
X            found_proto = 0; found_ipv4 = 0; replaced = 0; already = 0
X            blocks = 0; inline = 0
X        }
X        {
X            line = $0
X            if (line ~ /^ *#/) { print line; next }
X            tmp = line
X            o = gsub(/[{]/, "&", tmp)
X            tmp = line
X            c = gsub(/[}]/, "&", tmp)
X            if (!inproto && line ~ pstart) {
X                inproto = 1; found_proto = 1; depth = 0; blocks++
X            }
X            if (inproto && !inipv4 && line ~ /^ *ipv4 *[{]/) {
X                inipv4 = 1; found_ipv4 = 1; ipv4base = depth
X            }
X            out = line
X            if (inproto && inipv4 && !replaced && !already && !inline) {
X                if (line ~ kw " +filter +[{]") {
X                    inline = 1
X                } else if (index(line, stmt) > 0) {
X                    already = 1
X                } else if (sub(kw " +[^;]+;", stmt, out)) {
X                    replaced = 1
X                }
X            }
X            print out
X            depth = depth + o - c
X            if (inipv4 && depth <= ipv4base) inipv4 = 0
X            if (inproto && depth == 0) inproto = 0
X        }
X        END {
X            if (blocks > 1) exit 6
X            if (inline) exit 7
X            if (already) exit 5
X            if (!found_proto) exit 2
X            if (!found_ipv4) exit 3
X            if (!replaced) exit 4
X            exit 0
X        }
X    ' "$frag" > "$frag.tmp"
X    return $?
X}
X
X# show_frag FRAG PROTO -> cetak baris import/export blok ipv4.
X# rc: 0 ok, 2/3/4/6 sama seperti edit_frag.
Xshow_frag() {
X    local frag=$1 proto=$2
X    awk -v proto="$proto" '
X        BEGIN {
X            pstart = "^ *protocol +[A-Za-z0-9_]+ +" proto " *[{]"
X            inproto = 0; depth = 0; inipv4 = 0; ipv4base = 0
X            found_proto = 0; found_ipv4 = 0; found_any = 0; blocks = 0
X        }
X        {
X            line = $0
X            if (line ~ /^ *#/) next
X            tmp = line
X            o = gsub(/[{]/, "&", tmp)
X            tmp = line
X            c = gsub(/[}]/, "&", tmp)
X            if (!inproto && line ~ pstart) {
X                inproto = 1; found_proto = 1; depth = 0; blocks++
X            }
X            if (inproto && !inipv4 && line ~ /^ *ipv4 *[{]/) {
X                inipv4 = 1; found_ipv4 = 1; ipv4base = depth
X            }
X            if (inproto && inipv4) {
X                i = index(line, "import")
X                if (i > 0) {
X                    s = substr(line, i); j = index(s, ";")
X                    if (j > 0) { print "  " substr(s, 1, j); found_any = 1 }
X                }
X                i = index(line, "export")
X                if (i > 0) {
X                    s = substr(line, i); j = index(s, ";")
X                    if (j > 0) { print "  " substr(s, 1, j); found_any = 1 }
X                }
X            }
X            depth = depth + o - c
X            if (inipv4 && depth <= ipv4base) inipv4 = 0
X            if (inproto && depth == 0) inproto = 0
X        }
X        END {
X            if (blocks > 1) exit 6
X            if (!found_proto) exit 2
X            if (!found_ipv4) exit 3
X            if (!found_any) exit 4
X            exit 0
X        }
X    ' "$frag"
X    return $?
X}
X
X# apply SECTION FRAG: check dulu, lolos baru generate; gagal check ->
X# fragment dikembalikan dari backup pra-edit (.cli-bak dibuat pemanggil
X# SEBELUM edit; backup di sini akan percuma karena file sudah teredit).
Xapply() {
X    local sec=$1 frag=$2
X    if ! "$BIRD_SH" check "$sec" >/tmp/titian-filter-check.out 2>&1; then
X        cat /tmp/titian-filter-check.out >&2
X        cp -f "$frag.cli-bak" "$frag"
X        err "parse GAGAL, $frag dikembalikan (tidak ada perubahan diterapkan)"
X    fi
X    "$BIRD_SH" generate "$sec" || {
X        echo "PERINGATAN: generate $sec gagal setelah check lolos; fragmen tetap teredit, backup pra-edit: $frag.cli-bak" >&2
X        exit 33
X    }
X}
X
X# edit_finish FRAG RC: mv tmp bila rc=0, hapus tmp bila bukan.
Xedit_finish() {
X    if [ "$2" = 0 ]; then
X        mv -f "$1.tmp" "$1" || err "gagal tulis $1"
X    else
X        rm -f "$1.tmp"
X    fi
X}
X
Xedit_err() {
X    # $1=rc $2=frag $3=proto $4=dir
X    case "$1" in
X        2) err "protokol $3 tidak ditemukan di $2" ;;
X        3) err "blok ipv4 tidak ditemukan di protokol $3 ($2)" ;;
X        4) err "baris $4 tidak ditemukan di blok ipv4 protokol $3 (hanya baris satu baris didukung)" ;;
X        6) err "protokol $3 ganda dalam $2 (rapikan dulu)" ;;
X        7) err "filter inline multi-baris untuk $4 di $3 tidak didukung (edit manual)" ;;
X        *) err "gagal edit $2 (rc=$1)" ;;
X    esac
X}
X
Xdo_attach() {
X    local proto=$1 dir=$2 filt=$3 frag sec stmt rc
X    valid_name "$proto" || err "nama protokol tidak valid: $proto"
X    valid_name "$filt" || err "nama filter tidak valid: $filt"
X    case "$dir" in import|export) ;; *) err "arah tidak valid: $dir (import|export)" ;; esac
X    frag=$(find_proto "$proto") || exit 33
X    sec=$(section_of "$frag") || exit 33
X    filter_defined "$filt" || err "filter $filt tidak didefinisikan di $FILTER (buat dulu di filter.conf)"
X    cp -f "$frag" "$frag.cli-bak" || err "gagal backup $frag"
X    stmt="$dir filter $filt;"
X    edit_frag "$frag" "$proto" "$dir" "$stmt"; rc=$?
X    edit_finish "$frag" "$rc"
X    case $rc in
X        5) echo "sudah ditempel: $proto $dir -> filter $filt (section $sec)"; return 0 ;;
X        0) ;;
X        *) edit_err "$rc" "$frag" "$proto" "$dir" ;;
X    esac
X    apply "$sec" "$frag" || exit 33
X    echo "ditempel: $proto $dir -> filter $filt (section $sec)"
X}
X
Xdo_detach() {
X    local proto=$1 dir=$2 frag sec stmt rc
X    valid_name "$proto" || err "nama protokol tidak valid: $proto"
X    case "$dir" in import|export) ;; *) err "arah tidak valid: $dir (import|export)" ;; esac
X    frag=$(find_proto "$proto") || exit 33
X    sec=$(section_of "$frag") || exit 33
X    cp -f "$frag" "$frag.cli-bak" || err "gagal backup $frag"
X    if [ "$dir" = import ]; then stmt="import all;"; else stmt="export none;"; fi
X    edit_frag "$frag" "$proto" "$dir" "$stmt"; rc=$?
X    edit_finish "$frag" "$rc"
X    case $rc in
X        5) echo "sudah default: $proto $dir -> $stmt (section $sec)"; return 0 ;;
X        0) ;;
X        *) edit_err "$rc" "$frag" "$proto" "$dir" ;;
X    esac
X    apply "$sec" "$frag" || exit 33
X    echo "dilepas: $proto $dir -> $stmt (default; section $sec)"
X}
X
Xdo_show() {
X    local proto=$1 frag sec rc
X    valid_name "$proto" || err "nama protokol tidak valid: $proto"
X    frag=$(find_proto "$proto") || exit 33
X    sec=$(section_of "$frag") || exit 33
X    echo "$proto (section $sec):"
X    show_frag "$frag" "$proto"; rc=$?
X    case $rc in
X        0) return 0 ;;
X        *) edit_err "$rc" "$frag" "$proto" "import/export" ;;
X    esac
X}
X
Xcase "${1:-}" in
X    attach) do_attach "$2" "$3" "$4" ;;
X    detach) do_detach "$2" "$3" ;;
X    show)   do_show "$2" ;;
X    *) echo "Usage: $0 {attach <proto> <import|export> <filter>|detach <proto> <import|export>|show <proto>}" >&2; exit 2 ;;
Xesac
7cfe35d6635eb21afd548553febf0439
echo x - net/titian/files/sbin/titian-frr.sh
sed 's/^X//' >net/titian/files/sbin/titian-frr.sh << 'cdb9848e1fa6fbbd5dcee3ee615deecc'
X#!/bin/sh
X# TITIAN BSDRP — FRR (net/frr10) via klish.
X# - Enable/disable TIDAK langsung start/stop service: hanya mencatat
X#   niat di $ROOT/etc/netstate/routing.intent (format sama dengan
X#   titian-bird.sh) + menandai /var/run/routing.dirty; yang menaikkan
X#   service adalah `commit` (titian-commit.sh -> frr-apply di sini).
X#   Alasan: commit = tulis file + service langsung naik.
X# - Config dasar (router-id, log syslog) berlaku LANGSUNG via vtysh
X#   (running) + `write memory` agar persisten — model native FRR.
X# - CLI FRR sendiri tetap `vtysh` via perintah `cli`; script ini
X#   TIDAK mendefinisikan/menyentuh `cli`.
X# POSIX sh.
XOS=$(uname -s)
XROOT=${TITIAN_ROOT:-/opt/titian}
XSBIN_DIR=$(dirname "$0")
XBIRD_SH="$SBIN_DIR/titian-bird.sh"
XINTENT="$ROOT/etc/netstate/routing.intent"
XDIRTY=/var/run/routing.dirty
XFRR_CONF=/usr/local/etc/frr/frr.conf
Xerr() { echo "Error: $*" >&2; exit 33; }
X
Xhave_vtysh() { command -v vtysh >/dev/null 2>&1; }
X
Xvtysh_cmd() {
X    # $* = perintah vtysh (satu string -c). Gagal lantang bila vtysh tak ada.
X    have_vtysh || err "vtysh tidak ditemukan (FRR tidak terpasang di image ini?)"
X    vtysh -c "$*" || err "vtysh gagal: $*"
X}
X
Xsysrc_val() {
X    command -v sysrc >/dev/null 2>&1 || return 1
X    sysrc -n "$1" 2>/dev/null
X}
X
Xset_intent() {
X    # $1 = yes|no (niat frr)
X    mkdir -p "$(dirname "$INTENT")" 2>/dev/null
X    touch "$INTENT" 2>/dev/null
X    _tmp="$INTENT.tmp.$$"
X    grep -v "^frr " "$INTENT" > "$_tmp" 2>/dev/null || true
X    printf 'frr %s\n' "$1" >> "$_tmp"
X    mv "$_tmp" "$INTENT" || err "gagal tulis $INTENT"
X    touch "$DIRTY" 2>/dev/null || true
X}
X
Xintent_val() {
X    [ -f "$INTENT" ] || { echo "unset"; return 0; }
X    _v=$(sed -n 's/^frr //p' "$INTENT" 2>/dev/null | head -1)
X    printf '%s' "${_v:-unset}"
X}
X
Xsvc() {
X    # svc <name> <action>: gagal-aman bila `service` tak ada (uji Linux).
X    if command -v service >/dev/null 2>&1; then
X        service "$1" "$2"
X    else
X        echo "(service tidak ada di host ini — lewati: service $1 $2)"
X    fi
X}
X
Xdo_check() {
X    have_vtysh || err "FRR tidak terpasang (vtysh tidak ditemukan)"
X    exit 0
X}
X
Xdo_enable() {
X    have_vtysh || err "FRR tidak terpasang (vtysh tidak ditemukan)"
X    # Mutual exclusion: tolak bila BIRD aktif (sysrc / service / proses / niat).
X    sh "$BIRD_SH" check-exclusion frr || exit 33
X    set_intent yes
X    echo "router frr enable (pending commit — service frr naik saat commit)"
X}
X
Xdo_disable() {
X    set_intent no
X    echo "router frr disable (pending commit — service frr berhenti saat commit)"
X}
X
Xdo_apply() {
X    # Dipanggil commit (dan boot). Terapkan niat: sysrc + service.
X    local want
X    want=$(intent_val)
X    [ "$want" = "unset" ] && { echo "frr: tidak ada niat pending"; rm -f "$DIRTY"; return 0; }
X    if [ "$want" = "yes" ]; then
X        # Periksa ulang konflik SEBELUM menaikkan service.
X        sh "$BIRD_SH" check-exclusion frr || exit 33
X        if command -v sysrc >/dev/null 2>&1; then sysrc frr_enable="YES" >/dev/null || err "sysrc frr_enable gagal"; fi
X        if [ -n "$(pgrep -x zebra 2>/dev/null | head -1)" ]; then
X            echo "frr: zebra sudah jalan (tidak di-restart)"
X        else
X            svc frr start || err "service frr start gagal"
X        fi
X        echo "frr: enabled + running"
X    else
X        if command -v sysrc >/dev/null 2>&1; then sysrc frr_enable="NO" >/dev/null || err "sysrc frr_enable gagal"; fi
X        svc frr stop 2>/dev/null || true
X        echo "frr: disabled + stopped"
X    fi
X    rm -f "$DIRTY"
X    return 0
X}
X
Xdo_set_router_id() {
X    local id=$1
X    case "$id" in
X        *.*.*.*) ;;
X        *) err "router-id harus IPv4: $id" ;;
X    esac
X    # vtysh menerima beberapa -c berurutan dalam satu sesi.
X    have_vtysh || err "vtysh tidak ditemukan"
X    vtysh -c "configure terminal" -c "router-id $id" -c "end" -c "write memory" \
X        || err "gagal set router-id $id via vtysh"
X    echo "frr: router-id $id (running + write memory)"
X}
X
Xdo_del_router_id() {
X    have_vtysh || err "vtysh tidak ditemukan"
X    vtysh -c "configure terminal" -c "no router-id" -c "end" -c "write memory" \
X        || err "gagal hapus router-id via vtysh"
X    echo "frr: router-id dihapus (running + write memory)"
X}
X
Xdo_set_log() {
X    # $1 = syslog|none
X    have_vtysh || err "vtysh tidak ditemukan"
X    if [ "$1" = "syslog" ]; then
X        vtysh -c "configure terminal" -c "log syslog" -c "end" -c "write memory" \
X            || err "gagal set log syslog via vtysh"
X        echo "frr: log syslog (running + write memory)"
X    else
X        vtysh -c "configure terminal" -c "no log syslog" -c "end" -c "write memory" \
X            || err "gagal matikan log syslog via vtysh"
X        echo "frr: log syslog dimatikan (running + write memory)"
X    fi
X}
X
Xdo_write_memory() {
X    vtysh_cmd "write memory"
X    echo "frr: running-config ditulis ke $FRR_CONF"
X}
X
Xfrr_version() {
X    local v=""
X    if have_vtysh; then
X        v=$(vtysh --version 2>/dev/null | head -1 | sed -n 's/.* \([0-9][0-9.]*\).*/\1/p')
X    fi
X    if [ -z "$v" ] && command -v pkg >/dev/null 2>&1; then
X        v=$(pkg info -x '^frr[0-9]*$' 2>/dev/null | head -1 | sed -n 's/^frr[0-9]*-\([0-9][0-9.]*\).*/\1/p')
X    fi
X    printf '%s' "${v:-unknown}"
X}
X
Xdo_show() {
X    local want fver fen frn zpid
X    want=$(intent_val); fver=$(frr_version)
X    fen=no; frn="not running"
X    [ "$(sysrc_val frr_enable 2>/dev/null)" = "YES" ] && fen="enabled"
X    zpid=$(pgrep -x zebra 2>/dev/null | head -1)
X    [ -n "$zpid" ] && frn="running, pid $zpid"
X    echo "FRR: $fver (intent: $want, rc: $fen, $frn)"
X    if command -v service >/dev/null 2>&1; then
X        service frr status 2>&1 | sed 's/^/  /'
X    fi
X    if have_vtysh && [ -n "$zpid" ]; then
X        echo "-- daemons (vtysh show version):"
X        vtysh -c "show version" 2>/dev/null | head -5 | sed 's/^/  /'
X    fi
X}
X
Xdo_show_version() {
X    local fver zpid
X    fver=$(frr_version)
X    zpid=$(pgrep -x zebra 2>/dev/null | head -1)
X    if [ -n "$zpid" ]; then
X        echo "FRR $fver (running, pid $zpid)"
X    else
X        echo "FRR $fver (not running)"
X    fi
X    if have_vtysh; then
X        vtysh -c "show version" 2>/dev/null | sed -n '1,8p'
X    fi
X}
X
Xcase "${1:-}" in
X    check) do_check ;;
X    frr-enable) do_enable ;;
X    frr-disable) do_disable ;;
X    frr-apply) do_apply ;;
X    set-router-id) do_set_router_id "${2:-}" ;;
X    del-router-id) do_del_router_id ;;
X    set-log) do_set_log "${2:-}" ;;
X    write-memory) do_write_memory ;;
X    show) do_show ;;
X    show-version) do_show_version ;;
X    *) echo "Usage: $0 {check|frr-enable|frr-disable|frr-apply|set-router-id IP|del-router-id|set-log syslog|none|write-memory|show|show-version}" >&2; exit 2 ;;
Xesac
cdb9848e1fa6fbbd5dcee3ee615deecc
echo x - net/titian/files/sbin/titian-fw.sh
sed 's/^X//' >net/titian/files/sbin/titian-fw.sh << '2e7410561deaf0cb316d03d10a75e32b'
X#!/bin/sh
X# titian-fw.sh — klish helper: edit + apply /usr/local/etc/firewall.conf (pf only)
X# BSDRP_klish, prepared 2026-11-08 ~19:15 WIB.
X# POSIX sh, no bashisms. Model follows Titian's proven firewall
X# (~/workspace/titian/titian-cli/sbin/titian-fw.sh, lab-verified 2 Nov 2026):
X# one config file = source of truth; rules identified by CONTENT (no IDs);
X# duplicates = "already exists"; `no` form = same full syntax.
X# IPv4 only (v1). pf is FreeBSD-only here (no nftables).
X#
X# Config format (one rule per line; written by klish, read by
X# firewall-apply):
X#   enable yes|no
X#   protected <if>            (repeatable; default em0)
X#   filter <chain> <action> proto <p> src <a> dst <a> sport <s> dport <d>
X#          in <if> out <if>
X#   snat <srcnet> to <target|masquerade> out <if>
X#   dnat <tcp|udp> in <if> dport <n> to <addr> port <n|same>
X#
X# Validation (all enforced here, loudly, before anything is written):
X# - forward/input: in = real iface, out = any. output: in = any,
X#   out = real iface. (pf matches transit traffic on ingress; an out
X#   qualifier on a forward/input rule has no pf equivalent.)
X# - snat: out = real iface (snat without out is rejected).
X# - dnat: tcp/udp only; in = real iface.
X# - NAT conflicts rejected: snat (srcnet,out) / dnat (proto,in,dport)
X#   with a different target.
X# - Protected interfaces (default em0, the mgmt iface) are rejected as
X#   in/out — this is the anti-lockout guard. At least one protected
X#   interface must remain.
X#
X# Every mutation touches /var/run/firewall.dirty so the klish commit
X# hook knows to run `service firewall restart` (or stop).
Xset -u
X
XCONF="${FW_CONF:-/usr/local/etc/firewall.conf}"
XDIRTY=/var/run/firewall.dirty
XPROG="titian-fw"
X
Xdie() { echo "$PROG: $*" >&2; exit 1; }
X
Xtouch_conf() {
X    if [ ! -f "$CONF" ]; then
X        printf '# firewall.conf - generated by klish, do not edit by hand\nenable no\nprotected em0\n' > "$CONF" \
X            || die "cannot create $CONF"
X    fi
X}
X
Xmark_dirty() { touch "$DIRTY" 2>/dev/null || true; }
X
X# --- validation helpers -------------------------------------------------
Xvalid_name() {
X    case "$1" in
X        *[!A-Za-z0-9_-]*|"") die "bad name: $1 (use [A-Za-z0-9_-]+)" ;;
X    esac
X}
X
X# valid_octet <n>: 0-255, no leading junk
Xvalid_octet() {
X    case "$1" in
X        ""|*[!0-9]*) return 1 ;;
X    esac
X    [ "$1" -ge 0 ] && [ "$1" -le 255 ] 2>/dev/null
X}
X
X# valid_v4 <addr>: dotted quad, each octet 0-255
Xvalid_v4() {
X    _a="$1"
X    case "$_a" in
X        *.*.*.*) ;;
X        *) return 1 ;;
X    esac
X    _o1=${_a%%.*}; _rest=${_a#*.}
X    _o2=${_rest%%.*}; _rest=${_rest#*.}
X    _o3=${_rest%%.*}; _o4=${_rest#*.}
X    case "$_o4" in *.*) return 1 ;; esac
X    valid_octet "$_o1" && valid_octet "$_o2" \
X        && valid_octet "$_o3" && valid_octet "$_o4"
X}
X
X# valid_cidr <addr>: bare IPv4 or IPv4/n (n 0-32)
Xvalid_cidr() {
X    case "$1" in
X        */*)
X            _ip=${1%%/*}; _n=${1#*/}
X            case "$_n" in *[!0-9]*|"") return 1 ;; esac
X            [ "$_n" -ge 0 ] && [ "$_n" -le 32 ] 2>/dev/null || return 1
X            valid_v4 "$_ip"
X            ;;
X        *) valid_v4 "$1" ;;
X    esac
X}
X
Xvalid_port() {
X    case "$1" in *[!0-9]*|"") return 1 ;; esac
X    [ "$1" -ge 1 ] && [ "$1" -le 65535 ] 2>/dev/null
X}
X
Xiface_exists() {
X    ifconfig "$1" >/dev/null 2>&1 || die "interface $1 not found (see 'show interfaces')"
X}
X
Xis_protected() {
X    grep -q "^protected $1\$" "$CONF" 2>/dev/null
X}
X
Xcheck_not_protected() {
X    if is_protected "$1"; then
X        die "interface $1 is protected (mgmt guard) — remove it from the protected list first ('no protect-interface $1'), at your own risk"
X    fi
X}
X
X# --- read-only ops ------------------------------------------------------
Xcmd_check() { touch_conf; exit 0; }
X
Xcmd_show() {
X    touch_conf
X    _en=$(sed -n 's/^enable //p' "$CONF" | head -1)
X    echo "firewall: ${_en:-no}"
X    echo "protected interfaces:"
X    grep '^protected ' "$CONF" 2>/dev/null | sed 's/^protected /  /' || true
X    echo "rules (order = priority; delete with the full syntax):"
X    _n=0
X    while IFS= read -r _line; do
X        case "$_line" in
X            filter\ *|snat\ *|dnat\ *)
X                _n=$((_n + 1))
X                printf '  %d. %s\n' "$_n" "$_line" ;;
X        esac
X    done < "$CONF"
X    [ "$_n" -gt 0 ] || echo "  (no rules)"
X    exit 0
X}
X
Xcmd_show_filter() {
X    touch_conf
X    grep '^filter ' "$CONF" 2>/dev/null || echo "(no filter rules)"
X    exit 0
X}
X
Xcmd_show_nat() {
X    touch_conf
X    grep -E '^(snat|dnat) ' "$CONF" 2>/dev/null || echo "(no NAT rules)"
X    exit 0
X}
X
Xcmd_status() {
X    echo "forwarding: net.inet.ip.forwarding=$(sysctl -n net.inet.ip.forwarding 2>/dev/null) (pf does NOT forward by itself — needs 1 for transit)"
X    if pfctl -s Running >/dev/null 2>&1; then
X        echo "pf: $(pfctl -s Running 2>&1 | head -1)"
X    else
X        echo "pf: not running"
X        exit 0
X    fi
X    echo "-- live anchor firewall (filter):"
X    pfctl -a firewall -sr 2>&1 | sed 's/^/   /'
X    echo "-- live anchor nat (nat/rdr):"
X    pfctl -a nat -sn 2>&1 | sed 's/^/   /'
X    exit 0
X}
X
X# --- mutations ----------------------------------------------------------
Xcmd_set_enable() {
X    case "$1" in
X        yes|no) ;;
X        *) die "enable takes yes|no" ;;
X    esac
X    touch_conf
X    _tmp="$CONF.tmp.$$"
X    grep -v '^enable ' "$CONF" > "$_tmp" 2>/dev/null || true
X    printf 'enable %s\n' "$1" >> "$_tmp"
X    mv "$_tmp" "$CONF" || die "cannot write $CONF"
X    mark_dirty
X    echo "firewall $1"
X    exit 0
X}
X
X# add_line <canonical-line> — append if not already present (exact match)
Xadd_line() {
X    touch_conf
X    if grep -qxF "$1" "$CONF" 2>/dev/null; then
X        echo "firewall: rule already exists: $1"
X        exit 0
X    fi
X    printf '%s\n' "$1" >> "$CONF" || die "cannot write $CONF"
X    mark_dirty
X    echo "firewall: rule added: $1"
X    exit 0
X}
X
X# del_line <canonical-line> — remove exact match, fail if absent
Xdel_line() {
X    touch_conf
X    if ! grep -qxF "$1" "$CONF" 2>/dev/null; then
X        die "firewall: rule not found (nothing deleted): $1"
X    fi
X    _tmp="$CONF.tmp.$$"
X    grep -vxF "$1" "$CONF" > "$_tmp" || true
X    mv "$_tmp" "$CONF" || die "cannot write $CONF"
X    mark_dirty
X    echo "firewall: rule deleted: $1"
X    exit 0
X}
X
X# add-filter <chain> <action> <proto> <src> <dst> <sport> <dport> <in> <out>
Xcmd_add_filter() {
X    _chain="$1"; _action="$2"; _proto="$3"; _src="$4"; _dst="$5"
X    _sport="$6"; _dport="$7"; _in="$8"; _out="$9"
X    case "$_chain" in forward|input|output) ;; *) die "chain must be forward|input|output" ;; esac
X    case "$_action" in permit|deny) ;; *) die "action must be permit|deny" ;; esac
X    case "$_proto" in tcp|udp|icmp|all) ;; *) die "proto must be tcp|udp|icmp|all" ;; esac
X    if [ "$_src" != "any" ]; then valid_cidr "$_src" || die "src must be CIDR or any: $_src"; fi
X    if [ "$_dst" != "any" ]; then valid_cidr "$_dst" || die "dst must be CIDR or any: $_dst"; fi
X    case "$_proto" in
X        tcp|udp)
X            [ "$_sport" != "any" ] && { valid_port "$_sport" || die "sport out of 1-65535: $_sport"; }
X            [ "$_dport" != "any" ] && { valid_port "$_dport" || die "dport out of 1-65535: $_dport"; }
X            ;;
X        *)
X            [ "$_sport" = "any" ] && [ "$_dport" = "any" ] \
X                || die "proto $_proto does not use ports (use any)"
X            ;;
X    esac
X    touch_conf
X    case "$_chain" in
X        forward|input)
X            [ "$_in" != "any" ] || die "$_chain needs a real in-interface (any is rejected on FreeBSD/pf)"
X            [ "$_out" = "any" ] || die "FreeBSD/pf: filter cannot match out-interface — use in only (out must be any)"
X            iface_exists "$_in"
X            check_not_protected "$_in"
X            ;;
X        output)
X            [ "$_in" = "any" ] || die "output chain: in must be any (traffic originates locally)"
X            [ "$_out" != "any" ] || die "output chain needs a real out-interface"
X            iface_exists "$_out"
X            check_not_protected "$_out"
X            ;;
X    esac
X    add_line "filter $_chain $_action proto $_proto src $_src dst $_dst sport $_sport dport $_dport in $_in out $_out"
X}
X
Xcmd_del_filter() {
X    touch_conf
X    del_line "filter $1 $2 proto $3 src $4 dst $5 sport $6 dport $7 in $8 out $9"
X}
X
X# add-snat <srcnet> <target> <out>
Xcmd_add_snat() {
X    _src="$1"; _tgt="$2"; _out="$3"
X    case "$_src" in */*) ;; *) die "snat srcnet must be CIDR: $_src" ;; esac
X    valid_cidr "$_src" || die "snat srcnet must be CIDR: $_src"
X    if [ "$_tgt" != "masquerade" ]; then valid_v4 "$_tgt" || die "snat target must be an IPv4 address or masquerade: $_tgt"; fi
X    [ "$_out" != "any" ] || die "FreeBSD/pf: snat needs an explicit out-interface"
X    touch_conf
X    iface_exists "$_out"
X    check_not_protected "$_out"
X    # conflict: same (srcnet,out), different target
X    while IFS= read -r _line; do
X        set -- $_line
X        if [ "${1:-}" = "snat" ] && [ "${2:-}" = "$_src" ] && [ "${6:-}" = "$_out" ] && [ "${4:-}" != "$_tgt" ]; then
X            die "snat conflict: ($_src, out $_out) already maps to ${4} — delete it first to change target"
X        fi
X    done < "$CONF"
X    add_line "snat $_src to $_tgt out $_out"
X}
X
Xcmd_del_snat() {
X    del_line "snat $1 to $2 out $3"
X}
X
X# add-dnat <proto> <in> <dport> <to> <toport>
Xcmd_add_dnat() {
X    _proto="$1"; _in="$2"; _dport="$3"; _to="$4"; _toport="$5"
X    case "$_proto" in tcp|udp) ;; *) die "dnat only supports tcp/udp (not $_proto)" ;; esac
X    valid_port "$_dport" || die "dport out of 1-65535: $_dport"
X    valid_v4 "$_to" || die "dnat target must be IPv4: $_to"
X    if [ "$_toport" != "same" ]; then valid_port "$_toport" || die "target port out of 1-65535: $_toport"; fi
X    touch_conf
X    iface_exists "$_in"
X    check_not_protected "$_in"
X    # conflict: same (proto,in,dport), different target
X    while IFS= read -r _line; do
X        set -- $_line
X        if [ "${1:-}" = "dnat" ] && [ "${2:-}" = "$_proto" ] && [ "${4:-}" = "$_in" ] && [ "${6:-}" = "$_dport" ] \
X            && { [ "${8:-}" != "$_to" ] || [ "${10:-}" != "$_toport" ]; }; then
X            die "dnat conflict: ($_proto, in $_in, dport $_dport) already maps to ${8}:${10} — delete it first to change target"
X        fi
X    done < "$CONF"
X    add_line "dnat $_proto in $_in dport $_dport to $_to port $_toport"
X}
X
Xcmd_del_dnat() {
X    del_line "dnat $1 in $2 dport $3 to $4 port $5"
X}
X
Xcmd_add_protected() {
X    valid_name "$1"
X    touch_conf
X    iface_exists "$1"
X    add_line "protected $1"
X}
X
Xcmd_del_protected() {
X    touch_conf
X    if ! grep -qxF "protected $1" "$CONF" 2>/dev/null; then
X        die "interface $1 is not in the protected list"
X    fi
X    _n=$(grep -c '^protected ' "$CONF" 2>/dev/null)
X    [ "$_n" -gt 1 ] || die "at least one protected interface is required (add another one first, then remove $1)"
X    del_line "protected $1"
X}
X
Xcmd_flush() {
X    printf '# firewall.conf - generated by klish, do not edit by hand\nenable no\nprotected em0\n' > "$CONF" \
X        || die "cannot write $CONF"
X    mark_dirty
X    echo "firewall: all configuration flushed (enable no, protected reset to em0)"
X    exit 0
X}
X
X# firewall-apply — apply /usr/local/etc/firewall.conf to pf anchors
X# BSDRP_klish, prepared 2026-11-08 ~19:15 WIB.
X# POSIX sh, no bashisms. Generation logic follows Titian's proven
X# pf_apply (~/workspace/titian/titian-cli/sbin/titian-fw.sh, lab-verified
X# 2 Nov 2026): translation first, filter rules all `quick` (first match
X# wins), trailing `block in quick on <if> all` per in-iface from forward
X# filters AND dnat rules (dnat alone must close its iface), iface-missing
X# rules SKIPPED with a warning (pfctl fails the whole anchor load on an
X# unknown iface name), and CHECK-BEFORE-LOAD — an anchor is never loaded
X# live before it passes `pfctl -a <anchor> -n -f`.
X#
X# Usage (merged): titian-fw.sh apply [config-file] | apply --flush
X#   (test-only env overrides: FW_CONF, PF_CONF, PF_FW_FILE, PF_NAT_FILE)
X#
X# Anchors (must be referenced in /etc/pf.conf — see staging pf.conf):
X#   nat-anchor "nat" + rdr-anchor "nat"  -> /etc/pf-nat.conf
X#   anchor "firewall"                    -> /etc/pf-firewall.conf
X# The traffic-shape anchor lives in the same pf.conf (separate subsystem).
X#
X# Idempotent: full rebuild from the config file on every run. Exit 0 on
X# success (including disabled / no config). Non-zero with a clear message
X# on bad config or failed parse-check, so a klish commit can fail loudly.
X
XPF_CONF="${PF_CONF:-/etc/pf.conf}"
XFW_FILE="${PF_FW_FILE:-/etc/pf-firewall.conf}"
XNAT_FILE="${PF_NAT_FILE:-/etc/pf-nat.conf}"
X
Xwarn() { echo "$PROG: warning: $*" >&2; }
X
Xpf_enabled() {
X    pfctl -s info 2>/dev/null | grep -q "Status: Enabled"
X}
X
Xiface_present() {
X    ifconfig "$1" >/dev/null 2>&1
X}
X
Xflush_anchors() {
X    if pf_enabled; then
X        pfctl -a firewall -F rules >/dev/null 2>&1 || true
X        pfctl -a nat -F rules >/dev/null 2>&1 || true
X        pfctl -a nat -F nat >/dev/null 2>&1 || true
X    fi
X    rm -f "$FW_FILE" "$NAT_FILE"
X}
X
X# --- apply (was firewall-apply, standalone) -------------------------
Xcmd_apply() {
X    # $1 = optional config path, or --flush
X    if [ "${1:-}" = "--flush" ]; then
X        kldstat -q -m pf 2>/dev/null || exit 0
X        flush_anchors
X        exit 0
X    fi
X    [ -n "${1:-}" ] && CONF="$1"
X    # --- load module --------------------------------------------------------
X    kldstat -q -m pf 2>/dev/null || kldload pf \
X        || die "cannot load pf module"
X
X    # --- no config yet = nothing to do --------------------------------------
X    [ -f "$CONF" ] || { flush_anchors; exit 0; }
X
X    # --- disabled = flush everything and stop -------------------------------
X    _en=$(sed -n 's/^enable //p' "$CONF" | head -1)
X    if [ "$_en" != "yes" ]; then
X        flush_anchors
X        exit 0
X    fi
X
X    # --- pf.conf must reference our anchors ---------------------------------
X    if [ ! -f "$PF_CONF" ]; then
X        warn "$PF_CONF does not exist — anchors cannot be evaluated (ship staging pf.conf to BSDRP/Files/etc/pf.conf)"
X    elif ! grep -q 'anchor "firewall"' "$PF_CONF" 2>/dev/null \
X        || ! grep -q 'nat-anchor "nat"' "$PF_CONF" 2>/dev/null; then
X        warn "$PF_CONF does not reference anchors \"firewall\"/\"nat\" — add:"
X        warn '    nat-anchor "nat"'
X        warn '    rdr-anchor "nat"'
X        warn '    anchor "firewall"'
X        warn "anchors are created, but pf will not evaluate them until then"
X    fi
X
X    # --- generate anchor files (temp, then parse-check, then install) -------
X    _nat_tmp="$NAT_FILE.tmp.$$"
X    _fw_tmp="$FW_FILE.tmp.$$"
X    : > "$_nat_tmp" || die "cannot write $_nat_tmp"
X    : > "$_fw_tmp" || die "cannot write $_fw_tmp"
X    printf '# generated by firewall-apply — do not edit by hand (source: %s)\n' "$CONF" >> "$_nat_tmp"
X    printf '# generated by firewall-apply — do not edit by hand (source: %s)\n' "$CONF" >> "$_fw_tmp"
X
X    _fwd_ifaces=""
X    while IFS= read -r _line; do
X        case "$_line" in
X            ""|\#*) continue ;;
X            enable\ *|protected\ *) continue ;;
X            snat\ *)
X                set -- $_line
X                # $1=snat $2=srcnet $3=to $4=target $5=out $6=if
X                [ "$#" -eq 6 ] || die "corrupt snat line: $_line"
X                if ! iface_present "$6"; then
X                    warn "SKIP (iface $6 missing): $_line"
X                    continue
X                fi
X                if [ "$4" = "masquerade" ]; then
X                    printf 'nat on %s from %s to any -> (%s)\n' "$6" "$2" "$6" >> "$_nat_tmp"
X                else
X                    printf 'nat on %s from %s to any -> %s\n' "$6" "$2" "$4" >> "$_nat_tmp"
X                fi
X                ;;
X            dnat\ *)
X                set -- $_line
X                # $1=dnat $2=proto $3=in $4=if $5=dport $6=n $7=to $8=addr
X                # $9=port ${10}=n|same
X                [ "$#" -eq 10 ] || die "corrupt dnat line: $_line"
X                if ! iface_present "$4"; then
X                    warn "SKIP (iface $4 missing): $_line"
X                    continue
X                fi
X                case " $_fwd_ifaces " in *" $4 "*) ;; *) _fwd_ifaces="$_fwd_ifaces $4" ;; esac
X                if [ "${10}" = "same" ]; then
X                    printf 'rdr on %s proto %s from any to any port %s -> %s\n' "$4" "$2" "$6" "$8" >> "$_nat_tmp"
X                else
X                    printf 'rdr on %s proto %s from any to any port %s -> %s port %s\n' "$4" "$2" "$6" "$8" "${10}" >> "$_nat_tmp"
X                fi
X                ;;
X            filter\ *)
X                set -- $_line
X                # $1=filter $2=chain $3=action $4=proto $5=p $6=src $7=a $8=dst
X                # $9=a $10=sport $11=s $12=dport $13=d $14=in $15=if $16=out $17=if
X                [ "$#" -eq 17 ] || die "corrupt filter line: $_line"
X                _chain="$2"; _action="$3"; _proto="$5"; _src="$7"; _dst="$9"
X                _sport="${11}"; _dport="${13}"; _in="${15}"; _out="${17}"
X                case "$_chain" in
X                    forward|input) _dir=in; _if="$_in" ;;
X                    output)        _dir=out; _if="$_out" ;;
X                    *) die "corrupt filter line (bad chain): $_line" ;;
X                esac
X                if ! iface_present "$_if"; then
X                    warn "SKIP (iface $_if missing): $_line"
X                    continue
X                fi
X                if [ "$_chain" = "forward" ]; then
X                    case " $_fwd_ifaces " in *" $_if "*) ;; *) _fwd_ifaces="$_fwd_ifaces $_if" ;; esac
X                fi
X                case "$_action" in
X                    permit) _act=pass ;;
X                    deny)   _act=block ;;
X                    *) die "corrupt filter line (bad action): $_line" ;;
X                esac
X                _t="$_act $_dir quick on $_if inet"
X                case "$_proto" in tcp|udp|icmp) _t="$_t proto $_proto" ;; esac
X                _t="$_t from $_src"
X                case "$_proto" in
X                    tcp|udp) [ "$_sport" != "any" ] && _t="$_t port $_sport" ;;
X                esac
X                _t="$_t to $_dst"
X                case "$_proto" in
X                    tcp|udp) [ "$_dport" != "any" ] && _t="$_t port $_dport" ;;
X                esac
X                printf '%s\n' "$_t" >> "$_fw_tmp"
X                ;;
X            *) die "unknown config line: $_line" ;;
X        esac
X    done < "$CONF"
X
X    # --- trailing block per in-iface (forward default DENY) -----------------
X    for _f in $_fwd_ifaces; do
X        iface_present "$_f" || continue
X        printf 'block in quick on %s all\n' "$_f" >> "$_fw_tmp"
X    done
X
X    # --- parse-check BEFORE touching live state -----------------------------
X    if ! pfctl -a nat -n -f "$_nat_tmp" 2>/dev/null; then
X        warn "nat anchor FAILED parse-check — live not changed"
X        rm -f "$_nat_tmp" "$_fw_tmp"
X        exit 1
X    fi
X    if ! pfctl -a firewall -n -f "$_fw_tmp" 2>/dev/null; then
X        warn "firewall anchor FAILED parse-check — live not changed"
X        rm -f "$_nat_tmp" "$_fw_tmp"
X        exit 1
X    fi
X
X    # --- install + load live ------------------------------------------------
X    mv "$_nat_tmp" "$NAT_FILE" || die "cannot write $NAT_FILE"
X    mv "$_fw_tmp" "$FW_FILE" || die "cannot write $FW_FILE"
X    pfctl -a nat -f "$NAT_FILE" 2>/dev/null \
X        || die "pfctl failed to load nat anchor"
X    pfctl -a firewall -f "$FW_FILE" 2>/dev/null \
X        || die "pfctl failed to load firewall anchor"
X
X    # --- enable pf if it is not running -------------------------------------
X    if ! pfctl -s Running >/dev/null 2>&1; then
X        pfctl -e 2>/dev/null || warn "pfctl -e failed (pf not running — check pf_enable)"
X    fi
X
X    exit 0
X}
X
X# --- dispatch -----------------------------------------------------------
Xop="${1:-}"; shift 2>/dev/null || true
Xcase "$op" in
X    check)           cmd_check ;;
X    show)            cmd_show ;;
X    show-filter)     cmd_show_filter ;;
X    show-nat)        cmd_show_nat ;;
X    status)          cmd_status ;;
X    set-enable)      cmd_set_enable "$@" ;;
X    add-filter)      cmd_add_filter "$@" ;;
X    del-filter)      cmd_del_filter "$@" ;;
X    add-snat)        cmd_add_snat "$@" ;;
X    del-snat)        cmd_del_snat "$@" ;;
X    add-dnat)        cmd_add_dnat "$@" ;;
X    del-dnat)        cmd_del_dnat "$@" ;;
X    add-protected)   cmd_add_protected "$@" ;;
X    del-protected)   cmd_del_protected "$@" ;;
X    flush)           cmd_flush ;;
X    apply)         cmd_apply "$@" ;;
X    apply-all)     cmd_apply ;;
X    *) echo "usage: $PROG <check|set-enable|add-filter|del-filter|add-snat|del-snat|add-dnat|del-dnat|add-protected|del-protected|flush|show|show-filter|show-nat|status|apply|apply-all> ..." >&2; exit 2 ;;
Xesac
