echo x - net/titian/files/sbin/titian-sysinfo.sh
sed 's/^X//' >net/titian/files/sbin/titian-sysinfo.sh << 'c56f0d6ca522607df513e237fc7597b2'
X#!/bin/sh
X# TITIAN Fase 1 — banner startup clish (pengganti ACTION Linux-only
X# di startup.xml rtcli: free, /proc/loadavg).
X# POSIX sh.
XOS=$(uname -s)
Xdate
Xif [ "$OS" = "FreeBSD" ]; then
X    phys=$(sysctl -n hw.physmem 2>/dev/null)
X    user=$(sysctl -n hw.usermem 2>/dev/null)
X    if [ -n "$phys" ] && [ -n "$user" ]; then
X        used=$(( (phys - user) / 1024 / 1024 ))
X        total=$(( phys / 1024 / 1024 ))
X        echo "Memory Usage: ${used}/${total}MB"
X    fi
X    df -h / 2>/dev/null | awk 'NR==2{printf "Disk Usage: %s/%s (%s)\n", $3, $2, $5}'
X    sysctl -n vm.loadavg 2>/dev/null | awk '{print "CPU Load:", $2, $3, $4}'
Xelse
X    free -m 2>/dev/null | awk 'NR==2{printf "Memory Usage: %s/%sMB (%.2f%%)\n", $3,$2,$3*100/$2 }'
X    df -h 2>/dev/null | awk '$NF=="/"{printf "Disk Usage: %d/%dGB (%s)\n", $3,$2,$5}'
X    awk '{print "CPU Load:", $1, $2, $3}' /proc/loadavg 2>/dev/null
Xfi
Xecho
