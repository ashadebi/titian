X# TITIAN bird.d/static.conf — static contoh (TEST-NET, via gateway lab).
X# Kernel export none: route hanya hidup di tabel BIRD, tidak diinstal
X# ke tabel kernel — aman untuk lab.
Xprotocol static static4 {
X    ipv4;
X    route 203.0.113.0/24 via 192.168.122.1;
X}
