echo x - net/titian/files/tree/conf-monitoring.xml
sed 's/^X//' >net/titian/files/tree/conf-monitoring.xml << 'dc967275ab0c037974445dd4e92809f2'
X<?xml version="1.0" encoding="UTF-8"?>
X<CLISH_MODULE xmlns="http://clish.sourceforge.net/XMLSchema"
X          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
X xsi:schemaLocation="http://clish.sourceforge.net/XMLSchema
X                     http://clish.sourceforge.net/XMLSchema/clish.xsd">
X    <!--=======================================================-->
X    <!-- Monitoring — BSDRP port (BARU). Semua OFF by default di
X         image (feature-list §9): snmpd (net-snmp, community
X         default bsdrp-ro — GANTI sebelum di-expose), node_exporter
X         (:9100), bird_exporter (:9324), nfacctd/pmacct.
X         `enable` hanya mencatat niat + dirty; service naik/berhenti
X         saat `commit` (titian-commit.sh -> titian-monitoring.sh
X         apply). Community SNMP ditulis ke snmpd.conf saat apply.
X         Nama rc script yang dipakai backend (snmpd, node_exporter,
X         bird_exporter, nfacctd) — verifikasi live di guest: nama
X         service bisa berbeda menurut port yang terpasang. -->
X
X<VIEW name="configure-view">
X    <COMMAND name="monitoring"
X            help="Monitoring: snmpd / node_exporter / bird_exporter / nfacctd (semua OFF by default)"
X            view="configure-monitoring-view"
X            viewid="sysview=monitoring"
X            ptype="SUBCOMMAND"
X            mode="subcommand">
X        <CONFIG priority="0x1800" pattern="^${__line}$"/>
X        <ACTION>
X            ${RT_SBIN}/titian-monitoring.sh check
X        </ACTION>
X    </COMMAND>
X</VIEW>
X
X<VIEW name="configure-monitoring-view"
X    prompt="${SYSTEM_NAME}(config-monitoring)# "
X    depth="1">
X    <NAMESPACE ref="configure-view"
X        help="false"
X        completion="true"/>
X
X    <COMMAND name="exit"
X        help="Kembali ke configure-view"
X        lock="false">
X        <ACTION builtin="clish_nested_up"/>
X    </COMMAND>
X    <COMMAND name="end"
X        help="Kembali ke enable-view"
X        view="enable-view"/>
X    <HOTKEY key="^Z" cmd="exit"/>
X
X    <COMMAND name="no"
X        help="Negate a command or set its defaults"/>
X
X    <COMMAND name="snmp"
X        help="SNMP (snmpd)"/>
X    <COMMAND name="node-exporter"
X        help="node_exporter (:9100)"/>
X    <COMMAND name="bird-exporter"
X        help="bird_exporter (:9324)"/>
X    <COMMAND name="nfacctd"
X        help="nfacctd (pmacct)"/>
X
X    <COMMAND name="no snmp"
X        help="Negate SNMP configuration"/>
X    <COMMAND name="no node-exporter"
X        help="Negate node_exporter configuration"/>
X    <COMMAND name="no bird-exporter"
X        help="Negate bird_exporter configuration"/>
X    <COMMAND name="no nfacctd"
X        help="Negate nfacctd configuration"/>
X
X    <COMMAND name="snmp enable"
X          help="Enable snmpd (pending commit)">
X        <CONFIG/>
X        <ACTION>
X            ${RT_SBIN}/titian-monitoring.sh set snmp yes
X        </ACTION>
X    </COMMAND>
X    <COMMAND name="no snmp enable"
X          help="Disable snmpd (pending commit)">
X        <CONFIG operation="unset" pattern="^snmp enable"/>
X        <ACTION>
X            ${RT_SBIN}/titian-monitoring.sh set snmp no
X        </ACTION>
X    </COMMAND>
X    <COMMAND name="snmp community"
X        help="Community SNMP read-only (default bsdrp-ro — ganti sebelum expose)">
X        <PARAM name="Comm"
X            help="community string"
X            ptype="STRING"/>
X        <CONFIG/>
X        <ACTION>
X            ${RT_SBIN}/titian-monitoring.sh set-community "${Comm}"
X        </ACTION>
X    </COMMAND>
X
X    <COMMAND name="node-exporter enable"
X          help="Enable node_exporter :9100 (pending commit)">
X        <CONFIG/>
X        <ACTION>
X            ${RT_SBIN}/titian-monitoring.sh set node-exporter yes
X        </ACTION>
X    </COMMAND>
X    <COMMAND name="no node-exporter enable"
X          help="Disable node_exporter (pending commit)">
X        <CONFIG operation="unset" pattern="^node-exporter enable"/>
X        <ACTION>
X            ${RT_SBIN}/titian-monitoring.sh set node-exporter no
X        </ACTION>
X    </COMMAND>
X
X    <COMMAND name="bird-exporter enable"
X          help="Enable bird_exporter :9324 (pending commit)">
X        <CONFIG/>
X        <ACTION>
X            ${RT_SBIN}/titian-monitoring.sh set bird-exporter yes
X        </ACTION>
X    </COMMAND>
X    <COMMAND name="no bird-exporter enable"
X          help="Disable bird_exporter (pending commit)">
X        <CONFIG operation="unset" pattern="^bird-exporter enable"/>
X        <ACTION>
X            ${RT_SBIN}/titian-monitoring.sh set bird-exporter no
X        </ACTION>
X    </COMMAND>
X
X    <COMMAND name="nfacctd enable"
X          help="Enable nfacctd/pmacct (pending commit)">
X        <CONFIG/>
X        <ACTION>
X            ${RT_SBIN}/titian-monitoring.sh set nfacctd yes
X        </ACTION>
X    </COMMAND>
X    <COMMAND name="no nfacctd enable"
X          help="Disable nfacctd (pending commit)">
X        <CONFIG operation="unset" pattern="^nfacctd enable"/>
X        <ACTION>
X            ${RT_SBIN}/titian-monitoring.sh set nfacctd no
X        </ACTION>
X    </COMMAND>
X</VIEW>
X
X<VIEW name="enable-view">
X    <COMMAND name="show monitoring"
X        help="Status monitoring (snmpd, node_exporter, bird_exporter, nfacctd)"
X        lock="false"
X        interrupt="true">
X        <PARAM name="service"
X            help="satu service saja"
X            ptype="SUBCOMMAND"
X            mode="switch"
X            optional="true">
X            <PARAM name="snmp"
X                help="snmpd"
X                mode="subcommand"
X                ptype="SUBCOMMAND"/>
X            <PARAM name="node-exporter"
X                help="node_exporter"
X                mode="subcommand"
X                ptype="SUBCOMMAND"/>
X            <PARAM name="bird-exporter"
X                help="bird_exporter"
X                mode="subcommand"
X                ptype="SUBCOMMAND"/>
X            <PARAM name="nfacctd"
X                help="nfacctd"
X                mode="subcommand"
X                ptype="SUBCOMMAND"/>
X        </PARAM>
X        <ACTION>
X            ${RT_SBIN}/titian-monitoring.sh show "${service}"
X        </ACTION>
X    </COMMAND>
X</VIEW>
X
X</CLISH_MODULE>
