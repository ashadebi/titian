X#!/bin/sh
X# PROVIDE: titian
X# REQUIRE: DAEMON
X# KEYWORD: shutdown
X. /etc/rc.subr
Xname="titian"
Xrcvar="titian_enable"
Xpidfile="/var/run/titian-konfd.pid"
Xprocname="%%PREFIX%%/bin/konfd"
Xcommand="%%PREFIX%%/sbin/titian-boot.sh"
Xstart_cmd="titian_start"
Xstop_cmd="titian_stop"
Xtitian_start() {
X    %%PREFIX%%/sbin/titian-boot.sh
X}
Xtitian_stop() {
X    if [ -f /var/run/titian-konfd.pid ]; then
X        kill "$(cat /var/run/titian-konfd.pid)" 2>/dev/null || true
X        rm -f /var/run/titian-konfd.pid /tmp/konfd.socket
X    else
X        pkill -f '%%PREFIX%%/bin/konfd|/usr/local/bin/konfd' 2>/dev/null || true
X        rm -f /tmp/konfd.socket
X    fi
X}
Xload_rc_config $name
Xrun_rc_command "$1"
