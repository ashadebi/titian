echo x - net/titian/files/sbin/titian-checkpoint.sh
sed 's/^X//' >net/titian/files/sbin/titian-checkpoint.sh << '269f43508c08ddd43ea99346dbc7dcb2'
X#!/bin/sh
X# TITIAN — checkpoint + rollback.
X# Checkpoint = TITIK SIMPAN BERNAMA dari konfigurasi. User membuat
X# beberapa titik, melihat daftarnya, lalu memilih mau balik ke titik
X# yang mana. Bukan "undo satu langkah".
X#
X# Isi satu checkpoint (di /opt/titian/etc/checkpoints/<nama>/):
X#   running-config  — dump running-config saat titik dibuat, TANPA
X#                     baris stempel (! version / ! last commit).
X#                     Alasan: stempel adalah metadata save, bukan
X#                     konfigurasi — replay startup-config TIDAK
X#                     mempertahankannya (terbukti: dump sesudah
X#                     restart tidak mengandung stempel, sementara
X#                     state yang baru di-save mengandungnya). Bila
X#                     stempel ikut disimpan, verifikasi diff sesudah
X#                     rollback akan selalu gagal palsu pada baris
X#                     stempel. Dengan strip ini, diff rollback
X#                     benar-benar byte-persis.
X#   bird.conf       — bird.conf live saat titik dibuat
X#   bird.d/         — fragmen sumber generate (*.conf saja; *.cli-bak
X#                     dan *.pkgsave TIDAK ikut — itu artefak backup)
X#   netstate/       — seluruh isi netstate (addr/managed/tuning/
X#                     tuning.prev/bond/vxlan) saat titik dibuat
X#   sysctl.titian (+ .prev) — sysctl global yang dikelola Titian
X#   meta            — nama + waktu dibuat (WIB) + waktu rollback terakhir
X#
X# Semantik rollback (BACA SEBELUM PAKAI — ditulis juga di help text):
X#   rollback MENGEMBALIKAN running-config + bird.conf + bird.d +
X#   netstate + sysctl ke isi titik, MENULIS JUGA startup-config
X#   (jadi rollback BERSIFAT PERSISTEN, bertahan melewati reboot —
X#   bukan sekadar live), lalu restart service titian (konfd baru +
X#   replay + apply-all tuning + apply-bond + apply-vxlan, mengikuti
X#   jalur boot yang sudah terbukti) + birdc configure untuk bird.conf.
X#   Alasan persistensi: "balik ke titik" harus berarti kembali
X#   sungguhan, bukan kembali sampai reboot berikutnya.
X#   Sebelum restart, rollback membersihkan (prune) objek live yang
X#   tidak ada di titik: interface buatan Titian yang mengendap,
X#   alamat ekstra, kunci tuning ekstra, sysctl ekstra, dan route
X#   statik ekstra — karena replay hanya MENAMBAH/MENGGANTI, tidak
X#   menghapus. Prune bersifat best-effort per item (gagal satu item =
X#   peringatan, rollback tetap jalan; kegagalan fatal hanya bila
X#   service tidak kembali atau verifikasi diff gagal total).
X#
X# Rollback polos (tanpa nama) = kembali ke startup-config. Karena
X# `save` tidak pernah memotret bird.d/netstate/sysctl, perintah
X# `save` kini JUGA menulis titik tersembunyi `.last-save` (best-effort,
X# tidak pernah menggagalkan save) yang memuat isi yang sama dengan
X# checkpoint bernama — sehingga rollback polos memakai `.last-save`
X# sebagai sumber dan mencapai fidelitas penuh, bukan sekadar replay.
X# `.last-save` tidak tampil di `checkpoint list` dan tidak bisa
X# dihapus/di-rollback lewat nama (nama titik tidak boleh diawali
X# titik — lihat valid_name).
X#
X# Batasan yang dinyatakan apa adanya (bukan diam):
X#   - `no speed` / speed-del: nilai live speed bertahan sampai reboot
X#     (driver tidak punya operasi unset) — sama seperti semantik
X#     `no speed` yang sudah didokumentasikan. Rollback TIDAK bisa
X#     memaksa live speed kembali tanpa reboot.
X#   - Route blackhole FreeBSD tidak di-prune (sintaks delete-nya
X#     tidak diverifikasi di lab ini) — hapus lewat `no` form bila
X#     perlu, atau akan hilang sendiri saat reboot berikutnya
X#     (replay hanya menambah route dari titik).
X#   - Bird yang tidak jalan (birdc gagal) = peringatan lantang,
X#     bukan pembatalan rollback (file sudah dipulihkan; parse check
X#     bird.conf sudah lolos sebelum file diganti).
X# POSIX sh (jalan di dash Debian dan sh FreeBSD).
Xset -u
XOS=$(uname -s)
XROOT=${TITIAN_ROOT:-/opt/titian}
XBIN=$ROOT/bin
Xif [ ! -x "$BIN/clish" ] && [ -x /usr/local/bin/clish ]; then BIN=/usr/local/bin; fi
XSBIN=${RT_SBIN:-$ROOT/sbin}
XSTATE_DIR=${TITIAN_STATE_DIR:-$ROOT/etc/netstate}
XCKPT_DIR=$ROOT/etc/checkpoints
XSOCKFILE=/tmp/konfd.socket
X
Xerr() { echo "Error: $*" >&2; exit 33; }
Xwarn() { echo "Warning(checkpoint): $*" >&2; }
X
Xvalid_name() {
X    # $1=nama -> 0 bila valid: [A-Za-z0-9][A-Za-z0-9_-]*, maks 64
X    case "$1" in
X        ''|.*) return 1 ;;
X    esac
X    [ "${#1}" -le 64 ] || return 1
X    case "$1" in
X        *[!A-Za-z0-9_-]*) return 1 ;;
X        *) return 0 ;;
X    esac
X}
X
Xnow_wib() { TZ=Asia/Jakarta date '+%Y-%m-%d %H:%M:%S WIB'; }
X
Xbird_bin() {
X    command -v bird 2>/dev/null || { [ -x /usr/sbin/bird ] && echo /usr/sbin/bird; } || \
X        { [ -x /usr/local/sbin/bird ] && echo /usr/local/sbin/bird; } || echo bird
X}
Xbirdc_bin() {
X    command -v birdc 2>/dev/null || { [ -x /usr/sbin/birdc ] && echo /usr/sbin/birdc; } || \
X        { [ -x /usr/local/sbin/birdc ] && echo /usr/local/sbin/birdc; } || echo birdc
X}
Xbird_conf_path() {
X    if [ "$OS" = "FreeBSD" ]; then echo "/usr/local/etc/bird.conf"; else echo "/etc/bird/bird.conf"; fi
X}
X
X# --- dump running-config lewat batch clish (read-only) ---
Xdump_running() {
X    # $1=file-tujuan (ditulis penuh, bukan append)
X    local tmp cmd
X    tmp=$(mktemp /tmp/titian-ckpt-dump.XXXXXX) || return 1
X    cmd=$(mktemp /tmp/titian-ckpt-cmd.XXXXXX) || { rm -f "$tmp"; return 1; }
X    printf 'show running-config\n' > "$cmd"
X    if ! "$BIN/clish" -x "$ROOT/etc/clish-en" -w enable-view "$cmd" > "$tmp" 2>&1; then
X        warn "batch clish dump gagal"
X        rm -f "$tmp" "$cmd"; return 1
X    fi
X    rm -f "$cmd"
X    # buang banner sesi + baris prompt-echo; sisakan dump mulai
X    # baris setelah `# show running-config`. Buang baris kosong
X    # di akhir agar diff byte-persis stabil. Buang juga baris
X    # stempel (metadata save, bukan konfigurasi — lihat header).
X    awk '/# show running-config$/ {dump=1; next} dump {print}' "$tmp" | \
X        grep -v -e '^! version' -e '^ ! last commit' -e '^! last commit' | \
X        awk '{lines[NR]=$0} END {last=NR; while (last>0 && lines[last]=="") last--; for (i=1;i<=last;i++) print lines[i]}' > "$1"
X    rm -f "$tmp"
X    [ -s "$1" ] || return 1
X    grep -q '^end$' "$1" || return 1
X    return 0
X}
X
X# --- snapshot file-file state ke direktori titik (sudah ada) ---
Xsnapshot_files() {
X    # $1=dir-titik $2=sumber-running-config (file; untuk .last-save
X    #      ini startup-config yang baru ditulis save)
X    local d=$1 src=$2 conf
X    conf=$(bird_conf_path)
X    # simpan running-config TANPA baris stempel (alasan: header).
X    # Untuk .last-save, sumbernya startup-config yang baru ditulis
X    # save (berstempel) — strip di sini membuatnya kanonis.
X    grep -v -e '^! version' -e '^ ! last commit' -e '^! last commit' "$src" > "$d/running-config.tmp" 2>/dev/null && \
X        mv "$d/running-config.tmp" "$d/running-config" || return 1
X    [ -f "$conf" ] && cp -f "$conf" "$d/bird.conf"
X    mkdir -p "$d/bird.d" "$d/netstate" || return 1
X    for f in "$ROOT/etc/bird.d/"*.conf; do
X        [ -e "$f" ] || continue
X        case "$f" in *.cli-bak|*.pkgsave) continue ;; esac
X        cp -f "$f" "$d/bird.d/" 2>/dev/null || true
X    done
X    if [ -d "$STATE_DIR" ]; then
X        for f in "$STATE_DIR/"*; do
X            [ -e "$f" ] || continue
X            cp -f "$f" "$d/netstate/" 2>/dev/null || true
X        done
X    fi
X    [ -f "$ROOT/etc/sysctl.titian" ] && cp -f "$ROOT/etc/sysctl.titian" "$d/sysctl.titian"
X    [ -f "$ROOT/etc/sysctl.titian.prev" ] && cp -f "$ROOT/etc/sysctl.titian.prev" "$d/sysctl.titian.prev"
X    chmod 700 "$d" "$d/bird.d" "$d/netstate" 2>/dev/null || true
X    chmod 600 "$d/running-config" "$d/bird.conf" "$d/meta" 2>/dev/null || true
X    return 0
X}
X
Xwrite_meta() {
X    # $1=dir-titik $2=nama $3=sumber (running|save)
X    {
X        echo "name=$2"
X        echo "created_wib=$(now_wib)"
X        echo "source=$3"
X    } > "$1/meta" || return 1
X}
X
Xcmd_save() {
X    # $1=nama
X    local name=$1 d tmp
X    valid_name "$name" || err "nama checkpoint tidak valid: '$name' (harus [A-Za-z0-9][A-Za-z0-9_-]*, maks 64 karakter)"
X    d="$CKPT_DIR/$name"
X    [ -e "$d" ] && err "checkpoint sudah ada: $name — hapus dulu ('checkpoint delete $name') atau pakai nama lain (tidak ditimpa diam-diam)"
X    mkdir -p "$CKPT_DIR" 2>/dev/null || err "gagal mkdir $CKPT_DIR"
X    mkdir -p "$d" || err "gagal mkdir $d"
X    tmp=$(mktemp /tmp/titian-ckpt-save.XXXXXX) || { rmdir "$d" 2>/dev/null; err "gagal mktemp"; }
X    if ! dump_running "$tmp"; then
X        rm -rf "$d" "$tmp"
X        err "gagal membuang running-config (konfd tidak terjangkau?) — checkpoint TIDAK dibuat, tidak ada perubahan"
X    fi
X    if ! snapshot_files "$d" "$tmp"; then
X        rm -rf "$d" "$tmp"
X        err "gagal memotret file state — checkpoint TIDAK dibuat, tidak ada perubahan"
X    fi
X    rm -f "$tmp"
X    write_meta "$d" "$name" "running" || warn "gagal tulis meta (checkpoint tetap tersimpan)"
X    echo "checkpoint $name dibuat: $(grep '^created_wib=' "$d/meta" 2>/dev/null | cut -d= -f2-)"
X    echo "  isi: running-config + bird.conf + bird.d + netstate + sysctl (beku; 'save' biasa tidak mengubah titik ini)"
X}
X
Xcmd_snapshot_last_save() {
X    # Dipanggil perintah `save` (best-effort; TIDAK PERNAH gagal fatal).
X    # Sumber running-config = startup-config yang baru ditulis save.
X    local d="$CKPT_DIR/.last-save"
X    mkdir -p "$CKPT_DIR" 2>/dev/null || { warn "gagal mkdir $CKPT_DIR"; return 0; }
X    mkdir -p "$d" 2>/dev/null || { warn "gagal mkdir $d"; return 0; }
X    if ! snapshot_files "$d" "$ROOT/etc/startup-config"; then
X        warn "gagal memotret .last-save (save tetap berhasil)"
X        return 0
X    fi
X    write_meta "$d" ".last-save" "save" 2>/dev/null || true
X    return 0
X}
X
Xcmd_list() {
X    local d name created dump tmp line found=0
X    # tidak ada titik non-tersembunyi sama sekali -> pesan ramah
X    if [ -d "$CKPT_DIR" ]; then
X        for d in "$CKPT_DIR/"*/; do
X            [ -d "$d" ] || continue
X            case "$(basename "$d")" in .*) continue ;; *) found=1; break ;; esac
X        done
X    fi
X    if [ "$found" -eq 0 ]; then
X        echo "(belum ada checkpoint — pakai 'checkpoint save <nama>')"
X        return 0
X    fi
X    tmp=$(mktemp /tmp/titian-ckpt-list.XXXXXX) || tmp=""
X    if [ -n "$tmp" ] && ! dump_running "$tmp"; then rm -f "$tmp"; tmp=""; fi
X    printf '%-24s %-22s %s\n' "NAMA" "DIBUAT (WIB)" "SAAT INI"
X    # kumpulkan "created|name", urutkan kronologis, lalu cetak
X    for d in "$CKPT_DIR/"*/; do
X        [ -d "$d" ] || continue
X        name=$(basename "$d")
X        case "$name" in .* ) continue ;; esac
X        created=$(grep '^created_wib=' "$d/meta" 2>/dev/null | cut -d= -f2-)
X        [ -n "$created" ] || created="(tanpa meta)"
X        echo "$created|$name"
X    done | LC_ALL=C sort | while IFS='|' read -r created name; do
X        line=""
X        if [ -n "$tmp" ] && [ -f "$CKPT_DIR/$name/running-config" ] && cmp -s "$CKPT_DIR/$name/running-config" "$tmp"; then
X            line="*"
X        fi
X        printf '%-24s %-22s %s\n' "$name" "$created" "$line"
X    done
X    [ -n "$tmp" ] && rm -f "$tmp"
X    echo "  * = isi titik sama persis dengan running-config saat ini"
X}
X
Xcmd_delete() {
X    local name=$1 d
X    valid_name "$name" || err "nama checkpoint tidak valid: '$name'"
X    d="$CKPT_DIR/$name"
X    [ -d "$d" ] || err "checkpoint tidak ada: $name — tidak ada yang dihapus"
X    rm -rf "$d" || err "gagal hapus checkpoint $name"
X    echo "checkpoint $name dihapus"
X}
X
X# --- prune: hapus objek live yang tidak ada di titik ---
X# Semua prune membaca state SAAT INI (sebelum restore file) dan
X# membandingkannya dengan isi titik. Gagal satu item = peringatan,
X# bukan pembatalan (dilaporkan di akhir).
XPRUNE_WARN=0
Xprune_note() { warn "$*"; PRUNE_WARN=1; }
X
Xprune_iface() {
X    # $1=iface $2=tipe (vlan|vxlan|bonding|lagg|loopback)
X    local iface=$1 type=$2 bond
X    # lepas dari bond bila masih menempel (Linux; FreeBSD best-effort)
X    if [ -f "$STATE_DIR/$iface.bond" ]; then
X        bond=$(head -n 1 "$STATE_DIR/$iface.bond" 2>/dev/null)
X        if [ -n "$bond" ]; then
X            if [ "$OS" = "FreeBSD" ]; then
X                ifconfig "$bond" -laggport "$iface" 2>/dev/null || prune_note "gagal lepas $iface dari $bond (best-effort)"
X            else
X                if [ -w "/sys/class/net/$bond/bonding/slaves" ]; then
X                    echo "-$iface" > "/sys/class/net/$bond/bonding/slaves" 2>/dev/null || prune_note "gagal lepas $iface dari $bond"
X                fi
X            fi
X        fi
X    fi
X    if [ "$OS" = "FreeBSD" ]; then
X        ifconfig "$iface" >/dev/null 2>&1 || return 0
X        ifconfig "$iface" destroy 2>/dev/null || prune_note "gagal hapus interface $iface (best-effort)"
X    else
X        [ -d "/sys/class/net/$iface" ] || return 0
X        ip link delete dev "$iface" 2>/dev/null || prune_note "gagal hapus interface $iface (best-effort)"
X    fi
X}
X
Xprune_addrs() {
X    # $1=iface $2=file-.addr-saat-ini $3=file-.addr-titik (boleh absen)
X    local iface=$1 cur=$2 tgt=$3 line a b c
X    [ -f "$cur" ] || return 0
X    while IFS= read -r line; do
X        [ -n "$line" ] || continue
X        if [ -f "$tgt" ] && grep -qxF "$line" "$tgt" 2>/dev/null; then continue; fi
X        # bentuk: "inet <cidr>" | "inet <local> peer <peer>"
X        # (sama untuk inet6) — set -- memecah jadi $1..$4
X        set -- $line; a=${1:-}; b=${2:-}; c=${3:-}; d=${4:-}
X        case "$a" in
X            inet)
X                if [ "$c" = "peer" ]; then
X                    "$SBIN/titian-if.sh" addr-del "$iface" "$b" "$d" 2>/dev/null || prune_note "gagal hapus alamat $line di $iface"
X                else
X                    "$SBIN/titian-if.sh" addr-del "$iface" "$b" 2>/dev/null || prune_note "gagal hapus alamat $line di $iface"
X                fi
X                ;;
X            inet6)
X                if [ "$c" = "peer" ]; then
X                    "$SBIN/titian-if.sh" addr6-del "$iface" "$b" "$d" 2>/dev/null || prune_note "gagal hapus alamat $line di $iface"
X                else
X                    "$SBIN/titian-if.sh" addr6-del "$iface" "$b" 2>/dev/null || prune_note "gagal hapus alamat $line di $iface"
X                fi
X                ;;
X        esac
X    done < "$cur"
X}
X
Xtuning_key() {
X    # $1=baris .tuning -> kunci ("mtu"|"qlen"|"offload tso"|"coalesce rx-usecs"|"speed")
X    case "$1" in
X        'offload '*) echo "offload ${1#offload }" | awk '{print $1" "$2}' ;;
X        'coalesce '*) echo "coalesce ${1#coalesce }" | awk '{print $1" "$2}' ;;
X        *) echo "$1" | awk '{print $1}' ;;
X    esac
X}
Xprune_tuning() {
X    # $1=iface $2=file-.tuning-saat-ini $3=file-.tuning-titik (boleh absen)
X    local iface=$1 cur=$2 tgt=$3 line key feat kind
X    [ -f "$cur" ] || return 0
X    while IFS= read -r line; do
X        [ -n "$line" ] || continue
X        key=$(tuning_key "$line")
X        if [ -f "$tgt" ] && grep -q "^$key " "$tgt" 2>/dev/null; then continue; fi
X        case "$key" in
X            mtu) "$SBIN/titian-tune.sh" mtu-del "$iface" 2>/dev/null || prune_note "gagal hapus tuning mtu di $iface" ;;
X            qlen) "$SBIN/titian-tune.sh" qlen-del "$iface" 2>/dev/null || prune_note "gagal hapus tuning qlen di $iface" ;;
X            'offload '*) feat=${key#offload }; "$SBIN/titian-tune.sh" offload-del "$iface" "$feat" 2>/dev/null || prune_note "gagal hapus tuning offload $feat di $iface" ;;
X            'coalesce '*) kind=${key#coalesce }; "$SBIN/titian-tune.sh" coalesce-del "$iface" "$kind" 2>/dev/null || prune_note "gagal hapus tuning coalesce $kind di $iface" ;;
X            speed) "$SBIN/titian-tune.sh" speed-del "$iface" 2>/dev/null || prune_note "gagal hapus tuning speed di $iface (live bertahan sampai reboot — batas driver)" ;;
X        esac
X    done < "$cur"
X}
X
Xprune_sysctls() {
X    # $1=file-sysctl-saat-ini $2=file-sysctl-titik (boleh absen)
X    local cur=$1 tgt=$2 line k
X    [ -f "$cur" ] || return 0
X    while IFS='=' read -r k _v; do
X        [ -n "$k" ] || continue
X        if [ -f "$tgt" ] && grep -q "^$k=" "$tgt" 2>/dev/null; then continue; fi
X        "$SBIN/titian-sysctl.sh" del "$k" 2>/dev/null || prune_note "gagal hapus sysctl $k"
X    done < "$cur"
X}
X
Xprune_routes() {
X    # $1=dump-saat-ini $2=running-config-titik
X    # (baca dari file temp, bukan pipa — supaya prune_note tidak
X    # tenggelam di subshell)
X    local cur=$1 tgt=$2 line prefix tmpf
X    tmpf=$(mktemp /tmp/titian-ckpt-rt.XXXXXX) || return 0
X    grep -E '^(ip|ipv6) route ' "$cur" 2>/dev/null > "$tmpf" || true
X    while IFS= read -r line; do
X        grep -qxF "$line" "$tgt" 2>/dev/null && continue
X        case "$line" in
X            'ip route blackhole '*) prefix=${line#ip route blackhole }; prefix=${prefix%% *}
X                if [ "$OS" = "FreeBSD" ]; then prune_note "route blackhole $prefix tidak di-prune di FreeBSD (hapus lewat 'no' form bila perlu)"; continue; fi
X                ip route del blackhole "$prefix" 2>/dev/null || prune_note "gagal hapus route blackhole $prefix" ;;
X            'ip route '*) prefix=${line#ip route }; prefix=${prefix%% *}
X                if [ "$OS" = "FreeBSD" ]; then route delete -inet "$prefix" 2>/dev/null || prune_note "gagal hapus route $prefix";
X                else ip route del to "$prefix" 2>/dev/null || prune_note "gagal hapus route $prefix"; fi ;;
X            'ipv6 route blackhole '*) prefix=${line#ipv6 route blackhole }; prefix=${prefix%% *}
X                if [ "$OS" = "FreeBSD" ]; then prune_note "route blackhole v6 $prefix tidak di-prune di FreeBSD (hapus lewat 'no' form bila perlu)"; continue; fi
X                ip -6 route del blackhole "$prefix" 2>/dev/null || prune_note "gagal hapus route blackhole v6 $prefix" ;;
X            'ipv6 route '*) prefix=${line#ipv6 route }; prefix=${prefix%% *}
X                if [ "$OS" = "FreeBSD" ]; then route delete -inet6 "$prefix" 2>/dev/null || prune_note "gagal hapus route v6 $prefix";
X                else ip -6 route del to "$prefix" 2>/dev/null || prune_note "gagal hapus route v6 $prefix"; fi ;;
X        esac
X    done < "$tmpf"
X    rm -f "$tmpf"
X}
X
Xprune_all() {
X    # $1=dump-saat-ini $2=dir-titik
X    # (baca dari file temp, bukan pipa — supaya prune_note tidak
X    # tenggelam di subshell)
X    # URUTAN WAJIB (pelajaran FreeBSD 2 Nov 2026): route, alamat,
X    # tuning, dan sysctl DIHAPUS DULU selagi interface masih ada,
X    # interface buatan dihancurkan TERAKHIR. Dua ketergantungan
X    # yang terbukti: (1) menghancurkan interface ikut menghapus
X    # alamat + route-nya; (2) di FreeBSD, menghapus alamat
X    # interface ikut menghapus route statik via interface itu
X    # (terbukti: addr-del lo1 menghilangkan 198.51.99.0/24 dari
X    # tabel). Karena itu route DIHAPUS SEBELUM alamat — kalau
X    # dibalik, prune route gagal palsu ("not in table") dan
X    # memunculkan Warning yang menyesatkan padahal keadaan akhir
X    # sudah benar.
X    local cur=$1 d=$2 line type name tmpf
X    # (a) route statik ekstra — PERTAMA (lihat komentar urutan)
X    prune_routes "$cur" "$d/running-config"
X    # (b) alamat ekstra per interface
X    if [ -d "$STATE_DIR" ]; then
X        for f in "$STATE_DIR/"*.addr; do
X            [ -e "$f" ] || continue
X            name=$(basename "$f" .addr)
X            prune_addrs "$name" "$f" "$d/netstate/$name.addr"
X        done
X    fi
X    # (c) kunci tuning ekstra per interface
X    if [ -d "$STATE_DIR" ]; then
X        for f in "$STATE_DIR/"*.tuning; do
X            [ -e "$f" ] || continue
X            case "$f" in *.prev) continue ;; esac
X            name=$(basename "$f" .tuning)
X            prune_tuning "$name" "$f" "$d/netstate/$name.tuning"
X        done
X    fi
X    # (d) sysctl global ekstra
X    prune_sysctls "$ROOT/etc/sysctl.titian" "$d/sysctl.titian"
X    # (e) interface buatan Titian yang mengendap — TERAKHIR:
X    #     header seksi `interface <tipe> <nama>` di dump saat ini
X    #     tapi tidak di titik
X    tmpf=$(mktemp /tmp/titian-ckpt-if.XXXXXX) || return 0
X    grep -E '^interface (vlan|vxlan|bonding|lagg|loopback) ' "$cur" 2>/dev/null > "$tmpf" || true
X    while IFS= read -r line; do
X        grep -qxF "$line" "$d/running-config" 2>/dev/null && continue
X        type=$(echo "$line" | awk '{print $2}'); name=$(echo "$line" | awk '{print $3}')
X        prune_iface "$name" "$type"
X    done < "$tmpf"
X    rm -f "$tmpf"
X}
X
Xservice_restart() {
X    if [ "$OS" = "FreeBSD" ]; then
X        service titian restart 2>&1 || return 1
X    else
X        systemctl restart titian 2>&1 || return 1
X    fi
X    # tunggu socket konfd kembali (maks ~30 detik)
X    i=0
X    while [ ! -S "$SOCKFILE" ] && [ "$i" -lt 60 ]; do sleep 0.5; i=$((i + 1)); done
X    [ -S "$SOCKFILE" ] || return 1
X    return 0
X}
X
Xrestore_files() {
X    # $1=dir-titik — tulis startup-config + bird.conf + bird.d +
X    # netstate + sysctl dari titik (menimpa penuh)
X    local d=$1 conf f
X    conf=$(bird_conf_path)
X    cp -f "$d/running-config" "$ROOT/etc/startup-config" || return 1
X    # MODE FILE LIVE (perbaikan 2 Nov 2026): cp FreeBSD MENULAR mode
X    # sumber ke tujuan yang sudah ada (terbukti di lab: cp -f src600
X    # dst644 -> dst 600), sementara file snapshot sengaja 600
X    # (snapshot_files). Tanpa chmod eksplisit ini, restore membuat
X    # file live 600 sehingga tidak terbaca tanpa sudo — persis yang
X    # terjadi pada bird.conf + startup-config FreeBSD sesudah fitur
X    # checkpoint (1 Nov 22:29). GNU cp Linux mempertahankan mode
X    # tujuan, jadi chmod ini no-op di sana; tapi tetap ditulis
X    # eksplisit agar restore tidak bergantung pada perilaku cp.
X    # Mode live yang benar: 644 (semua saudara file di /opt/titian/etc
X    # dan /usr/local/etc FreeBSD 644; startup-config Debian 644).
X    # bird.conf Debian DIKECUALIKAN: normanya 640 bird:bird di dir
X    # 750 (hanya via sudo) — jangan dilebarkan.
X    chmod 644 "$ROOT/etc/startup-config" 2>/dev/null || true
X    if [ -f "$d/bird.conf" ]; then
X        cp -f "$d/bird.conf" "$conf" || return 1
X        if [ "$OS" = "FreeBSD" ]; then chmod 644 "$conf" 2>/dev/null || true; fi
X    fi
X    if [ -d "$d/bird.d" ]; then
X        for f in "$ROOT/etc/bird.d/"*.conf; do
X            [ -e "$f" ] || continue
X            case "$f" in *.cli-bak|*.pkgsave) continue ;; esac
X            rm -f "$f"
X        done
X        for f in "$d/bird.d/"*.conf; do
X            [ -e "$f" ] || continue
X            cp -f "$f" "$ROOT/etc/bird.d/" 2>/dev/null || true
X        done
X    fi
X    rm -rf "$STATE_DIR" 2>/dev/null || true
X    mkdir -p "$STATE_DIR" || return 1
X    if [ -d "$d/netstate" ]; then
X        for f in "$d/netstate/"*; do
X            [ -e "$f" ] || continue
X            cp -f "$f" "$STATE_DIR/" 2>/dev/null || true
X        done
X    fi
X    if [ -f "$d/sysctl.titian" ]; then cp -f "$d/sysctl.titian" "$ROOT/etc/sysctl.titian";
X    else rm -f "$ROOT/etc/sysctl.titian"; fi
X    if [ -f "$d/sysctl.titian.prev" ]; then cp -f "$d/sysctl.titian.prev" "$ROOT/etc/sysctl.titian.prev";
X    else rm -f "$ROOT/etc/sysctl.titian.prev"; fi
X    return 0
X}
X
Xregen_mirrors() {
X    # Cermin deklaratif dari netstate yang baru dipulihkan.
X    # ATURAN YANG SAMA DENGAN GUARD sync_debian (insiden rollback
X    # 2 Nov 2026): interface yang dikelola TAPI tanpa state
X    # (.addr kosong + .tuning kosong — mis. enp1s0 mgmt yang hanya
X    # tercatat sebagai managed) TIDAK BOLEH punya cermin; cermin
X    # yang ada untuknya DIHAPUS (bukan di-sync). Cermin kosong
X    # akan membajak interface sistem dari konfigurasi OS-nya.
X    local m name net
X    if [ -d "$STATE_DIR" ]; then
X        for m in "$STATE_DIR/"*.managed; do
X            [ -e "$m" ] || continue
X            name=$(basename "$m" .managed)
X            if [ ! -s "$STATE_DIR/$name.addr" ] && [ ! -s "$STATE_DIR/$name.tuning" ]; then
X                if [ "$OS" != "FreeBSD" ]; then
X                    rm -f "/etc/systemd/network/00-titian-$name.network" 2>/dev/null || true
X                fi
X                continue
X            fi
X            "$SBIN/titian-persist.sh" sync-if "$name" 2>/dev/null || true
X        done
X    fi
X    # hapus cermin networkd interface yang tidak lagi dikelola
X    if [ "$OS" != "FreeBSD" ]; then
X        for net in /etc/systemd/network/00-titian-*.network; do
X            [ -e "$net" ] || continue
X            name=$(basename "$net" .network); name=${name#00-titian-}
X            [ -f "$STATE_DIR/$name.managed" ] || rm -f "$net" 2>/dev/null || true
X        done
X    fi
X    "$SBIN/titian-sysctl.sh" mirror 2>/dev/null || true
X}
X
Xcmd_rollback() {
X    # $1=nama (boleh kosong = startup-config via .last-save)
X    local name=${1:-} d cur tmp bird
X    if [ -n "$name" ]; then
X        valid_name "$name" || err "nama checkpoint tidak valid: '$name'"
X        d="$CKPT_DIR/$name"
X        [ -d "$d" ] || err "checkpoint tidak ada: $name — TIDAK ADA PERUBAHAN (buat dulu dengan 'checkpoint save $name')"
X    else
X        d="$CKPT_DIR/.last-save"
X        [ -d "$d" ] || err "belum pernah save (tidak ada titik .last-save) — TIDAK ADA PERUBAHAN (jalankan 'save' dulu atau buat checkpoint)"
X        name="(startup-config)"
X    fi
X    [ -f "$d/running-config" ] || err "checkpoint rusak: $d/running-config tidak ada — TIDAK ADA PERUBAHAN"
X    # parse check bird.conf titik SEBELUM mengganti apa pun
X    if [ -f "$d/bird.conf" ]; then
X        bird=$(bird_bin)
X        if ! "$bird" -p -c "$d/bird.conf" >/dev/null 2>&1; then
X            err "bird.conf titik $name GAGAL parse — TIDAK ADA PERUBAHAN (titik rusak, jangan dipakai)"
X        fi
X    fi
X    cur=$(mktemp /tmp/titian-ckpt-rb.XXXXXX) || err "gagal mktemp"
X    if ! dump_running "$cur"; then
X        rm -f "$cur"
X        err "gagal membuang running-config saat ini (konfd tidak terjangkau?) — TIDAK ADA PERUBAHAN"
X    fi
X    echo "rollback ke $name — prune objek live yang tidak ada di titik..."
X    prune_all "$cur" "$d"
X    echo "rollback ke $name — pulihkan file (startup-config + bird + netstate + sysctl)..."
X    if ! restore_files "$d"; then
X        rm -f "$cur"
X        err "gagal memulihkan file dari titik $name — KEADAAN MUNGKIN SETENGAH (periksa manual; titik tidak diubah)"
X    fi
X    regen_mirrors
X    echo "rollback ke $name — restart service titian..."
X    if ! service_restart; then
X        rm -f "$cur"
X        err "service titian TIDAK KEMBALI setelah restart — file sudah dipulihkan dari titik, tapi konfd tidak jalan (periksa log service)"
X    fi
X    # sysctl live dari state yang dipulihkan (boot OS tidak me-apply
X    # ulang cermin titian saat restart service — apply eksplisit)
X    "$SBIN/titian-sysctl.sh" apply 2>/dev/null || true
X    if [ -f "$d/bird.conf" ]; then
X        out=$("$(birdc_bin)" configure 2>&1); rc=$?
X        echo "$out" | grep -v '^BIRD' || true
X        [ "$rc" -ne 0 ] && warn "birdc configure gagal (bird.conf sudah dipulihkan + parse lolos; periksa birdc)"
X    fi
X    tmp=$(mktemp /tmp/titian-ckpt-rb2.XXXXXX) || tmp=""
X    if [ -n "$tmp" ] && dump_running "$tmp"; then
X        if cmp -s "$tmp" "$d/running-config"; then
X            echo "rollback OK: running-config sama persis dengan titik $name"
X        else
X            echo "PERINGATAN: running-config sesudah rollback BERBEDA dari titik $name (diff di bawah):" >&2
X            diff "$d/running-config" "$tmp" 2>/dev/null | head -40 >&2
X            warn "verifikasi diff tidak kosong — periksa manual"
X        fi
X        rm -f "$tmp"
X    else
X        warn "verifikasi dump sesudah rollback gagal (konfd tidak menjawab) — periksa manual dengan 'show running-config'"
X        [ -n "$tmp" ] && rm -f "$tmp"
X    fi
X    rm -f "$cur"
X    # catat waktu rollback di meta titik (bukan mengubah isi titik)
X    if [ -f "$d/meta" ]; then
X        grep -v '^last_rollback_wib=' "$d/meta" > "$d/meta.tmp" 2>/dev/null && mv "$d/meta.tmp" "$d/meta" 2>/dev/null || true
X        echo "last_rollback_wib=$(now_wib)" >> "$d/meta" 2>/dev/null || true
X    fi
X    echo "rollback ke $name SELESAI (persistensi: startup-config sudah ditulis dari titik — bertahan melewati reboot)."
X    [ "$PRUNE_WARN" -eq 1 ] && warn "ada peringatan prune di atas — periksa baris Warning sebelum menganggap rollback bersih"
X    return 0
X}
X
Xcase "${1:-}" in
X    save) cmd_save "${2:-}" ;;
X    snapshot-last-save) cmd_snapshot_last_save ;;
X    list) cmd_list ;;
X    delete) cmd_delete "${2:-}" ;;
X    rollback) cmd_rollback "${2:-}" ;;
X    dump-running) dump_running "${2:-/dev/stdout}" ;;
X    *) echo "Usage: $0 {save <nama>|snapshot-last-save|list|delete <nama>|rollback [nama]|dump-running <file>}" >&2; exit 2 ;;
Xesac
269f43508c08ddd43ea99346dbc7dcb2
echo x - net/titian/files/sbin/titian-comm.sh
sed 's/^X//' >net/titian/files/sbin/titian-comm.sh << '1c1d09dd0ca0825a4ecbcaf697623597'
X#!/bin/sh
X# TITIAN — kelola community BGP lewat CLI (bird-view).
X# Pola: edit bird.d/filter.conf -> generate check filter (parse saja) ->
X# lolos baru generate filter (backup + birdc configure). Gagal parse =
X# file dikembalikan dari backup, tidak ada perubahan diterapkan.
X# Bentuk community yang diterima:
X#   AA:NN            standard, mis. 64512:300
X#   no-export | no-advertise | no-peer | blackhole   (well-known)
X#   rt:AA:NN | ro:AA:NN      extended community
X#   large:AA:X:NN            large community
X# Aksi import-match: reject | localpref:N | med:N
X# POSIX sh. Dipanggil dari bird-view sebagai ${RT_SBIN}/titian-comm.sh.
XDIR=$(dirname "$0")
XROOT=$(dirname "$DIR")
XFILTER="$ROOT/etc/bird.d/filter.conf"
XBIRD_SH="$DIR/titian-bird.sh"
Xerr() { echo "Error: $*" >&2; exit 33; }
X[ -f "$FILTER" ] || err "filter.conf tidak ada: $FILTER"
X[ -x "$BIRD_SH" ] || err "titian-bird.sh tidak ada: $BIRD_SH"
X
X# norm COMM -> "TYPE|EXPR|ADDLINE-EXPR"
X#   TYPE: std|ext|large ; EXPR: (AA, NN) | (rt, AA, NN) | (AA, X, NN)
Xnorm() {
X    case "$1" in
X        no-export)    echo "std|(65535, 65281)" ;;
X        no-advertise) echo "std|(65535, 65282)" ;;
X        no-peer)      echo "std|(65535, 65283)" ;;
X        blackhole)    echo "std|(65535, 666)" ;;
X        rt:*|ro:*)
X            kind=${1%%:*}; rest=${1#*:}
X            aa=${rest%%:*}; nn=${rest#*:}
X            case "$aa" in ''|*[!0-9]*) err "community tidak valid: $1" ;; esac
X            case "$nn" in ''|*[!0-9]*) err "community tidak valid: $1" ;; esac
X            echo "ext|($kind, $aa, $nn)" ;;
X        large:*)
X            rest=${1#large:}
X            aa=${rest%%:*}; rest2=${rest#*:}
X            x=${rest2%%:*}; nn=${rest2#*:}
X            case "$aa" in ''|*[!0-9]*) err "community tidak valid: $1" ;; esac
X            case "$x" in ''|*[!0-9]*) err "community tidak valid: $1" ;; esac
X            case "$nn" in ''|*[!0-9]*) err "community tidak valid: $1" ;; esac
X            echo "large|($aa, $x, $nn)" ;;
X        *:*)
X            aa=${1%%:*}; nn=${1#*:}
X            case "$aa" in ''|*[!0-9]*) err "community tidak valid: $1" ;; esac
X            case "$nn" in ''|*[!0-9]*) err "community tidak valid: $1" ;; esac
X            [ "$aa" -le 65535 ] 2>/dev/null || err "AS di luar 0-65535: $1"
X            [ "$nn" -le 65535 ] 2>/dev/null || err "NN di luar 0-65535: $1"
X            echo "std|($aa, $nn)" ;;
X        *) err "community tidak valid: $1 (AA:NN | no-export | no-advertise | no-peer | blackhole | rt:AA:NN | large:AA:X:NN)" ;;
X    esac
X}
X
X# norm_action ACT -> filter statement (tanpa indent, tanpa ;)
Xnorm_action() {
X    case "$1" in
X        reject) echo "reject" ;;
X        localpref:*)
X            n=${1#localpref:}
X            case "$n" in ''|*[!0-9]*) err "aksi tidak valid: $1" ;; esac
X            echo "bgp_local_pref = $n" ;;
X        med:*)
X            n=${1#med:}
X            case "$n" in ''|*[!0-9]*) err "aksi tidak valid: $1" ;; esac
X            echo "bgp_med = $n" ;;
X        *) err "aksi tidak valid: $1 (reject | localpref:N | med:N)" ;;
X    esac
X}
X
X# apply: check dulu, lolos baru generate; gagal -> restore backup
X# pra-edit (.cli-bak dibuat pemanggil SEBELUM edit; backup di sini
X# akan percuma karena file sudah teredit).
Xapply() {
X    if ! "$BIRD_SH" check filter >/tmp/titian-comm-check.out 2>&1; then
X        cat /tmp/titian-comm-check.out >&2
X        cp -f "$FILTER.cli-bak" "$FILTER"
X        err "parse GAGAL, filter.conf dikembalikan (tidak ada perubahan diterapkan)"
X    fi
X    "$BIRD_SH" generate filter || {
X        echo "PERINGATAN: generate filter gagal setelah check lolos; backup filter: $FILTER.cli-bak" >&2
X        exit 33
X    }
X}
X
Xlist_add() {
X    name=$1; spec=$(norm "$2"); expr=${spec#*|}
X    case "$name" in ''|*[!A-Za-z0-9_]*) err "nama list tidak valid: $name (huruf/angka/_)" ;; esac
X    line="define $name = $expr;"
X    if grep -qF -- "$line" "$FILTER"; then echo "sudah ada: $line"; return 0; fi
X    if grep -q "^define $name " "$FILTER"; then err "nama $name sudah didefinisikan dgn nilai lain (hapus dulu)"; fi
X    cp -f "$FILTER" "$FILTER.cli-bak" || err "gagal backup $FILTER"
X    echo "$line" >> "$FILTER" || err "gagal tulis $FILTER"
X    apply
X}
X
Xlist_del() {
X    name=$1
X    case "$name" in ''|*[!A-Za-z0-9_]*) err "nama list tidak valid: $name" ;; esac
X    grep -q "^define $name " "$FILTER" || { echo "tidak ada: define $name"; return 0; }
X    cp -f "$FILTER" "$FILTER.cli-bak" || err "gagal backup $FILTER"
X    grep -v "^define $name " "$FILTER" > "$FILTER.tmp" || err "gagal edit $FILTER"
X    mv "$FILTER.tmp" "$FILTER" || err "gagal tulis $FILTER"
X    apply
X}
X
Xlist_show() {
X    grep '^define ' "$FILTER" || echo "(tidak ada community list)"
X}
X
X# export-add COMM: sisipkan add-line ke cabang static di bgp_export_attr.
Xexport_add() {
X    spec=$(norm "$1"); type=${spec%%|*}; expr=${spec#*|}
X    case "$type" in
X        std)   add="        bgp_community.add($expr);" ;;
X        ext)   add="        bgp_ext_community.add($expr);" ;;
X        large) add="        bgp_large_community.add($expr);" ;;
X    esac
X    cp -f "$FILTER" "$FILTER.cli-bak" || err "gagal backup $FILTER"
X    awk -v add="$add" '
X        /^filter bgp_export_attr \{/ { infilter = 1 }
X        infilter && /if source = RTS_STATIC then \{/ { instatic = 1 }
X        infilter && instatic && $0 == add { found = 1 }
X        infilter && instatic && !inserted && /^ *accept;/ { print add; inserted = 1 }
X        { print }
X        END {
X            if (found) exit 2
X            if (!infilter || !instatic || !inserted) exit 3
X        }
X    ' "$FILTER" > "$FILTER.tmp"; rc=$?
X    case $rc in
X        2) rm -f "$FILTER.tmp"; echo "sudah ada: $add"; return 0 ;;
X        3) rm -f "$FILTER.tmp"; err "filter bgp_export_attr / cabang RTS_STATIC tidak ditemukan di $FILTER" ;;
X        0) mv "$FILTER.tmp" "$FILTER" || err "gagal tulis $FILTER"; apply ;;
X        *) rm -f "$FILTER.tmp"; err "gagal edit $FILTER" ;;
X    esac
X}
X
Xexport_del() {
X    spec=$(norm "$1"); type=${spec%%|*}; expr=${spec#*|}
X    case "$type" in
X        std)   add="        bgp_community.add($expr);" ;;
X        ext)   add="        bgp_ext_community.add($expr);" ;;
X        large) add="        bgp_large_community.add($expr);" ;;
X    esac
X    cp -f "$FILTER" "$FILTER.cli-bak" || err "gagal backup $FILTER"
X    awk -v add="$add" '
X        /^filter bgp_export_attr \{/ { infilter = 1 }
X        infilter && /if source = RTS_STATIC then \{/ { instatic = 1 }
X        infilter && instatic && $0 == add { skipped = 1; next }
X        { print }
X        END { if (!skipped) exit 2 }
X    ' "$FILTER" > "$FILTER.tmp"; rc=$?
X    case $rc in
X        2) rm -f "$FILTER.tmp"; echo "tidak ada: $add"; return 0 ;;
X        0) mv "$FILTER.tmp" "$FILTER" || err "gagal tulis $FILTER"; apply ;;
X        *) rm -f "$FILTER.tmp"; err "gagal edit $FILTER" ;;
X    esac
X}
X
Xexport_show() {
X    sed -n '/^filter bgp_export_attr {/,/^}/p' "$FILTER" || echo "(filter bgp_export_attr tidak ada)"
X}
X
X# import-add COMM ACTION: hapus match lama utk community tsb, sisip baru di atas.
Ximport_add() {
X    spec=$(norm "$1"); type=${spec%%|*}; expr=${spec#*|}
X    act=$(norm_action "$2")
X    case "$type" in
X        std)   m="    if $expr ~ bgp_community then $act;" ;;
X        ext)   m="    if $expr ~ bgp_ext_community then $act;" ;;
X        large) m="    if $expr ~ bgp_large_community then $act;" ;;
X    esac
X    # pola match lama: baris "if EXPR ~ bgp_*_community then ..."
X    # PORTABEL: jangan escape \( \) (awk -v memproses backslash berbeda di
X    # gawk vs BSD awk sehingga match gagal di FreeBSD); pakai kelas [(] [)].
X    pat="^ *if $(printf '%s' "$expr" | sed 's/(/[(]/g; s/)/[)]/g') ~ bgp_"
X    cp -f "$FILTER" "$FILTER.cli-bak" || err "gagal backup $FILTER"
X    awk -v m="$m" -v pat="$pat" '
X        /^filter bgp_import_comm \{/ { inimport = 1; print; print m; inserted = 1; next }
X        inimport && $0 ~ pat { next }
X        { print }
X        END { if (!inserted) exit 3 }
X    ' "$FILTER" > "$FILTER.tmp"; rc=$?
X    case $rc in
X        3) rm -f "$FILTER.tmp"; err "filter bgp_import_comm tidak ditemukan di $FILTER" ;;
X        0) mv "$FILTER.tmp" "$FILTER" || err "gagal tulis $FILTER"; apply ;;
X        *) rm -f "$FILTER.tmp"; err "gagal edit $FILTER" ;;
X    esac
X}
X
Ximport_del() {
X    spec=$(norm "$1"); type=${spec%%|*}; expr=${spec#*|}
X    pat="^ *if $(printf '%s' "$expr" | sed 's/(/[(]/g; s/)/[)]/g') ~ bgp_"
X    cp -f "$FILTER" "$FILTER.cli-bak" || err "gagal backup $FILTER"
X    awk -v pat="$pat" '
X        /^filter bgp_import_comm \{/ { inimport = 1 }
X        inimport && $0 ~ pat { skipped = 1; next }
X        { print }
X        END { if (!skipped) exit 2 }
X    ' "$FILTER" > "$FILTER.tmp"; rc=$?
X    case $rc in
X        2) rm -f "$FILTER.tmp"; echo "tidak ada match untuk $expr"; return 0 ;;
X        0) mv "$FILTER.tmp" "$FILTER" || err "gagal tulis $FILTER"; apply ;;
X        *) rm -f "$FILTER.tmp"; err "gagal edit $FILTER" ;;
X    esac
X}
X
Ximport_show() {
X    sed -n '/^filter bgp_import_comm {/,/^}/p' "$FILTER" || echo "(filter bgp_import_comm tidak ada)"
X}
X
Xcase "${1:-}" in
X    list-add)     list_add "$2" "$3" ;;
X    list-del)     list_del "$2" ;;
X    list-show)    list_show ;;
X    export-add)   export_add "$2" ;;
X    export-del)   export_del "$2" ;;
X    export-show)  export_show ;;
X    import-add)   import_add "$2" "$3" ;;
X    import-del)   import_del "$2" ;;
X    import-show)  import_show ;;
X    *) echo "Usage: $0 {list-add|list-del|list-show|export-add|export-del|export-show|import-add|import-del|import-show} ..." >&2; exit 2 ;;
Xesac
