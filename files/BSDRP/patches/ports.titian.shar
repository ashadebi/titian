echo x - net/titian/files/sbin/titian-if-list.sh
sed 's/^X//' >net/titian/files/sbin/titian-if-list.sh << '0af7efe8cac198c42d578df1c0f2be19'
X#!/bin/sh
X# TITIAN Fase 1 — daftar interface untuk completion klish (VAR Get_if_*).
X# Linux: /sys/class/net (fallback /proc/net/dev).
X# FreeBSD: ifconfig -l.
X# Aturan kategori `eth` (2 Nov 2026, PTYPE terpadu): EXCLUSION-based,
X# bukan pola nama — supaya interface yang di-rename di level OS tetap
X# muncul di completion. `eth` = semua interface sistem KECUALI loopback
X# (lo/lo0/lo[1-9]) dan objek virtual Titian (bond*, lagg*, vlan*,
X# vxlan*, dan subinterface bertitik di Linux). Deteksi fisik via
X# symlink `device` di /sys/class/net DIEVALUASI dan DITOLAK: interface
X# software (dummy/macvlan/veth) tidak punya symlink device, padahal
X# sah di-rename dan dikelola lewat view ethernet — aturan device hanya
X# akan menyembunyikan mereka. `vlan` Linux = semua nama bertitik
X# (parent boleh nama hasil rename, mis. wan0.100). Kategori bond/lagg/
X# vxlan/dummy adalah nama objek buatan Titian — tetap pola nama.
X# POSIX sh.
XOS=$(uname -s)
Xlist_linux() {
X    if [ -d /sys/class/net ]; then
X        # Hanya DIREKTORI = interface nyata. /sys/class/net juga memuat
X        # berkas non-interface (mis. bonding_masters saat modul bonding
X        # termuat) yang BUKAN interface dan tidak boleh masuk completion.
X        for _e in /sys/class/net/*; do
X            [ -d "$_e" ] || continue
X            basename "$_e"
X        done
X    else
X        awk -F: '{gsub(/ /,"",$1); print $1}' /proc/net/dev 2>/dev/null | grep -v '^$'
X    fi
X}
Xlist_fbsd() { ifconfig -l 2>/dev/null; }
Xcase "$OS" in
X    FreeBSD) ALL=$(list_fbsd) ;;
X    *)       ALL=$(list_linux) ;;
Xesac
X# Normalisasi ke satu nama per baris: ifconfig -l FreeBSD mengeluarkan
X# SEMUA nama dalam satu baris dipisah spasi, sehingga pola grep yang
X# berjangkar (^...$) tidak pernah cocok bila ALL dibiarkan satu baris
X# (gejala: kategori eth FreeBSD == all, vlan/bond/lagg kosong).
X# printf '%s\n' dengan $ALL tak dikutip memecah spasi jadi baris-baris.
Xif [ -n "$ALL" ]; then ALL=$(printf '%s\n' $ALL); fi
Xcase "${1:-all}" in
X    eth)
X        # Exclusion-based: interface hasil rename tidak cocok pola nama
X        # apa pun — justru karena itu ia harus lolos di sini.
X        if [ "$OS" = "FreeBSD" ]; then
X            echo "$ALL" | grep -v -E '^lo[0-9]+$|^lagg[0-9]+$|^vlan[0-9]+$|^vxlan[0-9]+$|^bond[0-9]+$' | sort
X        else
X            echo "$ALL" | grep -v -E '^lo[0-9]*$|^bond[0-9]+$|^vxlan[0-9]+$|^lagg[0-9]+$' | grep -v '\.' | sort
X        fi
X        ;;
X    vlan)
X        if [ "$OS" = "FreeBSD" ]; then
X            echo "$ALL" | grep -E '^vlan[0-9]+$' | sort
X        else
X            # Semua nama bertitik = subinterface vlan; parent boleh
X            # nama hasil rename (wan0.100).
X            echo "$ALL" | grep '\.' | sort
X        fi
X        ;;
X    bond)
X        if [ "$OS" = "FreeBSD" ]; then
X            exit 0
X        else
X            echo "$ALL" | grep -E '^bond[0-9]+$' | sort
X        fi
X        ;;
X    lagg)
X        if [ "$OS" = "FreeBSD" ]; then
X            echo "$ALL" | grep -E '^lagg[0-9]+$' | sort
X        else
X            exit 0
X        fi
X        ;;
X    vxlan)
X        echo "$ALL" | grep -E '^vxlan[0-9]+$' | sort
X        ;;
X    dummy)
X        echo "$ALL" | grep -E '^lo[1-9]$' | sort
X        ;;
X    all)
X        echo "$ALL" | sort
X        ;;
X    *) echo "Usage: $0 {eth|vlan|bond|lagg|dummy|all}" >&2; exit 2 ;;
Xesac
