echo x - net/titian/files/tree/conf-frr.xml
sed 's/^X//' >net/titian/files/tree/conf-frr.xml << '503ad2a47e650738e074e6a417af9284'
X<?xml version="1.0" encoding="UTF-8"?>
X<CLISH_MODULE xmlns="http://clish.sourceforge.net/XMLSchema"
X          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
X xsi:schemaLocation="http://clish.sourceforge.net/XMLSchema
X                     http://clish.sourceforge.net/XMLSchema/clish.xsd">
X    <!--=======================================================-->
X    <!-- FRR (net/frr10) — BSDRP port (BARU).
X         - Enable/disable di conf-router.xml (`router frr enable`,
X           mutual exclusion vs BIRD di sana + di commit).
X         - File ini: subview `router frr` untuk config dasar via
X           vtysh (router-id, log syslog, write-memory) + show status.
X         - CLI FRR sendiri tetap `vtysh` via perintah `cli` — file
X           ini TIDAK menyentuh/mendefinisikan `cli` (feature-list §3).
X         - Config via vtysh berlaku langsung (running) + `write
X           memory` agar persisten; hanya enable/disable yang menunggu
X           commit. -->
X
X<VIEW name="configure-view">
X    <COMMAND name="router frr"
X            help="FRR routing suite — config dasar via vtysh"
X            view="configure-frr-view"
X            viewid="sysview=frr"
X            ptype="SUBCOMMAND"
X            mode="subcommand">
X        <CONFIG priority="0x1520" pattern="^${__line}$"/>
X        <ACTION>
X            ${RT_SBIN}/titian-frr.sh check
X        </ACTION>
X    </COMMAND>
X</VIEW>
X
X<VIEW name="configure-frr-view"
X    prompt="${SYSTEM_NAME}(config-frr)# "
X    depth="1">
X    <NAMESPACE ref="configure-view"
X        help="false"
X        completion="true"/>
X
X    <COMMAND name="exit"
X        help="Kembali ke configure-view"
X        lock="false">
X        <ACTION builtin="clish_nested_up"/>
X    </COMMAND>
X    <COMMAND name="end"
X        help="Kembali ke enable-view"
X        view="enable-view"/>
X    <HOTKEY key="^Z" cmd="exit"/>
X
X    <COMMAND name="no"
X        help="Negate a command or set its defaults"/>
X
X    <COMMAND name="log"
X        help="Logging FRR"/>
X
X    <COMMAND name="no log"
X        help="Negate logging configuration"/>
X
X    <COMMAND name="router-id"
X        help="Router ID FRR (dipakai OSPF/BGP)">
X        <PARAM name="id"
X            help="alamat IPv4 router-id"
X            ptype="IP_ADDR"/>
X        <CONFIG/>
X        <ACTION>
X            ${RT_SBIN}/titian-frr.sh set-router-id "${id}"
X        </ACTION>
X    </COMMAND>
X    <COMMAND name="no router-id"
X        help="Hapus router-id FRR">
X        <CONFIG operation="unset" pattern="^router-id"/>
X        <ACTION>
X            ${RT_SBIN}/titian-frr.sh del-router-id
X        </ACTION>
X    </COMMAND>
X
X    <COMMAND name="log syslog"
X        help="Log FRR ke syslog">
X        <CONFIG/>
X        <ACTION>
X            ${RT_SBIN}/titian-frr.sh set-log syslog
X        </ACTION>
X    </COMMAND>
X    <COMMAND name="no log syslog"
X        help="Matikan log FRR ke syslog">
X        <CONFIG operation="unset" pattern="^log syslog"/>
X        <ACTION>
X            ${RT_SBIN}/titian-frr.sh set-log none
X        </ACTION>
X    </COMMAND>
X
X    <COMMAND name="write-memory"
X        help="Tulis running-config FRR ke frr.conf (persisten)">
X        <ACTION>
X            ${RT_SBIN}/titian-frr.sh write-memory
X        </ACTION>
X    </COMMAND>
X</VIEW>
X
X<VIEW name="enable-view">
X    <COMMAND name="show frr"
X        help="Status + versi FRR (enable intent, service, zebra pid)"
X        lock="false"
X        interrupt="true">
X        <ACTION>
X            ${RT_SBIN}/titian-frr.sh show
X        </ACTION>
X    </COMMAND>
X    <COMMAND name="show frr version"
X        help="Versi FRR + daemon yang jalan"
X        lock="false"
X        interrupt="true">
X        <ACTION>
X            ${RT_SBIN}/titian-frr.sh show-version
X        </ACTION>
X    </COMMAND>
X</VIEW>
X
X</CLISH_MODULE>
