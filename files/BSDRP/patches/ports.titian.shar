echo x - net/titian/files/tree/conf-if-eth-fbsd.xml
sed 's/^X//' >net/titian/files/tree/conf-if-eth-fbsd.xml << 'd9baf406b4694247e62b57f6c8f59ed5'
X<?xml version="1.0" encoding="UTF-8"?>
X<CLISH_MODULE xmlns="http://clish.sourceforge.net/XMLSchema"
X          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
X xsi:schemaLocation="http://clish.sourceforge.net/XMLSchema
X                     http://clish.sourceforge.net/XMLSchema/clish.xsd">
X	<!--=======================================================-->
X	<!-- TITIAN Fase 1: padanan FreeBSD dari conf-if-eth.xml
X	     (hanya diinstal di FreeBSD; Linux memakai conf-if-eth.xml).
X	     View dan nama perintah sama, aksi memakai ifconfig. -->
X
X<VIEW name="configure-view">
X
X    <COMMAND name="interface ethernet"
X        help="Ethernet interface"
X        view="configure-if-view"
X        viewid="iface=${iface_dev}">
X        <PARAM name="iface_dev"
X            help="Ethernet interface"
X            completion="${Get_if_eth}"
X            ptype="IFACE_SYS"/>
X        <CONFIG priority="0x2001" pattern="^${__line}$"/>
X            <ACTION>
X                if ! ifconfig "${iface_dev}" >/dev/null 2>&amp;1; then
X                    printf "%s \n" "Error: interface ${iface_dev} tidak ditemukan di sistem (lihat 'show interfaces' untuk daftar)."
X                    exit 33
X                fi
X                ${RT_SBIN}/titian-persist.sh mark-if "${iface_dev}"
