X# TITIAN bird.d/bgp.conf — BGP contoh lab (dual-stack channel).
X# Neighbor TEST-NET 192.0.2.1 tidak akan pernah tersambung; protokol
X# tetap tampil di `birdc show protocols` (state Connect/Active).
X# import/export none: tidak ada route yang bocor ke/dari peer contoh.
Xprotocol bgp bgp_lab {
X    # ASN global dari header bird.conf (define TITIAN_ASN).
X    local as TITIAN_ASN;
X    neighbor 192.0.2.1 as 64513;
X    ipv4 { import none; export none; };
X    ipv6 { import none; export none; };
X}
6c98bf0f1a930ed57a9cc78e4d3878f9
