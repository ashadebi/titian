echo x - net/titian/files/tree-nonroot/overview.xml
sed 's/^X//' >net/titian/files/tree-nonroot/overview.xml << '324a58e17f0cf15541cf6b81a161cbb9'
X<?xml version="1.0" encoding="UTF-8"?>
X<CLISH_MODULE xmlns="http://clish.sourceforge.net/XMLSchema" 
X          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
X xsi:schemaLocation="http://clish.sourceforge.net/XMLSchema
X                     http://clish.sourceforge.net/XMLSchema/clish.xsd">
X 	<!--=======================================================-->
X	<OVERVIEW>
XCONTEXT SENSITIVE HELP
X[?] - Display context sensitive help. This is either a list of possible
X      command completions with summaries, or the full syntax of the 
X      current command. A subsequent repeat of this key, when a command
X      has been resolved, will display a detailed reference.
X
XAUTO-COMPLETION
XThe following keys both perform auto-completion for the current command line.
XIf the command prefix is not unique then the bell will ring and a subsequent
Xrepeat of the key will display possible completions.
X
X[enter] - Auto-completes, syntax-checks then executes a command. If there is 
X          a syntax error then offending part of the command line will be
X          highlighted and explained.
X
X[space] - Auto-completes, or if the command is already resolved inserts a space.
X
XMOVEMENT KEYS
X[CTRL-A] - Move to the start of the line
X[CTRL-E] - Move to the end of the line.
X[up]     - Move to the previous command line held in history.
X[down]   - Move to the next command line held in history.
X[left]   - Move the insertion point left one character.
X[right]  - Move the insertion point right one character.
X
XDELETION KEYS
X[CTRL-C]    - Delete and abort the current line
X[CTRL-D]    - Delete the character to the right on the insertion point.
X[CTRL-K]    - Delete all the characters to the right of the insertion point.
X[CTRL-U]    - Delete the whole line.
X[backspace] - Delete the character to the left of the insertion point.
X
XESCAPE SEQUENCES
X!!  - Subsitute the the last command line.
X!N  - Substitute the Nth command line (absolute as per 'history' command)
X!-N - Substitute the command line entered N lines before (relative)
X    </OVERVIEW>
X</CLISH_MODULE>
324a58e17f0cf15541cf6b81a161cbb9
echo x - net/titian/files/tree-nonroot/ping.xml
sed 's/^X//' >net/titian/files/tree-nonroot/ping.xml << 'cc2b29063a730db73e9a166d01d6b40d'
X<?xml version="1.0" encoding="UTF-8"?>
X<CLISH_MODULE xmlns="http://clish.sourceforge.net/XMLSchema" 
X          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
X xsi:schemaLocation="http://clish.sourceforge.net/XMLSchema
X                     http://clish.sourceforge.net/XMLSchema/clish.xsd">
X	<!--=======================================================-->
X
X<VIEW name="ping-view"
X	prompt="${SYSTEM_NAME}# ">
X
X<!-- commands set: ping, ping6, arping, traceroute, traceroute6 -->
X<!-- ping, ping6, arping -->
X	<COMMAND name="ping"
X		help="Send messages to network hosts"
X		lock="false"
X		interrupt="true">
X		<PARAM name="proto"
X			help="Protocol to use for the ping"
X			optional="true"
X			mode="switch"
X			ptype="SUBCOMMAND">
X			<PARAM name="ip"
X				help="Send ICMP IPv4 messages to network hosts (default)"
X				mode="subcommand"
X				ptype="SUBCOMMAND"/>
X			<PARAM name="ipv6"
X				help="Send ICMP IPv6 messages to network hosts"
X				mode="subcommand"
X				ptype="SUBCOMMAND"/>
X			<PARAM name="arp"
X				help="Send ARP requests to a neighbour host"
X				mode="subcommand"
X				ptype="SUBCOMMAND"/>
X		</PARAM>
X		<PARAM name="dst"
X			help="Hostname or IP-address to ping"
X			ptype="STRING"/>
X		<PARAM name="source"
X			help="Source IP-address (ip) or interface (ip and arp)"
X			optional="true"
X			mode="subcommand"
X			ptype="SUBCOMMAND">
X			<PARAM name="src"
X				help="Source IP-address (ip) or interface name (ip and arp)"
X				ptype="STRING"/>
X		</PARAM>
X		<PARAM name="repeat"
X			help="Requests to send count, default is 5"
X			optional="true"
X			mode="subcommand"
X			ptype="SUBCOMMAND">
X			<PARAM name="count"
X				help="Requests count"
X				ptype="UINT"/>
X		</PARAM>
X		<PARAM name="resolve"
X			test='"${proto}"!="arp"'
X			help="Resolve names"
X			optional="true"
X			mode="subcommand"
X			ptype="SUBCOMMAND"/>
X		<PARAM name="broadcast"
X			test='"${proto}"!="arp"'
X			help="Ping broadcast address"
X			optional="true"
X			mode="subcommand"
X			ptype="SUBCOMMAND"/>
X		<PARAM name="size"
X			test='"${proto}"!="arp"'
X			help="Packet size"
X			optional="true"
X			mode="subcommand"
X			ptype="SUBCOMMAND">
X			<PARAM name="psize"
X				help="Number of data bytes to send"
X				ptype="UINT"/>
X		</PARAM>
X		<PARAM name="interval"
X			test='"${proto}"!="arp"'
X			help="The time interval between packets, default is 1"
X			optional="true"
X			mode="subcommand"
X			ptype="SUBCOMMAND">
X			<PARAM name="period"
X				help="Interval between packets"
X				ptype="STRING"/>
X		</PARAM>
X		<PARAM name="flood"
X			test='"${proto}"!="arp"'
X			help="Flood ping"
X			optional="true"
X			mode="subcommand"
X			ptype="SUBCOMMAND"/>
X		<PARAM name="duplicate-detect"
X			test='"${proto}"="arp"'
X			help="Duplicate address detection mode"
X			optional="true"
X			mode="subcommand"
X			ptype="SUBCOMMAND"/>
X		<ACTION>
X			case "${proto}" in
X				"ipv6")
X					cmd="ping -6"
X					;;
X				"arp")
X					cmd="arping"
X					;;
X				*)
X					cmd="ping"
X					;;
X			esac
X			if test "${proto}" != "arp"; then
X				# Resolve names
X				if test -z "${resolve}"; then
X					cmd=$cmd" -n"
X				fi
X				# Ping broadcast
X				cmd=$cmd"`expr substr '${ -b :broadcast}' 1 3`"
X				# Packet size
X				cmd=$cmd"${ -s :psize}"
X				# Interval between packets 
X				if test -n "${period}"; then
X					cmd=$cmd"${ -i :period}"
X				else
X					cmd=$cmd" -i 1"
X				fi
X				# Flood ping
X				cmd=$cmd"`expr substr '${ -f :flood}' 1 3`"
X			else
X				# Detect MAC duplicate
X				cmd=$cmd"`expr substr '${ -D :duplicate-detect}' 1 3`"
X			fi
X			# Interface or address
X			cmd=$cmd"${ -I :src}"
X			# Request count
X			if test -z "${count}"; then
X				cmd=$cmd" -c 5"
X			else
X				cmd=$cmd"${ -c :count}"
X			fi
X			#
X			cmd=$cmd" ${dst}"
X			$cmd
X		</ACTION>
X	</COMMAND>
X
X<!-- traceroute, traceroute6 -->
X	<COMMAND name="traceroute"
X		help="Print the route packets trace to network host"
X		lock="false"
X		interrupt="true">
X		<PARAM name="proto"
X			help="Protocol to use"
X			optional="true"
X			mode="switch"
X			ptype="SUBCOMMAND">
X			<PARAM name="ip"
X				help="IPv4"
X				mode="subcommand"
X				ptype="SUBCOMMAND"/>
X			<PARAM name="ipv6"
X				help="IPv6"
X				mode="subcommand"
X				ptype="SUBCOMMAND"/>
X		</PARAM>
X		<PARAM name="dst"
X			help="Hostname or IP-address to trace the route"
X			ptype="STRING"/>
X		<PARAM name="resolve"
X			help="Resolve names"
X			ptype="SUBCOMMAND"
X			mode="subcommand"
X			optional="true"/>
X		<PARAM name="source"
X			help="Source IP-address"
X			optional="true"
X			mode="subcommand"
X			ptype="SUBCOMMAND">
X			<PARAM name="src"
X				help="IP-address"
X				ptype="STRING"/>
X		</PARAM>
X		<PARAM name="interface"
X			help="Source interface"
X			optional="true"
X			mode="subcommand"
X			ptype="SUBCOMMAND">
X			<PARAM name="if"
X				help="Interface name"
X				ptype="STRING"/>
X		</PARAM>
X		<ACTION>
X			if test -n "${ipv6}"; then
X				cmd="traceroute -6"
X			else
X				cmd="traceroute"
X			fi
X			#Resolve names
X			if test -z "${resolve}"; then
X				cmd=$cmd" -n"
X			fi
X			# Source address
X			cmd=$cmd"${ -s :src}"
X			# Source interface
X			cmd=$cmd"${ -i :if}"
X			#
X			cmd=$cmd" ${dst}"
X			$cmd
X		</ACTION>
X	</COMMAND>
X
X</VIEW>
X
X</CLISH_MODULE>
cc2b29063a730db73e9a166d01d6b40d
