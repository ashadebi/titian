X<?xml version="1.0" encoding="UTF-8"?>
X<CLISH_MODULE xmlns="http://clish.sourceforge.net/XMLSchema" 
X          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
X xsi:schemaLocation="http://clish.sourceforge.net/XMLSchema
X                     http://clish.sourceforge.net/XMLSchema/clish.xsd">
X	<!--=======================================================-->
X
X<VIEW name="info-view"
X      prompt="cli-${SYSTEM_NAME}> ">
X
X<!-- Inheritance -->
X
X	<NAMESPACE ref="ping-view"
X		help="true"
X		completion="true"/>
X
X<!-- Non-priveledged mode commands -->
X
X	<COMMAND name="enable"
X		help="Turn on privileged commands"
X		lock="false"
X		interrupt="true">
X		<ACTION>
X                    if test -f "/usr/bin/sudo"; then
X                        sudo /opt/titian/bin/clish -l -x /opt/titian/etc/clish-en
X                    else
X                        echo "sudo not installed.."
X                    fi
X                </ACTION>
X	</COMMAND>
X
X	<COMMAND name="logout"
X		help="Exit commands"
X            	lock="false">
X		<ACTION builtin="clish_close"/>
X	</COMMAND>
X
X</VIEW>
X
X</CLISH_MODULE>
