echo x - net/titian/files/sbin/titian-commit.sh
sed 's/^X//' >net/titian/files/sbin/titian-commit.sh << '9febba63481ecfb2dee9cb35f85ae4bf'
X#!/bin/sh
X# TITIAN BSDRP — commit: terapkan semua niat pending + cek penghalang.
X# Semantik (feature-list §1): commit = tulis file + service langsung
X# naik. `save` = `config save` (persist ke partisi cfg); commit tanpa
X# save = jalan sekarang, hilang setelah reboot (rc.conf di RAM disk).
X#
X# Urutan commit:
X#   1. mutual exclusion bird vs FRR (dua arah) — BLOKIR bila konflik.
X#   2. validasi varian bird3 atas bird.conf (braces `case`, `scope`).
X#   3. terapkan niat dirty: routing (bird/frr), firewall,
X#      traffic-shape, pppoe, wireguard, monitoring.
X# Gagal di langkah mana pun = BERHENTI (exit 33), tidak ada terap paksa
X# untuk langkah itu; langkah sebelumnya yang sudah diterapkan tetap
X# diterapkan (dilaporkan apa adanya).
X# POSIX sh.
XROOT=${TITIAN_ROOT:-/opt/titian}
XSBIN_DIR=$(dirname "$0")
XBIRD_SH="$SBIN_DIR/titian-bird.sh"
XFRR_SH="$SBIN_DIR/titian-frr.sh"
XFW_SH="$SBIN_DIR/titian-fw.sh"
XTS_SH="$SBIN_DIR/titian-traffic-shape.sh"
XPPPOE_SH="$SBIN_DIR/titian-pppoe.sh"
XWG_SH="$SBIN_DIR/titian-wireguard.sh"
XMON_SH="$SBIN_DIR/titian-monitoring.sh"
Xerr() { echo "Error(commit): $*" >&2; exit 33; }
X
Xapply_routing() {
X    # Niat bird/frr dari $ROOT/etc/netstate/routing.intent.
X    local intent="$ROOT/etc/netstate/routing.intent"
X    [ -f /var/run/routing.dirty ] || [ -f "$intent" ] || return 0
X    _bird=$(sed -n 's/^bird //p' "$intent" 2>/dev/null | head -1)
X    _frr=$(sed -n 's/^frr //p' "$intent" 2>/dev/null | head -1)
X    if [ "$_bird" = "yes" ]; then
X        if command -v sysrc >/dev/null 2>&1; then sysrc bird_enable="YES" >/dev/null || err "sysrc bird_enable gagal"; fi
X        if [ -n "$(pgrep -x bird 2>/dev/null | head -1)" ]; then
X            sh "$BIRD_SH" check filter >/dev/null 2>&1 || true
X            _birdc=$(command -v birdc 2>/dev/null || echo birdc)
X            $_birdc configure 2>&1 | grep -v '^BIRD' || true
X            echo "commit: bird sudah jalan — config di-reload (birdc configure)"
X        else
X            if command -v service >/dev/null 2>&1; then service bird start || err "service bird start gagal"; else echo "(service tidak ada — lewati: service bird start)"; fi
X            echo "commit: bird enabled + started"
X        fi
X    elif [ "$_bird" = "no" ]; then
X        if command -v sysrc >/dev/null 2>&1; then sysrc bird_enable="NO" >/dev/null || err "sysrc bird_enable gagal"; fi
X        if command -v service >/dev/null 2>&1; then service bird stop 2>/dev/null || true; fi
X        echo "commit: bird disabled + stopped"
X    fi
X    if [ "$_frr" = "yes" ] || [ "$_frr" = "no" ]; then
X        sh "$FRR_SH" frr-apply || exit 33
X    fi
X    rm -f /var/run/routing.dirty
X}
X
Xapply_firewall() {
X    [ -f /var/run/firewall.dirty ] || return 0
X    _en=$(sed -n 's/^enable //p' /usr/local/etc/firewall.conf 2>/dev/null | head -1)
X    if [ "$_en" = "yes" ]; then
X        if command -v sysrc >/dev/null 2>&1; then
X            sysrc pf_enable="YES" >/dev/null
X            sysrc firewall_enable="YES" >/dev/null
X        fi
X        if command -v service >/dev/null 2>&1; then service firewall restart || err "service firewall restart gagal"; else sh "$FW_SH" apply-all || err "firewall apply gagal"; fi
X        echo "commit: firewall enabled + applied"
X    else
X        if command -v service >/dev/null 2>&1; then service firewall stop 2>/dev/null || true; else sh "$FW_SH" apply-all || true; fi
X        echo "commit: firewall disabled (anchors di-flush, pf tetap loaded)"
X    fi
X    rm -f /var/run/firewall.dirty
X}
X
Xapply_traffic_shape() {
X    [ -f /var/run/traffic-shape.dirty ] || return 0
X    _en=$(sed -n 's/^enable //p' /usr/local/etc/traffic-shape.conf 2>/dev/null | head -1)
X    if [ "$_en" = "yes" ]; then
X        if command -v sysrc >/dev/null 2>&1; then sysrc traffic_shape_enable="YES" >/dev/null; fi
X        if command -v service >/dev/null 2>&1; then service traffic-shape restart || err "service traffic-shape restart gagal"; else sh "$TS_SH" apply-all || err "traffic-shape apply gagal"; fi
X        echo "commit: traffic-shape enabled + applied"
X    else
X        if command -v service >/dev/null 2>&1; then service traffic-shape stop 2>/dev/null || true; else sh "$TS_SH" apply --flush || true; fi
X        echo "commit: traffic-shape disabled + flushed"
X    fi
X    rm -f /var/run/traffic-shape.dirty
X}
X
Xapply_pppoe() {
X    [ -f /var/run/pppoe.dirty ] || return 0
X    sh "$PPPOE_SH" apply || exit 33
X    rm -f /var/run/pppoe.dirty
X}
X
Xapply_wireguard() {
X    [ -f /var/run/wireguard.dirty ] || return 0
X    sh "$WG_SH" apply-all || exit 33
X    rm -f /var/run/wireguard.dirty
X}
X
Xapply_monitoring() {
X    [ -f /var/run/monitoring.dirty ] || return 0
X    sh "$MON_SH" apply || exit 33
X    rm -f /var/run/monitoring.dirty
X}
X
Xdo_check() {
X    # Cek saja, tanpa menerapkan: exclusion + validasi bird.conf.
X    sh "$BIRD_SH" check-exclusion commit || exit 33
X    if [ -f /usr/local/etc/bird.conf ]; then
X        sh "$BIRD_SH" validate-config /usr/local/etc/bird.conf || exit 33
X    fi
X    echo "commit check: OK (tidak ada konflik bird/FRR, bird.conf lolos validasi varian)"
X}
X
Xdo_commit() {
X    do_check || exit 33
X    apply_routing || exit 33
X    apply_firewall || exit 33
X    apply_traffic_shape || exit 33
X    apply_pppoe || exit 33
X    apply_wireguard || exit 33
X    apply_monitoring || exit 33
X    echo "commit: selesai"
X}
X
Xdo_apply_all() {
X    # Dipakai boot (titian-boot.sh sesudah replay): terapkan semua niat
X    # tanpa validasi ulang yang ketat — tapi exclusion TETAP diperiksa.
X    sh "$BIRD_SH" check-exclusion commit || exit 33
X    apply_routing || exit 33
X    apply_firewall || exit 33
X    apply_traffic_shape || exit 33
X    apply_pppoe || exit 33
X    apply_wireguard || exit 33
X    apply_monitoring || exit 33
X    echo "commit apply-all: selesai"
X}
X
Xcase "${1:-}" in
X    check) do_check ;;
X    commit) do_commit ;;
X    apply-all) do_apply_all ;;
X    *) echo "Usage: $0 {check|commit|apply-all}" >&2; exit 2 ;;
Xesac
