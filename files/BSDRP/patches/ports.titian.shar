X# TITIAN bird.d/ospf.conf — OSPF contoh lab (area 0, interface lo*).
X# Loopback tidak membentuk adjacency; protokol tetap tampil di
X# `birdc show protocols`. import/export none: aman untuk lab.
Xprotocol ospf ospf_lab {
X    area 0 {
X        interface "lo*" {
X        };
X    };
X    ipv4 { import none; export none; };
X    ipv6 { import none; export none; };
X}
