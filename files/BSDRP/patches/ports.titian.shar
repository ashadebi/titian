X<?xml version="1.0" encoding="UTF-8"?>
X<CLISH_MODULE xmlns="http://clish.sourceforge.net/XMLSchema" 
X          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
X xsi:schemaLocation="http://clish.sourceforge.net/XMLSchema
X                     http://clish.sourceforge.net/XMLSchema/clish.xsd">
X    <!--=======================================================-->
X
X<VIEW name="configure-view">
X
X    <COMMAND name="system domain-name"
X        help="Set system domain name">
X        <PARAM name="domain"
X            help="ex: gmedia.net.id"
X            ptype="STRING"/>
X        <CONFIG priority="0x1010" splitter="true"/>
X        <ACTION>
X            ${RT_SBIN}/titian-sys.sh dns-domain "${domain}"
X        </ACTION>
X    </COMMAND>
X
X    <COMMAND name="no system domain-name"
X        help="Remove system domain name">
X        <CONFIG operation="unset" pattern="^system domain-name"/>
X        <ACTION>
X            ${RT_SBIN}/titian-sys.sh dns-domain-clear
X        </ACTION>
X    </COMMAND>
X
X    <COMMAND name="system name-servers"
X            help="Domain Name Server (resolvers)"
X            view="configure-ns-view"
X            viewid="sysview=ns"
X            ptype="SUBCOMMAND"
X            mode="subcommand">
X        <CONFIG priority="0x1011" pattern="^${__line}$"/>
X    </COMMAND>
X</VIEW>
X
X
X<VIEW name="configure-ns-view"
X    prompt="${SYSTEM_NAME}(config-system-${sysview})# "
X    depth="1">
X
X<!-- Inheritance -->
X    <NAMESPACE ref="configure-view"
X        help="false"
X        completion="true"/>
X
X    <COMMAND name="exit"
X        help="Exit configuration mode"
X        lock="false">
X        <ACTION builtin="clish_nested_up"/>
X    </COMMAND>
X    <HOTKEY key="^Z" cmd="exit"/>
X
X    <COMMAND name="no"
X        help="Negate a command or set its defaults"/>
X
X<!-- IP resolvers -->
X    <COMMAND name="nameserver"
X            help="resolvers ip address">
X            <PARAM name="ip"
X                  help="IP address"
X                  ptype="IP_ADDR"/>
X        <CONFIG pattern="nameserver ${ip}" splitter="false"/>
X        <ACTION>
X            ${RT_SBIN}/titian-sys.sh dns-ns-add "${ip}"
X        </ACTION>
X    </COMMAND>
X
X    <COMMAND name="no nameserver"
X            help="">
X            <PARAM name="ip"
X                  help="IP address"
X                  completion="${Get_nameservers}"
X                  ptype="IP_ADDR"/>
X        <CONFIG operation="unset" pattern="nameserver ${ip}"/>
X        <ACTION>
X            ${RT_SBIN}/titian-sys.sh dns-ns-del "${ip}"
X        </ACTION>
X    </COMMAND>
X
X
X</VIEW>
X
X</CLISH_MODULE>
