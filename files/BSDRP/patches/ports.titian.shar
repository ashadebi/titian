echo x - net/titian/files/tree/conf-if-vxlan-fbsd.xml
sed 's/^X//' >net/titian/files/tree/conf-if-vxlan-fbsd.xml << 'f59099df84dee653a22a4a5747129afd'
X<?xml version="1.0" encoding="UTF-8"?>
X<CLISH_MODULE xmlns="http://clish.sourceforge.net/XMLSchema"
X    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
X    xsi:schemaLocation="http://clish.sourceforge.net/XMLSchema
X                        http://clish.sourceforge.net/XMLSchema/clish.xsd">
X
X<!-- VXLAN tunnel endpoint (FreeBSD). Model: setiap perubahan parameter
X     vni/local/remote/group/dstport = recreate interface dari netstate
X     <iface>.vxlan via titian-vxlan.sh (FreeBSD tidak punya negasi
X     -vxlanlocal dkk; vxlanport bukan parameter settable — port tetap
X     4789, nilai lain ditolak helper). Alamat dipulihkan dari
X     <iface>.addr, MTU dari <iface>.tuning, up-state dipulihkan.
X     Recreate = flap singkat + MAC bisa berubah (MAC vxlan acak per
X     pembuatan). Unicast (remote) dan multicast (group+dev) saling
X     eksklusif: set satu menghapus yang lain. Modul if_vxlan dimuat
X     saat create (kldload) dan dipersistenkan via if_vxlan_load="YES"
X     di /boot/loader.conf. -->
X
X<VIEW name="configure-view">
X    <COMMAND name="interface vxlan"
X        help="VXLAN tunnel endpoint (overlay L2 di atas UDP/IP)"
X        view="configure-vxlan-fbsd-view"
X        viewid="iface=${iface_vxlan}">
X        <PARAM name="iface_vxlan"
X            help="VXLAN interface (vxlan[N])"
X            completion="${Get_if_vxlan}"
X            ptype="IFACE_VXLAN"/>
X        <CONFIG priority="0x2001" pattern="^${__line}$"/>
X        <ACTION>
X            ${RT_SBIN}/titian-vxlan.sh create "${iface_vxlan}"
X        </ACTION>
X    </COMMAND>
X    <COMMAND name="no interface vxlan"
X        help="delete VXLAN interface">
X        <PARAM name="iface_vxlan"
X            help="VXLAN interface (vxlan[N])"
X            completion="${Get_if_vxlan}"
X            ptype="IFACE_VXLAN"/>
X        <CONFIG operation="unset" pattern="interface vxlan ${iface_vxlan}$"/>
X        <ACTION>
X            if ${RT_SBIN}/titian-vxlan.sh exists "${iface_vxlan}"; then
X                ${RT_SBIN}/titian-vxlan.sh delete "${iface_vxlan}"
X                ${RT_SBIN}/titian-persist.sh drop-if "${iface_vxlan}"
X            else
X                printf "%s \n" "${iface_vxlan} not found."
X            fi
X        </ACTION>
X    </COMMAND>
X</VIEW>
X
X<VIEW name="configure-vxlan-fbsd-view"
X    prompt="${SYSTEM_NAME}(config-vxlan-${iface})# "
X    depth="1">
X    <PTYPE name="iface" pattern="${iface_vxlan}"/>
X    <NAMESPACE ref="configure-view">
X        <COMMAND name="exit"
X            help="kembali ke configure-view"
X            view="configure-view"/>
X        <COMMAND name="end"
X            help="kembali ke enable-view"
X            view="enable-view"/>
X        <COMMAND name="interface" help="ganti interface"/>
X        <COMMAND name="show" help="lihat status"/>
X    </NAMESPACE>
X    <HOTKEY key="^Z" cmd="exit"/>
X    <COMMAND name="no"
X        help="negasi perintah">
X        <PARAM name="subcommand"
X            help="perintah yang dinegasi"
X            ptype="SUBCOMMAND"/>
X    </COMMAND>
X    <COMMAND name="ip"
X        help="konfigurasi IP">
X        <PARAM name="subcommand"
X            help="sub-perintah IP"
X            ptype="SUBCOMMAND"/>
X    </COMMAND>
X    <COMMAND name="no ip"
X        help="negasi konfigurasi IP">
X        <PARAM name="subcommand"
X            help="sub-perintah IP yang dinegasi"
X            ptype="SUBCOMMAND"/>
X    </COMMAND>
X    <COMMAND name="ipv6"
X        help="konfigurasi IPv6">
X        <PARAM name="subcommand"
X            help="sub-perintah IPv6"
X            ptype="SUBCOMMAND"/>
X    </COMMAND>
X    <COMMAND name="no ipv6"
X        help="negasi konfigurasi IPv6">
X        <PARAM name="subcommand"
X            help="sub-perintah IPv6 yang dinegasi"
X            ptype="SUBCOMMAND"/>
X    </COMMAND>
X    <COMMAND name="disable"
X        help="matikan interface (admin down)">
X        <CONFIG operation="unset" pattern="^enable"/>
X        <ACTION>
X            ifconfig "${iface}" down
X        </ACTION>
X    </COMMAND>
X    <COMMAND name="enable"
X        help="hidupkan interface (admin up)">
X        <CONFIG/>
X        <ACTION>
X            ifconfig "${iface}" up
X        </ACTION>
X    </COMMAND>
X    <COMMAND name="ip address"
X        help="alamat IPv4 overlay (CIDR, atau PtP: addr peer peer)">
X        <PARAM name="addr"
X            help="alamat IPv4 (CIDR, contoh 198.51.110.1/24)"
X            ptype="IP_ADDR_MASK"/>
X        <PARAM name="peer"
X            help="peer"
X            mode="subcommand"
X            optional="true"
X            ptype="SUBCOMMAND">
X            <PARAM name="peer_ip"
X                help="alamat peer (PtP)"
X                ptype="IP_ADDR"/>
X        </PARAM>
X        <CONFIG pattern="^${__line}$"/>
X        <ACTION>
X            ${RT_SBIN}/titian-if.sh addr-add "${iface}" "${addr}" "${peer_ip}"
X            ${RT_SBIN}/titian-persist.sh sync-if "${iface}"
X        </ACTION>
X    </COMMAND>
X    <COMMAND name="no ip address"
X        help="hapus alamat IPv4 overlay">
X        <PARAM name="addr"
X            help="alamat IPv4"
X            ptype="IP_ADDR_MASK"/>
X        <CONFIG operation="unset" pattern="^ip address ${addr}$"/>
X        <ACTION>
X            ${RT_SBIN}/titian-if.sh addr-del "${iface}" "${addr}"
X            ${RT_SBIN}/titian-persist.sh sync-if "${iface}"
X        </ACTION>
X    </COMMAND>
X    <COMMAND name="ipv6 address"
X        help="alamat IPv6 overlay (CIDR; FreeBSD: tanpa peer)">
X        <PARAM name="addr"
X            help="alamat IPv6 (CIDR, contoh 2001:db8:310::1/64)"
X            ptype="IP6_ADDR_MASK"/>
X        <CONFIG pattern="^${__line}$"/>
X        <ACTION>
X            ${RT_SBIN}/titian-if.sh addr6-add "${iface}" "${addr}" ""
X            ${RT_SBIN}/titian-persist.sh sync-if "${iface}"
X        </ACTION>
X    </COMMAND>
X    <COMMAND name="no ipv6 address"
X        help="hapus alamat IPv6 overlay">
X        <PARAM name="addr"
X            help="alamat IPv6"
X            ptype="IP6_ADDR_MASK"/>
X        <CONFIG operation="unset" pattern="^ipv6 address ${addr}$"/>
X        <ACTION>
X            ${RT_SBIN}/titian-if.sh addr6-del "${iface}" "${addr}"
X            ${RT_SBIN}/titian-persist.sh sync-if "${iface}"
X        </ACTION>
X    </COMMAND>
X    <COMMAND name="description"
X        help="deskripsi interface">
X        <PARAM name="text"
X            help="teks deskripsi"
X            ptype="STRING"/>
X        <CONFIG/>
X        <ACTION>
X            ifconfig "${iface}" description "${text}"
X        </ACTION>
X    </COMMAND>
X    <COMMAND name="no description"
X        help="hapus deskripsi interface">
X        <CONFIG operation="unset" pattern="^description"/>
X        <ACTION>
X            ifconfig "${iface}" -description
X        </ACTION>
X    </COMMAND>
X    <COMMAND name="mtu"
X        help="MTU overlay (batas berguna: 1450 untuk overhead VXLAN ~50B; dibuktikan uji DF, bukan dari dokumen)">
X        <PARAM name="val"
X            help="MTU"
X            ptype="MTU"/>
X        <CONFIG pattern="^mtu"/>
X        <ACTION>
X            ${RT_SBIN}/titian-tune.sh mtu "${iface}" "${val}"
X        </ACTION>
X    </COMMAND>
X    <COMMAND name="no mtu"
X        help="hapus MTU kustom (kembali ke default)">
X        <CONFIG operation="unset" pattern="^mtu"/>
X        <ACTION>
X            ${RT_SBIN}/titian-tune.sh mtu-del "${iface}"
X        </ACTION>
X    </COMMAND>
X    <COMMAND name="vni"
X        help="VXLAN Network Identifier (1-16777215). Mengubah VNI = recreate interface (flap singkat; MAC stabil per nama di lab)">
X        <PARAM name="vni"
X            help="VNI (1-16777215)"
X            ptype="VNI_ID"/>
X        <CONFIG pattern="^${__line}$"/>
X        <ACTION>
X            ${RT_SBIN}/titian-vxlan.sh set "${iface}" vni "${vni}"
X        </ACTION>
X    </COMMAND>
X    <COMMAND name="no vni"
X        help="hapus VNI (kembali ke placeholder tanpa vxlanid)">
X        <CONFIG operation="unset" pattern="^vni"/>
X        <ACTION>
X            ${RT_SBIN}/titian-vxlan.sh unset "${iface}" vni
X        </ACTION>
X    </COMMAND>
X    <COMMAND name="local"
X        help="alamat VTEP lokal (underlay, harus terjangkau lawan)">
X        <PARAM name="addr"
X            help="IPv4 VTEP lokal"
X            ptype="IP_ADDR"/>
X        <CONFIG pattern="^${__line}$"/>
X        <ACTION>
X            ${RT_SBIN}/titian-vxlan.sh set "${iface}" local "${addr}"
X        </ACTION>
X    </COMMAND>
X    <COMMAND name="no local"
X        help="hapus VTEP lokal">
X        <CONFIG operation="unset" pattern="^local"/>
X        <ACTION>
X            ${RT_SBIN}/titian-vxlan.sh unset "${iface}" local
X        </ACTION>
X    </COMMAND>
X    <COMMAND name="remote"
X        help="alamat VTEP lawan (unicast). Menghapus group+dev bila ada">
X        <PARAM name="addr"
X            help="IPv4 VTEP lawan"
X            ptype="IP_ADDR"/>
X        <CONFIG pattern="^${__line}$"/>
X        <ACTION>
X            ${RT_SBIN}/titian-vxlan.sh set "${iface}" remote "${addr}"
X        </ACTION>
X    </COMMAND>
X    <COMMAND name="no remote"
X        help="hapus VTEP lawan">
X        <CONFIG operation="unset" pattern="^remote"/>
X        <ACTION>
X            ${RT_SBIN}/titian-vxlan.sh unset "${iface}" remote
X        </ACTION>
X    </COMMAND>
X    <COMMAND name="group"
X        help="multicast group + underlay device (varian multicast; menghapus remote bila ada)">
X        <PARAM name="mcast"
X            help="alamat multicast 224.0.0.0-239.255.255.255"
X            ptype="IP_ADDR"/>
X        <PARAM name="dev"
X            help="dev"
X            mode="subcommand"
X            ptype="SUBCOMMAND">
X            <PARAM name="dev_iface"
X                help="underlay device"
X                completion="${Get_if_eth}"
X                ptype="IFACE_SYS"/>
X        </PARAM>
X        <CONFIG pattern="^${__line}$"/>
X        <ACTION>
X            ${RT_SBIN}/titian-vxlan.sh set "${iface}" group "${mcast}" "${dev_iface}"
X        </ACTION>
X    </COMMAND>
X    <COMMAND name="no group"
X        help="hapus multicast group + dev">
X        <CONFIG operation="unset" pattern="^group"/>
X        <ACTION>
X            ${RT_SBIN}/titian-vxlan.sh unset "${iface}" group
X        </ACTION>
X    </COMMAND>
X    <COMMAND name="dstport"
X        help="UDP dstport VXLAN (FreeBSD: tetap 4789, nilai lain ditolak)">
X        <PARAM name="port"
X            help="UDP port (1-65535)"
X            ptype="DSTPORT"/>
X        <CONFIG pattern="^${__line}$"/>
X        <ACTION>
X            ${RT_SBIN}/titian-vxlan.sh set "${iface}" dstport "${port}"
X        </ACTION>
X    </COMMAND>
X    <COMMAND name="no dstport"
X        help="hapus dstport (kembali ke 4789)">
X        <CONFIG operation="unset" pattern="^dstport"/>
X        <ACTION>
X            ${RT_SBIN}/titian-vxlan.sh unset "${iface}" dstport
X        </ACTION>
X    </COMMAND>
X</VIEW>
X
X</CLISH_MODULE>
