echo x - net/titian/files/tree/ping.xml
sed 's/^X//' >net/titian/files/tree/ping.xml << 'a062204621d041b8251bff905e454c18'
X<?xml version="1.0" encoding="UTF-8"?>
X<CLISH_MODULE xmlns="http://clish.sourceforge.net/XMLSchema" 
X          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
X xsi:schemaLocation="http://clish.sourceforge.net/XMLSchema
X                     http://clish.sourceforge.net/XMLSchema/clish.xsd">
X	<!--=======================================================-->
X
X<VIEW name="ping-view"
X	prompt="${SYSTEM_NAME}# ">
X
X<!-- commands set: ping, ping6, arping, traceroute, traceroute6 -->
X<!-- ping, ping6, arping -->
X	<COMMAND name="ping"
X		help="Send messages to network hosts"
X		lock="false"
X		interrupt="true">
X		<PARAM name="proto"
X			help="Protocol to use for the ping"
X			optional="true"
X			mode="switch"
X			ptype="SUBCOMMAND">
X			<PARAM name="ip"
X				help="Send ICMP IPv4 messages to network hosts (default)"
X				mode="subcommand"
X				ptype="SUBCOMMAND"/>
X			<PARAM name="ipv6"
X				help="Send ICMP IPv6 messages to network hosts"
X				mode="subcommand"
X				ptype="SUBCOMMAND"/>
X			<PARAM name="arp"
X				help="Send ARP requests to a neighbour host"
X				mode="subcommand"
X				ptype="SUBCOMMAND"/>
X		</PARAM>
X		<PARAM name="dst"
X			help="Hostname or IP-address to ping"
X			ptype="STRING"/>
X		<PARAM name="source"
X			help="Source IP-address (ip) or interface (ip and arp)"
X			optional="true"
X			mode="subcommand"
X			ptype="SUBCOMMAND">
X			<PARAM name="src"
X				help="Source IP-address (ip) or interface name (ip and arp)"
X				ptype="STRING"/>
X		</PARAM>
X		<PARAM name="repeat"
X			help="Requests to send count, default is 5"
X			optional="true"
X			mode="subcommand"
X			ptype="SUBCOMMAND">
X			<PARAM name="count"
X				help="Requests count"
X				ptype="UINT"/>
X		</PARAM>
X		<PARAM name="resolve"
X			test='"${proto}"!="arp"'
X			help="Resolve names"
X			optional="true"
X			mode="subcommand"
X			ptype="SUBCOMMAND"/>
X		<PARAM name="broadcast"
X			test='"${proto}"!="arp"'
X			help="Ping broadcast address"
X			optional="true"
X			mode="subcommand"
X			ptype="SUBCOMMAND"/>
X		<PARAM name="size"
X			test='"${proto}"!="arp"'
X			help="Packet size"
X			optional="true"
X			mode="subcommand"
X			ptype="SUBCOMMAND">
X			<PARAM name="psize"
X				help="Number of data bytes to send"
X				ptype="UINT"/>
X		</PARAM>
X		<PARAM name="interval"
X			test='"${proto}"!="arp"'
X			help="The time interval between packets, default is 1"
X			optional="true"
X			mode="subcommand"
X			ptype="SUBCOMMAND">
X			<PARAM name="period"
X				help="Interval between packets"
X				ptype="STRING"/>
X		</PARAM>
X		<PARAM name="flood"
X			test='"${proto}"!="arp"'
X			help="Flood ping"
X			optional="true"
X			mode="subcommand"
X			ptype="SUBCOMMAND"/>
X		<PARAM name="duplicate-detect"
X			test='"${proto}"="arp"'
X			help="Duplicate address detection mode"
X			optional="true"
X			mode="subcommand"
X			ptype="SUBCOMMAND"/>
X		<ACTION>
X			case "${proto}" in
X				"ipv6")
X					# ping -6 tersedia di iputils (Linux) maupun ping FreeBSD;
X					# ping6 sebagai biner terpisah sudah tidak ada di keduanya.
X					cmd="ping -6"
X					;;
X				"arp")
X					cmd="arping"
X					;;
X				*)
X					cmd="ping"
X					;;
X			esac
X			if test "${proto}" != "arp"; then
X				# Resolve names
X				if test -z "${resolve}"; then
X					cmd=$cmd" -n"
X				fi
X				# Ping broadcast
X				cmd=$cmd"`expr substr '${ -b :broadcast}' 1 3`"
X				# Packet size
X				cmd=$cmd"${ -s :psize}"
X				# Interval between packets 
X				if test -n "${period}"; then
X					cmd=$cmd"${ -i :period}"
X				else
X					cmd=$cmd" -i 1"
X				fi
X				# Flood ping
X				cmd=$cmd"`expr substr '${ -f :flood}' 1 3`"
X			else
X				# Detect MAC duplicate
X				cmd=$cmd"`expr substr '${ -D :duplicate-detect}' 1 3`"
X			fi
X			# Interface or address
X			cmd=$cmd"${ -I :src}"
X			# Request count
X			if test -z "${count}"; then
X				cmd=$cmd" -c 5"
X			else
X				cmd=$cmd"${ -c :count}"
X			fi
X			#
X			cmd=$cmd" ${dst}"
X			$cmd
X		</ACTION>
X	</COMMAND>
X
X<!-- traceroute, traceroute6 -->
X	<COMMAND name="traceroute"
X		help="Print the route packets trace to network host"
X		lock="false"
X		interrupt="true">
X		<PARAM name="proto"
X			help="Protocol to use"
X			optional="true"
X			mode="switch"
X			ptype="SUBCOMMAND">
X			<PARAM name="ip"
X				help="IPv4"
X				mode="subcommand"
X				ptype="SUBCOMMAND"/>
X			<PARAM name="ipv6"
X				help="IPv6"
X				mode="subcommand"
X				ptype="SUBCOMMAND"/>
X		</PARAM>
X		<PARAM name="dst"
X			help="Hostname or IP-address to trace the route"
X			ptype="STRING"/>
X		<PARAM name="resolve"
X			help="Resolve names"
X			ptype="SUBCOMMAND"
X			mode="subcommand"
X			optional="true"/>
X		<PARAM name="source"
X			help="Source IP-address"
X			optional="true"
X			mode="subcommand"
X			ptype="SUBCOMMAND">
X			<PARAM name="src"
X				help="IP-address"
X				ptype="STRING"/>
X		</PARAM>
X		<PARAM name="interface"
X			help="Source interface"
X			optional="true"
X			mode="subcommand"
X			ptype="SUBCOMMAND">
X			<PARAM name="if"
X				help="Interface name"
X				ptype="STRING"/>
X		</PARAM>
X		<ACTION>
X			if test -n "${ipv6}"; then
X				cmd="traceroute -6"
X			else
X				cmd="traceroute"
X			fi
X			#Resolve names
X			if test -z "${resolve}"; then
X				cmd=$cmd" -n"
X			fi
X			# Source address
X			cmd=$cmd"${ -s :src}"
X			# Source interface
X			cmd=$cmd"${ -i :if}"
X			#
X			cmd=$cmd" ${dst}"
X			$cmd
X		</ACTION>
X	</COMMAND>
X
X</VIEW>
X
X</CLISH_MODULE>
a062204621d041b8251bff905e454c18
echo x - net/titian/files/tree/startup.xml
sed 's/^X//' >net/titian/files/tree/startup.xml << '2a6e1e5ece47211305aa48ca19f3a1c5'
X<?xml version="1.0" encoding="UTF-8"?>
X<CLISH_MODULE xmlns="/opt/titian/XMLSchema" 
X          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
X xsi:schemaLocation="/opt/titian/XMLSchema/clish.xsd">
X<!--=======================================================-->
X	<OVERVIEW>
XCONTEXT SENSITIVE HELP
X[?] - Display context sensitive help. This is either a list of possible
X
XHOTKEYS
X[CTRL-z] - Logout of the current session.
X    </OVERVIEW>
X	<STARTUP timeout="1800" view="enable-view">
X		<DETAIL>
X	    </DETAIL>
X		<ACTION>
X			${RT_SBIN}/titian-sysinfo.sh
X		</ACTION>
X	</STARTUP>
X
X<!--#######################################################################-->
X<!-- Get hostname -->
X<VAR name="SYSTEM_NAME" help="Get hostname" dynamic="true">
X	<ACTION>printf "%s" $(hostname)</ACTION>
X</VAR>
X<!--#######################################################################-->
X<VAR name="Get_nameservers" help="Get hostname" dynamic="true">
X	<ACTION>grep nameserver /etc/resolv.conf 2>/dev/null |awk '{print $2}'; grep -h '^DNS=' /etc/systemd/resolved.conf.d/titian.conf 2>/dev/null |cut -d= -f2- |tr ' ' '\n' |grep -v '^$'</ACTION>
X</VAR>
X<!--#######################################################################-->
X<!--Get ethX aja (per OS lewat helper: Linux /sys, FreeBSD ifconfig) -->
X<VAR name="Get_if_eth" help="Get" dynamic="true">
X	<ACTION>
X		${RT_SBIN}/titian-if-list.sh eth
X	</ACTION>
X</VAR>
X
X<!--Get Vlan aja -->
X<VAR name="Get_if_vlan" help="Get" dynamic="true">
X	<ACTION>
X		${RT_SBIN}/titian-if-list.sh vlan
X	</ACTION>
X</VAR>
X
X<!--Get dummy aja-->
X<VAR name="Get_if_dummy" help="Get" dynamic="true">
X	<ACTION>
X		${RT_SBIN}/titian-if-list.sh dummy
X	</ACTION>
X</VAR>
X
X<!--Get bonding interface -->
X<VAR name="Get_if_bond" help="Get" dynamic="true">
X	<ACTION>
X		${RT_SBIN}/titian-if-list.sh bond
X	</ACTION>
X</VAR>
X
X<!--Get lagg interface (FreeBSD) -->
X<VAR name="Get_if_lagg" help="Get" dynamic="true">
X	<ACTION>
X		${RT_SBIN}/titian-if-list.sh lagg
X	</ACTION>
X</VAR>
X
X<!--Get vxlan interface -->
X<VAR name="Get_if_vxlan" help="Get" dynamic="true">
X	<ACTION>
X		${RT_SBIN}/titian-if-list.sh vxlan
X	</ACTION>
X</VAR>
X
X<!--Get all interface -->
X<VAR name="Get_if_all" help="Get" dynamic="true">
X	<ACTION>
X		${RT_SBIN}/titian-if-list.sh all
X	</ACTION>
X</VAR>
X
X<!--// 
X	var var an.
X//-->
X
X<VAR name="RT_ROOT" help="root dir install" dynamic="false">
X	<ACTION>printf "%s" "/opt/titian"</ACTION>
X</VAR>
X<VAR name="RT_DB" help="debug dir prosessing scripts" dynamic="false">
X	<ACTION>printf "%s" "/opt/titian/etc/db"</ACTION>
X</VAR>
X<VAR name="RT_BIN" help="binary dir (klish)" dynamic="false">
X	<ACTION>printf "%s" "/opt/titian/bin"</ACTION>
X</VAR>
X<VAR name="RT_SBIN" help="scripts dir" dynamic="false">
X	<ACTION>printf "%s" "/opt/titian/sbin"</ACTION>
X</VAR>
X<VAR name="RT_SOCK" help="konfd socks file" dynamic="false">
X	<ACTION>printf "%s" "/tmp/konfd.socket"</ACTION>
X</VAR>
X
X<!--// Get klish core version //-->
X<VAR name="RT_CONF_VER" help="static ver" dynamic="false">
X	<ACTION>printf "%s" "core: $(${RT_BIN}/konf -v)"</ACTION>
X</VAR>
X
X</CLISH_MODULE>
2a6e1e5ece47211305aa48ca19f3a1c5
echo x - net/titian/files/tree/traffic-shape.xml
sed 's/^X//' >net/titian/files/tree/traffic-shape.xml << '80269a8ab3cc7b9eaab732baa86f5662'
X<?xml version="1.0" encoding="UTF-8"?>
X<CLISH_MODULE xmlns="http://clish.sourceforge.net/XMLSchema"
X          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
X xsi:schemaLocation="http://clish.sourceforge.net/XMLSchema
X                     http://clish.sourceforge.net/XMLSchema/clish.xsd">
X    <!--=======================================================-->
X    <!-- traffic-shape (dummynet limiter) — BSDRP_klish.
X         Prepared 2026-11-08, completed 2026-11-08 ~18:00 WIB.
X         MERGED into the BSDRP tree (~/workspace/titian-bsdRP-xml/tree/).
X         Style follows titian-cli/tree (conf-serv-ssh.xml,
X         en-show-hw.xml, types-dev.xml).
X         PTYPEs TS_* are defined here; IFACE_SYS / FW_PROTO /
X         FW_CIDR_OR_ANY / DSTPORT come from the main tree
X         (types-dev.xml).
X         Backend: ${RT_SBIN}/titian-traffic-shape.sh (edit config),
X         /usr/local/sbin/traffic-shape-apply (apply at commit/boot),
X         /usr/local/etc/rc.d/traffic-shape (rc script).
X         Parameter syntax verified against FreeBSD 16 ipfw.8 +
X         sbin/ipfw/dummynet.c (mask specifiers, sched types,
X         AQM forms). Needs a clish syntax check against klish
X         0.2.0 at port time, plus a live test on a guest. -->
X    <!--=======================================================-->
X    <PTYPE name="TS_NAME"
X        pattern="^[A-Za-z0-9][A-Za-z0-9_-]{0,31}$"
X        help="nama pipe/queue/sched/rule [A-Za-z0-9_-]+ (maks 32)"/>
X    <PTYPE name="TS_RATE"
X        pattern="^[0-9]+(Kbit/s|Mbit/s|Gbit/s|bit/s)$"
X        help="bandwidth, mis. 10Mbit/s, 512Kbit/s, 1Gbit/s"/>
X    <PTYPE name="TS_UINT"
X        pattern="^[0-9]+$"
X        help="bilangan bulat >= 0"/>
X    <PTYPE name="TS_FLOAT"
X        pattern="^(0(\.[0-9]*)?|1(\.0*)?)$"
X        help="angka 0..1 (mis. 0.002)"/>
X    <PTYPE name="TS_PLR"
X        pattern="^(0(\.[0-9]*)?|1(\.0*)?)$"
X        help="packet loss rate 0..1 (mis. 0.01)"/>
X    <PTYPE name="TS_MASK"
X        pattern="^(dst-ip|src-ip|dst-ip6|src-ip6|dst-port|src-port|proto|flow-id|all)$"
X        help="dst-ip | src-ip | dst-ip6 | src-ip6 | dst-port | src-port | proto | flow-id | all"/>
X    <PTYPE name="TS_MASKVAL"
X        pattern="^(/([0-9]|[1-9][0-9]|1[0-2][0-9])|0x[0-9a-fA-F]+|[0-9]+)$"
X        help="nilai mask: /N bit (mis. /32) atau angka 0x... (default = full mask)"/>
X    <PTYPE name="TS_DIR"
X        pattern="^(in|out)$"
X        help="in | out"/>
X    <PTYPE name="TS_SCHEDTYPE"
X        pattern="^(fifo|wf2q\+|rr|qfq|fq_codel|fq_pie)$"
X        help="fifo | wf2q+ | rr | qfq | fq_codel | fq_pie"/>
X
X    <!--==================== configure-view ====================-->
X    <VIEW name="configure-view">
X        <COMMAND name="traffic-shape"
X                help="Traffic shaping (dummynet limiter)"
X                view="configure-ts-view"
X                viewid="sysview=traffic-shape"
X                ptype="SUBCOMMAND"
X                mode="subcommand">
X            <CONFIG priority="0x1300" pattern="^${__line}$"/>
X            <ACTION>
X                ${RT_SBIN}/titian-traffic-shape.sh check
X            </ACTION>
X        </COMMAND>
X    </VIEW>
X
X    <!--================= configure-ts-view =================-->
X    <VIEW name="configure-ts-view"
X        prompt="${SYSTEM_NAME}(config-traffic-shape)# "
X        depth="1">
X
X        <NAMESPACE ref="configure-view"
X            help="false"
X            completion="true"/>
X
X        <COMMAND name="exit"
X            help="Exit traffic-shape mode"
X            lock="false">
X            <ACTION builtin="clish_nested_up"/>
X        </COMMAND>
X        <HOTKEY key="^Z" cmd="exit"/>
X
X        <COMMAND name="no"
X            help="Negate a command or set its defaults"/>
X
X        <COMMAND name="enable"
X              help="Enable traffic shaping">
X            <CONFIG/>
X            <ACTION>
X                ${RT_SBIN}/titian-traffic-shape.sh set-enable yes
X            </ACTION>
X        </COMMAND>
X        <COMMAND name="no enable"
X              help="Disable traffic shaping">
X            <CONFIG operation="unset" pattern="^enable"/>
X            <ACTION>
X                ${RT_SBIN}/titian-traffic-shape.sh set-enable no
X            </ACTION>
X        </COMMAND>
X
X        <COMMAND name="pipe"
X                help="Configure a dummynet pipe (bandwidth cap)"
X                view="configure-ts-pipe-view"
X                viewid="ts_pipe=${Name}"
X                ptype="SUBCOMMAND"
X                mode="subcommand">
X            <PARAM name="Name"
X                help="nama pipe"
X                ptype="TS_NAME"/>
X            <CONFIG priority="0x1310" pattern="^pipe ${Name}$"/>
X            <ACTION>
X                ${RT_SBIN}/titian-traffic-shape.sh check-pipe "${Name}"
X            </ACTION>
X        </COMMAND>
X        <COMMAND name="no pipe"
X                help="Delete a dummynet pipe">
X            <PARAM name="Name"
X                help="nama pipe"
X                ptype="TS_NAME"/>
X            <CONFIG operation="unset" pattern="^pipe ${Name}"/>
X            <ACTION>
X                ${RT_SBIN}/titian-traffic-shape.sh del-pipe "${Name}"
X            </ACTION>
X        </COMMAND>
X
X        <COMMAND name="sched"
X                help="Configure a dummynet scheduler (algorithm)"
X                view="configure-ts-sched-view"
X                viewid="ts_sched=${Name}"
X                ptype="SUBCOMMAND"
X                mode="subcommand">
X            <PARAM name="Name"
X                help="nama scheduler"
X                ptype="TS_NAME"/>
X            <CONFIG priority="0x1315" pattern="^sched ${Name}$"/>
X            <ACTION>
X                ${RT_SBIN}/titian-traffic-shape.sh check-sched "${Name}"
X            </ACTION>
X        </COMMAND>
X        <COMMAND name="no sched"
X                help="Delete a dummynet scheduler">
X            <PARAM name="Name"
X                help="nama scheduler"
X                ptype="TS_NAME"/>
X            <CONFIG operation="unset" pattern="^sched ${Name}"/>
X            <ACTION>
X                ${RT_SBIN}/titian-traffic-shape.sh del-sched "${Name}"
X            </ACTION>
X        </COMMAND>
X
X        <COMMAND name="queue"
X                help="Configure a dummynet queue (per-flow split of a pipe/sched)"
