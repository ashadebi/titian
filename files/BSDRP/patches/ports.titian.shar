sed 's/^X//' >net/titian/files/bird.d/filter.conf << '79c630ee72737df3a98700cd7b328595'
X# TITIAN bird.d/filter.conf - contoh + filter BGP wajib CLI.
Xfilter f_accept {
X    accept;
X}
X
Xfilter f_reject {
X    reject;
X}
X
X# Filter export BGP: community export + redistribute static/direct.
Xfilter bgp_export_attr {
X    if source = RTS_STATIC then {
X        accept;
X    }
X    reject;
X}
X
X# Filter import BGP: community import (match disisipkan di atas accept).
Xfilter bgp_import_comm {
X    accept;
X}
