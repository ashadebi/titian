X<?xml version="1.0" encoding="UTF-8"?>
X<CLISH_MODULE xmlns="http://clish.sourceforge.net/XMLSchema" 
X          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
X xsi:schemaLocation="http://clish.sourceforge.net/XMLSchema
X                     http://clish.sourceforge.net/XMLSchema/clish.xsd">
X    <!--=======================================================-->
X
X<VIEW name="enable-view">
X<!-- Show commands -->
X    <COMMAND name="show"
X        help="Show running system information"/>
X
X    <COMMAND name="show ipv6"
X        help="IPv6 information"/>
X
X    <COMMAND name="show running-config"
X        help="Current operating configuration">
X        <CONFIG operation="dump"/>
X        <ACTION>
X        </ACTION>
X    </COMMAND>
X
X    <COMMAND name="show startup-config"
X        help="Contents of startup configuration">
X        <ACTION>cat ${RT_ROOT}/etc/startup-config</ACTION>
X    </COMMAND>
X
X    <COMMAND name="show history"
X        help="Commands history">
X        <ACTION>cat ${HOME}/.clish_history 2>/dev/null || echo "no history"</ACTION>
X    </COMMAND>
X
X    <COMMAND name="show ip"
X        help="IP information"/>
X
X<!-- Show routing (per OS lewat helper) -->
X    <COMMAND name="show ip route"
X        help="IP routing table"
X        lock="false"
X        interrupt="true">
X        <PARAM name="ip"
X                help="ip address or mask"
X                optional="true"
X                ptype="IP_ADDR_ANY"/>
X        <ACTION>
X            ${RT_SBIN}/titian-show.sh route "${ip}"
X            </ACTION>
X    </COMMAND>
X
X    <COMMAND name="show ipv6 route"
X        help="IPv6 routing table"
X        lock="false"
X        interrupt="true">
X        <PARAM name="ip"
X                help="ipv6 address or prefix"
X                optional="true"
X                ptype="IP6_ADDR_ANY"/>
X        <ACTION>
X            ${RT_SBIN}/titian-show.sh route6 "${ip}"
X            </ACTION>
X    </COMMAND>
X
X<!-- Show short if summary + ip (helper: tampilkan inet DAN inet6) -->
X    <COMMAND name="show interfaces"
X            help="Interfaces and Ip information"
X            lock="false"
X            interrupt="true">
X        <ACTION>
X            ${RT_SBIN}/titian-show.sh interfaces
X        </ACTION>
X    </COMMAND>
X
X<!-- Show semua interface sistem: terse = satu baris per interface
X     (admin up/disabled, link up/down); all = blok detail per interface.
X     CATATAN: bentuk singular "show interface ..." SENGAJA tidak dibuat —
X     klish gagal membedakan token "interface" dari "interfaces" (tabrakan
X     prefix) sehingga bentuk singular ditolak "Illegal command line",
X     sementara bentuk plural jalan. Pakai bentuk plural. -->
X    <COMMAND name="show interfaces terse"
X            help="All interfaces, one line each (admin/link status)"
X            lock="false"
X            interrupt="true">
X        <ACTION>
X            ${RT_SBIN}/titian-show.sh terse
X        </ACTION>
X    </COMMAND>
X
X    <COMMAND name="show interfaces all"
X            help="All interfaces, full detail"
X            lock="false"
X            interrupt="true">
X        <ACTION>
X            ${RT_SBIN}/titian-show.sh all
X        </ACTION>
X    </COMMAND>
X
X<!-- Tuning per interface: nilai live (mtu/qlen/speed/offload/coalesce)
X     + satu baris arti tiap nilai. Bentuk singular "show interface"
X     sengaja tidak dibuat (tabrakan prefix dengan "interfaces",
X     lihat catatan di atas). -->
X    <COMMAND name="show interfaces tuning"
X            help="Interface tuning values + meaning (mtu/qlen/speed/offload/coalesce)"
X            lock="false"
X            interrupt="true">
X        <PARAM name="iface"
X                help="Interface"
X                completion="${Get_if_all}"
X                ptype="IFACE_SYS"/>
X        <ACTION>
X            ${RT_SBIN}/titian-tune.sh show "${iface}"
X        </ACTION>
X    </COMMAND>
X
X    <COMMAND name="show interfaces ethernet"
X            help="Interface status and configuration" 
X            lock="false"
X            interrupt="true">
X        <PARAM name="iface"
X                help="Interface physical"
X                completion="${Get_if_eth}"
X                ptype="IFACE_SYS"/>
X        <PARAM name="detail"
X                help="Detail hardware information"
X                ptype="SUBCOMMAND"
X                mode="subcommand"
X                optional="true"
X                order="true"/>
X        <ACTION>
X            if test ! -z "${detail}"; then
X                ${RT_SBIN}/titian-show.sh if-detail "${iface}" detail
X            else
X                ${RT_SBIN}/titian-show.sh if-detail "${iface}"
X            fi
X        </ACTION>
X     </COMMAND>
X
X    
X
X    
X
X<!-- Show neighbor/ARP -->
X    <COMMAND name="show ip neighbor"
X        help="IP neighbor/ARP table"
X        lock="false"
X        interrupt="true">
X            <PARAM name="iface"
X                  help="Interface"
X                  completion="${Get_if_all}"
X                  optional="true"
X                  ptype="IFACE_SYS"/>
X        <ACTION>
X            ${RT_SBIN}/titian-show.sh neighbor "${iface}"
X        </ACTION>
X    </COMMAND>
X
X<!--services configuration -->
X    <COMMAND name="show service"
X        help="IP information"/>
X
X    <COMMAND name="show service summary"
X            help="services summary"
X            lock="false"
X            interrupt="true">
X        <ACTION>
X            ${RT_SBIN}/titian-sys.sh services
X        </ACTION>
X    </COMMAND>
X    <COMMAND name="show service status"
X            help="service init commands"
X            lock="false"
X            interrupt="true">
X        <PARAM name="service"
X            help="services any"
X            ptype="STRING"/>
X        <ACTION>
X            ${RT_SBIN}/titian-sys.sh service-status "${service}"
X        </ACTION>
X    </COMMAND>
X
X    <COMMAND name="show pwd"
X            help="Current dir"
X            lock="false"
X            interrupt="true">
X        <ACTION>
X            pwd
X        </ACTION>
X    </COMMAND>
X
X</VIEW>
X
X</CLISH_MODULE>
