echo x - net/titian/files/sbin/titian-show.sh
sed 's/^X//' >net/titian/files/sbin/titian-show.sh << 'edbf683c273770303a635de8996fe70e'
X#!/bin/sh
X# TITIAN Fase 1 — perintah show (interfaces, route, neighbor).
X# Perbedaan dari rtcli: show interfaces MENAMPILKAN inet6 (rtcli
X# sengaja membuangnya dengan egrep -v inet6).
X# POSIX sh.
XOS=$(uname -s)
X
Xinterfaces_linux() {
X    printf "\n"
X    printf "Codes: State, u - Up, D - Down, L - Loopback. \n"
X    printf "  %-11s%-19s%8s    %s\n" "Interface" "IP Address" "state" "Description"
X    printf "  %-11s%-19s%8s    %s\n" "---------" "----------" "-----" "-----------"
X    for f in $(ls /sys/class/net 2>/dev/null | sort); do
X        dev=$f
X        # Hanya direktori = interface nyata (lewati berkas non-interface
X        # seperti bonding_masters — lihat titian-if-list.sh).
X        [ -d "/sys/class/net/$dev" ] || continue
X        operstate=$(cat /sys/class/net/$dev/operstate 2>/dev/null)
X        alias=$(cat /sys/class/net/$dev/ifalias 2>/dev/null)
X        case "$operstate" in
X            up) operstate="u" ;;
X            *)  operstate="D" ;;
X        esac
X        case "$dev" in
X            lo*) operstate="L" ;;
X        esac
X        addrs=$(ip -o addr show dev "$dev" 2>/dev/null | awk '{if ($5=="peer") print $4 " peer " $6; else print $4}')
X        if [ -z "$addrs" ]; then
X            printf "  %-11s%-19s%8s    %s\n" "$dev" "-" "$operstate" "$alias"
X        else
X            first=1
X            for a in $addrs; do
X                if [ "$first" -eq 1 ]; then
X                    printf "  %-11s%-19s%8s    %s\n" "$dev" "$a" "$operstate" "$alias"
X                    first=0
X                else
X                    printf "  %-11s%-19s\n" "" "$a"
X                fi
X            done
X        fi
X    done
X    printf "\n"
X}
X
Xinterfaces_fbsd() {
X    printf "\n"
X    printf "Codes: State, u - Up, D - Down, L - Loopback. \n"
X    printf "  %-11s%-19s%8s    %s\n" "Interface" "IP Address" "state" "Description"
X    printf "  %-11s%-19s%8s    %s\n" "---------" "----------" "-----" "-----------"
X    ifconfig -a 2>/dev/null | awk '
X        /^[a-z0-9]+:/ {
X            if (dev != "") { flush() }
X            split($1, n, ":"); dev = n[1]
X            flags = $0
X            state = (flags ~ /UP/) ? "u" : "D"
X            if (dev ~ /^lo/) state = "L"
X            desc = ""; naddr = 0
X        }
X        /^[[:space:]]*inet6? / {
X            # $2 = address; PtP: inet A --> B
X            if ($1 == "inet") {
X                if ($3 == "-->") addrs[++naddr] = $2 " peer " $4
X                else addrs[++naddr] = $2
X            } else {
X                # inet6 A prefixlen N ...
X                for (i = 1; i <= NF; i++) if ($i == "prefixlen") { addrs[++naddr] = $2 "/" $(i+1) }
X            }
X        }
X        /^[[:space:]]*description: / { desc = substr($0, index($0, ":") + 2) }
X        function flush() {
X            if (naddr == 0) {
X                printf("  %-11s%-19s%8s    %s\n", dev, "-", state, desc)
X            } else {
X                for (i = 1; i <= naddr; i++) {
X                    if (i == 1) printf("  %-11s%-19s%8s    %s\n", dev, addrs[i], state, desc)
X                    else printf("  %-11s%-19s\n", "", addrs[i])
X                }
X            }
X        }
X        END { if (dev != "") flush() }
X    '
X    printf "\n"
X}
X
X# Status tiga nilai (permintaan user): admin up/disabled dari flag UP,
X# link up/down dari operstate/LOWER_UP (Linux) atau status (FreeBSD).
X# terse = satu baris per interface sistem (bukan hanya yang terkonfigurasi).
Xterse_linux() {
X    printf "\n"
X    printf "  %-11s %-9s %-6s %s\n" "Interface" "Admin" "Link" "IP Address"
X    printf "  %-11s %-9s %-6s %s\n" "---------" "-----" "----" "----------"
X    for dev in $(ls /sys/class/net 2>/dev/null | sort); do
X        # Hanya direktori = interface nyata (lewati berkas non-interface
X        # seperti bonding_masters — lihat titian-if-list.sh).
X        [ -d "/sys/class/net/$dev" ] || continue
X        flags_hex=$(cat /sys/class/net/$dev/flags 2>/dev/null)
X        [ -n "$flags_hex" ] || flags_hex=0x0
X        flags=$((flags_hex))
X        if [ $((flags & 1)) -eq 1 ]; then admin="up"; else admin="disabled"; fi
X        operstate=$(cat /sys/class/net/$dev/operstate 2>/dev/null)
X        # lo: operstate=unknown + flags tanpa LOWER_UP (0x9) -> LOOPBACK (0x8) yang menandakan link up.
X        link="down"
X        if [ "$admin" = "up" ]; then
X            if [ "$operstate" = "up" ] || [ $((flags & 65536)) -ne 0 ] || [ $((flags & 8)) -ne 0 ]; then link="up"; fi
X        fi
X        addrs=$(ip -o addr show dev "$dev" 2>/dev/null | awk '{if ($5=="peer") print $4 " peer " $6; else print $4}' | paste -sd ", " -)
X        [ -z "$addrs" ] && addrs="-"
X        printf "  %-11s %-9s %-6s %s\n" "$dev" "$admin" "$link" "$addrs"
X    done
X    printf "\n"
X}
X
Xterse_fbsd() {
X    printf "\n"
X    printf "  %-11s %-9s %-6s %s\n" "Interface" "Admin" "Link" "IP Address"
X    printf "  %-11s %-9s %-6s %s\n" "---------" "-----" "----" "----------"
X    ifconfig -a 2>/dev/null | awk '
X        /^[a-z0-9]+:/ {
X            if (dev != "") flush()
X            split($1, n, ":"); dev = n[1]
X            f = $2; sub(/^.*</, "", f); sub(/>.*$/, "", f)
X            admin = (f ~ /(^|,)UP(,|$)/) ? "up" : "disabled"
X            link = (dev ~ /^lo/) ? "up" : "down"
X            naddr = 0
X        }
X        /^[[:space:]]*status: / { link = ($2 == "active") ? "up" : "down" }
X        /^[[:space:]]*inet6? / {
X            if ($1 == "inet") {
X                if ($3 == "-->") addrs[++naddr] = $2 " peer " $4
X                else addrs[++naddr] = $2
X            } else {
X                for (i = 1; i <= NF; i++) if ($i == "prefixlen") addrs[++naddr] = $2 "/" $(i+1)
X            }
X        }
X        function flush() {
X            a = "-"
X            for (i = 1; i <= naddr; i++) a = (i == 1) ? addrs[i] : a ", " addrs[i]
X            printf("  %-11s %-9s %-6s %s\n", dev, admin, link, a)
X        }
X        END { if (dev != "") flush() }
X    '
X    printf "\n"
X}
X
X# all = blok detail per interface sistem (admin/link, mtu, mac, alamat, counter).
Xall_linux() {
X    printf "\n"
X    for dev in $(ls /sys/class/net 2>/dev/null | sort); do
X        # Hanya direktori = interface nyata (lewati berkas non-interface
X        # seperti bonding_masters — lihat titian-if-list.sh).
X        [ -d "/sys/class/net/$dev" ] || continue
X        flags_hex=$(cat /sys/class/net/$dev/flags 2>/dev/null)
X        [ -n "$flags_hex" ] || flags_hex=0x0
X        flags=$((flags_hex))
X        if [ $((flags & 1)) -eq 1 ]; then admin="up"; else admin="disabled"; fi
X        operstate=$(cat /sys/class/net/$dev/operstate 2>/dev/null)
X        # lo: operstate=unknown + flags tanpa LOWER_UP (0x9) -> LOOPBACK (0x8) yang menandakan link up.
X        link="down"
X        if [ "$admin" = "up" ]; then
X            if [ "$operstate" = "up" ] || [ $((flags & 65536)) -ne 0 ] || [ $((flags & 8)) -ne 0 ]; then link="up"; fi
X        fi
X        mtu=$(cat /sys/class/net/$dev/mtu 2>/dev/null)
X        mac=$(cat /sys/class/net/$dev/address 2>/dev/null)
X        alias=$(cat /sys/class/net/$dev/ifalias 2>/dev/null)
X        printf "Interface %s: admin %s, link %s, mtu %s, mac %s" "$dev" "$admin" "$link" "$mtu" "$mac"
X        [ -n "$alias" ] && printf ", description \"%s\"" "$alias"
X        printf "\n"
X        ip -o addr show dev "$dev" 2>/dev/null | awk '{if ($5=="peer") print "    " $3 " " $4 " peer " $6; else print "    " $3 " " $4}'
X        ip -s link show "$dev" 2>/dev/null | awk '/RX:/ {getline; rx=$1" bytes, "$2" packets, "$3" errors, "$4" dropped"} /TX:/ {getline; tx=$1" bytes, "$2" packets, "$3" errors, "$4" dropped"} END {if (rx != "") {print "    RX: " rx; print "    TX: " tx}}'
X        printf "\n"
X    done
X}
X
Xall_fbsd() {
X    printf "\n"
X    for dev in $(ifconfig -l 2>/dev/null); do
X        out=$(ifconfig "$dev" 2>/dev/null) || continue
X        line=$(printf "%s\n" "$out" | head -1)
X        f=$(printf "%s" "$line" | awk '{f=$2; sub(/^.*</, "", f); sub(/>.*$/, "", f); print f}')
X        case ",$f," in *,UP,*) admin="up" ;; *) admin="disabled" ;; esac
X        case "$dev" in
X            lo*) link="up" ;;
X            *) link=$(printf "%s\n" "$out" | awk '/^[[:space:]]*status: / {print ($2 == "active") ? "up" : "down"; exit}'); [ -z "$link" ] && link="down" ;;
X        esac
X        printf "Interface %s: admin %s, link %s\n" "$dev" "$admin" "$link"
X        printf "%s\n" "$out" | sed 's/^/    /'
X        netstat -I "$dev" -b 2>/dev/null | awk 'NR > 1 && $3 ~ /^<Link/ {printf("    counters: RX %s packets, %s bytes; TX %s packets, %s bytes\n", $5, $8, $9, $11); exit}'
X        printf "\n"
X    done
X}
X
Xif_detail() {
X    # $1=iface [$2=detail]
X    local iface=$1 detail=${2:-}
X    if [ "$OS" = "FreeBSD" ]; then
X        ifconfig "$iface" 2>/dev/null || { echo "Error: interface $iface tidak ditemukan di sistem (lihat 'show interfaces' untuk daftar)." >&2; exit 33; }
X        if [ -n "$detail" ]; then
X            echo "(detail hardware setara ethtool/udev tidak tersedia di FreeBSD; pakai pciconf -lv)"
X        fi
X    else
X        if [ ! -d "/sys/class/net/$iface" ]; then
X            echo "Error: interface $iface tidak ditemukan di sistem (lihat 'show interfaces' untuk daftar)." >&2; exit 33
X        fi
X        printf "\n"
X        ip -d link show "$iface"
X        ip -d addr show "$iface" | grep inet
X        printf "\n"
X        if [ -n "$detail" ]; then
X            if command -v ethtool >/dev/null 2>&1; then ethtool "$iface"; printf "\n"; fi
X            if command -v udevadm >/dev/null 2>&1; then udevadm info "/sys/class/net/$iface"; printf "\n"; fi
X        fi
X    fi
X}
X
Xcase "${1:-}" in
X    interfaces)
X        if [ "$OS" = "FreeBSD" ]; then interfaces_fbsd; else interfaces_linux; fi
X        ;;
X    if-detail)
X        if_detail "$2" "${3:-}"
X        ;;
X    terse)
X        if [ "$OS" = "FreeBSD" ]; then terse_fbsd; else terse_linux; fi
X        ;;
X    all)
X        if [ "$OS" = "FreeBSD" ]; then all_fbsd; else all_linux; fi
X        ;;
X    route)
X        if [ "$OS" = "FreeBSD" ]; then
X            if [ -n "${2:-}" ]; then netstat -rn -f inet 2>/dev/null | grep -F -- "$2" || true
X            else netstat -rn -f inet 2>/dev/null; fi
X        else
X            if [ -n "${2:-}" ]; then ip route show "$2"; else ip route show; fi
X        fi
X        ;;
X    route6)
X        if [ "$OS" = "FreeBSD" ]; then
X            if [ -n "${2:-}" ]; then netstat -rn -f inet6 2>/dev/null | grep -F -- "$2" || true
X            else netstat -rn -f inet6 2>/dev/null; fi
X        else
X            if [ -n "${2:-}" ]; then ip -6 route show "$2"; else ip -6 route show; fi
X        fi
X        ;;
X    neighbor)
X        if [ "$OS" = "FreeBSD" ]; then
X            if [ -n "${2:-}" ]; then arp -a 2>/dev/null | grep -F -- "$2" || true
X            else arp -a 2>/dev/null; fi
X        else
X            if [ -n "${2:-}" ]; then ip -d neighbor show dev "$2"; else ip -d neighbor show; fi
X        fi
X        ;;
X    *) echo "Usage: $0 {interfaces|if-detail|terse|all|route|route6|neighbor} [arg]" >&2; exit 2 ;;
Xesac
