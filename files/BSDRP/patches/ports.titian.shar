X<?xml version="1.0" encoding="UTF-8"?>
X<CLISH_MODULE xmlns="/opt/titian/XMLSchema" 
X          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
X xsi:schemaLocation="/opt/titian/XMLSchema/clish.xsd">
X    <!--=======================================================-->
X<!--//
X        pattern super mengakomodasi semua interface
X//-->
X<!-- Interface sistem TERPADU (2 Nov 2026): satu PTYPE kedua OS.
X     Dulu IFACE_DEV (pola nama Linux) + IFACE_DEV_FBSD (pola nama
X     FreeBSD) + IFACE_ANY (gabungan pola) — ketiganya gagal untuk
X     interface yang di-rename di level OS. Sekarang validasi klish
X     hanya memeriksa BENTUK nama (charset + panjang IFNAMSIZ 15),
X     sedangkan keberadaan interface diperiksa helper ACTION
X     (view/ACTION per-OS) dengan pesan lantang. Pola: huruf/angka/
X     underscore di awal, lalu huruf/angka/underscore/titik/strip,
X     total maks 15 karakter. Sengaja TIDAK mengizinkan: '/' (tidak sah
X     di kedua OS), spasi, ':' (notasi alias, bukan interface nyata),
X     awalan '.'/'-' ('.'/'..' tidak sah; '-' pathological untuk CLI).
X     Total 15 = IFNAMSIZ 16 kedua OS (Linux + FreeBSD) minus NUL. -->
X    <PTYPE name="IFACE_SYS"
X        pattern="^[A-Za-z0-9_][A-Za-z0-9_.-]{0,14}$"
X        help="nama interface sistem apa pun — terdeteksi langsung dari OS (lihat 'show interfaces', atau Tab/? untuk daftar). Nama fisik gaya romawi (e=Ethernet): xe=10G, xxve=25G, xle=40G, le=50G, ce=100G, cce=200G, cde=400G"/>
X    <!--=======================================================-->
X    <!-- VLAN Linux = parent.tag; parent adalah interface sistem yang
X         BISA di-rename, jadi parent memakai charset IFACE_SYS (tanpa
X         titik — vlan bertingkat tidak didukung ACTION split). VID
X         tetap 1-4094. Total panjang nama ditegakkan kernel (15);
X         bila melebihi, ACTION ip gagal lantang. -->
X    <PTYPE name="IFACE_VLAN"
X        pattern="^[A-Za-z0-9_][A-Za-z0-9_-]{0,14}\.(409[0-5]|40[0-8][0-9]|[1-3][0-9]{3}|[1-9][0-9]{2}|[1-9][0-9]|[1-9])$"
X        help="nama-parent.VLAN-ID (contoh: enp9s0.100; daftar: show interfaces)"/>
X    <!--=======================================================--> 
X    <PTYPE name="IFACE_DUMMY"
X        pattern="lo([1-9])$"
X        help="lo[1-9]"/>
X    <!--=======================================================-->
X    <PTYPE name="IFACE_BOND"
X        pattern="bond([0-9])$"
X        help="bond[0-9]"/>
X    <!--=======================================================-->
X    <PTYPE name="IFACE_VXLAN"
X        pattern="vxlan[0-9]+$"
X        help="vxlan[N]"/>
X    <!--=======================================================-->
X    <PTYPE name="VNI_ID"
X        pattern="[0-9]+"
X        help="range 1-16777215"/>
X    <!--=======================================================-->
X    <PTYPE name="DSTPORT"
X        pattern="[0-9]+"
X        help="range 1-65535"/>
X    <!-- IFACE_ANY dihapus 2 Nov 2026: digantikan IFACE_SYS (charset yang
X         sama mencakup semua nama lama IFACE_ANY + nama hasil rename). -->
X<!-- IP Address -->
X    <!--=======================================================-->
X    <PTYPE name="IP_ADDR"
X        pattern="(((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?))"
X        help="A.B.C.D"/>
X    <!--=======================================================-->
X    <PTYPE name="IP_ADDR_MASK"
X        pattern="^(([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])\.){3}([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])(\/([0-9]|[1-2][0-9]|3[0-2]))$"
X        help="A.B.C.D[/mask]"/>
X    <PTYPE name="IP_ADDR_MASK_OPT"
X        pattern="^(([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])\.){3}([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])(\/([0-9]|[1-2][0-9]|3[0-2]))?$"
X        help="A.B.C.D or A.B.C.D/mask (bare = /32; PtP form)"/>
X    <!--=======================================================-->
X    <PTYPE name="IP_ADDR_ANY"
X        pattern="^(([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])\.){3}([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])(\/([0-9]|[1-2][0-9]|3[0-2]))$|((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)"
X        help="A.B.C.D or A.B.C.D[/mask]"/>
X    <!--=======================================================-->
X    <PTYPE name="MTU"
X        pattern="(9000|8[0-9][0-9][0-9]|[1-7][0-9]{3}|[1-9][0-9]{2}|[7-9][0-9]|6[8-9])"
X        help="range 68-9000"/>
X    <!--=======================================================-->
X    <PTYPE name="SPEED"
X        pattern="^(100000|50000|40000|25000|10000|5000|2500|1000|100|10)$"
X        help="speed Mb/s: 10 100 1000 2500 5000 10000 25000 40000 50000 100000"/>
X    <!--=======================================================-->
X    <PTYPE name="VLAN_ID" 
X        pattern="(409[0-5]|40[0-8][0-9]|[1-3][0-9]{3}|[1-9][0-9]{2}|[1-9][0-9]|[1-9])"
X        help="range 1-4094"/>
X    <!--=======================================================-->
X    <PTYPE name="CHECKPOINT_NAME"
X        pattern="[A-Za-z0-9][A-Za-z0-9_-]*"
X        help="nama checkpoint [A-Za-z0-9_-]+"/>
X    <!--=======================================================-->
X    <!-- Firewall/NAT (2 Nov 2026): bentuk kanonis dipaksa PTYPE
X         agar baris running-config selalu sama persis dengan `no`
X         form-nya (CIDR wajib bermask; host = /32; `any` eksplisit). -->
X    <PTYPE name="FW_CHAIN"
X        pattern="^(forward|input|output)$"
X        help="forward | input | output"/>
X    <PTYPE name="FW_ACTION"
X        pattern="^(permit|deny)$"
X        help="permit | deny"/>
X    <PTYPE name="FW_PROTO"
X        pattern="^(tcp|udp|icmp|all)$"
X        help="tcp | udp | icmp | all"/>
X    <PTYPE name="FW_DNAT_PROTO"
X        pattern="^(tcp|udp)$"
X        help="tcp | udp"/>
X    <PTYPE name="FW_CIDR_OR_ANY"
X        pattern="^(any|((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)/([0-9]|[1-2][0-9]|3[0-2]))$"
X        help="CIDR (contoh 198.51.100.0/24; host = /32) atau any"/>
X    <PTYPE name="FW_PORT_OR_ANY"
X        pattern="^(any|[0-9]+)$"
X        help="port 1-65535 atau any (range dicek helper)"/>
X    <PTYPE name="FW_PORT_OR_SAME"
X        pattern="^(same|[0-9]+)$"
X        help="port 1-65535 atau same (range dicek helper)"/>
X    <PTYPE name="FW_IFACE_OR_ANY"
X        pattern="^(any|[A-Za-z0-9_][A-Za-z0-9_.-]{0,14})$"
X        help="nama interface (charset IFACE_SYS) atau any"/>
X    <PTYPE name="FW_SNAT_TARGET"
X        pattern="^(masquerade|((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?))$"
X        help="alamat IPv4 atau masquerade"/>
X    <!--=======================================================-->
X</CLISH_MODULE>
d640b19062fa496656683ecc34310640
echo x - net/titian/files/tree/types-ip6.xml
sed 's/^X//' >net/titian/files/tree/types-ip6.xml << '3b726a8a46bda81b51795dfe7b0add04'
X<?xml version="1.0" encoding="UTF-8"?>
X<CLISH_MODULE xmlns="http://clish.sourceforge.net/XMLSchema"
X          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
X xsi:schemaLocation="http://clish.sourceforge.net/XMLSchema
X                     http://clish.sourceforge.net/XMLSchema/clish.xsd">
X    <!--=======================================================-->
X    <!-- TITIAN: PTYPE IPv6 (baru di Fase 1; PTYPE IPv4 lama di
X         types-dev.xml dipertahankan apa adanya).
X         Pola di sini adalah filter lapis pertama: wajib mengandung
X         ':' dan hanya karakter heksadesimal/titik-dua. Validasi ketat
X         (bentuk terkompresi, jumlah grup, prefix) dilakukan helper
X         titian-if.sh/titian-route.sh lewat `ip -6` (Linux) atau
X         `ifconfig inet6`/`route -6` (FreeBSD) yang menolak input
X         tidak valid — perintah gagal bersih, bukan tersimpan. -->
X    <PTYPE name="IP6_ADDR"
X        pattern="^([0-9a-fA-F]{0,4}:){2,7}[0-9a-fA-F]{0,4}$"
X        help="IPv6 address (ex: 2001:db8::1)"/>
X    <!--=======================================================-->
X    <PTYPE name="IP6_ADDR_MASK"
X        pattern="^([0-9a-fA-F]{0,4}:){2,7}[0-9a-fA-F]{0,4}/(12[0-8]|1[0-1][0-9]|[1-9][0-9]|[0-9])$"
X        help="IPv6 address/prefix (ex: 2001:db8::1/64)"/>
X    <PTYPE name="IP6_ADDR_MASK_OPT"
X        pattern="^([0-9a-fA-F]{0,4}:){2,7}[0-9a-fA-F]{0,4}(/(12[0-8]|1[0-1][0-9]|[1-9][0-9]|[0-9]))?$"
X        help="IPv6 address or address/prefix (bare = /128; PtP form)"/>
X    <!--=======================================================-->
X    <PTYPE name="IP6_ADDR_ANY"
X        pattern="^([0-9a-fA-F]{0,4}:){2,7}[0-9a-fA-F]{0,4}(/(12[0-8]|1[0-1][0-9]|[1-9][0-9]|[0-9]))?$"
X        help="IPv6 address or address/prefix"/>
X    <!-- IFACE_DEV_FBSD dihapus 2 Nov 2026: digantikan IFACE_SYS
X         (types-dev.xml, COMMON) — satu PTYPE interface sistem kedua OS. -->
X    <!--=======================================================-->
X    <PTYPE name="IFACE_VLAN_FBSD"
X        pattern="vlan[0-9]+$"
X        help="vlan[N] (FreeBSD)"/>
X    <!--=======================================================-->
X    <PTYPE name="IFACE_LAGG"
X        pattern="lagg[0-9]+$"
X        help="lagg[N] (FreeBSD)"/>
X    <!--=======================================================-->
X</CLISH_MODULE>
3b726a8a46bda81b51795dfe7b0add04
echo x - net/titian/files/tree/types.xml
sed 's/^X//' >net/titian/files/tree/types.xml << '3c63f4f994c86b6d9c0620eb33dc03fb'
X<?xml version="1.0" encoding="UTF-8"?>
X<CLISH_MODULE xmlns="/opt/titian/XMLSchema" 
X          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
X xsi:schemaLocation="/opt/titian/XMLSchema/clish.xsd">
X    <!--=======================================================-->
X    <PTYPE name="UINT"
X        pattern="[0-9]+"
X        help="Unsigned integer"/>
X    <!--=======================================================-->
X    <PTYPE name="STRING"
X        pattern=".+"
X        help="String"/>
X    <!--=======================================================-->
X    <PTYPE name="SUBCOMMAND"
X        pattern="[^\]+"
X        help="String"/>
X    <!--=======================================================-->
X    <PTYPE name="BOOL"
X        method="select"
X        pattern="true(1) false(0)"
X        help="Boolean choice"/>
X    <!--=======================================================-->
X    <PTYPE name="PROTO"
X        method="select"
X        pattern="ip(ip) ipencap(ipencap) icmp(icmp) igmp(igmp) tcp(tcp) udp(udp)"
X        help="Protocol choice"/>
X    <!--=======================================================-->
X    <PTYPE name="SERVICE"
X        pattern="((ftp)|(telnet)|(sntp)|(smtp)|(http)|([0-9]+))"
X        help="Port"/>
X    <!--=======================================================-->
X    <PTYPE name="PORT_MASK_ANY"
X        pattern="^(([0-9]+(/0x[0-9a-f]+)?)|(any))$"
X        help="Port[/mask]" />
X    <!--=======================================================-->
X    <PTYPE name="SEQ"
X        pattern="^[0-9]*[1-9][0-9]*"
X        help="Entry number"/>
X    <!--=======================================================-->
X    <PTYPE name="CPU_CORE"
X        pattern="(1[0-9]|[0-9]|[0-9]-([0-9]|1[0-9]))" 
X        help="core"/>
X        <!-- 19 core limits -->
X    <!--=======================================================-->
X
X</CLISH_MODULE>
