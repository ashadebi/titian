<?xml version="1.0" encoding="UTF-8"?>
<CLISH_MODULE xmlns="http://clish.sourceforge.net/XMLSchema"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
 xsi:schemaLocation="http://clish.sourceforge.net/XMLSchema
                     http://clish.sourceforge.net/XMLSchema/clish.xsd">
    <!--=======================================================-->
    <!-- RIP / RIPng (BIRD `protocol rip` / `protocol rip ng`). -->
    <!--   - Masuk dari `router bird` -> `rip` (IPv4, RIPv1/v2) -->
    <!--     atau `ripng` (IPv6) — SATU view dipakai berdua     -->
    <!--     (viewid rip_inst=rip|ripng): infinity, ecmp (+     -->
    <!--     limit), channel import/export (+ export-rip-metric -->
    <!--     / export-rip-tag), `interface <PATTERN>` (masuk ke -->
    <!--     interface view).                                   -->
    <!--   - Interface view: metric, mode, passive, address,   -->
    <!--     port, version (RIP saja), version-only (RIP saja, -->
    <!--     B15), split-horizon, poison-reverse, demand-       -->
    <!--     circuit, check-zero, timer update/timeout/garbage, -->
    <!--     ecmp-weight, ttl-security, tx-class/tx-dscp,        -->
    <!--     rx-buffer, tx-length, check-link, authentication,  -->
    <!--     `password <TEXT>` (masuk ke password view: id +    -->
    <!--     rotasi berjadwal + algorithm).                      -->
    <!--   - Intent di /etc/titian/rip.conf; generate via       -->
    <!--     titian-rip.sh (menulis section bird.d/rip.conf     -->
    <!--     lalu titian-bird.sh generate rip). Section ditulis -->
    <!--     ulang UTUH tiap apply.                             -->
    <!--   - Service BIRD naik/berubah saat `commit`            -->
    <!--     (apply_rip di titian-commit.sh, sesudah            -->
    <!--     apply_static, sebelum apply_bgp).                  -->
    <!--   - Sintaks BIRD 2.16.1 (docs §6.15): protocol rip     -->
    <!--     [ng] { infinity; ecmp [limit]; ipv4|ipv6 { import; -->
    <!--     export; }; interface "<pat>" { metric; mode;       -->
    <!--     passive; address; port; version; split horizon;    -->
    <!--     poison reverse; demand circuit; check zero; update -->
    <!--     / timeout / garbage time; ecmp weight; ttl         -->
    <!--     security; tx class|dscp; rx buffer; tx length;     -->
    <!--     check link; authentication; password { id;         -->
    <!--     generate/accept/from/to; algorithm }; }; }.        -->
    <!--     Default BIRD: infinity 16; metric 1; mode          -->
    <!--     multicast (v2) / broadcast (v1) / selalu multicast -->
    <!--     (RIPng); port 520/521; version 2; split horizon    -->
    <!--     yes; poison reverse yes; update 30 / timeout 180 / -->
    <!--     garbage 120; ecmp weight 1; ttl security yes       -->
    <!--     (RIPng) / no (RIP); rx/tx 532 (RIP) / MTU (RIPng); -->
    <!--     check link yes; auth none (algo kunci default      -->
    <!--     keyed-MD5); rip_metric 1 / rip_tag 0 untuk route   -->
    <!--     non-RIP yang diekspor.                             -->
    <!--   - TIDAK diimplementasi (lihat titian-rip.sh):        -->
    <!--     `tx priority` (Linux-specific). `version only`    -->
    <!--     TERIMPLEMENTASI batch 5 (B15): `version-only`      -->
    <!--     (bird -p live rc=0 untuk yes/on).                  -->

<VIEW name="configure-bird-rip-view"
    prompt="${SYSTEM_NAME}(config-bird-${rip_inst})# "
    depth="2">
    <NAMESPACE ref="configure-bird-view"
        help="false"
        completion="true"/>
    <COMMAND name="exit"
        help="Back to BIRD mode" help-id="Back to bird mode"
        lock="false">
        <ACTION builtin="clish_nested_up"/>
    </COMMAND>
    <COMMAND name="end"
        help="Back to enable-view"
        view="enable-view"/>
    <HOTKEY key="^Z" cmd="exit"/>

    <COMMAND name="no"
        help="Negate a command or set its defaults"/>

    <COMMAND name="import"
        help="Import channel (all|none|filter NAME)" help-id="Channel import (all|none|filter NAME)"/>

    <COMMAND name="export"
        help="Export channel (all|none|filter NAME)" help-id="Channel export (all|none|filter NAME)"/>

    <COMMAND name="infinity"
        help="RIP infinity distance (BIRD default: 16)" help-id="Jarak infinity RIP (default BIRD 16)">
        <PARAM name="Value"
            help="Infinity (1..255, default 16)"
            ptype="UINT"/>
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh infinity-set "${rip_inst}" "${Value}"
        </ACTION>
    </COMMAND>
    <COMMAND name="no infinity"
        help="Back to the BIRD default infinity (16)" help-id="Kembali ke infinity default BIRD (16)">
        <CONFIG operation="unset" pattern="^infinity"/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh infinity-del "${rip_inst}"
        </ACTION>
    </COMMAND>

    <COMMAND name="ecmp"
        help="Allow route ECMP (BIRD default: enabled if Kernel supports)" help-id="Izinkan route ECMP (default BIRD: enabled bila Kernel mendukung)">
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh ecmp-set "${rip_inst}" on
        </ACTION>
    </COMMAND>
    <COMMAND name="no ecmp"
        help="Disable ECMP" help-id="Matikan ECMP">
        <CONFIG operation="unset" pattern="^ecmp"/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh ecmp-del "${rip_inst}"
        </ACTION>
    </COMMAND>

    <COMMAND name="ecmp-limit"
        help="Max nexthop ECMP limit (requires ecmp on)" help-id="Batas maks nexthop ECMP (butuh ecmp on)">
        <PARAM name="Value"
            help="Limit (1..256, BIRD default 16)" help-id="Limit (1..256, default BIRD 16)"
            ptype="UINT"/>
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh ecmp-limit-set "${rip_inst}" "${Value}"
        </ACTION>
    </COMMAND>
    <COMMAND name="no ecmp-limit"
        help="Back to the BIRD default ecmp-limit (16)" help-id="Kembali ke ecmp-limit default BIRD (16)">
        <CONFIG operation="unset" pattern="^ecmp-limit"/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh ecmp-limit-del "${rip_inst}"
        </ACTION>
    </COMMAND>

    <COMMAND name="preference"
        help="Preference route channel (best-route selection inter-protocol)" help-id="Preference route channel (best-route selection antar-protokol)">
        <PARAM name="Value"
            help="Preference (0..65535)"
            ptype="UINT"/>
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh preference-set "${rip_inst}" "${Value}"
        </ACTION>
    </COMMAND>
    <COMMAND name="no preference"
        help="Back to the BIRD default preference (depending on protocol)" help-id="Kembali ke preference default BIRD (tergantung protokol)">
        <CONFIG operation="unset" pattern="^preference"/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh preference-del "${rip_inst}"
        </ACTION>
    </COMMAND>

    <COMMAND name="import-keep-filtered"
        help="Also save routes rejected by the import filter (hidden, can be seen via show route filtered)" help-id="Simpan juga route yang ditolak import filter (hidden, bisa dilihat show route filtered)">
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh import-keep-filtered-set "${rip_inst}" on
        </ACTION>
    </COMMAND>
    <COMMAND name="no import-keep-filtered"
        help="">
        <CONFIG operation="unset" pattern="^import-keep-filtered"/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh import-keep-filtered-del "${rip_inst}"
        </ACTION>
    </COMMAND>
    <COMMAND name="import-limit"
        help="Route count import channel limit (Chapter 3.5-8; BIRD default without limit)" help-id="Batas jumlah route import channel (Bab 3.5-8; default BIRD tanpa limit)">
        <PARAM name="Value"
            help="Route count max (0..4294967295) or off" help-id="Jumlah route maks (0..4294967295) atau off"
            ptype="STRING"/>
        <PARAM name="Action"
            help="Action if limit exceeded: warn|block|restart|disable (optional)" help-id="Aksi bila limit terlampaui: warn|block|restart|disable (opsional)"
            ptype="STRING"
            optional="true"/>
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh limit-set "${rip_inst}" import "${Value}" "${Action}"
        </ACTION>
    </COMMAND>
    <COMMAND name="no import-limit"
        help="Delete import-limit (and its action)" help-id="Hapus import-limit (dan action-nya)">
        <CONFIG operation="unset" pattern="^import-limit"/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh limit-del "${rip_inst}" import
        </ACTION>
    </COMMAND>

    <COMMAND name="receive-limit"
        help="Route count receive channel limit (Chapter 3.5-9; BIRD default without limit)" help-id="Batas jumlah route receive channel (Bab 3.5-9; default BIRD tanpa limit)">
        <PARAM name="Value"
            help="Route count max (0..4294967295) or off" help-id="Jumlah route maks (0..4294967295) atau off"
            ptype="STRING"/>
        <PARAM name="Action"
            help="Action if limit exceeded: warn|block|restart|disable (optional)" help-id="Aksi bila limit terlampaui: warn|block|restart|disable (opsional)"
            ptype="STRING"
            optional="true"/>
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh limit-set "${rip_inst}" receive "${Value}" "${Action}"
        </ACTION>
    </COMMAND>
    <COMMAND name="no receive-limit"
        help="Delete receive-limit (and its action)" help-id="Hapus receive-limit (dan action-nya)">
        <CONFIG operation="unset" pattern="^receive-limit"/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh limit-del "${rip_inst}" receive
        </ACTION>
    </COMMAND>

    <COMMAND name="export-limit"
        help="Route count export channel limit (Chapter 3.5-10; BIRD default without limit)" help-id="Batas jumlah route export channel (Bab 3.5-10; default BIRD tanpa limit)">
        <PARAM name="Value"
            help="Route count max (0..4294967295) or off" help-id="Jumlah route maks (0..4294967295) atau off"
            ptype="STRING"/>
        <PARAM name="Action"
            help="Action if limit exceeded: warn|block|restart|disable (optional)" help-id="Aksi bila limit terlampaui: warn|block|restart|disable (opsional)"
            ptype="STRING"
            optional="true"/>
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh limit-set "${rip_inst}" export "${Value}" "${Action}"
        </ACTION>
    </COMMAND>
    <COMMAND name="no export-limit"
        help="Delete export-limit (and its action)" help-id="Hapus export-limit (dan action-nya)">
        <CONFIG operation="unset" pattern="^export-limit"/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh limit-del "${rip_inst}" export
        </ACTION>
    </COMMAND>


    <COMMAND name="debug"
        help="Debug protocol (all|off|states,routes,filters,interfaces,events,packets)" help-id="Debug protokol (all|off|states,routes,filters,interfaces,events,packets)">
        <PARAM name="Value"
            help="Debug class (all|off|comma-separated list)" help-id="Kelas debug (all|off|daftar koma)"
            ptype="STRING"/>
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh debug-set "${rip_inst}" "${Value}"
        </ACTION>
    </COMMAND>
    <COMMAND name="no debug"
        help="Disable debug protocol (BIRD default off)" help-id="Matikan debug protokol (default BIRD off)">
        <CONFIG operation="unset" pattern="^debug"/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh debug-del "${rip_inst}"
        </ACTION>
    </COMMAND>

    <COMMAND name="mrtdump"
        help="MRT dump protocol (all|off|states|messages)" help-id="Dump MRT protokol (all|off|states|messages)">
        <PARAM name="Value"
            help="Mrtdump class (all|off|states|messages)" help-id="Kelas mrtdump (all|off|states|messages)"
            ptype="STRING"/>
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh mrtdump-set "${rip_inst}" "${Value}"
        </ACTION>
    </COMMAND>
    <COMMAND name="no mrtdump"
        help="Disable mrtdump protocol (BIRD default off)" help-id="Matikan mrtdump protokol (default BIRD off)">
        <CONFIG operation="unset" pattern="^mrtdump"/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh mrtdump-del "${rip_inst}"
        </ACTION>
    </COMMAND>

    <COMMAND name="router-id"
        help="This Router ID specific protocol (default: router ID global BIRD)" help-id="Router id khusus protokol ini (default: router id global BIRD)">
        <PARAM name="IP"
            help="Router ID IPv4 address" help-id="Alamat IPv4 router id"
            ptype="IP_ADDR"/>
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh router-id-set "${rip_inst}" "${IP}"
        </ACTION>
    </COMMAND>
    <COMMAND name="no router-id"
        help="Delete router ID protocol (back to router ID global BIRD)" help-id="Hapus router id protokol (kembali ke router id global BIRD)">
        <CONFIG operation="unset" pattern="^router-id"/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh router-id-del "${rip_inst}"
        </ACTION>
    </COMMAND>

    <COMMAND name="description"
        help="Label/this description protocol" help-id="Label/deskripsi protokol ini">
        <PARAM name="Text"
            help="Description text" help-id="Teks deskripsi"
            ptype="STRING"/>
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh description-set "${rip_inst}" "${Text}"
        </ACTION>
    </COMMAND>
    <COMMAND name="no description"
        help="Delete description protocol" help-id="Hapus deskripsi protokol">
        <CONFIG operation="unset" pattern="^description"/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh description-del "${rip_inst}"
        </ACTION>
    </COMMAND>

    <COMMAND name="disabled"
        help="Disable this protocol (not started when configure)" help-id="Nonaktifkan protokol ini (tidak di-start saat configure)">
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh disabled-set "${rip_inst}" on
        </ACTION>
    </COMMAND>
    <COMMAND name="no disabled"
        help="This Re-enable protocol (BIRD default)" help-id="Aktifkan kembali protokol ini (default BIRD)">
        <CONFIG operation="unset" pattern="^disabled"/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh disabled-del "${rip_inst}"
        </ACTION>
    </COMMAND>

    <COMMAND name="from"
        help="Take options from template RIP (template-add RIP &lt;NAME&gt; first in router BIRD)" help-id="Ambil opsi dari template RIP (template-add rip &lt;NAMA&gt; dulu di router bird)">
        <PARAM name="Name"
            help="RIP template name" help-id="Nama template RIP"
            ptype="STRING"/>
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh from-set "${rip_inst}" "${Name}"
        </ACTION>
    </COMMAND>
    <COMMAND name="no from"
        help="Remove the RIP template (options are written explicitly)" help-id="Lepas template RIP (opsi ditulis eksplisit)">
        <CONFIG operation="unset" pattern="^from"/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh from-del "${rip_inst}"
        </ACTION>
    </COMMAND>

    <COMMAND name="import all"
        help="Channel: import all routes (default)" help-id="Channel: import semua route (default)">
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh chan-set "${rip_inst}" import all
        </ACTION>
    </COMMAND>
    <COMMAND name="import none"
        help="Channel: do not import route" help-id="Channel: jangan import route">
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh chan-set "${rip_inst}" import none
        </ACTION>
    </COMMAND>
    <COMMAND name="import filter"
        help="Channel: import via filter named" help-id="Channel: import via filter bernama">
        <PARAM name="Name"
            help="BIRD filter name (e.g. F-RIP-IN)" help-id="Nama filter BIRD (mis. F-RIP-IN)"
            ptype="STRING"/>
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh chan-set "${rip_inst}" import filter "${Name}"
        </ACTION>
    </COMMAND>
    <COMMAND name="import where"
        help="Channel: import via filter inline (concise-form expression, e.g. net~10.0.0.0/8)" help-id="Channel: import via filter inline (ekspresi bentuk ringkas, mis. net~10.0.0.0/8)">
        <PARAM name="Cond"
            help="Concise-form filter expression (e.g. net~10.0.0.0/8)" help-id="Ekspresi filter bentuk ringkas (mis. net~10.0.0.0/8)"
            ptype="STRING"/>
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh chan-set "${rip_inst}" import where "${Cond}"
        </ACTION>
    </COMMAND>

    <COMMAND name="export all"
        help="Channel: export all routes (default)" help-id="Channel: export semua route (default)">
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh chan-set "${rip_inst}" export all
        </ACTION>
    </COMMAND>
    <COMMAND name="export none"
        help="Channel: do not export route" help-id="Channel: jangan export route">
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh chan-set "${rip_inst}" export none
        </ACTION>
    </COMMAND>
    <COMMAND name="export filter"
        help="Channel: export via filter named" help-id="Channel: export via filter bernama">
        <PARAM name="Name"
            help="BIRD filter name (e.g. F-RIP-OUT)" help-id="Nama filter BIRD (mis. F-RIP-OUT)"
            ptype="STRING"/>
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh chan-set "${rip_inst}" export filter "${Name}"
        </ACTION>
    </COMMAND>
    <COMMAND name="export where"
        help="Channel: export via filter inline (concise-form expression, e.g. net~10.0.0.0/8)" help-id="Channel: export via filter inline (ekspresi bentuk ringkas, mis. net~10.0.0.0/8)">
        <PARAM name="Cond"
            help="Concise-form filter expression (e.g. net~10.0.0.0/8)" help-id="Ekspresi filter bentuk ringkas (mis. net~10.0.0.0/8)"
            ptype="STRING"/>
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh chan-set "${rip_inst}" export where "${Cond}"
        </ACTION>
    </COMMAND>

    <COMMAND name="export-rip-metric"
        help="rip_metric for non-RIP routes exported to RIP (only if export all)" help-id="rip_metric route non-RIP yang diekspor ke RIP (hanya bila export all)">
        <PARAM name="Value"
            help="Metric (0..255, BIRD default 1)" help-id="Metric (0..255, default BIRD 1)"
            ptype="UINT"/>
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh export-rip-metric-set "${rip_inst}" "${Value}"
        </ACTION>
    </COMMAND>
    <COMMAND name="no export-rip-metric"
        help="Back to the BIRD default rip_metric (1)" help-id="Kembali ke rip_metric default BIRD (1)">
        <CONFIG operation="unset" pattern="^export-rip-metric"/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh export-rip-metric-del "${rip_inst}"
        </ACTION>
    </COMMAND>

    <COMMAND name="export-rip-tag"
        help="rip_tag for non-RIP routes exported to RIP (only if export all)" help-id="rip_tag route non-RIP yang diekspor ke RIP (hanya bila export all)">
        <PARAM name="Value"
            help="Tag (0..65535, BIRD default 0)" help-id="Tag (0..65535, default BIRD 0)"
            ptype="UINT"/>
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh export-rip-tag-set "${rip_inst}" "${Value}"
        </ACTION>
    </COMMAND>
    <COMMAND name="no export-rip-tag"
        help="Back to the BIRD default rip_tag (0)" help-id="Kembali ke rip_tag default BIRD (0)">
        <CONFIG operation="unset" pattern="^export-rip-tag"/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh export-rip-tag-del "${rip_inst}"
        </ACTION>
    </COMMAND>

    <COMMAND name="interface"
        help="RIP options per interface (enter interface view)" help-id="Opsi RIP per interface (masuk ke interface view)"
        view="configure-bird-rip-interface-view"
        viewid="rip_if_ctx=${rip_inst}:${Pattern}"
        ptype="SUBCOMMAND"
        mode="subcommand">
        <PARAM name="Pattern"
            help="BIRD interface pattern (e.g. ge*, bridge0)" help-id="Pola interface BIRD (mis. ge*, bridge0)"
            ptype="STRING"/>
        <CONFIG priority="0x1560" pattern="^${__line}$"/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh interface-add "${rip_inst}:${Pattern}"
        </ACTION>
    </COMMAND>
    <COMMAND name="no interface"
        help="Delete all this options RIP interface" help-id="Hapus semua opsi RIP interface ini">
        <PARAM name="Pattern"
            help="BIRD interface pattern" help-id="Pola interface BIRD"
            ptype="STRING"/>
        <CONFIG operation="unset" pattern="^interface ${Pattern}"/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh interface-del "${rip_inst}:${Pattern}"
        </ACTION>
    </COMMAND>
</VIEW>

<VIEW name="configure-bird-rip-interface-view"
    prompt="${SYSTEM_NAME}(config-bird-rip-if-${rip_if_ctx})# "
    depth="3">
    <NAMESPACE ref="configure-bird-rip-view"
        help="false"
        completion="true"/>
    <COMMAND name="exit"
        help="Back to RIP mode"
        lock="false">
        <ACTION builtin="clish_nested_up"/>
    </COMMAND>
    <HOTKEY key="^Z" cmd="exit"/>

    <COMMAND name="no"
        help="Negate a command or set its defaults"/>

    <COMMAND name="metric"
        help="Metric added to routes received via this interface" help-id="Metric ditambahkan ke route yang diterima via interface ini">
        <PARAM name="Value"
            help="Metric (1..255, BIRD default 1)" help-id="Metric (1..255, default BIRD 1)"
            ptype="UINT"/>
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh interface-set "${rip_if_ctx}" metric "${Value}"
        </ACTION>
    </COMMAND>
    <COMMAND name="no metric"
        help="Back to the BIRD default metric (1)" help-id="Kembali ke metric default BIRD (1)">
        <CONFIG operation="unset" pattern="^metric"/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh interface-unset "${rip_if_ctx}" metric
        </ACTION>
    </COMMAND>

    <COMMAND name="mode"
        help="Update sending mode (RIPng always multicast)" help-id="Mode pengiriman update (RIPng selalu multicast)">
        <PARAM name="Value"
            help="multicast|broadcast"
            ptype="STRING"/>
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh interface-set "${rip_if_ctx}" mode "${Value}"
        </ACTION>
    </COMMAND>
    <COMMAND name="no mode"
        help="Back to the BIRD default mode" help-id="Kembali ke mode default BIRD">
        <CONFIG operation="unset" pattern="^mode"/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh interface-unset "${rip_if_ctx}" mode
        </ACTION>
    </COMMAND>

    <COMMAND name="passive"
        help="Passive interface: accepts updates, does not send messages" help-id="Interface pasif: terima update, tidak kirim pesan">
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh interface-set "${rip_if_ctx}" passive on
        </ACTION>
    </COMMAND>
    <COMMAND name="no passive"
        help="Active interface (BIRD default)" help-id="Interface aktif (default BIRD)">
        <CONFIG operation="unset" pattern="^passive"/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh interface-set "${rip_if_ctx}" passive off
        </ACTION>
    </COMMAND>

    <COMMAND name="address"
        help="Destination address multicast/broadcast (default 224.0.0.9 / ff02::9)" help-id="Alamat tujuan multicast/broadcast (default 224.0.0.9 / ff02::9)">
        <PARAM name="IP"
            help="IP address (same family as the instance)" help-id="Alamat IP (keluarga sama dengan instance)"
            ptype="STRING"/>
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh interface-set "${rip_if_ctx}" address "${IP}"
        </ACTION>
    </COMMAND>
    <COMMAND name="no address"
        help="Back to the BIRD default address" help-id="Kembali ke address default BIRD">
        <CONFIG operation="unset" pattern="^address"/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh interface-unset "${rip_if_ctx}" address
        </ACTION>
    </COMMAND>

    <COMMAND name="port"
        help="Port UDP RIP (default 520 / 521 RIPng)">
        <PARAM name="Value"
            help="Port (1..65535)"
            ptype="UINT"/>
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh interface-set "${rip_if_ctx}" port "${Value}"
        </ACTION>
    </COMMAND>
    <COMMAND name="no port"
        help="Back to the BIRD default port" help-id="Kembali ke port default BIRD">
        <CONFIG operation="unset" pattern="^port"/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh interface-unset "${rip_if_ctx}" port
        </ACTION>
    </COMMAND>

    <COMMAND name="version"
        help="RIP version per interface (RIP IPv4 only; RIPng does not support it)" help-id="Versi RIP per interface (RIP IPv4 saja; RIPng tidak mendukung)">
        <PARAM name="Value"
            help="1|2 (BIRD default 2)" help-id="1|2 (default BIRD 2)"
            ptype="UINT"/>
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh interface-set "${rip_if_ctx}" version "${Value}"
        </ACTION>
    </COMMAND>
    <COMMAND name="no version"
        help="Back to the BIRD default version (2)" help-id="Kembali ke version default BIRD (2)">
        <CONFIG operation="unset" pattern="^version"/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh interface-unset "${rip_if_ctx}" version
        </ACTION>
    </COMMAND>

    <COMMAND name="version-only"
        help="Only accept RIP packets with the configured version (BIRD default: no; RIP IPv4 only)" help-id="Hanya terima paket RIP dengan versi yang dikonfigurasi (default BIRD no; RIP IPv4 saja)">
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh interface-set "${rip_if_ctx}" version-only on
        </ACTION>
    </COMMAND>
    <COMMAND name="no version-only"
        help="Accept all RIP versions (BIRD default)" help-id="Terima semua versi RIP (default BIRD)">
        <CONFIG operation="unset" pattern="^version-only"/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh interface-set "${rip_if_ctx}" version-only off
        </ACTION>
    </COMMAND>

    <COMMAND name="split-horizon"
        help="Do not advertise routes back to their originating interface (BIRD default: yes)" help-id="Jangan sebarkan route kembali ke interface asalnya (default BIRD yes)">
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh interface-set "${rip_if_ctx}" split-horizon on
        </ACTION>
    </COMMAND>
    <COMMAND name="no split-horizon"
        help="Disable split horizon" help-id="Matikan split horizon">
        <CONFIG operation="unset" pattern="^split-horizon"/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh interface-set "${rip_if_ctx}" split-horizon off
        </ACTION>
    </COMMAND>

    <COMMAND name="poison-reverse"
        help="Advertise back with metric infinity (BIRD default yes)" help-id="Sebarkan balik dengan metric infinity (default BIRD yes)">
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh interface-set "${rip_if_ctx}" poison-reverse on
        </ACTION>
    </COMMAND>
    <COMMAND name="no poison-reverse"
        help="Disable poison reverse" help-id="Matikan poison reverse">
        <CONFIG operation="unset" pattern="^poison-reverse"/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh interface-set "${rip_if_ctx}" poison-reverse off
        </ACTION>
    </COMMAND>

    <COMMAND name="demand-circuit"
        help="Triggered RIP RFC 2091: without periodic updates (must active in both sides)" help-id="Triggered RIP RFC 2091: tanpa update periodik (wajib aktif di kedua sisi)">
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh interface-set "${rip_if_ctx}" demand-circuit on
        </ACTION>
    </COMMAND>
    <COMMAND name="no demand-circuit"
        help="Disable demand circuit (BIRD default)" help-id="Matikan demand circuit (default BIRD)">
        <CONFIG operation="unset" pattern="^demand-circuit"/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh interface-set "${rip_if_ctx}" demand-circuit off
        </ACTION>
    </COMMAND>

    <COMMAND name="check-zero"
        help="Discard RIPv1 packets with non-zero reserved fields (BIRD default: yes)" help-id="Buang paket RIPv1 dengan field reserved non-zero (default BIRD yes)">
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh interface-set "${rip_if_ctx}" check-zero on
        </ACTION>
    </COMMAND>
    <COMMAND name="no check-zero"
        help="Disable check zero" help-id="Matikan check zero">
        <CONFIG operation="unset" pattern="^check-zero"/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh interface-set "${rip_if_ctx}" check-zero off
        </ACTION>
    </COMMAND>

    <COMMAND name="update-time"
        help="Periodic update interval (BIRD default: 30 seconds)" help-id="Interval update periodik (default BIRD 30 detik)">
        <PARAM name="Value"
            help="Seconds (1..86400)" help-id="Detik (1..86400)"
            ptype="UINT"/>
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh interface-set "${rip_if_ctx}" update-time "${Value}"
        </ACTION>
    </COMMAND>
    <COMMAND name="no update-time"
        help="Back to the BIRD default update time (30)" help-id="Kembali ke update time default BIRD (30)">
        <CONFIG operation="unset" pattern="^update-time"/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh interface-unset "${rip_if_ctx}" update-time
        </ACTION>
    </COMMAND>

    <COMMAND name="timeout-time"
        help="Routes expire after this long without announcement (BIRD default: 180 seconds)" help-id="Route kedaluwarsa sesudah selama ini tanpa pengumuman (default BIRD 180 detik)">
        <PARAM name="Value"
            help="Seconds (1..86400)" help-id="Detik (1..86400)"
            ptype="UINT"/>
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh interface-set "${rip_if_ctx}" timeout-time "${Value}"
        </ACTION>
    </COMMAND>
    <COMMAND name="no timeout-time"
        help="Back to the BIRD default timeout time (180)" help-id="Kembali ke timeout time default BIRD (180)">
        <CONFIG operation="unset" pattern="^timeout-time"/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh interface-unset "${rip_if_ctx}" timeout-time
        </ACTION>
    </COMMAND>

    <COMMAND name="garbage-time"
        help="Interval between route expiry and entry deletion (BIRD default: 120 seconds)" help-id="Interval antara route kedaluwarsa dan penghapusan entry (default BIRD 120 detik)">
        <PARAM name="Value"
            help="Seconds (1..86400)" help-id="Detik (1..86400)"
            ptype="UINT"/>
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh interface-set "${rip_if_ctx}" garbage-time "${Value}"
        </ACTION>
    </COMMAND>
    <COMMAND name="no garbage-time"
        help="Back to the BIRD default garbage time (120)" help-id="Kembali ke garbage time default BIRD (120)">
        <CONFIG operation="unset" pattern="^garbage-time"/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh interface-unset "${rip_if_ctx}" garbage-time
        </ACTION>
    </COMMAND>

    <COMMAND name="ecmp-weight"
        help="Relative nexthop weight via this interface for route ECMP" help-id="Bobot relatif nexthop via interface ini untuk route ECMP">
        <PARAM name="Value"
            help="Weight (1..256, BIRD default 1)" help-id="Weight (1..256, default BIRD 1)"
            ptype="UINT"/>
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh interface-set "${rip_if_ctx}" ecmp-weight "${Value}"
        </ACTION>
    </COMMAND>
    <COMMAND name="no ecmp-weight"
        help="Back to the BIRD default ecmp weight (1)" help-id="Kembali ke ecmp weight default BIRD (1)">
        <CONFIG operation="unset" pattern="^ecmp-weight"/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh interface-unset "${rip_if_ctx}" ecmp-weight
        </ACTION>
    </COMMAND>

    <COMMAND name="ttl-security"
        help="GTSM: send TTL 255 &amp; drop packets with TTL &lt;255 (default: yes for RIPng / no for RIP)" help-id="GTSM: kirim TTL 255 &amp; drop paket TTL &lt;255 (default yes RIPng / no RIP)">
        <PARAM name="Value"
            help="on|off|tx-only"
            ptype="STRING"/>
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh interface-set "${rip_if_ctx}" ttl-security "${Value}"
        </ACTION>
    </COMMAND>
    <COMMAND name="no ttl-security"
        help="Back to the BIRD default TTL-security" help-id="Kembali ke ttl-security default BIRD">
        <CONFIG operation="unset" pattern="^ttl-security"/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh interface-unset "${rip_if_ctx}" ttl-security
        </ACTION>
    </COMMAND>

    <COMMAND name="tx-class"
        help="Type-of-Service of outgoing RIP packets" help-id="Type-of-Service paket RIP keluar">
        <PARAM name="Value"
            help="ToS (0..255)"
            ptype="UINT"/>
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh interface-set "${rip_if_ctx}" tx-class "${Value}"
        </ACTION>
    </COMMAND>
    <COMMAND name="no tx-class"
        help="Delete this tx-class interface" help-id="Hapus tx-class interface ini">
        <CONFIG operation="unset" pattern="^tx-class"/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh interface-unset "${rip_if_ctx}" tx-class
        </ACTION>
    </COMMAND>

    <COMMAND name="tx-dscp"
        help="DSCP of outgoing RIP packets" help-id="DSCP paket RIP keluar">
        <PARAM name="Value"
            help="DSCP (0..63)"
            ptype="UINT"/>
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh interface-set "${rip_if_ctx}" tx-dscp "${Value}"
        </ACTION>
    </COMMAND>
    <COMMAND name="no tx-dscp"
        help="Delete this tx-DSCP interface" help-id="Hapus tx-dscp interface ini">
        <CONFIG operation="unset" pattern="^tx-dscp"/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh interface-unset "${rip_if_ctx}" tx-dscp
        </ACTION>
    </COMMAND>

    <COMMAND name="rx-buffer"
        help="Packet processing buffer size (default 532 RIP / MTU RIPng)" help-id="Ukuran buffer pemrosesan paket (default 532 RIP / MTU RIPng)">
        <PARAM name="Value"
            help="Byte (1..65535)"
            ptype="UINT"/>
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh interface-set "${rip_if_ctx}" rx-buffer "${Value}"
        </ACTION>
    </COMMAND>
    <COMMAND name="no rx-buffer"
        help="Back to the BIRD default rx-buffer" help-id="Kembali ke rx-buffer default BIRD">
        <CONFIG operation="unset" pattern="^rx-buffer"/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh interface-unset "${rip_if_ctx}" rx-buffer
        </ACTION>
    </COMMAND>

    <COMMAND name="tx-length"
        help="Maximum length of RIP packets created (default 532 RIP / MTU RIPng)" help-id="Panjang maks paket RIP yang dibuat (default 532 RIP / MTU RIPng)">
        <PARAM name="Value"
            help="Byte (1..65535)"
            ptype="UINT"/>
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh interface-set "${rip_if_ctx}" tx-length "${Value}"
        </ACTION>
    </COMMAND>
    <COMMAND name="no tx-length"
        help="Back to the BIRD default tx-length" help-id="Kembali ke tx-length default BIRD">
        <CONFIG operation="unset" pattern="^tx-length"/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh interface-unset "${rip_if_ctx}" tx-length
        </ACTION>
    </COMMAND>

    <COMMAND name="check-link"
        help="Perhatikan hardware link state (BIRD default yes)" help-id="Perhatikan hardware link state (default BIRD yes)">
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh interface-set "${rip_if_ctx}" check-link on
        </ACTION>
    </COMMAND>
    <COMMAND name="no check-link"
        help="Ignore hardware link state" help-id="Abaikan hardware link state">
        <CONFIG operation="unset" pattern="^check-link"/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh interface-set "${rip_if_ctx}" check-link off
        </ACTION>
    </COMMAND>

    <COMMAND name="authentication"
        help="RIP packet authentication method (default none; default key algorithm keyed-MD5)" help-id="Metode autentikasi paket RIP (default none; algo kunci default keyed-MD5)">
        <PARAM name="Value"
            help="none|plaintext|cryptographic"
            ptype="STRING"/>
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh interface-set "${rip_if_ctx}" authentication "${Value}"
        </ACTION>
    </COMMAND>
    <COMMAND name="no authentication"
        help="Back to authentication none (BIRD default)" help-id="Kembali ke authentication none (default BIRD)">
        <CONFIG operation="unset" pattern="^authentication"/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh interface-unset "${rip_if_ctx}" authentication
        </ACTION>
    </COMMAND>

    <COMMAND name="password"
        help="RIP authentication key (enter password view: ID + rotation + algorithm)" help-id="Kunci autentikasi RIP (masuk ke password view: id + rotasi + algorithm)"
        view="configure-bird-rip-password-view"
        viewid="rip_pw_ctx=${rip_if_ctx}:${Text}"
        ptype="SUBCOMMAND"
        mode="subcommand">
        <PARAM name="Text"
            help="Password (without space, without &quot; and without backslash)" help-id="Password (tanpa spasi, tanpa &quot; dan tanpa backslash)"
            ptype="STRING"/>
        <CONFIG priority="0x1561" pattern="^${__line}$"/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh password-add "${rip_if_ctx}:${Text}"
        </ACTION>
    </COMMAND>
    <COMMAND name="no password"
        help="Delete this key (+ all its sub-options)" help-id="Hapus kunci ini (+ semua sub-opsinya)">
        <PARAM name="Text"
            help="Deleted password" help-id="Password yang dihapus"
            ptype="STRING"/>
        <CONFIG operation="unset" pattern="^password ${Text}"/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh password-del "${rip_if_ctx}:${Text}"
        </ACTION>
    </COMMAND>
</VIEW>

<VIEW name="configure-bird-rip-password-view"
    prompt="${SYSTEM_NAME}(config-bird-rip-pw)# "
    depth="4">
    <NAMESPACE ref="configure-bird-rip-interface-view"
        help="false"
        completion="true"/>
    <COMMAND name="exit"
        help="Back to interface mode"
        lock="false">
        <ACTION builtin="clish_nested_up"/>
    </COMMAND>
    <HOTKEY key="^Z" cmd="exit"/>

    <COMMAND name="no"
        help="Negate a command or set its defaults"/>

    <COMMAND name="id"
        help="ID key (for rotation)" help-id="ID kunci (untuk rotasi)">
        <PARAM name="Value"
            help="ID (0..4294967295)"
            ptype="UINT"/>
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh password-set "${rip_pw_ctx}" id "${Value}"
        </ACTION>
    </COMMAND>
    <COMMAND name="no id"
        help="Delete this ID key" help-id="Hapus id kunci ini">
        <CONFIG operation="unset" pattern="^id"/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh password-unset "${rip_pw_ctx}" id
        </ACTION>
    </COMMAND>

    <COMMAND name="generate-from"
        help="Key generation starts on this date" help-id="Kunci mulai di-generate pada tanggal ini">
        <PARAM name="Value"
            help="YYYY-MM-DD only (BIRD rejects date+time)" help-id="YYYY-MM-DD saja (BIRD menolak tanggal+jam)"
            ptype="STRING"/>
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh password-set "${rip_pw_ctx}" generate-from "${Value}"
        </ACTION>
    </COMMAND>
    <COMMAND name="no generate-from"
        help="Delete this generate-from key" help-id="Hapus generate-from kunci ini">
        <CONFIG operation="unset" pattern="^generate-from"/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh password-unset "${rip_pw_ctx}" generate-from
        </ACTION>
    </COMMAND>

    <COMMAND name="generate-to"
        help="Key generation stops on this date" help-id="Kunci berhenti di-generate pada tanggal ini">
        <PARAM name="Value"
            help="YYYY-MM-DD only (BIRD rejects date+time)" help-id="YYYY-MM-DD saja (BIRD menolak tanggal+jam)"
            ptype="STRING"/>
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh password-set "${rip_pw_ctx}" generate-to "${Value}"
        </ACTION>
    </COMMAND>
    <COMMAND name="no generate-to"
        help="Delete this generate-to key" help-id="Hapus generate-to kunci ini">
        <CONFIG operation="unset" pattern="^generate-to"/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh password-unset "${rip_pw_ctx}" generate-to
        </ACTION>
    </COMMAND>

    <COMMAND name="accept-from"
        help="Key acceptance starts on this date" help-id="Kunci mulai diterima pada tanggal ini">
        <PARAM name="Value"
            help="YYYY-MM-DD only (BIRD rejects date+time)" help-id="YYYY-MM-DD saja (BIRD menolak tanggal+jam)"
            ptype="STRING"/>
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh password-set "${rip_pw_ctx}" accept-from "${Value}"
        </ACTION>
    </COMMAND>
    <COMMAND name="no accept-from"
        help="Delete this accept-from key" help-id="Hapus accept-from kunci ini">
        <CONFIG operation="unset" pattern="^accept-from"/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh password-unset "${rip_pw_ctx}" accept-from
        </ACTION>
    </COMMAND>

    <COMMAND name="accept-to"
        help="Key acceptance stops on this date" help-id="Kunci berhenti diterima pada tanggal ini">
        <PARAM name="Value"
            help="YYYY-MM-DD only (BIRD rejects date+time)" help-id="YYYY-MM-DD saja (BIRD menolak tanggal+jam)"
            ptype="STRING"/>
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh password-set "${rip_pw_ctx}" accept-to "${Value}"
        </ACTION>
    </COMMAND>
    <COMMAND name="no accept-to"
        help="Delete this accept-to key" help-id="Hapus accept-to kunci ini">
        <CONFIG operation="unset" pattern="^accept-to"/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh password-unset "${rip_pw_ctx}" accept-to
        </ACTION>
    </COMMAND>

    <COMMAND name="from"
        help="Key valid from this date" help-id="Kunci berlaku mulai tanggal ini">
        <PARAM name="Value"
            help="YYYY-MM-DD only (BIRD rejects date+time)" help-id="YYYY-MM-DD saja (BIRD menolak tanggal+jam)"
            ptype="STRING"/>
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh password-set "${rip_pw_ctx}" from "${Value}"
        </ACTION>
    </COMMAND>
    <COMMAND name="no from"
        help="Delete this from key" help-id="Hapus from kunci ini">
        <CONFIG operation="unset" pattern="^from"/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh password-unset "${rip_pw_ctx}" from
        </ACTION>
    </COMMAND>

    <COMMAND name="to"
        help="Key valid until this date" help-id="Kunci berlaku sampai tanggal ini">
        <PARAM name="Value"
            help="YYYY-MM-DD only (BIRD rejects date+time)" help-id="YYYY-MM-DD saja (BIRD menolak tanggal+jam)"
            ptype="STRING"/>
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh password-set "${rip_pw_ctx}" to "${Value}"
        </ACTION>
    </COMMAND>
    <COMMAND name="no to"
        help="Delete this to key" help-id="Hapus to kunci ini">
        <CONFIG operation="unset" pattern="^to"/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh password-unset "${rip_pw_ctx}" to
        </ACTION>
    </COMMAND>

    <COMMAND name="algorithm"
        help="This Algorithm key (default keyed-MD5)" help-id="Algoritma kunci ini (default keyed-MD5)">
        <PARAM name="Value"
            help="keyed-MD5|keyed-sha1|hmac-sha1|hmac-sha256|hmac-sha384|hmac-sha512|blake2s128|blake2s256|blake2b256|blake2b512" help-id="keyed-md5|keyed-sha1|hmac-sha1|hmac-sha256|hmac-sha384|hmac-sha512|blake2s128|blake2s256|blake2b256|blake2b512"
            ptype="STRING"/>
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh password-set "${rip_pw_ctx}" algorithm "${Value}"
        </ACTION>
    </COMMAND>
    <COMMAND name="no algorithm"
        help="Back to algorithm default (keyed-MD5)" help-id="Kembali ke algorithm default (keyed-MD5)">
        <CONFIG operation="unset" pattern="^algorithm"/>
        <ACTION>
            ${RT_SBIN}/titian-rip.sh password-unset "${rip_pw_ctx}" algorithm
        </ACTION>
    </COMMAND>
</VIEW>

<VIEW name="enable-view">
    <COMMAND name="show rip"
        help="RIP/RIPng BIRD status (intent + section + BIRD protocol)" help-id="Status RIP/RIPng BIRD (intent + section + protokol BIRD)"
        lock="false"
        interrupt="true">
        <ACTION>
            ${RT_SBIN}/titian-rip.sh show
        </ACTION>
    </COMMAND>
</VIEW>

</CLISH_MODULE>
