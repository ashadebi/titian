<?xml version="1.0" encoding="UTF-8"?>
<CLISH_MODULE xmlns="http://clish.sourceforge.net/XMLSchema"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
 xsi:schemaLocation="http://clish.sourceforge.net/XMLSchema
                     http://clish.sourceforge.net/XMLSchema/clish.xsd">
    <!--=======================================================-->
    <!-- FRR (net/frr10) — BSDRP port. DESAIN VTYSH HANDOFF
         (keputusan user 17 Nov 2026): program coverage klish
         penuh untuk FRR DIBATALKAN.
         - Enable/disable di conf-router.xml (`router frr enable`,
           mutual exclusion vs BIRD di sana + di commit).
         - File ini: masuk view `router frr`, handoff interaktif
           `vtysh` ke CLI native FRR (child, bukan exec — `exit`
           di vtysh kembali ke klish; wajib TTY), + show
           passthrough via `vtysh -c`.
         - TIDAK ADA LAGI perintah klish untuk router-id / log /
           write-memory / router bgp / router ospf / route-map /
           ip prefix-list / ip community-list (dihapus 17 Nov
           2026 — lihat panduan §9c, catatan migrasi). Semua
           konfigurasi FRR kini langsung di vtysh.
         - Persistensi: keluar vtysh + `save` menjalankan
           `write memory` lalu menyalin frr.conf live ke
           /cfg/titian/frr.conf; boot memasang snapshot itu
           kembali ke /usr/local/etc/frr/frr.conf SEBELUM FRR
           naik (titian-frr.sh frr-sync/frr-restore, dipanggil
           titian-cfg.sh). Snapshot format intent klish lama
           DITOLAK saat restore (bukan config FRR native).
         - Nama perintah handoff adalah `vtysh`, BUKAN `cli`:
           `cli` sudah dipakai perintah socket CLI BIRD
           (conf-bgp.xml) dan perintah shell BSDRP di luar klish.
         - `show frr` menampilkan status enable (intent enable,
           rc.conf, pid zebra) — bukan config intent (konsep itu
           sudah tidak ada). -->

<VIEW name="configure-view">
    <COMMAND name="router frr"
            help="FRR routing suite — enter view FRR (handoff vtysh)" help-id="FRR routing suite — masuk ke view FRR (handoff vtysh)"
            view="configure-frr-view"
            viewid="sysview=frr"
            ptype="SUBCOMMAND"
            mode="subcommand">
        <CONFIG priority="0x1520" pattern="^${__line}$"/>
        <ACTION>
            ${RT_SBIN}/titian-frr.sh check
        </ACTION>
    </COMMAND>
</VIEW>

<VIEW name="configure-frr-view"
    prompt="${SYSTEM_NAME}(config-frr)# "
    depth="1">
    <NAMESPACE ref="configure-view"
        help="false"
        completion="true"/>

    <COMMAND name="exit"
        help="Back to configure-view"
        lock="false">
        <ACTION builtin="clish_nested_up"/>
    </COMMAND>
    <COMMAND name="end"
        help="Back to enable-view"
        view="enable-view"/>
    <HOTKEY key="^Z" cmd="exit"/>

    <COMMAND name="no"
        help="Negate a command or set its defaults"/>

    <COMMAND name="vtysh"
        help="Enter the native FRR CLI (vtysh) — type 'exit' in vtysh to return to klish; the running-config is synchronized to /cfg on exit" help-id="Masuk ke CLI native FRR (vtysh) — ketik 'exit' di vtysh untuk kembali ke klish; running-config disinkronkan ke /cfg saat keluar">
        <ACTION>
            ${RT_SBIN}/titian-frr.sh vtysh
        </ACTION>
    </COMMAND>
</VIEW>

<VIEW name="enable-view">
    <COMMAND name="show frr"
        help="Status + FRR version (enable intent, service, zebra pid)" help-id="Status + versi FRR (enable intent, service, zebra pid)"
        lock="false"
        interrupt="true">
        <ACTION>
            ${RT_SBIN}/titian-frr.sh show
        </ACTION>
    </COMMAND>
    <COMMAND name="show frr version"
        help="FRR version + running daemons" help-id="Versi FRR + daemon that jalan"
        lock="false"
        interrupt="true">
        <ACTION>
            ${RT_SBIN}/titian-frr.sh show-version
        </ACTION>
    </COMMAND>
    <COMMAND name="show frr bgp"
        help="BGP FRR (vtysh show ip bgp)"/>
    <COMMAND name="show frr bgp summary"
        help="BGP FRR session summary (vtysh show ip bgp summary)" help-id="Ringkasan sesi BGP FRR (vtysh show ip bgp summary)"
        lock="false"
        interrupt="true">
        <ACTION>
            ${RT_SBIN}/titian-frr.sh show-ip-bgp-summary
        </ACTION>
    </COMMAND>
    <COMMAND name="show frr ospf"
        help="OSPF FRR (vtysh show IP OSPF)" help-id="OSPF FRR (vtysh show ip ospf)"/>
    <COMMAND name="show frr ospf neighbor"
        help="Neighbor OSPF FRR (vtysh show IP OSPF neighbor)" help-id="Neighbor OSPF FRR (vtysh show ip ospf neighbor)"
        lock="false"
        interrupt="true">
        <ACTION>
            ${RT_SBIN}/titian-frr.sh show-ip-ospf-neighbor
        </ACTION>
    </COMMAND>
    <COMMAND name="show ip bgp"
        help="BGP table FRR (vtysh show IP BGP)" help-id="Tabel BGP FRR (vtysh show ip bgp)"
        lock="false"
        interrupt="true">
        <ACTION>
            ${RT_SBIN}/titian-frr.sh show-ip-bgp
        </ACTION>
    </COMMAND>
    <COMMAND name="show ip bgp summary"
        help="BGP FRR session summary (vtysh show ip bgp summary)" help-id="Ringkasan sesi BGP FRR (vtysh show ip bgp summary)"
        lock="false"
        interrupt="true">
        <ACTION>
            ${RT_SBIN}/titian-frr.sh show-ip-bgp-summary
        </ACTION>
    </COMMAND>
    <COMMAND name="show ip ospf"
        help="OSPF FRR status (vtysh show IP OSPF)" help-id="Status OSPF FRR (vtysh show ip ospf)"
        lock="false"
        interrupt="true">
        <ACTION>
            ${RT_SBIN}/titian-frr.sh show-ip-ospf
        </ACTION>
    </COMMAND>
    <COMMAND name="show ip ospf neighbor"
        help="Neighbor OSPF FRR (vtysh show IP OSPF neighbor)" help-id="Neighbor OSPF FRR (vtysh show ip ospf neighbor)"
        lock="false"
        interrupt="true">
        <ACTION>
            ${RT_SBIN}/titian-frr.sh show-ip-ospf-neighbor
        </ACTION>
    </COMMAND>
    <COMMAND name="show frr route"
        help="FRR / zebra route table (vtysh show ip route; the usual `show ip route` is the kernel table)" help-id="Tabel route FRR / zebra (vtysh show ip route; `show ip route` yang biasa adalah tabel kernel)"
        lock="false"
        interrupt="true">
        <ACTION>
            ${RT_SBIN}/titian-frr.sh show-ip-route
        </ACTION>
    </COMMAND>
</VIEW>

</CLISH_MODULE>
