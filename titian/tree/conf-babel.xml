<?xml version="1.0" encoding="UTF-8"?>
<CLISH_MODULE xmlns="http://clish.sourceforge.net/XMLSchema"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
 xsi:schemaLocation="http://clish.sourceforge.net/XMLSchema
                     http://clish.sourceforge.net/XMLSchema/clish.xsd">
    <!--=======================================================-->
    <!-- Babel BIRD (`protocol babel`, Bab 6.2 docs, batch B9).-->
    <!--   - Masuk dari `router bird` -> `babel` — SATU         -->
    <!--     instance tetap (seperti radv/bmp). `interface`    -->
    <!--     masuk ke iface view (viewid babel_iface).          -->
    <!--   - Channel ipv4 / ipv6 (+ sadr): table + import /     -->
    <!--     export all|none|filter bernama. Bentuk `where`     -->
    <!--     mentah TIDAK diekspos.                             -->
    <!--   - tx priority N/A Linux-only — TIDAK diekspos.       -->
    <!--   - babel_metric READ-ONLY, diekspos sebagai atribut   -->
    <!--     filter (titian-bgp.sh / titian-function.sh).       -->
    <!--   - TIDAK ADA birdc `show babel` (Bab 4.3) — status    -->
    <!--     lewat `show protocols [all]`.                       -->
    <!--   - Intent di /etc/titian/babel.conf; generate via    -->
    <!--     titian-babel.sh (section bird.d/babel.conf lalu    -->
    <!--     titian-bird.sh generate babel). Section ditulis    -->
    <!--     ulang UTUH tiap apply.                              -->

<VIEW name="configure-bird-babel-view"
    prompt="${SYSTEM_NAME}(config-bird-babel)# "
    depth="2">
    <NAMESPACE ref="configure-bird-view"
        help="false"
        completion="true"/>
    <COMMAND name="exit"
        help="Back to BIRD mode" help-id="Back to bird mode"
        lock="false">
        <ACTION builtin="clish_nested_up"/>
    </COMMAND>
    <COMMAND name="end"
        help="Back to enable-view"
        view="enable-view"/>
    <HOTKEY key="^Z" cmd="exit"/>

    <COMMAND name="no"
        help="Negate a command or set its defaults"/>

    <COMMAND name="show"
        help="Show Babel state"/>

    <COMMAND name="randomize-router-id"
        help="Randomize the top 32 bits of the router ID on each start (default no)" help-id="Acak 32 bit teratas router ID tiap start (default no)">
        <PARAM name="Value"
            help="on|off"
            ptype="STRING"/>
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-babel.sh top-set randomize-router-id "${Value}"
        </ACTION>
    </COMMAND>
    <COMMAND name="no randomize-router-id"
        help="Delete randomize-router-ID (BIRD default no)" help-id="Hapus randomize-router-id (default BIRD no)">
        <CONFIG operation="unset" pattern="^randomize-router-id"/>
        <ACTION>
            ${RT_SBIN}/titian-babel.sh top-del randomize-router-id
        </ACTION>
    </COMMAND>

    <COMMAND name="ipv6-sadr"
        help="Enable support SADR/SSR in channel IPv6 (default off)" help-id="Aktifkan dukungan SADR/SSR di channel ipv6 (default off)">
        <PARAM name="Value"
            help="on|off"
            ptype="STRING"/>
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-babel.sh top-set ipv6-sadr "${Value}"
        </ACTION>
    </COMMAND>
    <COMMAND name="no ipv6-sadr"
        help="Delete IPv6-SADR (regular IPv6 channel)" help-id="Hapus ipv6-sadr (channel ipv6 reguler)">
        <CONFIG operation="unset" pattern="^ipv6-sadr"/>
        <ACTION>
            ${RT_SBIN}/titian-babel.sh top-del ipv6-sadr
        </ACTION>
    </COMMAND>

    <COMMAND name="ipv4-table"
        help="IPv4 channel table" help-id="Tabel channel ipv4">
        <PARAM name="Value"
            help="IPv4 table name (global -> table-add IPv4; master4 valid)" help-id="Nama tabel ipv4 (global -> table-add ipv4; master4 sah)"
            ptype="STRING"/>
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-babel.sh chan-set ipv4 table "${Value}"
        </ACTION>
    </COMMAND>
    <COMMAND name="no ipv4-table"
        help="Delete IPv4-table" help-id="Hapus ipv4-table">
        <CONFIG operation="unset" pattern="^ipv4-table"/>
        <ACTION>
            ${RT_SBIN}/titian-babel.sh chan-del ipv4 table
        </ACTION>
    </COMMAND>
    <COMMAND name="ipv4-import"
        help="Import filter channel IPv4 (all|none|filter NAME)" help-id="Import filter channel ipv4 (all|none|filter NAMA)">
        <PARAM name="Value"
            help="all|none|filter"
            ptype="STRING"/>
        <PARAM name="FilterName"
            help="Filter name (if Value=filter)" help-id="Nama filter (bila Value=filter)"
            ptype="STRING"
            optional="true"/>
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-babel.sh chan-set ipv4 import "${Value}" "${FilterName}"
        </ACTION>
    </COMMAND>
    <COMMAND name="no ipv4-import"
        help="Delete IPv4-import" help-id="Hapus ipv4-import">
        <CONFIG operation="unset" pattern="^ipv4-import"/>
        <ACTION>
            ${RT_SBIN}/titian-babel.sh chan-del ipv4 import
        </ACTION>
    </COMMAND>
    <COMMAND name="ipv4-export"
        help="Export filter channel IPv4 (all|none|filter NAME)" help-id="Export filter channel ipv4 (all|none|filter NAMA)">
        <PARAM name="Value"
            help="all|none|filter"
            ptype="STRING"/>
        <PARAM name="FilterName"
            help="Filter name (if Value=filter)" help-id="Nama filter (bila Value=filter)"
            ptype="STRING"
            optional="true"/>
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-babel.sh chan-set ipv4 export "${Value}" "${FilterName}"
        </ACTION>
    </COMMAND>
    <COMMAND name="no ipv4-export"
        help="Delete IPv4-export" help-id="Hapus ipv4-export">
        <CONFIG operation="unset" pattern="^ipv4-export"/>
        <ACTION>
            ${RT_SBIN}/titian-babel.sh chan-del ipv4 export
        </ACTION>
    </COMMAND>

    <COMMAND name="ipv6-table"
        help="IPv6 channel table" help-id="Tabel channel ipv6">
        <PARAM name="Value"
            help="IPv6/IPv6-SADR table name (global -> table-add IPv6; master6 valid)" help-id="Nama tabel ipv6/ipv6-sadr (global -> table-add ipv6; master6 sah)"
            ptype="STRING"/>
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-babel.sh chan-set ipv6 table "${Value}"
        </ACTION>
    </COMMAND>
    <COMMAND name="no ipv6-table"
        help="Delete IPv6-table" help-id="Hapus ipv6-table">
        <CONFIG operation="unset" pattern="^ipv6-table"/>
        <ACTION>
            ${RT_SBIN}/titian-babel.sh chan-del ipv6 table
        </ACTION>
    </COMMAND>
    <COMMAND name="ipv6-import"
        help="Import filter channel IPv6 (all|none|filter NAME)" help-id="Import filter channel ipv6 (all|none|filter NAMA)">
        <PARAM name="Value"
            help="all|none|filter"
            ptype="STRING"/>
        <PARAM name="FilterName"
            help="Filter name (if Value=filter)" help-id="Nama filter (bila Value=filter)"
            ptype="STRING"
            optional="true"/>
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-babel.sh chan-set ipv6 import "${Value}" "${FilterName}"
        </ACTION>
    </COMMAND>
    <COMMAND name="no ipv6-import"
        help="Delete IPv6-import" help-id="Hapus ipv6-import">
        <CONFIG operation="unset" pattern="^ipv6-import"/>
        <ACTION>
            ${RT_SBIN}/titian-babel.sh chan-del ipv6 import
        </ACTION>
    </COMMAND>
    <COMMAND name="ipv6-export"
        help="Export filter channel IPv6 (all|none|filter NAME)" help-id="Export filter channel ipv6 (all|none|filter NAMA)">
        <PARAM name="Value"
            help="all|none|filter"
            ptype="STRING"/>
        <PARAM name="FilterName"
            help="Filter name (if Value=filter)" help-id="Nama filter (bila Value=filter)"
            ptype="STRING"
            optional="true"/>
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-babel.sh chan-set ipv6 export "${Value}" "${FilterName}"
        </ACTION>
    </COMMAND>
    <COMMAND name="no ipv6-export"
        help="Delete IPv6-export" help-id="Hapus ipv6-export">
        <CONFIG operation="unset" pattern="^ipv6-export"/>
        <ACTION>
            ${RT_SBIN}/titian-babel.sh chan-del ipv6 export
        </ACTION>
    </COMMAND>

    <COMMAND name="debug"
        help="This Debug protocol (all, off, or states,routes,filters,interfaces,events,packets)" help-id="Debug protokol ini (all, off, atau states,routes,filters,interfaces,events,packets)">
        <PARAM name="Value"
            help="all|off|class,class,..." help-id="all|off|kelas,kelas,..."
            ptype="STRING"/>
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-babel.sh debug-set "${Value}"
        </ACTION>
    </COMMAND>
    <COMMAND name="no debug"
        help="Disable this debug protocol (BIRD default off)" help-id="Matikan debug protokol ini (default BIRD off)">
        <CONFIG operation="unset" pattern="^debug"/>
        <ACTION>
            ${RT_SBIN}/titian-babel.sh debug-del
        </ACTION>
    </COMMAND>

    <COMMAND name="mrtdump"
        help="This MRTdump protocol (all, off, or states,messages)" help-id="MRTdump protokol ini (all, off, atau states,messages)">
        <PARAM name="Value"
            help="all|off|states,messages"
            ptype="STRING"/>
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-babel.sh mrtdump-set "${Value}"
        </ACTION>
    </COMMAND>
    <COMMAND name="no mrtdump"
        help="Disable this mrtdump protocol (BIRD default off)" help-id="Matikan mrtdump protokol ini (default BIRD off)">
        <CONFIG operation="unset" pattern="^mrtdump"/>
        <ACTION>
            ${RT_SBIN}/titian-babel.sh mrtdump-del
        </ACTION>
    </COMMAND>

    <COMMAND name="interface"
        help="Interface Babel (enter interface view)" help-id="Interface Babel (masuk ke interface view)"
        view="configure-bird-babel-iface-view"
        viewid="babel_iface=${Pattern}"
        ptype="SUBCOMMAND"
        mode="subcommand">
        <PARAM name="Pattern"
            help="Interface pattern (e.g. ge* or wlan0)" help-id="Pola interface (mis. ge* atau wlan0)"
            ptype="STRING"/>
        <CONFIG pattern="^${__line}$"/>
        <ACTION>
            ${RT_SBIN}/titian-babel.sh interface-add "${Pattern}"
        </ACTION>
    </COMMAND>
    <COMMAND name="no interface"
        help="Delete interface Babel (all options that interface)" help-id="Hapus interface Babel (semua opsi interface itu)">
        <PARAM name="Pattern"
            help="Interface pattern" help-id="Pola interface"
            ptype="STRING"/>
        <CONFIG operation="unset" pattern="^interface ${Pattern}"/>
        <ACTION>
            ${RT_SBIN}/titian-babel.sh interface-del "${Pattern}"
        </ACTION>
    </COMMAND>

    <COMMAND name="show babel"
        help="Show the intent + section + birdc status of this instance (via show protocols)" help-id="Tampilkan intent + section + status birdc instance ini (via show protocols)">
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-babel.sh show
        </ACTION>
    </COMMAND>
</VIEW>

<VIEW name="configure-bird-babel-iface-view"
    prompt="${SYSTEM_NAME}(config-bird-babel-iface-${babel_iface})# "
    depth="3">
    <NAMESPACE ref="configure-bird-babel-view"
        help="false"
        completion="true"/>
    <COMMAND name="exit"
        help="Back to babel mode"
        lock="false">
        <ACTION builtin="clish_nested_up"/>
    </COMMAND>
    <COMMAND name="end"
        help="Back to enable-view"
        view="enable-view"/>
    <HOTKEY key="^Z" cmd="exit"/>

    <COMMAND name="no"
        help="Negate a command or set its defaults"/>

    <COMMAND name="type"
        help="Interface type (default wired)" help-id="Tipe interface (default wired)">
        <PARAM name="Value"
            help="wired|wireless|tunnel"
            ptype="STRING"/>
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-babel.sh interface-set "${babel_iface}" type "${Value}"
        </ACTION>
    </COMMAND>
    <COMMAND name="no type"
        help="Delete type (BIRD default wired)" help-id="Hapus type (default BIRD wired)">
        <CONFIG operation="unset" pattern="^type"/>
        <ACTION>
            ${RT_SBIN}/titian-babel.sh interface-unset "${babel_iface}" type
        </ACTION>
    </COMMAND>

    <COMMAND name="rxcost"
        help="Nominal RX interface cost (default 96 wired / 256 wireless)" help-id="Biaya RX nominal interface (default 96 wired / 256 wireless)">
        <PARAM name="Value"
            help="0..65535"
            ptype="UINT"/>
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-babel.sh interface-set "${babel_iface}" rxcost "${Value}"
        </ACTION>
    </COMMAND>
    <COMMAND name="no rxcost"
        help="Delete rxcost" help-id="Hapus rxcost">
        <CONFIG operation="unset" pattern="^rxcost"/>
        <ACTION>
            ${RT_SBIN}/titian-babel.sh interface-unset "${babel_iface}" rxcost
        </ACTION>
    </COMMAND>

    <COMMAND name="limit"
        help="How many of the last 16 Hellos must be received for the neighbor to be up (wired; default 12)" help-id="Berapa dari 16 Hello terakhir harus diterima agar tetangga up (wired; default 12)">
        <PARAM name="Value"
            help="0..16"
            ptype="UINT"/>
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-babel.sh interface-set "${babel_iface}" limit "${Value}"
        </ACTION>
    </COMMAND>
    <COMMAND name="no limit"
        help="Delete limit (BIRD default 12)" help-id="Hapus limit (default BIRD 12)">
        <CONFIG operation="unset" pattern="^limit"/>
        <ACTION>
            ${RT_SBIN}/titian-babel.sh interface-unset "${babel_iface}" limit
        </ACTION>
    </COMMAND>

    <COMMAND name="hello-interval"
        help="Periodic Hello send interval (default: 4 seconds)" help-id="Interval kirim Hello periodik (default 4 detik)">
        <PARAM name="Value"
            help="BIRD time (e.g. 4, 4s, 500ms)" help-id="Waktu BIRD (mis. 4, 4s, 500ms)"
            ptype="STRING"/>
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-babel.sh interface-set "${babel_iface}" hello-interval "${Value}"
        </ACTION>
    </COMMAND>
    <COMMAND name="no hello-interval"
        help="Delete hello-interval (BIRD default 4 seconds)" help-id="Hapus hello-interval (default BIRD 4 detik)">
        <CONFIG operation="unset" pattern="^hello-interval"/>
        <ACTION>
            ${RT_SBIN}/titian-babel.sh interface-unset "${babel_iface}" hello-interval
        </ACTION>
    </COMMAND>

    <COMMAND name="update-interval"
        help="Periodic full update send interval (default: 4x hello interval)" help-id="Interval kirim update penuh periodik (default 4x hello interval)">
        <PARAM name="Value"
            help="BIRD time (e.g. 16, 16s)" help-id="Waktu BIRD (mis. 16, 16s)"
            ptype="STRING"/>
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-babel.sh interface-set "${babel_iface}" update-interval "${Value}"
        </ACTION>
    </COMMAND>
    <COMMAND name="no update-interval"
        help="Delete update-interval (default 4x hello)" help-id="Hapus update-interval (default 4x hello)">
        <CONFIG operation="unset" pattern="^update-interval"/>
        <ACTION>
            ${RT_SBIN}/titian-babel.sh interface-unset "${babel_iface}" update-interval
        </ACTION>
    </COMMAND>

    <COMMAND name="port"
        help="UDP port Babel (default 6696)">
        <PARAM name="Value"
            help="1..65535"
            ptype="UINT"/>
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-babel.sh interface-set "${babel_iface}" port "${Value}"
        </ACTION>
    </COMMAND>
    <COMMAND name="no port"
        help="Delete port (BIRD default 6696)" help-id="Hapus port (default BIRD 6696)">
        <CONFIG operation="unset" pattern="^port"/>
        <ACTION>
            ${RT_SBIN}/titian-babel.sh interface-unset "${babel_iface}" port
        </ACTION>
    </COMMAND>

    <COMMAND name="tx-class"
        help="ToS/Class value of outgoing Babel packets (0-255)" help-id="Nilai ToS/Class paket Babel keluar (0-255)">
        <PARAM name="Value"
            help="0..255"
            ptype="UINT"/>
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-babel.sh interface-set "${babel_iface}" tx-class "${Value}"
        </ACTION>
    </COMMAND>
    <COMMAND name="no tx-class"
        help="Delete tx-class" help-id="Hapus tx-class">
        <CONFIG operation="unset" pattern="^tx-class"/>
        <ACTION>
            ${RT_SBIN}/titian-babel.sh interface-unset "${babel_iface}" tx-class
        </ACTION>
    </COMMAND>

    <COMMAND name="tx-dscp"
        help="DSCP value of outgoing Babel packets (0-63)" help-id="Nilai DSCP paket Babel keluar (0-63)">
        <PARAM name="Value"
            help="0..63"
            ptype="UINT"/>
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-babel.sh interface-set "${babel_iface}" tx-dscp "${Value}"
        </ACTION>
    </COMMAND>
    <COMMAND name="no tx-dscp"
        help="Delete tx-DSCP" help-id="Hapus tx-dscp">
        <CONFIG operation="unset" pattern="^tx-dscp"/>
        <ACTION>
            ${RT_SBIN}/titian-babel.sh interface-unset "${babel_iface}" tx-dscp
        </ACTION>
    </COMMAND>

    <COMMAND name="rx-buffer"
        help="Packet processing buffer size (default interface MTU; min 512 + overhead)" help-id="Ukuran buffer pemrosesan paket (default MTU interface; min 512 + overhead)">
        <PARAM name="Value"
            help="512..65535"
            ptype="UINT"/>
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-babel.sh interface-set "${babel_iface}" rx-buffer "${Value}"
        </ACTION>
    </COMMAND>
    <COMMAND name="no rx-buffer"
        help="Delete rx-buffer" help-id="Hapus rx-buffer">
        <CONFIG operation="unset" pattern="^rx-buffer"/>
        <ACTION>
            ${RT_SBIN}/titian-babel.sh interface-unset "${babel_iface}" rx-buffer
        </ACTION>
    </COMMAND>

    <COMMAND name="tx-length"
        help="Maximum length of generated Babel packets (default MTU; min 512 + overhead)" help-id="Panjang maks paket Babel yang dihasilkan (default MTU; min 512 + overhead)">
        <PARAM name="Value"
            help="512..65535"
            ptype="UINT"/>
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-babel.sh interface-set "${babel_iface}" tx-length "${Value}"
        </ACTION>
    </COMMAND>
    <COMMAND name="no tx-length"
        help="Delete tx-length" help-id="Hapus tx-length">
        <CONFIG operation="unset" pattern="^tx-length"/>
        <ACTION>
            ${RT_SBIN}/titian-babel.sh interface-unset "${babel_iface}" tx-length
        </ACTION>
    </COMMAND>

    <COMMAND name="check-link"
        help="Pertimbangkan link state hardware (default yes)">
        <PARAM name="Value"
            help="on|off"
            ptype="STRING"/>
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-babel.sh interface-set "${babel_iface}" check-link "${Value}"
        </ACTION>
    </COMMAND>
    <COMMAND name="no check-link"
        help="Delete check-link (BIRD default yes)" help-id="Hapus check-link (default BIRD yes)">
        <CONFIG operation="unset" pattern="^check-link"/>
        <ACTION>
            ${RT_SBIN}/titian-babel.sh interface-unset "${babel_iface}" check-link
        </ACTION>
    </COMMAND>

    <COMMAND name="next-hop-ipv4"
        help="Next hop advertised for IPv4 routes (default preferred IPv4 interface)" help-id="Next hop yang diiklankan untuk route IPv4 (default preferred IPv4 interface)">
        <PARAM name="Value"
            help="IPv4 address" help-id="Alamat IPv4"
            ptype="STRING"/>
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-babel.sh interface-set "${babel_iface}" next-hop-ipv4 "${Value}"
        </ACTION>
    </COMMAND>
    <COMMAND name="no next-hop-ipv4"
        help="Delete next-hop-IPv4" help-id="Hapus next-hop-ipv4">
        <CONFIG operation="unset" pattern="^next-hop-ipv4"/>
        <ACTION>
            ${RT_SBIN}/titian-babel.sh interface-unset "${babel_iface}" next-hop-ipv4
        </ACTION>
    </COMMAND>

    <COMMAND name="next-hop-ipv6"
        help="Next hop advertised for IPv6 routes (default link-local source)" help-id="Next hop yang diiklankan untuk route IPv6 (default link-local source)">
        <PARAM name="Value"
            help="IPv6 address" help-id="Alamat IPv6"
            ptype="STRING"/>
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-babel.sh interface-set "${babel_iface}" next-hop-ipv6 "${Value}"
        </ACTION>
    </COMMAND>
    <COMMAND name="no next-hop-ipv6"
        help="Delete next-hop-IPv6" help-id="Hapus next-hop-ipv6">
        <CONFIG operation="unset" pattern="^next-hop-ipv6"/>
        <ACTION>
            ${RT_SBIN}/titian-babel.sh interface-unset "${babel_iface}" next-hop-ipv6
        </ACTION>
    </COMMAND>

    <COMMAND name="extended-next-hop"
        help="Accept &amp; send route IPv4 with next hop IPv6 (RFC 9229; default yes)" help-id="Terima &amp; kirim route IPv4 dengan next hop IPv6 (RFC 9229; default yes)">
        <PARAM name="Value"
            help="on|off"
            ptype="STRING"/>
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-babel.sh interface-set "${babel_iface}" extended-next-hop "${Value}"
        </ACTION>
    </COMMAND>
    <COMMAND name="no extended-next-hop"
        help="Delete extended-next-hop (BIRD default yes)" help-id="Hapus extended-next-hop (default BIRD yes)">
        <CONFIG operation="unset" pattern="^extended-next-hop"/>
        <ACTION>
            ${RT_SBIN}/titian-babel.sh interface-unset "${babel_iface}" extended-next-hop
        </ACTION>
    </COMMAND>

    <COMMAND name="rtt-cost"
        help="Additional RTT cost per neighbor (default 0 disabled; 96 for tunnel)" help-id="Biaya RTT tambahan per tetangga (default 0 disabled; 96 untuk tunnel)">
        <PARAM name="Value"
            help="0..65535"
            ptype="UINT"/>
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-babel.sh interface-set "${babel_iface}" rtt-cost "${Value}"
        </ACTION>
    </COMMAND>
    <COMMAND name="no rtt-cost"
        help="Delete rtt-cost (BIRD default 0)" help-id="Hapus rtt-cost (default BIRD 0)">
        <CONFIG operation="unset" pattern="^rtt-cost"/>
        <ACTION>
            ${RT_SBIN}/titian-babel.sh interface-unset "${babel_iface}" rtt-cost
        </ACTION>
    </COMMAND>

    <COMMAND name="rtt-min"
        help="Minimum RTT at which the RTT cost starts to apply (default 10ms)" help-id="RTT minimum biaya RTT mulai diterapkan (default 10ms)">
        <PARAM name="Value"
            help="BIRD time (e.g. 10ms)" help-id="Waktu BIRD (mis. 10ms)"
            ptype="STRING"/>
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-babel.sh interface-set "${babel_iface}" rtt-min "${Value}"
        </ACTION>
    </COMMAND>
    <COMMAND name="no rtt-min"
        help="Delete rtt-min (BIRD default 10ms)" help-id="Hapus rtt-min (default BIRD 10ms)">
        <CONFIG operation="unset" pattern="^rtt-min"/>
        <ACTION>
            ${RT_SBIN}/titian-babel.sh interface-unset "${babel_iface}" rtt-min
        </ACTION>
    </COMMAND>

    <COMMAND name="rtt-max"
        help="RTT at which the full RTT cost applies (default 120ms)" help-id="RTT biaya RTT penuh diterapkan (default 120ms)">
        <PARAM name="Value"
            help="BIRD time (e.g. 120ms)" help-id="Waktu BIRD (mis. 120ms)"
            ptype="STRING"/>
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-babel.sh interface-set "${babel_iface}" rtt-max "${Value}"
        </ACTION>
    </COMMAND>
    <COMMAND name="no rtt-max"
        help="Delete rtt-max (BIRD default 120ms)" help-id="Hapus rtt-max (default BIRD 120ms)">
        <CONFIG operation="unset" pattern="^rtt-max"/>
        <ACTION>
            ${RT_SBIN}/titian-babel.sh interface-unset "${babel_iface}" rtt-max
        </ACTION>
