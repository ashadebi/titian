<?xml version="1.0" encoding="UTF-8"?>
<CLISH_MODULE xmlns="http://clish.sourceforge.net/XMLSchema"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
 xsi:schemaLocation="http://clish.sourceforge.net/XMLSchema
                     http://clish.sourceforge.net/XMLSchema/clish.xsd">
    <!--=======================================================-->
    <!-- Kernel (BIRD `protocol kernel`) — sinkronisasi tabel   -->
    <!-- routing BIRD <-> kernel OS.                            -->
    <!--   - Masuk dari `router bird` -> `kernel` (view         -->
    <!--     configure-bird-kernel-view): learn / persist /     -->
    <!--     scan-time / graceful-restart / merge-paths,        -->
    <!--     `ipv4` / `ipv6` masuk ke channel view (import /    -->
    <!--     export all|none per channel).                      -->
    <!--   - Intent di /etc/titian/kernel.conf; generate via    -->
    <!--     titian-protocol.sh (menulis section                -->
    <!--     bird.d/protocol.conf — BERBAGI dengan device,      -->
    <!--     lihat header titian-protocol.sh — lalu              -->
    <!--     titian-bird.sh generate protocol). Section ditulis -->
    <!--     ulang UTUH tiap apply.                             -->
    <!--   - Service BIRD naik/berubah saat `commit`            -->
    <!--     (apply_protocol di titian-commit.sh).               -->
    <!--   - Sintaks BIRD 2.16.1 (docs §6.8): learn [all];     -->
    <!--     persist; scan time N; graceful restart; merge      -->
    <!--     paths [limit N]; ipv4/ipv6 { import; export; }.   -->
    <!--     Default channel LAB-SAFE dipertahankan dari contoh -->
    <!--     protocol.conf lama: import none + export none     -->
    <!--     (BIRD tidak menyentuh tabel kernel sampai operator -->
    <!--     membuka ekspornya). Default persist / scan time /  -->
    <!--     graceful restart TIDAK dinyatakan docs — hanya     -->
    <!--     ditulis bila diset eksplisit.                      -->
    <!--   - N/A FreeBSD (Linux-only, TIDAK diimplementasi):    -->
    <!--     kernel table, metric, netlink rx buffer, krt_*.    -->

<VIEW name="configure-bird-kernel-view"
    prompt="${SYSTEM_NAME}(config-bird-kernel)# "
    depth="2">
    <NAMESPACE ref="configure-bird-view"
        help="false"
        completion="true"/>
    <COMMAND name="exit"
        help="Back to bird mode"
        lock="false">
        <ACTION builtin="clish_nested_up"/>
    </COMMAND>
    <COMMAND name="end"
        help="Back to enable-view"
        view="enable-view"/>
    <HOTKEY key="^Z" cmd="exit"/>

    <COMMAND name="no"
        help="Negate a command or set its defaults"/>

    <COMMAND name="learn"
        help="Belajar route alien dari kernel (daemon lain/admin)">
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-protocol.sh kernel-set learn on
        </ACTION>
    </COMMAND>
    <COMMAND name="learn all"
        help="Belajar route alien + device route buatan kernel sendiri">
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-protocol.sh kernel-set learn all
        </ACTION>
    </COMMAND>
    <COMMAND name="no learn"
        help="Jangan belajar route dari kernel (default BIRD)">
        <CONFIG operation="unset" pattern="^learn"/>
        <ACTION>
            ${RT_SBIN}/titian-protocol.sh kernel-set learn off
        </ACTION>
    </COMMAND>

    <COMMAND name="persist"
        help="Biarkan route BIRD di tabel kernel saat BIRD exit">
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-protocol.sh kernel-set persist on
        </ACTION>
    </COMMAND>
    <COMMAND name="no persist"
        help="Bersihkan route BIRD dari kernel saat BIRD exit">
        <CONFIG operation="unset" pattern="^persist"/>
        <ACTION>
            ${RT_SBIN}/titian-protocol.sh kernel-set persist off
        </ACTION>
    </COMMAND>

    <COMMAND name="scan-time"
        help="Interval scan tabel routing kernel (detik)">
        <PARAM name="Secs"
            help="Detik (1..86400)"
            ptype="UINT"/>
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-protocol.sh kernel-set scan-time "${Secs}"
        </ACTION>
    </COMMAND>
    <COMMAND name="no scan-time"
        help="Hapus scan-time kernel (kembali tanpa nilai eksplisit)">
        <CONFIG operation="unset" pattern="^scan-time"/>
        <ACTION>
            ${RT_SBIN}/titian-protocol.sh kernel-scan-time-del
        </ACTION>
    </COMMAND>

    <COMMAND name="graceful-restart"
        help="Tunda sinkronisasi tabel sampai graceful-restart recovery selesai">
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-protocol.sh kernel-set graceful-restart on
        </ACTION>
    </COMMAND>
    <COMMAND name="no graceful-restart"
        help="Matikan graceful-restart kernel">
        <CONFIG operation="unset" pattern="^graceful-restart"/>
        <ACTION>
            ${RT_SBIN}/titian-protocol.sh kernel-set graceful-restart off
        </ACTION>
    </COMMAND>

    <COMMAND name="merge-paths"
        help="Gabung best + non-best route ekuivalen jadi ECMP saat export ke kernel">
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-protocol.sh kernel-set merge-paths on
        </ACTION>
    </COMMAND>
    <COMMAND name="merge-paths limit"
        help="Batas maks nexthop ECMP saat merge-paths (1..16, default BIRD 16 bila enabled)">
        <PARAM name="Limit"
            help="Limit (1..16)"
            ptype="UINT"/>
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-protocol.sh kernel-set merge-paths-limit "${Limit}"
        </ACTION>
    </COMMAND>
    <COMMAND name="no merge-paths"
        help="Matikan merge-paths (default BIRD: disabled)">
        <CONFIG operation="unset" pattern="^merge-paths"/>
        <ACTION>
            ${RT_SBIN}/titian-protocol.sh kernel-set merge-paths off
        </ACTION>
    </COMMAND>

    <COMMAND name="debug"
        help="Debug protokol kernel (all|off|states,routes,filters,interfaces,events,packets)">
        <PARAM name="Value"
            help="Kelas debug (all|off|daftar koma)"
            ptype="STRING"/>
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-protocol.sh kernel-set debug "${Value}"
        </ACTION>
    </COMMAND>
    <COMMAND name="no debug"
        help="Matikan debug kernel (default BIRD off)">
        <CONFIG operation="unset" pattern="^debug"/>
        <ACTION>
            ${RT_SBIN}/titian-protocol.sh kernel-del debug
        </ACTION>
    </COMMAND>

    <COMMAND name="mrtdump"
        help="Dump MRT protokol kernel (all|off|states|messages)">
        <PARAM name="Value"
            help="Kelas mrtdump (all|off|states|messages)"
            ptype="STRING"/>
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-protocol.sh kernel-set mrtdump "${Value}"
        </ACTION>
    </COMMAND>
    <COMMAND name="no mrtdump"
        help="Matikan mrtdump kernel (default BIRD off)">
        <CONFIG operation="unset" pattern="^mrtdump"/>
        <ACTION>
            ${RT_SBIN}/titian-protocol.sh kernel-del mrtdump
        </ACTION>
    </COMMAND>

    <COMMAND name="disabled"
        help="Nonaktifkan protokol kernel (tidak di-start saat configure)">
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-protocol.sh kernel-set disabled on
        </ACTION>
    </COMMAND>
    <COMMAND name="no disabled"
        help="Aktifkan kembali protokol kernel (default BIRD)">
        <CONFIG operation="unset" pattern="^disabled"/>
        <ACTION>
            ${RT_SBIN}/titian-protocol.sh kernel-del disabled
        </ACTION>
    </COMMAND>

    <COMMAND name="ipv4"
        help="Channel kernel IPv4 (masuk ke channel view: import / export)"
        view="configure-bird-kernel-channel-view"
        viewid="kchan=ipv4"
        ptype="SUBCOMMAND"
        mode="subcommand">
        <CONFIG priority="0x1556" pattern="^${__line}$"/>
        <ACTION>
            ${RT_SBIN}/titian-protocol.sh kernel-touch
        </ACTION>
    </COMMAND>

    <COMMAND name="ipv6"
        help="Channel kernel IPv6 (masuk ke channel view: import / export)"
        view="configure-bird-kernel-channel-view"
        viewid="kchan=ipv6"
        ptype="SUBCOMMAND"
        mode="subcommand">
        <CONFIG priority="0x1557" pattern="^${__line}$"/>
        <ACTION>
            ${RT_SBIN}/titian-protocol.sh kernel-touch
        </ACTION>
    </COMMAND>
</VIEW>

<VIEW name="configure-bird-kernel-channel-view"
    prompt="${SYSTEM_NAME}(config-bird-kernel-${kchan})# "
    depth="3">
    <NAMESPACE ref="configure-bird-kernel-view"
        help="false"
        completion="true"/>
    <COMMAND name="exit"
        help="Back to kernel mode"
        lock="false">
        <ACTION builtin="clish_nested_up"/>
    </COMMAND>
    <HOTKEY key="^Z" cmd="exit"/>

    <COMMAND name="no"
        help="Negate a command or set its defaults"/>

    <COMMAND name="import"
        help="Import policy channel ini (all / none / filter NAME / where COND)"/>

    <COMMAND name="import all"
        help="Import semua route kernel ke tabel BIRD">
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-protocol.sh kernel-channel-set "${kchan}" import all
        </ACTION>
    </COMMAND>
    <COMMAND name="import none"
        help="Import tidak ada route kernel (default lab-safe)">
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-protocol.sh kernel-channel-set "${kchan}" import none
        </ACTION>
    </COMMAND>
    <COMMAND name="import filter"
        help="Import via filter bernama">
        <PARAM name="Name"
            help="Nama filter BIRD"
            ptype="STRING"/>
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-protocol.sh kernel-channel-set "${kchan}" import filter "${Name}"
        </ACTION>
    </COMMAND>
    <COMMAND name="import where"
        help="Import via filter inline (ekspresi bentuk ringkas, mis. net~10.0.0.0/8)">
        <PARAM name="Cond"
            help="Ekspresi filter bentuk ringkas (mis. net~10.0.0.0/8)"
            ptype="STRING"/>
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-protocol.sh kernel-channel-set "${kchan}" import where "${Cond}"
        </ACTION>
    </COMMAND>

    <COMMAND name="export"
        help="Export policy channel ini (all / none / filter NAME / where COND)"/>

    <COMMAND name="export all"
        help="Export semua route BIRD ke tabel kernel">
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-protocol.sh kernel-channel-set "${kchan}" export all
        </ACTION>
    </COMMAND>
    <COMMAND name="export none"
        help="Export tidak ada route BIRD ke kernel (default lab-safe)">
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-protocol.sh kernel-channel-set "${kchan}" export none
        </ACTION>
    </COMMAND>
    <COMMAND name="export filter"
        help="Export via filter bernama">
        <PARAM name="Name"
            help="Nama filter BIRD"
            ptype="STRING"/>
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-protocol.sh kernel-channel-set "${kchan}" export filter "${Name}"
        </ACTION>
    </COMMAND>
    <COMMAND name="export where"
        help="Export via filter inline (ekspresi bentuk ringkas, mis. net~10.0.0.0/8)">
        <PARAM name="Cond"
            help="Ekspresi filter bentuk ringkas (mis. net~10.0.0.0/8)"
            ptype="STRING"/>
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-protocol.sh kernel-channel-set "${kchan}" export where "${Cond}"
        </ACTION>
    </COMMAND>

    <COMMAND name="preference"
        help="Preference channel ini (0..65535, default BIRD 100 bila tak diset)">
        <PARAM name="Value"
            help="Preference (0..65535)"
            ptype="UINT"/>
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-protocol.sh kernel-channel-set "${kchan}" preference "${Value}"
        </ACTION>
    </COMMAND>
    <COMMAND name="no preference"
        help="Hapus preference channel (default BIRD)">
        <CONFIG operation="unset" pattern="^preference"/>
        <ACTION>
            ${RT_SBIN}/titian-protocol.sh kernel-channel-del "${kchan}" preference
        </ACTION>
    </COMMAND>
    <COMMAND name="table"
        help="Tabel BIRD yang disinkronkan channel ini ke kernel FIB (default master4/master6; Bab 2.1-2)">
        <PARAM name="Name"
            help="Nama tabel BIRD (master4/master6 atau tabel dari table-add)"
            ptype="STRING"/>
        <CONFIG/>
        <ACTION>
            ${RT_SBIN}/titian-protocol.sh kernel-channel-set "${kchan}" table "${Name}"
        </ACTION>
    </COMMAND>
    <COMMAND name="no table"
        help="Hapus tabel channel (kembali ke master4/master6)">
        <CONFIG operation="unset" pattern="^table"/>
        <ACTION>
            ${RT_SBIN}/titian-protocol.sh kernel-channel-del "${kchan}" table
        </ACTION>
    </COMMAND>
</VIEW>

<VIEW name="enable-view">
    <COMMAND name="show kernel"
        help="Status kernel BIRD (intent + section + protokol BIRD)"
        lock="false"
        interrupt="true">
        <ACTION>
            ${RT_SBIN}/titian-protocol.sh show
        </ACTION>
    </COMMAND>
</VIEW>

</CLISH_MODULE>
