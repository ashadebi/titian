<?xml version="1.0" encoding="UTF-8"?>
<CLISH_MODULE xmlns="http://clish.sourceforge.net/XMLSchema"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://clish.sourceforge.net/XMLSchema
                        http://clish.sourceforge.net/XMLSchema/clish.xsd">

<!-- VXLAN tunnel endpoint (FreeBSD). Model: setiap perubahan parameter
     vni/local/remote/group/dstport = recreate interface dari netstate
     <iface>.vxlan via titian-vxlan.sh (FreeBSD tidak punya negasi
     -vxlanlocal dkk; vxlanport bukan parameter settable — port tetap
     4789, nilai lain ditolak helper). Alamat dipulihkan dari
     <iface>.addr, MTU dari <iface>.tuning, up-state dipulihkan.
     Recreate = flap singkat + MAC bisa berubah (MAC vxlan acak per
     pembuatan). Unicast (remote) dan multicast (group+dev) saling
     eksklusif: set satu menghapus yang lain. Modul if_vxlan dimuat
     saat create (kldload) dan dipersistenkan via if_vxlan_load="YES"
     di /boot/loader.conf. -->

<VIEW name="configure-view">
    <COMMAND name="interface vxlan"
        help="VXLAN tunnel endpoint (overlay L2 at top UDP/IP)" help-id="VXLAN tunnel endpoint (overlay L2 at atas UDP/IP)"
        view="configure-vxlan-fbsd-view"
        viewid="iface=${iface_vxlan}">
        <PARAM name="iface_vxlan"
            help="VXLAN interface (VXLAN[N])" help-id="VXLAN interface (vxlan[N])"
            completion="${Get_if_vxlan}"
            ptype="IFACE_VXLAN"/>
        <CONFIG priority="0x2001" pattern="^${__line}$"/>
        <ACTION>
            ${RT_SBIN}/titian-vxlan.sh create "${iface_vxlan}"
        </ACTION>
    </COMMAND>
    <COMMAND name="no interface vxlan"
        help="delete VXLAN interface">
        <PARAM name="iface_vxlan"
            help="VXLAN interface (VXLAN[N])" help-id="VXLAN interface (vxlan[N])"
            completion="${Get_if_vxlan}"
            ptype="IFACE_VXLAN"/>
        <CONFIG operation="unset" pattern="interface vxlan ${iface_vxlan}$"/>
        <ACTION>
            if ${RT_SBIN}/titian-vxlan.sh exists "${iface_vxlan}"; then
                ${RT_SBIN}/titian-vxlan.sh delete "${iface_vxlan}"
                ${RT_SBIN}/titian-persist.sh drop-if "${iface_vxlan}"
            else
                printf "%s \n" "${iface_vxlan} not found."
            fi
        </ACTION>
    </COMMAND>
</VIEW>

<VIEW name="configure-vxlan-fbsd-view"
    prompt="${SYSTEM_NAME}(config-vxlan-${iface})# "
    depth="1">
    <PTYPE name="iface" pattern="${iface_vxlan}"/>
    <NAMESPACE ref="configure-view">
        <COMMAND name="end"
            help="back to enable-view"
            view="enable-view"/>
        <COMMAND name="interface" help="change interface"/>
        <COMMAND name="show" help="show status"/>
    </NAMESPACE>
    <HOTKEY key="^Z" cmd="exit"/>
    <COMMAND name="no"
        help="Negation of the command" help-id="negasi perintah">
        <PARAM name="subcommand"
            help="Negated command" help-id="perintah that dinegasi"
            ptype="SUBCOMMAND"/>
    </COMMAND>
    <COMMAND name="ip"
        help="IP configuration" help-id="konfigurasi IP">
        <PARAM name="subcommand"
            help="subcommand IP" help-id="sub-perintah IP"
            ptype="SUBCOMMAND"/>
    </COMMAND>
    <COMMAND name="no ip"
        help="Negation of IP configuration" help-id="negasi konfigurasi IP">
        <PARAM name="subcommand"
            help="Negated IP subcommand" help-id="sub-perintah IP that dinegasi"
            ptype="SUBCOMMAND"/>
    </COMMAND>
    <COMMAND name="ipv6"
        help="IPv6 configuration" help-id="konfigurasi IPv6">
        <PARAM name="subcommand"
            help="subcommand IPv6" help-id="sub-perintah IPv6"
            ptype="SUBCOMMAND"/>
    </COMMAND>
    <COMMAND name="no ipv6"
        help="Negation of IPv6 configuration" help-id="negasi konfigurasi IPv6">
        <PARAM name="subcommand"
            help="Negated IPv6 subcommand" help-id="sub-perintah IPv6 that dinegasi"
            ptype="SUBCOMMAND"/>
    </COMMAND>
    <COMMAND name="disable"
        help="disable interface (admin down)">
        <CONFIG operation="unset" pattern="^enable"/>
        <ACTION>
            ifconfig "${iface}" down
        </ACTION>
    </COMMAND>
    <COMMAND name="enable"
        help="hidupkan interface (admin up)">
        <CONFIG/>
        <ACTION>
            ifconfig "${iface}" up
        </ACTION>
    </COMMAND>
    <COMMAND name="ip address"
        help="IPv4 overlay address (CIDR, or PtP: peer address)" help-id="alamat IPv4 overlay (CIDR, or PtP: addr peer peer)">
        <PARAM name="addr"
            help="IPv4 address (CIDR, example 198.51.110.1/24)" help-id="alamat IPv4 (CIDR, example 198.51.110.1/24)"
            ptype="IP_ADDR_MASK"/>
        <PARAM name="peer"
            help="peer"
            mode="subcommand"
            optional="true"
            ptype="SUBCOMMAND">
            <PARAM name="peer_ip"
                help="peer address (PtP)" help-id="alamat peer (PtP)"
                ptype="IP_ADDR"/>
        </PARAM>
        <CONFIG pattern="^${__line}$"/>
        <ACTION>
            ${RT_SBIN}/titian-if.sh addr-add "${iface}" "${addr}" "${peer_ip}"
            ${RT_SBIN}/titian-persist.sh sync-if "${iface}"
        </ACTION>
    </COMMAND>
    <COMMAND name="no ip address"
        help="delete the IPv4 overlay address" help-id="delete alamat IPv4 overlay">
        <PARAM name="addr"
            help="IPv4 address" help-id="alamat IPv4"
            ptype="IP_ADDR_MASK"/>
        <CONFIG operation="unset" pattern="^ip address ${addr}$"/>
        <ACTION>
            ${RT_SBIN}/titian-if.sh addr-del "${iface}" "${addr}"
            ${RT_SBIN}/titian-persist.sh sync-if "${iface}"
        </ACTION>
    </COMMAND>
    <COMMAND name="ipv6 address"
        help="IPv6 address overlay (CIDR; FreeBSD: without peer)" help-id="alamat IPv6 overlay (CIDR; FreeBSD: tanpa peer)">
        <PARAM name="addr"
            help="IPv6 address (CIDR, example 2001:db8:310::1/64)" help-id="alamat IPv6 (CIDR, example 2001:db8:310::1/64)"
            ptype="IP6_ADDR_MASK"/>
        <CONFIG pattern="^${__line}$"/>
        <ACTION>
            ${RT_SBIN}/titian-if.sh addr6-add "${iface}" "${addr}" ""
            ${RT_SBIN}/titian-persist.sh sync-if "${iface}"
        </ACTION>
    </COMMAND>
    <COMMAND name="no ipv6 address"
        help="delete the IPv6 overlay address" help-id="delete alamat IPv6 overlay">
        <PARAM name="addr"
            help="IPv6 address" help-id="alamat IPv6"
            ptype="IP6_ADDR_MASK"/>
        <CONFIG operation="unset" pattern="^ipv6 address ${addr}$"/>
        <ACTION>
            ${RT_SBIN}/titian-if.sh addr6-del "${iface}" "${addr}"
            ${RT_SBIN}/titian-persist.sh sync-if "${iface}"
        </ACTION>
    </COMMAND>
    <COMMAND name="description"
        help="Interface description" help-id="deskripsi interface">
        <PARAM name="text"
            help="description text" help-id="teks deskripsi"
            ptype="STRING"/>
        <CONFIG/>
        <ACTION>
            ifconfig "${iface}" description "${text}"
        </ACTION>
    </COMMAND>

    <COMMAND name="no description"
        help="Delete the interface description" help-id="delete deskripsi interface">
        <CONFIG operation="unset" pattern="^description"/>
        <ACTION>
            ifconfig "${iface}" description ""
        </ACTION>
    </COMMAND>
    <COMMAND name="mtu"
        help="MTU overlay (useful limit: 1450 for VXLAN overhead ~50B; proven by a DF test, not from the docs)" help-id="MTU overlay (batas berguna: 1450 for overhead VXLAN ~50B; dibuktikan test DF, not from dokumen)">
        <PARAM name="val"
            help="MTU"
            ptype="MTU"/>
        <CONFIG pattern="^mtu"/>
        <ACTION>
            ${RT_SBIN}/titian-tune.sh mtu "${iface}" "${val}"
        </ACTION>
    </COMMAND>
    <COMMAND name="no mtu"
        help="delete MTU custom (back to default)" help-id="delete MTU kustom (back to default)">
        <CONFIG operation="unset" pattern="^mtu"/>
        <ACTION>
            ${RT_SBIN}/titian-tune.sh mtu-del "${iface}"
        </ACTION>
    </COMMAND>
    <COMMAND name="vni"
        help="VXLAN Network Identifier (1-16777215). Changing the VNI recreates the interface (brief flap; MAC stable per name in the lab)" help-id="VXLAN Network Identifier (1-16777215). Mengubah VNI = recreate interface (flap singkat; MAC stabil per name at lab)">
        <PARAM name="vni"
            help="VNI (1-16777215)"
            ptype="VNI_ID"/>
        <CONFIG pattern="^${__line}$"/>
        <ACTION>
            ${RT_SBIN}/titian-vxlan.sh set "${iface}" vni "${vni}"
        </ACTION>
    </COMMAND>
    <COMMAND name="no vni"
        help="delete VNI (back to placeholder without vxlanid)" help-id="delete VNI (back to placeholder tanpa vxlanid)">
        <CONFIG operation="unset" pattern="^vni"/>
        <ACTION>
            ${RT_SBIN}/titian-vxlan.sh unset "${iface}" vni
        </ACTION>
    </COMMAND>
    <COMMAND name="local"
        help="Local VTEP address (underlay, must be reachable by the peer)" help-id="alamat VTEP lokal (underlay, must terjangkau lawan)">
        <PARAM name="addr"
            help="Local IPv4 VTEP" help-id="IPv4 VTEP lokal"
            ptype="IP_ADDR"/>
        <CONFIG pattern="^${__line}$"/>
        <ACTION>
            ${RT_SBIN}/titian-vxlan.sh set "${iface}" local "${addr}"
        </ACTION>
    </COMMAND>
    <COMMAND name="no local"
        help="Delete the local VTEP" help-id="delete VTEP lokal">
        <CONFIG operation="unset" pattern="^local"/>
        <ACTION>
            ${RT_SBIN}/titian-vxlan.sh unset "${iface}" local
        </ACTION>
    </COMMAND>
    <COMMAND name="remote"
        help="Remote VTEP address (unicast). Removes group+dev if present" help-id="alamat VTEP lawan (unicast). Menghapus group+dev if ada">
        <PARAM name="addr"
            help="Remote IPv4 VTEP" help-id="IPv4 VTEP lawan"
            ptype="IP_ADDR"/>
        <CONFIG pattern="^${__line}$"/>
        <ACTION>
            ${RT_SBIN}/titian-vxlan.sh set "${iface}" remote "${addr}"
        </ACTION>
    </COMMAND>
    <COMMAND name="no remote"
        help="Delete the remote VTEP" help-id="delete VTEP lawan">
        <CONFIG operation="unset" pattern="^remote"/>
        <ACTION>
            ${RT_SBIN}/titian-vxlan.sh unset "${iface}" remote
        </ACTION>
    </COMMAND>
    <COMMAND name="group"
        help="multicast group + underlay device (multicast variant; removes the remote if present)" help-id="multicast group + underlay device (varian multicast; menghapus remote if ada)">
        <PARAM name="mcast"
            help="multicast address 224.0.0.0-239.255.255.255" help-id="alamat multicast 224.0.0.0-239.255.255.255"
            ptype="IP_ADDR"/>
        <PARAM name="dev"
            help="dev"
            mode="subcommand"
            ptype="SUBCOMMAND">
            <PARAM name="dev_iface"
                help="underlay device"
                completion="${Get_if_eth}"
                ptype="IFACE_SYS"/>
        </PARAM>
        <CONFIG pattern="^${__line}$"/>
        <ACTION>
            ${RT_SBIN}/titian-vxlan.sh set "${iface}" group "${mcast}" "${dev_iface}"
        </ACTION>
    </COMMAND>
    <COMMAND name="no group"
        help="delete multicast group + dev">
        <CONFIG operation="unset" pattern="^group"/>
        <ACTION>
            ${RT_SBIN}/titian-vxlan.sh unset "${iface}" group
        </ACTION>
    </COMMAND>
    <COMMAND name="dstport"
        help="UDP dstport for VXLAN (FreeBSD: fixed at 4789, other values are rejected)" help-id="UDP dstport VXLAN (FreeBSD: tetap 4789, value lain ditolak)">
        <PARAM name="port"
            help="UDP port (1-65535)"
            ptype="DSTPORT"/>
        <CONFIG pattern="^${__line}$"/>
        <ACTION>
            ${RT_SBIN}/titian-vxlan.sh set "${iface}" dstport "${port}"
        </ACTION>
    </COMMAND>
    <COMMAND name="no dstport"
        help="delete dstport (back to 4789)">
        <CONFIG operation="unset" pattern="^dstport"/>
        <ACTION>
            ${RT_SBIN}/titian-vxlan.sh unset "${iface}" dstport
        </ACTION>
    </COMMAND>
    <COMMAND name="learn"
        help="Enable VXLAN learning (the FDB is learned from incoming packets). Only for multicast multi-VTEP; unicast MUST be off — learn + underlay NAT maps peers to the gateway (95% loss, 16 Nov 2026)" help-id="Aktifkan VXLAN learning (FDB dipelajari dari paket masuk). Hanya untuk multicast multi-VTEP; unicast WAJIB off — learn + underlay NAT memetakan peer ke gateway (loss 95%, 16 Nov 2026)">
        <CONFIG pattern="^${__line}$"/>
        <ACTION>
            ${RT_SBIN}/titian-vxlan.sh set "${iface}" learn on
        </ACTION>
    </COMMAND>
    <COMMAND name="no learn"
        help="Disable VXLAN learning (default; unicast safe)" help-id="Matikan VXLAN learning (default; unicast aman)">
        <CONFIG operation="unset" pattern="^learn"/>
        <ACTION>
            ${RT_SBIN}/titian-vxlan.sh unset "${iface}" learn
        </ACTION>
    </COMMAND>

    <COMMAND name="exit"
        help="Exit from VXLAN configuration mode" help-id="Exit from mode konfigurasi vxlan">
        <ACTION builtin="clish_nested_up"/>
    </COMMAND>

</VIEW>

</CLISH_MODULE>
