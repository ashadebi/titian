<?xml version="1.0" encoding="UTF-8"?>
<CLISH_MODULE xmlns="/opt/titian/XMLSchema" 
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
 xsi:schemaLocation="/opt/titian/XMLSchema/clish.xsd">
    <!--=======================================================-->
<!--//
        pattern super mengakomodasi semua interface
//-->
<!-- Interface sistem TERPADU (2 Nov 2026): satu PTYPE kedua OS.
     Dulu IFACE_DEV (pola nama Linux) + IFACE_DEV_FBSD (pola nama
     FreeBSD) + IFACE_ANY (gabungan pola) — ketiganya gagal untuk
     interface yang di-rename di level OS. Sekarang validasi klish
     hanya memeriksa BENTUK nama (charset + panjang IFNAMSIZ 15),
     sedangkan keberadaan interface diperiksa helper ACTION
     (view/ACTION per-OS) dengan pesan lantang. Pola: huruf/angka/
     underscore di awal, lalu huruf/angka/underscore/titik/strip,
     total maks 15 karakter. Sengaja TIDAK mengizinkan: '/' (tidak sah
     di kedua OS), spasi, ':' (notasi alias, bukan interface nyata),
     awalan '.'/'-' ('.'/'..' tidak sah; '-' pathological untuk CLI).
     Total 15 = IFNAMSIZ 16 kedua OS (Linux + FreeBSD) minus NUL. -->
    <PTYPE name="IFACE_SYS"
        pattern="^[A-Za-z0-9_][A-Za-z0-9_.-]{0,14}$"
        help="name interface system apa pun — terdeteksi langsung from OS (show 'show interfaces', or Tab/? for list). Name fisik gaya romawi (e=Ethernet): xe=10G, xxve=25G, xle=40G, le=50G, ce=100G, cce=200G, cde=400G"/>
    <!--=======================================================-->
    <!-- VLAN Linux = parent.tag; parent adalah interface sistem yang
         BISA di-rename, jadi parent memakai charset IFACE_SYS (tanpa
         titik — vlan bertingkat tidak didukung ACTION split). VID
         tetap 1-4094. Total panjang nama ditegakkan kernel (15);
         bila melebihi, ACTION ip gagal lantang. -->
    <PTYPE name="IFACE_VLAN"
        pattern="^[A-Za-z0-9_][A-Za-z0-9_-]{0,14}\.(409[0-5]|40[0-8][0-9]|[1-3][0-9]{3}|[1-9][0-9]{2}|[1-9][0-9]|[1-9])$"
        help="name-parent.VLAN-ID (example: enp9s0.100; list: show interfaces)"/>
    <!--=======================================================--> 
    <PTYPE name="IFACE_DUMMY"
        pattern="lo([1-9][0-9]?)$"
        help="lo1-lo99"/>
    <!--=======================================================-->
    <PTYPE name="IFACE_BOND"
        pattern="bond([0-9])$"
        help="bond[0-9]"/>
    <!--=======================================================-->
    <PTYPE name="IFACE_VXLAN"
        pattern="vxlan[0-9]+$"
        help="vxlan[N]"/>
    <!--=======================================================-->
    <PTYPE name="IFACE_BRIDGE"
        pattern="bridge[0-9]+$"
        help="bridge[N]"/>
    <!--=======================================================-->
    <PTYPE name="VNI_ID"
        pattern="[0-9]+"
        help="range 1-16777215"/>
    <!--=======================================================-->
    <PTYPE name="BW_SECONDS"
        pattern="([1-9][0-9]{0,2}|[1-2][0-9]{3}|3[0-5][0-9]{2}|3600)"
        help="durasi detik 1-3600"/>
    <!--=======================================================-->
    <PTYPE name="DSTPORT"
        pattern="[0-9]+"
        help="range 1-65535"/>
    <!-- IFACE_ANY dihapus 2 Nov 2026: digantikan IFACE_SYS (charset yang
         sama mencakup semua nama lama IFACE_ANY + nama hasil rename). -->
<!-- IP Address -->
    <!--=======================================================-->
    <PTYPE name="IP_ADDR"
        pattern="(((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?))"
        help="A.B.C.D"/>
    <!--=======================================================-->
    <PTYPE name="IP_ADDR_MASK"
        pattern="^(([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])\.){3}([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])(\/([0-9]|[1-2][0-9]|3[0-2]))$"
        help="A.B.C.D[/mask]"/>
    <PTYPE name="IP_ADDR_MASK_OPT"
        pattern="^(([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])\.){3}([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])(\/([0-9]|[1-2][0-9]|3[0-2]))?$"
        help="A.B.C.D or A.B.C.D/mask (bare = /32; PtP form)"/>
    <!--=======================================================-->
    <PTYPE name="IP_ADDR_ANY"
        pattern="^(([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])\.){3}([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])(\/([0-9]|[1-2][0-9]|3[0-2]))$|((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)"
        help="A.B.C.D or A.B.C.D[/mask]"/>
    <!--=======================================================-->
    <PTYPE name="MTU"
        pattern="(9000|8[0-9][0-9][0-9]|[1-7][0-9]{3}|[1-9][0-9]{2}|[7-9][0-9]|6[8-9])"
        help="range 68-9000"/>
    <!--=======================================================-->
    <PTYPE name="SPEED"
        pattern="^(100000|50000|40000|25000|10000|5000|2500|1000|100|10)$"
        help="speed Mb/s: 10 100 1000 2500 5000 10000 25000 40000 50000 100000"/>
    <!--=======================================================-->
    <PTYPE name="VLAN_ID" 
        pattern="(409[0-5]|40[0-8][0-9]|[1-3][0-9]{3}|[1-9][0-9]{2}|[1-9][0-9]|[1-9])"
        help="range 1-4094"/>
    <!--=======================================================-->
    <PTYPE name="CHECKPOINT_NAME"
        pattern="[A-Za-z0-9][A-Za-z0-9_-]*"
        help="name checkpoint [A-Za-z0-9_-]+"/>
    <!--=======================================================-->
    <!-- Firewall/NAT (2 Nov 2026): bentuk kanonis dipaksa PTYPE
         agar baris running-config selalu sama persis dengan `no`
         form-nya (CIDR wajib bermask; host = /32; `any` eksplisit). -->
    <PTYPE name="FW_CHAIN"
        pattern="^(forward|input|output)$"
        help="forward | input | output"/>
    <PTYPE name="FW_ACTION"
        pattern="^(permit|deny)$"
        help="permit | deny"/>
    <PTYPE name="FW_PROTO"
        pattern="^(tcp|udp|icmp|all)$"
        help="tcp | udp | icmp | all"/>
    <PTYPE name="FW_DNAT_PROTO"
        pattern="^(tcp|udp)$"
        help="tcp | udp"/>
    <PTYPE name="FW_CIDR_OR_ANY"
        pattern="^(any|((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)/([0-9]|[1-2][0-9]|3[0-2]))$"
        help="CIDR (example 198.51.100.0/24; host = /32) or any"/>
    <PTYPE name="FW_PORT_OR_ANY"
        pattern="^(any|[0-9]+)$"
        help="port 1-65535 or any (range dicek helper)"/>
    <PTYPE name="FW_PORT_OR_SAME"
        pattern="^(same|[0-9]+)$"
        help="port 1-65535 or same (range dicek helper)"/>
    <PTYPE name="FW_IFACE_OR_ANY"
        pattern="^(any|[A-Za-z0-9_][A-Za-z0-9_.-]{0,14})$"
        help="name interface (charset IFACE_SYS) or any"/>
    <PTYPE name="FW_SNAT_TARGET"
        pattern="^(masquerade|((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?))$"
        help="alamat IPv4 or masquerade"/>
    <!--=======================================================-->
</CLISH_MODULE>
