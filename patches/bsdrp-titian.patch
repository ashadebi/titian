 sshd_ecdsa_enable="no"
 
+# SSH up saat boot (default BSDRP_klish). Root login butuh key
+# (authorized_keys); password root via SSH tetap mati (default sshd).
+sshd_enable="YES"
+
 # Fixing gpt corrupt state (after dd image in bigger disk)
 # growfs runs `gpart recover` on firstboot, replacing the old gpartfix script.
 # Disable growfs swap creation: BSDRP images are built with SWAPSIZE=0.
@@ -70,3 +74,25 @@ harvest_mask="351"
 
 # Drop ICMP redirect
 icmp_drop_redirect="YES"
+
+## Monitoring (BSDRP_klish defaults)
+
+# SNMP agent (net-snmp) — config: /usr/local/etc/snmpd.conf
+# Community default 'bsdrp-ro' — GANTI sebelum diekspos ke jaringan tak tepercaya.
+snmpd_enable="NO"
+
+# Prometheus exporters (node_exporter :9100, bird_exporter :9324)
+node_exporter_enable="NO"
+bird_exporter_enable="NO"
+
+# NetFlow collector (pmacct nfacctd) — listen 127.0.0.1:9996, log /var/log/nfacctd.log
+# Config: /usr/local/etc/nfacctd.conf
+nfacctd_enable="NO"
+
+# NetFlow exporter bawaan (ngnetflow) — MATI default: butuh interface transit.
+# Nyalakan dengan 2 baris ini (ganti igb0 dengan interface transit):
+# ngnetflow_enable="YES"
+# ngnetflow_if="igb0"
+ngnetflow_enable="NO"
+ngnetflow_dst="127.0.0.1:9996"
+ngnetflow_ver="9"
