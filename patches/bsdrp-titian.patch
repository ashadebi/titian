diff --git a/poudriere.etc/poudriere.d/BSDRPj-make.conf b/poudriere.etc/poudriere.d/BSDRPj-make.conf
index 7147e27..ed73492 100644
--- a/poudriere.etc/poudriere.d/BSDRPj-make.conf
+++ b/poudriere.etc/poudriere.d/BSDRPj-make.conf
@@ -11,7 +11,27 @@ security_openvpn_SET+=DCO
 benchmarks_netperf_UNSET+=OMNI
 sysutils_flashrom_UNSET+=DMIDECODE FTDI
 sysutils_mstflint_SET+=FWMANAGER ADAB
+# BMP is OPTIONS_DEFAULT in both bird2 and bird3; the two lines below make
+# the intent explicit. Only one of them ever takes effect: each image builds
+# exactly one bird variant (see BIRD_VERSION in the Makefile).
 net_bird2_SET+=BMP
+net_bird3_SET+=BMP
 net_mtr_UNSET+=JSON
 ftp_curl_SET+=GSSAPI_NONE
 ftp_curl_UNSET+=GSSAPI_BASE IMAP GOPHER HTTP2 LIBSSH2 POP3 PSL RTSP SMTP TELNET
+
+# 2026-11-09: libsoup3 GSSAPI_BASE fails — the BSDRP jail base is built
+# WITHOUT_KERBEROS, so /usr/include/gssapi/gssapi.h does not exist
+# (same reason ftp/curl already uses GSSAPI_NONE above). GSSAPI in
+# libsoup is irrelevant for a router.
+devel_libsoup3_SET+=GSSAPI_NONE
+devel_libsoup3_UNSET+=GSSAPI_BASE
+# 2026-11-09: OOM fix, part 1 — at most 2 parallel make jobs per package.
+MAKE_JOBS_NUMBER=2
+
+# 2026-11-09: llvm19 per-port jobs — at global MAKE_JOBS_NUMBER=2 it
+# would take ~5 days (72% in 24h at -j8). 4 jobs lets it finish in
+# ~2-3 days; with PARALLEL_JOBS=2 and disk wrkdir the memory is safe.
+.if ${.CURDIR:M*/devel/llvm19}
+MAKE_JOBS_NUMBER=4
+.endif
diff --git a/poudriere.etc/poudriere.d/BSDRPj-poudriere.conf b/poudriere.etc/poudriere.d/BSDRPj-poudriere.conf
index 20f725d..569f0ba 100644
--- a/poudriere.etc/poudriere.d/BSDRPj-poudriere.conf
+++ b/poudriere.etc/poudriere.d/BSDRPj-poudriere.conf
@@ -12,3 +12,16 @@
 # defaults to GSSAPI_BASE, which breaks net/bird3 and, via rtrlib, net/frr10).
 # Fetched packages also silently ignore the port options set in BSDRPj-make.conf.
 PACKAGE_FETCH_BRANCH=
+
+# 2026-11-09: OOM fix — kopler has 8 GB RAM + 2 GB swap (100% full);
+# 8 parallel builders with RAM-backed tmpfs wrkdir OOM-killed rust,
+# x265, gcc14 and spirv-tools (dmesg: cc1plus, c++, bsdtar, nasm
+# "failed to reclaim memory"). 2 builders + wrkdir on disk (1.7 TB
+# free): slower, but completes. Raise PARALLEL_JOBS again if RAM grows.
+PARALLEL_JOBS=2
+USE_TMPFS=no
+
+# 2026-11-09: llvm19 needs more than poudriere's 24h default timeout
+# (MAX_EXECUTION_TIME=86400) — it reached 72% in 24h at -j8, then was
+# killed. 4 days (per-package form, see poudriere.conf:243-246).
+MAX_EXECUTION_TIME_llvm19=345600
