diff --git a/Makefile b/Makefile
index 4a8f872..d254f14 100644
--- a/Makefile
+++ b/Makefile
@@ -158,12 +158,26 @@ src_ports_dir := ${OBJ_DIR}/ports
 src_arch = ${MACHINE_ARCH:S/aarch64/arm64/}
 kernel = ${OBJ_DIR}/FreeBSD/sys/${src_arch}/conf/${src_arch}
 
+# BIRD_VERSION: which BIRD routing daemon this image ships: 2 or 3.
+# bird2 and bird3 conflict in the ports tree (same binaries + rc script),
+# so one image can only ship one of them. Default is 2 (the lab-proven
+# version); override from the command line: make BIRD_VERSION=3
+BIRD_VERSION ?= 2
+.if ${BIRD_VERSION} != "2" && ${BIRD_VERSION} != "3"
+.error "BIRD_VERSION must be 2 or 3 (got ${BIRD_VERSION})"
+.endif
+
 # Config files concatenated as "common + optional arch-specific" by the build
 # targets below. The arch-specific half is optional, so it is only added as a
 # dependency when it exists: otherwise make would refuse to build a missing
 # prerequisite on arches that don't have one.
 pkglist_src = ${SRC_DIR}/poudriere.etc/poudriere.d/BSDRP-pkglist.common
 srcconf_src = ${SRC_DIR}/poudriere.etc/poudriere.d/BSDRPj-src.conf.common
+# The BIRD half is NOT optional: exactly one bird variant must be present,
+# so it is added unconditionally (a missing file fails the build loudly
+# instead of silently producing an image without any routing daemon).
+pkglist_bird = ${SRC_DIR}/poudriere.etc/poudriere.d/BSDRP-pkglist.bird${BIRD_VERSION}
+pkglist_src += ${pkglist_bird}
 .if exists(${SRC_DIR}/poudriere.etc/poudriere.d/BSDRP-pkglist.${src_arch})
 pkglist_src += ${SRC_DIR}/poudriere.etc/poudriere.d/BSDRP-pkglist.${src_arch}
 .endif
@@ -175,10 +189,10 @@ srcconf_src += ${SRC_DIR}/poudriere.etc/poudriere.d/BSDRPj-src.conf.${src_arch}
 VERSION != cat ${SRC_DIR}/BSDRP/Files/etc/version
 
 # Define output image file paths
-BSDRP_IMG_FULL = ${poudriere_images_dir}/BSDRP-${VERSION}-full-${MACHINE_ARCH}.img
-BSDRP_IMG_UPGRADE = ${poudriere_images_dir}/BSDRP-${VERSION}-upgrade-${MACHINE_ARCH}.img
-BSDRP_IMG_DEBUG = ${poudriere_images_dir}/BSDRP-${VERSION}-debug-${MACHINE_ARCH}.tar
-BSDRP_IMG_MTREE = ${poudriere_images_dir}/BSDRP-${VERSION}-${MACHINE_ARCH}.mtree
+BSDRP_IMG_FULL = ${poudriere_images_dir}/BSDRP-${VERSION}-full-bird${BIRD_VERSION}-${MACHINE_ARCH}.img
+BSDRP_IMG_UPGRADE = ${poudriere_images_dir}/BSDRP-${VERSION}-upgrade-bird${BIRD_VERSION}-${MACHINE_ARCH}.img
+BSDRP_IMG_DEBUG = ${poudriere_images_dir}/BSDRP-${VERSION}-debug-bird${BIRD_VERSION}-${MACHINE_ARCH}.tar
+BSDRP_IMG_MTREE = ${poudriere_images_dir}/BSDRP-${VERSION}-bird${BIRD_VERSION}-${MACHINE_ARCH}.mtree
 IMAGES := ${BSDRP_IMG_FULL} ${BSDRP_IMG_UPGRADE} ${BSDRP_IMG_MTREE} ${BSDRP_IMG_DEBUG}
 COMPRESSED_IMAGES := ${BSDRP_IMG_FULL}.xz ${BSDRP_IMG_UPGRADE}.xz ${BSDRP_IMG_MTREE}.xz ${BSDRP_IMG_DEBUG}.xz
 # The %= modifier applies a suffix to each item in a list
@@ -405,6 +419,8 @@ ${OBJ_DIR}/build-packages: ${OBJ_DIR}/build-builder-jail ${OBJ_DIR}/build-ports-
 	@if [ -f ${SRC_DIR}/poudriere.etc/poudriere.d/BSDRP-pkglist.${src_arch} ]; then \
 		cat ${SRC_DIR}/poudriere.etc/poudriere.d/BSDRP-pkglist.${src_arch} >> ${OBJ_DIR}/pkglist || exit 1; \
 	fi
+	# Append the selected BIRD variant (exactly one of bird2/bird3).
+	@cat ${pkglist_bird} >> ${OBJ_DIR}/pkglist || exit 1
 	@${sudo} poudriere -e ${SRC_DIR}/poudriere.etc bulk -j BSDRPj -p BSDRPp -f ${OBJ_DIR}/pkglist || { \
 		echo "Error: Package build failed"; \
 		exit 1; \
@@ -421,11 +437,12 @@ ${BSDRP_IMG_FULL} ${BSDRP_IMG_UPGRADE} ${BSDRP_IMG_MTREE} ${BSDRP_IMG_DEBUG}: ${
 	# the build is interrupted before the restore step).
 	@${sudo} rm -rf ${OBJ_DIR}/Files
 	@cp -R ${SRC_DIR}/BSDRP/Files ${OBJ_DIR}/Files
-	# Replace version in brand-bsdrp.lua (on the staged copy). The placeholder
-	# is the last 13 columns of the longest ASCII-art row, which is padded to
-	# square the boot banner, so pad/truncate the version to the same width.
+	# Replace version in brand-bsdrp.lua and brand-bsdrp.4th (on the staged copy). The placeholder
+	# sits on the version line below the logo art; pad/truncate the version to
+	# the same 13-column width.
 	@banner_version=$$(printf '%-13.13s' '${VERSION}') && \
-	sed -i '' -e "s/BSDRP_VERSION/$${banner_version}/" ${OBJ_DIR}/Files/boot/lua/brand-bsdrp.lua
+	sed -i '' -e "s/BSDRP_VERSION/$${banner_version}/" ${OBJ_DIR}/Files/boot/lua/brand-bsdrp.lua && \
+	sed -i '' -e "s/BSDRP_VERSION/$${banner_version}/" ${OBJ_DIR}/Files/boot/brand-bsdrp.4th
 	# Record the upstream sources this image was built from. /etc/version holds
 	# either a release string (2.1) or a FreeBSD commit count (n312550)
 	# depending on release state, and a count orders builds without identifying
@@ -433,6 +450,7 @@ ${BSDRP_IMG_FULL} ${BSDRP_IMG_UPGRADE} ${BSDRP_IMG_MTREE} ${BSDRP_IMG_DEBUG}: ${
 	@freebsd_count=$$(git -C ${src_FreeBSD_dir} rev-list --count HEAD 2>/dev/null || echo unknown); \
 	( \
 		echo "bsdrp_version=${VERSION}"; \
+		echo "bird_version=${BIRD_VERSION}"; \
 		echo "freebsd_hash=${FreeBSD_hash}"; \
 		echo "freebsd_branch=${FreeBSD_branch}"; \
 		echo "freebsd_count=$${freebsd_count}"; \
@@ -443,9 +461,11 @@ ${BSDRP_IMG_FULL} ${BSDRP_IMG_UPGRADE} ${BSDRP_IMG_MTREE} ${BSDRP_IMG_DEBUG}: ${
 	# poudriere-image copies the overlay preserving ownership; force root:wheel
 	# so the image root fs isn't owned by whoever ran make.
 	@${sudo} chown -R 0:0 ${OBJ_DIR}/Files
-	# Image size of 4g still too big to upgrade previous 4g nanobsd image, need to reduce
-	@${sudo} poudriere -e ${SRC_DIR}/poudriere.etc image -t firmware -s 3.95g \
-		-j BSDRPj -p BSDRPp -n BSDRP -h router.bsdrp.net \
+	# Image size 15g so the image fits a 16GB USB stick (poudriere reads 'g'
+	# as decimal GB -> 14648 MiB). Note: the -upgrade image from this build
+	# only applies to a system first flashed with this same 15g image.
+	@${sudo} poudriere -e ${SRC_DIR}/poudriere.etc image -t firmware -s 15g \
+		-j BSDRPj -p BSDRPp -n BSDRP -h bsdrp.ashadebi-kopler.net \
 		-c ${OBJ_DIR}/Files/ \
 		-f ${OBJ_DIR}/pkglist \
 		-X ${SRC_DIR}/poudriere.etc/poudriere.d/excluded.files \
@@ -550,3 +570,6 @@ help:
 	@echo " compress-images     - Compress generated files"
 	@echo " checksum-images     - Compute checksums of generated files"
 	@echo " release             - Build, compress, then generate checksums of images"
+	@echo ""
+	@echo "Variables (override on the command line, e.g. make BIRD_VERSION=3):"
+	@echo " BIRD_VERSION=2|3    - BIRD routing daemon in the image (default 2)"
